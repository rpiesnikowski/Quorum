@inject NavigationManager Navigation

<CascadingAuthenticationState>
    <Router AppAssembly="typeof(Program).Assembly" 
            AdditionalAssemblies="new[] { typeof(Quorum.Backend.AdminUI.Components.Layout.AdminLayout).Assembly }">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
                <NotAuthorized>
                    @if (context.User.Identity?.IsAuthenticated != true)
                    {
                        <div class="d-flex justify-content-center align-items-center" style="min-height: 70vh;">
                            <RadzenCard Class="rz-p-5 text-center" Style="max-width: 480px;">
                                <RadzenIcon Icon="lock" Style="font-size: 3.5rem; color: #3b82f6;" />
                                <RadzenText TextStyle="TextStyle.H4" Class="fw-bold mt-3 mb-2">Wymagane Logowanie</RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" Class="text-muted mb-4">
                                    Dostęp do tego zasobu wymaga uwierzytelnienia. Zaloguj się, aby kontynuować.
                                </RadzenText>
                                <a href="/account/login" class="btn btn-primary d-flex align-items-center justify-content-center gap-1">
                                    <i class="material-icons">login</i> Przejdź do logowania
                                </a>
                            </RadzenCard>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex justify-content-center align-items-center" style="min-height: 70vh;">
                            <RadzenCard Class="rz-p-5 text-center" Style="max-width: 480px;">
                                <RadzenIcon Icon="gpp_bad" Style="font-size: 3.5rem; color: #ef4444;" />
                                <RadzenText TextStyle="TextStyle.H4" Class="fw-bold mt-3 mb-2">Brak Uprawnień</RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" Class="text-muted mb-4">
                                    Nie posiadasz wystarczających uprawnień (wymagana rola <strong>Administratora</strong>), aby uzyskać dostęp do panelu administracyjnego.
                                </RadzenText>
                                <div class="d-flex justify-content-center gap-2">
                                    <a href="/" class="btn btn-outline-secondary d-flex align-items-center gap-1">
                                        <i class="material-icons">home</i> Strona Główna
                                    </a>
                                    <a href="/account/logout" class="btn btn-primary d-flex align-items-center gap-1">
                                        <i class="material-icons">logout</i> Zmień Konto
                                    </a>
                                </div>
                            </RadzenCard>
                        </div>
                    }
                </NotAuthorized>
                <Authorizing>
                    <div class="d-flex justify-content-center align-items-center" style="min-height: 60vh;">
                        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Medium" />
                    </div>
                </Authorizing>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>Nie Znaleziono | Quorum</PageTitle>
            <LayoutView Layout="@typeof(Layout.MainLayout)">
                <div class="d-flex justify-content-center align-items-center" style="min-height: 70vh;">
                    <RadzenCard Class="rz-p-5 text-center" Style="max-width: 480px;">
                        <RadzenIcon Icon="search_off" Style="font-size: 3.5rem; color: #64748b;" />
                        <RadzenText TextStyle="TextStyle.H3" Class="fw-bold mt-3 mb-2">404</RadzenText>
                        <RadzenText TextStyle="TextStyle.H5" Class="fw-bold mb-2">Nie znaleziono strony</RadzenText>
                        <RadzenText TextStyle="TextStyle.Body1" Class="text-muted mb-4">
                            Strona, której szukasz, nie istnieje lub została przeniesiona.
                        </RadzenText>
                        <RadzenButton Text="Powrót do Pulpitu" Icon="dashboard" ButtonStyle="ButtonStyle.Primary" Click="@(() => Navigation.NavigateTo("/admin"))" />
                    </RadzenCard>
                </div>
            </LayoutView>
        </NotFound>
    </Router> 
</CascadingAuthenticationState>

<RadzenComponents />
