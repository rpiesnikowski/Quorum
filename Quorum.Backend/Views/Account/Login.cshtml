@model Quorum.Backend.Controllers.LoginViewModel
@{
    ViewData["Title"] = "Logowanie";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="text-center mb-4">
                <div class="display-6 text-primary mb-2">
                    <i class="bi bi-shield-lock-fill"></i>
                </div>
                <h3 class="fw-bold">Zaloguj się do Quorum</h3>
                <p class="text-muted small">Centralny serwer tożsamości OpenID Connect / OAuth 2.0</p>
            </div>

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show small mb-3 shadow-sm rounded-3" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="card border-0 shadow-sm rounded-4 mb-3">
                <div class="card-body p-4 p-md-5">
                    @if (Model.ExternalProviders != null && Model.ExternalProviders.Any())
                    {
                        <div class="mb-4">
                            <label class="form-label fw-semibold small text-muted text-uppercase mb-3">Zaloguj się przez dostawcę SSO (Federated OIDC)</label>
                            <div class="d-flex flex-column gap-2">
                                @foreach (var provider in Model.ExternalProviders)
                                {
                                    <form asp-controller="Account" asp-action="ExternalLogin" method="post">
                                        <input type="hidden" name="provider" value="@provider.Scheme" />
                                        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                                        <button type="submit" class="btn w-100 py-2 d-flex align-items-center justify-content-center gap-2 text-white fw-semibold rounded-3 shadow-sm"
                                                style="background-color: @(provider.ButtonColor ?? "#0d6efd"); border: none;">
                                            @if (provider.IconType == "microsoft")
                                            {
                                                <i class="bi bi-microsoft"></i>
                                            }
                                            else if (provider.IconType == "azure")
                                            {
                                                <i class="bi bi-cloud-check-fill"></i>
                                            }
                                            else if (provider.IconType == "google")
                                            {
                                                <i class="bi bi-google"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-shield-lock"></i>
                                            }
                                            <span>Zaloguj przez @provider.DisplayName</span>
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>

                        <div class="position-relative my-4">
                            <hr class="text-secondary opacity-25" />
                            <span class="position-absolute top-50 start-50 translate-middle bg-white px-3 text-muted small fw-semibold">
                                lub zaloguj się kontem lokalnym
                            </span>
                        </div>
                    }

                    <form method="post" asp-controller="Account" asp-action="Login">
                        <input type="hidden" asp-for="ReturnUrl" />
                        
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Username" class="form-label fw-semibold small">Nazwa Użytkownika lub Email</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-person text-muted"></i></span>
                                <input asp-for="Username" class="form-control border-start-0" placeholder="admin" autofocus />
                            </div>
                            <span asp-validation-for="Username" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label fw-semibold small">Hasło</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-key text-muted"></i></span>
                                <input asp-for="Password" type="password" class="form-control border-start-0" placeholder="Pass123$" />
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="form-check mb-4">
                            <input asp-for="RememberMe" class="form-check-input" type="checkbox" id="rememberMeCheck" />
                            <label class="form-check-label small" for="rememberMeCheck">Zapamiętaj mnie na tym urządzeniu</label>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" name="button" value="login" class="btn btn-primary py-2 fw-semibold">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Zaloguj się kontem lokalnym
                            </button>
                            @if (!string.IsNullOrEmpty(Model.ReturnUrl))
                            {
                                <button type="submit" name="button" value="cancel" class="btn btn-outline-secondary py-2">
                                    Anuluj
                                </button>
                            }
                        </div>
                    </form>
                </div>
            </div>

            <div class="card bg-white border mt-3 rounded-3 p-3 shadow-sm">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="small fw-semibold text-dark"><i class="bi bi-people-fill text-primary me-1"></i>Konto użytkownika testowego:</span>
                    <span class="badge bg-primary-subtle text-primary">Portal Użytkownika</span>
                </div>
                <div class="small text-muted">Login: <code class="text-primary fw-bold">jan.kowalski</code> | Hasło: <code class="text-primary fw-bold">Pass123$</code></div>
                
                <hr class="my-2" />

                <div class="d-flex justify-content-between align-items-center">
                    <span class="small text-muted"><i class="bi bi-shield-lock-fill text-warning me-1"></i>Dedykowane okno logowania dla Admina:</span>
                    <a href="/Admin/Account/Login" class="btn btn-sm btn-dark d-inline-flex align-items-center gap-1">
                        <i class="bi bi-box-arrow-in-right"></i> Logowanie Admina
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
