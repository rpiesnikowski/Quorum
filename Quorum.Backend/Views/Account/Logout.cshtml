@model Quorum.Backend.Controllers.LogoutViewModel
@{
    ViewData["Title"] = "Wylogowanie";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 text-center p-4">
                <div class="card-body">
                    <div class="display-5 text-warning mb-3">
                        <i class="bi bi-box-arrow-right"></i>
                    </div>
                    <h3 class="fw-bold">Czy na pewno chcesz się wylogować?</h3>
                    <p class="text-muted">
                        Twoja aktywna sesja użytkownika zostanie zakończona.
                    </p>

                    <form method="post" asp-controller="Account" asp-action="Logout" class="mt-4">
                        <input type="hidden" asp-for="LogoutId" />
                        <div class="d-flex justify-content-center gap-2">
                            <button type="submit" class="btn btn-danger px-4 py-2 fw-semibold">
                                <i class="bi bi-box-arrow-right me-1"></i> Tak, wyloguj
                            </button>
                            <a href="/" class="btn btn-outline-secondary px-4 py-2">
                                Anuluj
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
