@model Quorum.Backend.Controllers.LoggedOutViewModel
@{
    ViewData["Title"] = "Wylogowano";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 text-center p-4">
                <div class="card-body">
                    <div class="display-4 text-success mb-3">
                        <i class="bi bi-check-circle-fill"></i>
                    </div>
                    <h3 class="fw-bold">Pomyślnie wylogowano</h3>
                    <p class="text-muted">
                        Twoja sesja została bezpiecznie zakończona.
                    </p>

                    @if (!string.IsNullOrEmpty(Model.PostLogoutRedirectUri))
                    {
                        <div class="mt-4">
                            <p class="small text-muted">
                                Kliknij poniżej, aby powrócić do aplikacji <strong>@(Model.ClientName ?? "klienta")</strong>:
                            </p>
                            <a href="@Model.PostLogoutRedirectUri" class="btn btn-primary px-4 py-2">
                                Powrót do aplikacji &rarr;
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="mt-4">
                            <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4 py-2">
                                Strona Główna
                            </a>
                            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary px-3 py-2 ms-2">
                                Zaloguj ponownie
                            </a>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.SignOutIFrameUrl))
                    {
                        <iframe class="d-none" src="@Model.SignOutIFrameUrl"></iframe>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@if (Model.AutomaticRedirectAfterSignOut && !string.IsNullOrEmpty(Model.PostLogoutRedirectUri))
{
    @section Scripts {
        <script>
            window.addEventListener("load", function () {
                var redirectUri = '@Model.PostLogoutRedirectUri';
                if (redirectUri) {
                    setTimeout(function() {
                        window.location.href = redirectUri;
                    }, 1500);
                }
            });
        </script>
    }
}
