@{
    ViewData["Title"] = "Serwer Tożsamości OpenID Connect & OAuth 2.0";
}

<div class="container py-3">
    <div class="p-5 mb-4 bg-white rounded-4 shadow-sm border">
        <div class="container-fluid py-2">
            <div class="d-flex align-items-center gap-3 mb-3">
                <div class="p-3 bg-primary text-white rounded-3 fs-3">
                    <i class="bi bi-shield-lock-fill"></i>
                </div>
                <div>
                    <h1 class="display-6 fw-bold mb-0">Quorum IdentityServer</h1>
                    <p class="text-muted mb-0">Serwer tożsamości OpenID Connect i OAuth 2.0 zbudowany na .NET 10</p>
                </div>
            </div>
            <p class="col-md-10 fs-6 text-secondary">
                Witaj w centralnym punkcie uwierzytelniania i autoryzacji Quorum. Serwer obsługuje przepływy OAuth 2.0 / OIDC (Authorization Code z PKCE, Client Credentials, Refresh Tokens) oraz zapewnia wbudowany interfejs zarządzania klientami i użytkownikami.
            </p>
            <div class="d-flex flex-wrap gap-2 pt-2">
                <a href="/Admin" class="btn btn-primary px-4 py-2 fw-semibold">
                    <i class="bi bi-speedometer2 me-1"></i> Przejdź do Panelu Admina
                </a>
                <a href="/.well-known/openid-configuration" target="_blank" class="btn btn-outline-dark px-3 py-2">
                    <i class="bi bi-filetype-json me-1"></i> Dokument Discovery OIDC
                </a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Diagnostics" asp-action="Index" class="btn btn-outline-secondary px-3 py-2">
                        <i class="bi bi-fingerprint me-1"></i> Podgląd Tokenów / Claims
                    </a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn btn-outline-success px-3 py-2">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Zaloguj się
                    </a>
                }
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-3">
                <div class="card-body p-4">
                    <div class="text-primary mb-3 fs-4">
                        <i class="bi bi-sliders"></i>
                    </div>
                    <h5 class="fw-bold">Panel Administracyjny CRUD</h5>
                    <p class="text-muted small">
                        Wizualne zarządzanie zarejestrowanymi klientami OIDC, zakresami API (Scopes), zasobami tożsamości oraz użytkownikami ASP.NET Identity w Razor Pages.
                    </p>
                    <a href="/Admin" class="text-decoration-none small fw-semibold text-primary">
                        Zarządzaj konfiguracją &rarr;
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-3">
                <div class="card-body p-4">
                    <div class="text-success mb-3 fs-4">
                        <i class="bi bi-database-check"></i>
                    </div>
                    <h5 class="fw-bold">Elastyczna Baza EF Core</h5>
                    <p class="text-muted small">
                        Domyślnie skonfigurowana bezobsługowa baza SQLite (<code>identityserver.db</code>) z opcją natychmiastowego przełączenia na PostgreSQL w <code>appsettings.json</code>.
                    </p>
                    <span class="badge bg-success-subtle text-success border border-success-subtle">SQLite &amp; PostgreSQL</span>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-3">
                <div class="card-body p-4">
                    <div class="text-warning mb-3 fs-4">
                        <i class="bi bi-key-fill"></i>
                    </div>
                    <h5 class="fw-bold">Domyślne Dane Dostępowe</h5>
                    <p class="text-muted small mb-2">
                        Konto administratora zainicjalizowane w SeedData:
                    </p>
                    <div class="bg-light p-2 rounded small font-monospace">
                        <div>Login: <strong>admin</strong></div>
                        <div>Hasło: <strong>Pass123$</strong></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
