@model Quorum.Backend.Controllers.ErrorViewModel
@{
    ViewData["Title"] = "Błąd autoryzacji";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 text-center p-4">
                <div class="card-body">
                    <div class="display-4 text-danger mb-3">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                    </div>
                    <h3 class="fw-bold text-danger">Wystąpił błąd autoryzacji</h3>
                    <p class="text-muted">
                        Serwer tożsamości napotkał problem podczas przetwarzania żądania OIDC / OAuth 2.0.
                    </p>

                    @if (Model.Error != null)
                    {
                        <div class="alert alert-danger text-start mt-4">
                            <h6 class="fw-bold"><i class="bi bi-bug me-1"></i> @Model.Error.Error</h6>
                            @if (!string.IsNullOrEmpty(Model.Error.ErrorDescription))
                            {
                                <p class="mb-1 small">@Model.Error.ErrorDescription</p>
                            }
                            @if (!string.IsNullOrEmpty(Model.Error.RequestId))
                            {
                                <div class="text-muted small mt-2 font-monospace">Request ID: @Model.Error.RequestId</div>
                            }
                        </div>
                    }

                    <div class="d-flex justify-content-center gap-2 mt-4">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4">
                            <i class="bi bi-house-door me-1"></i> Strona Główna
                        </a>
                        <a href="/Admin" class="btn btn-outline-secondary px-3">
                            <i class="bi bi-speedometer2 me-1"></i> Panel Admina
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
