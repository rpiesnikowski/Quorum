@model Quorum.Backend.Controllers.ConsentViewModel
@{
    ViewData["Title"] = "Zgoda na dostęp aplikacji";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <div class="card-body">
                    <div class="text-center mb-4">
                        @if (!string.IsNullOrEmpty(Model.ClientLogoUrl))
                        {
                            <img src="@Model.ClientLogoUrl" alt="Logo" class="mb-3 rounded" style="max-height: 60px;" />
                        }
                        else
                        {
                            <div class="display-6 text-primary mb-2">
                                <i class="bi bi-shield-check"></i>
                            </div>
                        }
                        <h4 class="fw-bold">Aplikacja prosi o uprawnienia</h4>
                        <p class="text-muted small">
                            Aplikacja <strong>@(Model.ClientName ?? "Zewnętrzny Klient")</strong> chce uzyskać dostęp do Twoich danych.
                        </p>
                    </div>

                    <form method="post" asp-controller="Consent" asp-action="Index">
                        <input type="hidden" asp-for="ReturnUrl" />
                        
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                        @if (Model.IdentityScopes.Any())
                        {
                            <div class="mb-4">
                                <h6 class="fw-bold text-secondary mb-2 small text-uppercase">Informacje o profilu (Tożsamość)</h6>
                                <ul class="list-group list-group-flush rounded border">
                                    @foreach (var scope in Model.IdentityScopes)
                                    {
                                        <li class="list-group-item d-flex align-items-start gap-2">
                                            <input class="form-check-input mt-1" type="checkbox" name="ScopesConsented" value="@scope.Value" checked="@scope.Checked" disabled="@scope.Required" />
                                            @if (scope.Required)
                                            {
                                                <input type="hidden" name="ScopesConsented" value="@scope.Value" />
                                            }
                                            <div>
                                                <strong class="d-block small">@scope.DisplayName @(scope.Required ? "(wymagane)" : "")</strong>
                                                <span class="text-muted small">@(scope.Description ?? scope.Value)</span>
                                            </div>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }

                        @if (Model.ApiScopes.Any())
                        {
                            <div class="mb-4">
                                <h6 class="fw-bold text-secondary mb-2 small text-uppercase">Dostęp do API</h6>
                                <ul class="list-group list-group-flush rounded border">
                                    @foreach (var scope in Model.ApiScopes)
                                    {
                                        <li class="list-group-item d-flex align-items-start gap-2">
                                            <input class="form-check-input mt-1" type="checkbox" name="ScopesConsented" value="@scope.Value" checked="@scope.Checked" disabled="@scope.Required" />
                                            @if (scope.Required)
                                            {
                                                <input type="hidden" name="ScopesConsented" value="@scope.Value" />
                                            }
                                            <div>
                                                <strong class="d-block small">@scope.DisplayName @(scope.Required ? "(wymagane)" : "")</strong>
                                                <span class="text-muted small">@(scope.Description ?? scope.Value)</span>
                                            </div>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }

                        @if (Model.AllowRememberConsent)
                        {
                            <div class="form-check mb-4">
                                <input asp-for="RememberConsent" class="form-check-input" type="checkbox" id="rememberConsent" />
                                <label class="form-check-label small" for="rememberConsent">Zapamiętaj moją decyzję dla tej aplikacji</label>
                            </div>
                        }

                        <div class="d-flex justify-content-end gap-2">
                            <button type="submit" name="button" value="no" class="btn btn-outline-secondary px-3">
                                Odmów
                            </button>
                            <button type="submit" name="button" value="yes" class="btn btn-primary px-4 fw-semibold">
                                Zezwól na dostęp
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
