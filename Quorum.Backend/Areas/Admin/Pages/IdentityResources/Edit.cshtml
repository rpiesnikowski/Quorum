@page "{id:int}"
@model Quorum.Backend.Areas.Admin.Pages.IdentityResources.EditModel
@{
    ViewData["Title"] = $"Edycja Zasobu: {Model.Input.Name}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h4 mb-1"><i class="bi bi-person-vcard text-primary me-2"></i>Edycja Zasobu Tożsamości: <span class="font-monospace text-success">@Model.Input.Name</span></h2>
        <p class="text-muted small mb-0">Zarządzaj właściwościami zakresu tożsamości OIDC oraz przypisanymi claims użytkownika</p>
    </div>
    <a asp-page="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Wróć do listy
    </a>
</div>

<form method="post">
    <input type="hidden" asp-for="Input.Id" />

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-light py-3">
            <span class="fw-semibold text-secondary"><i class="bi bi-sliders me-2"></i>Właściwości Zasobu</span>
        </div>
        <div class="card-body p-4">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Input.Name" class="form-label fw-semibold">Nazwa Zasobu (Scope Name) <span class="text-danger">*</span></label>
                    <input asp-for="Input.Name" class="form-control font-monospace" />
                    <span asp-validation-for="Input.Name" class="text-danger small"></span>
                    <div class="form-text">Identyfikator scope (np. <code>openid</code>, <code>profile</code>, <code>email</code>).</div>
                </div>

                <div class="col-md-6">
                    <label asp-for="Input.DisplayName" class="form-label fw-semibold">Nazwa Wyświetlana (Display Name)</label>
                    <input asp-for="Input.DisplayName" class="form-control" />
                    <span asp-validation-for="Input.DisplayName" class="text-danger small"></span>
                    <div class="form-text">Nazwa prezentowana użytkownikowi na ekranie zgody (Consent).</div>
                </div>

                <div class="col-12">
                    <label asp-for="Input.Description" class="form-label fw-semibold">Opis Zasobu</label>
                    <textarea asp-for="Input.Description" class="form-control" rows="2"></textarea>
                    <span asp-validation-for="Input.Description" class="text-danger small"></span>
                </div>

                <!-- Lista Claims -->
                <div class="col-12">
                    <div class="card border">
                        <div class="card-header bg-light d-flex justify-content-between align-items-center py-2">
                            <span class="fw-semibold small"><i class="bi bi-tags me-1 text-primary"></i>Przypisane Claims Użytkownika (User Claims)</span>
                            <span class="badge bg-secondary-subtle text-secondary small">Ilość: @Model.Input.ExistingClaims.Count</span>
                        </div>
                        <div class="card-body p-3">
                            <p class="text-muted small mb-3">
                                Typy claims powiązane z tym zasobem tożsamości. Gdy klient zażąda tego scope, claims te zostaną wydane w <code>id_token</code> lub udostępnione przez endpoint <code>/connect/userinfo</code>.
                            </p>

                            @if (Model.Input.ExistingClaims.Any())
                            {
                                <div class="table-responsive mb-3">
                                    <table class="table table-sm table-bordered align-middle mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Typ Claimu (User Claim Type)</th>
                                                <th style="width: 15%;" class="text-center text-danger">Usuń</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @for (int i = 0; i < Model.Input.ExistingClaims.Count; i++)
                                            {
                                                <tr>
                                                    <td>
                                                        <input type="hidden" asp-for="Input.ExistingClaims[i].Id" />
                                                        <input type="hidden" asp-for="Input.ExistingClaims[i].Type" />
                                                        <span class="badge bg-secondary-subtle text-secondary font-monospace fs-6 px-2 py-1">@Model.Input.ExistingClaims[i].Type</span>
                                                    </td>
                                                    <td class="text-center bg-danger-subtle">
                                                        <div class="form-check form-check-inline m-0">
                                                            <input asp-for="Input.ExistingClaims[i].Delete" class="form-check-input border-danger" type="checkbox" />
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="text-muted small fst-italic mb-3">Brak przypisanych claims do tego zasobu tożsamości.</div>
                            }

                            <!-- Dodaj nowy claim -->
                            <div class="p-3 bg-light rounded border">
                                <h6 class="fw-bold small mb-2 text-primary"><i class="bi bi-plus-circle me-1"></i>Dodaj Nowe Claims do tego Zasobu</h6>
                                <div class="row g-2 align-items-end">
                                    <div class="col-md-9">
                                        <label asp-for="Input.NewClaimType" class="form-label small fw-semibold">Typ Claimu (lub lista oddzielona spacjami)</label>
                                        <input asp-for="Input.NewClaimType" class="form-control font-monospace" placeholder="np. role department employee_id" />
                                    </div>
                                    <div class="col-md-3">
                                        <button type="submit" class="btn btn-primary w-100">
                                            <i class="bi bi-plus-lg me-1"></i> Zastosuj / Dodaj
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12"><hr class="my-2" /></div>

                <div class="col-md-3">
                    <div class="form-check form-switch">
                        <input asp-for="Input.Enabled" class="form-check-input" type="checkbox" id="editEnabledSwitch" />
                        <label class="form-check-label fw-semibold small" for="editEnabledSwitch">Aktywny (Enabled)</label>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="form-check form-switch">
                        <input asp-for="Input.ShowInDiscoveryDocument" class="form-check-input" type="checkbox" id="editDiscSwitch" />
                        <label class="form-check-label fw-semibold small" for="editDiscSwitch">Pokaż w Discovery</label>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="form-check form-switch">
                        <input asp-for="Input.Required" class="form-check-input" type="checkbox" id="editReqSwitch" />
                        <label class="form-check-label fw-semibold small" for="editReqSwitch">Wymagany (Required)</label>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="form-check form-switch">
                        <input asp-for="Input.Emphasize" class="form-check-input" type="checkbox" id="editEmphSwitch" />
                        <label class="form-check-label fw-semibold small" for="editEmphSwitch">Wyróżnij na Consent</label>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-footer bg-light p-3 d-flex justify-content-between">
            <a asp-page="Index" class="btn btn-outline-secondary">Anuluj</a>
            <button type="submit" class="btn btn-primary px-4 fw-semibold">
                <i class="bi bi-check-lg me-1"></i> Zapisz Zmiany
            </button>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
