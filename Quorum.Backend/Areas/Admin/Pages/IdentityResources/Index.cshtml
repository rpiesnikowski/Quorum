@page
@model Quorum.Backend.Areas.Admin.Pages.IdentityResources.IndexModel
@{
    ViewData["Title"] = "Zasoby Tożsamości";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h4 mb-1"><i class="bi bi-person-vcard me-2 text-success"></i>Zasoby Tożsamości (IdentityResources)</h2>
        <p class="text-muted small mb-0">Zdefiniowane zakresy danych użytkownika zwracane w id_token (np. openid, profile, email)</p>
    </div>
    <div>
        <a asp-page="Create" class="btn btn-success btn-sm px-3">
            <i class="bi bi-plus-lg me-1"></i> Dodaj Zasób Tożsamości
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Nazwa Zasobu</th>
                    <th>Nazwa Wyświetlana</th>
                    <th>Opis</th>
                    <th>Skojarzone Claims</th>
                    <th>Wymagany</th>
                    <th>W Discovery</th>
                    <th class="text-end">Akcje</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var res in Model.Resources)
                {
                    <tr>
                        <td class="fw-bold font-monospace text-success">@res.Name</td>
                        <td>@(string.IsNullOrWhiteSpace(res.DisplayName) ? "-" : res.DisplayName)</td>
                        <td class="text-muted small">@(string.IsNullOrWhiteSpace(res.Description) ? "-" : res.Description)</td>
                        <td>
                            @if (res.UserClaims != null && res.UserClaims.Any())
                            {
                                @foreach (var claim in res.UserClaims)
                                {
                                    <span class="badge bg-secondary-subtle text-secondary me-1">@claim.Type</span>
                                }
                            }
                            else
                            {
                                <span class="text-muted small fst-italic">Brak claims</span>
                            }
                        </td>
                        <td>
                            @if (res.Required)
                            {
                                <span class="badge bg-danger-subtle text-danger">Tak</span>
                            }
                            else
                            {
                                <span class="badge bg-light text-muted border">Opcjonalny</span>
                            }
                        </td>
                        <td>
                            @if (res.ShowInDiscoveryDocument)
                            {
                                <span class="badge bg-success-subtle text-success">Tak</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary">Ukryty</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-page="Edit" asp-route-id="@res.Id" class="btn btn-sm btn-outline-primary me-1">
                                <i class="bi bi-pencil me-1"></i> Edytuj
                            </a>
                            <form method="post" asp-page-handler="Delete" asp-route-id="@res.Id" class="d-inline" onsubmit="return confirm('Czy na pewno chcesz usunąć zasób tożsamości @res.Name?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
