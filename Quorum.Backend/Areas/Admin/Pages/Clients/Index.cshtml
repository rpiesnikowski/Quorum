@page
@model Quorum.Backend.Areas.Admin.Pages.Clients.IndexModel
@{
    ViewData["Title"] = "Klienci OAuth2 / OIDC";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h4 mb-1"><i class="bi bi-laptop me-2 text-info"></i>Klienci OAuth2 / OIDC</h2>
        <p class="text-muted small mb-0">Zarządzaj aplikacjami klienckimi uprawnionymi do autoryzacji w Open.IdentityServer</p>
    </div>
    <a asp-page="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Dodaj Nowego Klienta
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Client ID</th>
                    <th>Nazwa Klienta</th>
                    <th>Typy Przepływów (Grant Types)</th>
                    <th>Dozwolone Scopes</th>
                    <th>PKCE</th>
                    <th>Status</th>
                    <th class="text-end">Akcje</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Clients.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                            Brak zarejestrowanych klientów w bazie danych.
                        </td>
                    </tr>
                }
                @foreach (var client in Model.Clients)
                {
                    <tr>
                        <td class="fw-bold font-monospace text-primary">@client.ClientId</td>
                        <td>@client.ClientName</td>
                        <td>
                            @foreach (var grant in client.AllowedGrantTypes)
                            {
                                <span class="badge bg-secondary-subtle text-secondary me-1">@grant.GrantType</span>
                            }
                        </td>
                        <td>
                            @foreach (var scope in client.AllowedScopes)
                            {
                                <span class="badge bg-info-subtle text-info me-1">@scope.Scope</span>
                            }
                        </td>
                        <td>
                            @(client.RequirePkce ? "Wymagane" : "Opcjonalne")
                        </td>
                        <td>
                            @if (client.Enabled)
                            {
                                <span class="badge bg-success-subtle text-success">Aktywny</span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger">Nieaktywny</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <a asp-page="Edit" asp-route-id="@client.Id" class="btn btn-sm btn-outline-primary me-1" title="Edytuj">
                                <i class="bi bi-pencil-square me-1"></i> Edytuj
                            </a>
                            <form method="post" asp-page-handler="Delete" asp-route-id="@client.Id" class="d-inline" onsubmit="return confirm('Czy na pewno chcesz usunąć klienta @client.ClientId?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Usuń">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
