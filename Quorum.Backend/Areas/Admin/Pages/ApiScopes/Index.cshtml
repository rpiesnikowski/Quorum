@page
@model Quorum.Backend.Areas.Admin.Pages.ApiScopes.IndexModel
@{
    ViewData["Title"] = "Zakresy API (ApiScopes)";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h4 mb-1"><i class="bi bi-key me-2 text-warning"></i>Zakresy API (ApiScopes)</h2>
        <p class="text-muted small mb-0">Definiuj zasoby i uprawnienia API, o które mogą wnioskować aplikacje klienckie</p>
    </div>
    <a asp-page="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Dodaj Nowy Zakres
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Nazwa Scope</th>
                    <th>Nazwa Wyświetlana</th>
                    <th>Opis</th>
                    <th>Wymagany</th>
                    <th>Status</th>
                    <th class="text-end">Akcje</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Scopes.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">Brak zdefiniowanych zakresów API w bazie.</td>
                    </tr>
                }
                @foreach (var scope in Model.Scopes)
                {
                    <tr>
                        <td class="fw-bold font-monospace text-primary">@scope.Name</td>
                        <td>@scope.DisplayName</td>
                        <td class="text-muted small">@scope.Description</td>
                        <td>@(scope.Required ? "Tak" : "Nie")</td>
                        <td>
                            @if (scope.Enabled)
                            {
                                <span class="badge bg-success-subtle text-success">Aktywny</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary">Wyłączony</span>
                            }
                        </td>
                        <td class="text-end">
                            <form method="post" asp-page-handler="Delete" asp-route-id="@scope.Id" class="d-inline" onsubmit="return confirm('Czy usunąć zakres @scope.Name?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
