@page
@model Quorum.Backend.Areas.Admin.Pages.Grants.IndexModel
@{
    ViewData["Title"] = "Aktywne Zgody i Tokeny";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h4 mb-1"><i class="bi bi-ticket-perforated me-2 text-danger"></i>Aktywne Tokeny i Zgody (Persisted Grants)</h2>
        <p class="text-muted small mb-0">Podgląd aktywnych Refresh Tokens, kodów autoryzacyjnych oraz zapisanych zgód użytkowników</p>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Typ Grantu</th>
                    <th>Subject ID (Użytkownik)</th>
                    <th>Client ID</th>
                    <th>Data Utworzenia</th>
                    <th>Wygasa</th>
                    <th class="text-end">Akcje</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Grants.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">
                            <i class="bi bi-shield-check fs-3 d-block mb-2 text-success"></i>
                            Brak aktywnych sesji tokenów w magazynie operacyjnym bazy danych.
                        </td>
                    </tr>
                }
                @foreach (var grant in Model.Grants)
                {
                    <tr>
                        <td>
                            <span class="badge bg-secondary">@grant.Type</span>
                        </td>
                        <td class="font-monospace small">@grant.SubjectId</td>
                        <td class="fw-semibold text-primary">@grant.ClientId</td>
                        <td class="small text-muted">@grant.CreationTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td class="small text-muted">@(grant.Expiration?.ToString("yyyy-MM-dd HH:mm:ss") ?? "Nigdy")</td>
                        <td class="text-end">
                            <form method="post" asp-page-handler="Revoke" asp-route-key="@grant.Key" class="d-inline" onsubmit="return confirm('Czy na pewno unieważnić ten token?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-x-circle me-1"></i> Unieważnij
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
