@page "/datagrid"
@using global::Radzen
@using global::Radzen.Blazor
@using Radzen

@using Quorum.Backend.Radzen.Sample.Models
@rendermode InteractiveServer

<PageTitle>Quorum.Backend - Radzen DataGrid Sample</PageTitle>

<RadzenStack Gap="1rem" class="rz-p-4">
    <RadzenCard>
        <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1">RadzenDataGrid - Prezentacja Możliwości (.NET 10)</RadzenText>
        <RadzenText TextStyle="TextStyle.Body2">
            Widok demonstruje zaawansowane filtrowanie, sortowanie, grupowanie, podsumowania, kustomizację szablonów oraz edycję inline na zbiorze 100 elementów różnego typu.
        </RadzenText>
    </RadzenCard>

    <!-- Pasek narzędziowy DataGrid -->
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
            <RadzenButton Text="Wyczyść filtry i sortowanie" Icon="filter_alt_off" ButtonStyle="ButtonStyle.Secondary" Click="@ResetGrid" />
            <RadzenButton Text="Eksportuj do CSV" Icon="description" ButtonStyle="ButtonStyle.Info" Click="@ExportToCsv" />
        </RadzenStack>
        <RadzenText TextStyle="TextStyle.Subtitle1">
            Zaznaczono wierszy: <b>@(selectedItems?.Count ?? 0)</b>
        </RadzenText>
    </RadzenStack>

    <!-- Główny DataGrid -->
    <RadzenDataGrid @ref="grid" 
                    Data="@dataItems" 
                    TItem="SampleDataItem" 
                    AllowFiltering="true" 
                    FilterMode="FilterMode.Advanced"
                    AllowPaging="true" 
                    PageSize="10" 
                    AllowSorting="true" 
                    AllowGrouping="true"
                    AllowColumnResize="true" 
                    AllowColumnReorder="true"
                    ShowColumnMerger="true"
                    AllowColumnPicking="true"
                    SelectionMode="DataGridSelectionMode.Multiple"
                    @bind-Value="@selectedItems"
                    RowUpdate="@OnRowUpdate"
                    EditMode="DataGridEditMode.Single"
                    GridLines="DataGridGridLines.Both"
                    Density="Density.Compact"
                    Responsive="true">
        <Columns>
            <!-- Kolumna selekcji (Checkbox) -->
            <RadzenDataGridColumn TItem="SampleDataItem" Width="60px" Sortable="false" Filterable="false" Resizable="false">
                <HeaderTemplate>
                    <RadzenCheckBox TriState="false" TValue="bool" Value="@(dataItems.Any(i => selectedItems?.Contains(i) == true))" 
                                    Change="@(args => selectedItems = args ? dataItems.ToList() : new List<SampleDataItem>())" />
                </HeaderTemplate>
                <Template Context="item">
                    <RadzenCheckBox TriState="false" Value="@(selectedItems?.Contains(item) == true)" 
                                    TValue="bool" Change="@(args => { if (args) selectedItems?.Add(item); else selectedItems?.Remove(item); })" />
                </Template>
            </RadzenDataGridColumn>

            <!-- ID / Kod (string) -->
            <RadzenDataGridColumn TItem="SampleDataItem" Property="Code" Title="Kod" Width="110px" Frozen="true">
                <FooterTemplate>
                    Razem: <b>@dataItems.Count</b>
                </FooterTemplate>
            </RadzenDataGridColumn>

            <!-- Nazwa (string z edycją inline) -->
            <RadzenDataGridColumn TItem="SampleDataItem" Property="Name" Title="Nazwa Produktu" Width="200px">
                <EditTemplate Context="item">
                    <RadzenTextBox @bind-Value="item.Name" Style="width:100%" Name="NameInput" />
                </EditTemplate>
            </RadzenDataGridColumn>

            <!-- Kategoria (string z grupowaniem) -->
            <RadzenDataGridColumn TItem="SampleDataItem" Property="Category" Title="Kategoria" Width="140px">
                <EditTemplate Context="item">
                    <RadzenDropDown @bind-Value="item.Category" Data="@categories" Style="width:100%" />
                </EditTemplate>
            </RadzenDataGridColumn>

            <!-- Status (Enum z Badge Template) -->
            <RadzenDataGridColumn TItem="SampleDataItem" Property="Status" Title="Status" Width="130px">
                <Template Context="item">
                    @switch (item.Status)
                    {
                        case ItemStatus.Active:
                            <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="Aktywny" IsPill="true" />
                            break;
                        case ItemStatus.Pending:
                            <RadzenBadge BadgeStyle="BadgeStyle.Warning" Text="Oczekujący" IsPill="true" />
                            break;
                        case ItemStatus.Draft:
                            <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="Szkic" IsPill="true" />
                            break;
                        case ItemStatus.Archived:
                            <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="Zarchiwizowany" IsPill="true" />
                            break;
                    }
                </Template>
                <EditTemplate Context="item">
                    <RadzenDropDown @bind-Value="item.Status" Data="@(Enum.GetValues<ItemStatus>())" Style="width:100%" />
                </EditTemplate>
            </RadzenDataGridColumn>

            <!-- Cena (decimal z formatowaniem i sumą w stopce) -->
            <RadzenDataGridColumn TItem="SampleDataItem" Property="Price" Title="Cena (PLN)" FormatString="{0:C2}" Width="130px">
                <FooterTemplate>
                    Suma: <b>@dataItems.Sum(o => o.Price).ToString("C2")</b>
                </FooterTemplate>
                <EditTemplate Context="item">
                    <RadzenNumeric @bind-Value="item.Price" Format="c2" Style="width:100%" />
                </EditTemplate>
            </RadzenDataGridColumn>

            <!-- Ocena (double z Rating Bar) -->
            <RadzenDataGridColumn TItem="SampleDataItem" Property="Rating" Title="Ocena" Width="140px">
                <Template Context="item">
                    <RadzenRating ReadOnly="true" Value="@((int)Math.Round(item.Rating))" Stars="5" />
                    <span class="rz-ml-2">(@item.Rating)</span>
                </Template>
            </RadzenDataGridColumn>

            <!-- Dostępność (bool) -->
            <RadzenDataGridColumn TItem="SampleDataItem" Property="IsInStock" Title="W Magazynie" Width="120px">
                <Template Context="item">
                    <RadzenIcon Icon="@(item.IsInStock ? "check_circle" : "cancel")" 
                                IconColor="@(item.IsInStock ? Colors.Success : Colors.Danger)" />
                </Template>
                <EditTemplate Context="item">
                    <RadzenSwitch @bind-Value="item.IsInStock" />
                </EditTemplate>
            </RadzenDataGridColumn>

            <!-- Data utworzenia (DateTime) -->
            <RadzenDataGridColumn TItem="SampleDataItem" Property="CreatedAt" Title="Data Utworzenia" FormatString="{0:yyyy-MM-dd HH:mm}" Width="160px">
                <EditTemplate Context="item">
                    <RadzenDatePicker @bind-Value="item.CreatedAt" ShowTime="true" DateFormat="yyyy-MM-dd HH:mm" Style="width:100%" />
                </EditTemplate>
            </RadzenDataGridColumn>

            <!-- Tagi (List<string> z custom template) -->
            <RadzenDataGridColumn TItem="SampleDataItem" Property="Tags" Title="Tagi" Sortable="false" Filterable="false" Width="220px">
                <Template Context="item">
                    @foreach (var tag in item.Tags)
                    {
                        <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="@tag" class="rz-mr-1" />
                    }
                </Template>
            </RadzenDataGridColumn>

            <!-- Akcje edycji -->
            <RadzenDataGridColumn TItem="SampleDataItem" Context="item" Filterable="false" Sortable="false" TextAlign="TextAlign.Right" Width="120px">
                <Template Context="item">
                    <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" Click="@(args => EditRow(item))" @onclick:stopPropagation="true" />
                </Template>
                <EditTemplate Context="item">
                    <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" Click="@(args => SaveRow(item))" />
                    <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" Click="@(args => CancelEdit(item))" />
                </EditTemplate>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</RadzenStack>

@code {
    private RadzenDataGrid<SampleDataItem> grid = default!;
    private List<SampleDataItem> dataItems = new();
    private IList<SampleDataItem> selectedItems = new List<SampleDataItem>();
    private readonly string[] categories = new[] { "Electronics", "Hardware", "Software", "Services", "Books" };

    protected override void OnInitialized()
    {
        dataItems = SampleDataItem.GenerateSampleData(100);
        selectedItems.Add(dataItems.First());
    }

    private async Task EditRow(SampleDataItem item)
    {
        await grid.EditRow(item);
    }

    private async Task SaveRow(SampleDataItem item)
    {
        await grid.UpdateRow(item);
    }

    private void CancelEdit(SampleDataItem item)
    {
        grid.CancelEditRow(item);
    }

    private void OnRowUpdate(SampleDataItem item)
    {
        // Tutaj następuje zapis zaktualizowanego obiektu do bazy/serwisu
    }

    private async Task ResetGrid()
    {
        grid.Reset(true);
        await grid.FirstPage();
    }

    private void ExportToCsv()
    {
        // Eksport danych
    }
}