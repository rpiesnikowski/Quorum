@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-between align-items-center">
            <span class="fw-semibold text-secondary">Panel Administracyjny Blazor .NET 10</span>
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">Dokumentacja ASP.NET Core</a>
        </div>

        <article class="content px-4 py-3">
            @Body
        </article>
    </main>
</div>

<RadzenComponents />

<div id="blazor-error-ui" data-nosnippet>
    Wystąpił nieoczekiwany błąd.
    <a href="." class="reload">Przeładuj stronę</a>
    <span class="dismiss">🗙</span>
</div>
