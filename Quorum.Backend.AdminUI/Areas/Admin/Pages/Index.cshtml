@page
@model Quorum.Backend.AdminUI.Areas.Admin.Pages.IndexModel
@{
    ViewData["Title"] = "Pulpit Administracyjny";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Pulpit Zarządzania Open.IdentityServer</h1>
        <p class="text-muted mb-0">Moduł administracyjny NuGet (Quorum.Backend.AdminUI) dla .NET 10</p>
    </div>
    <div class="d-flex gap-2">
        <a href="/.well-known/openid-configuration" target="_blank" class="btn btn-outline-primary">
            <i class="bi bi-box-arrow-up-right me-1"></i> OpenID Discovery (.well-known)
        </a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4 col-sm-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center">
                <div class="rounded-3 bg-info-subtle text-info p-3 me-3 fs-3">
                    <i class="bi bi-laptop"></i>
                </div>
                <div>
                    <div class="text-muted small">Zarejestrowani Klienci</div>
                    <div class="fs-4 fw-bold text-dark">@Model.ClientsCount</div>
                    <a href="/Admin/Clients" class="small text-decoration-none">Przejdź do listy &rarr;</a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4 col-sm-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center">
                <div class="rounded-3 bg-warning-subtle text-warning p-3 me-3 fs-3">
                    <i class="bi bi-key"></i>
                </div>
                <div>
                    <div class="text-muted small">Zakresy API (ApiScopes)</div>
                    <div class="fs-4 fw-bold text-dark">@Model.ScopesCount</div>
                    <a href="/Admin/ApiScopes" class="small text-decoration-none">Zarządzaj Scopes &rarr;</a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4 col-sm-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center">
                <div class="rounded-3 bg-success-subtle text-success p-3 me-3 fs-3">
                    <i class="bi bi-person-vcard"></i>
                </div>
                <div>
                    <div class="text-muted small">Zasoby Tożsamości</div>
                    <div class="fs-4 fw-bold text-dark">@Model.IdentityResourcesCount</div>
                    <a href="/Admin/IdentityResources" class="small text-decoration-none">Zobacz zasoby &rarr;</a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4 col-sm-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center">
                <div class="rounded-3 bg-primary-subtle text-primary p-3 me-3 fs-3">
                    <i class="bi bi-people"></i>
                </div>
                <div>
                    <div class="text-muted small">Konta Użytkowników (Identity)</div>
                    <div class="fs-4 fw-bold text-dark">@Model.UsersCount</div>
                    <a href="/Admin/Users" class="small text-decoration-none">Zarządzaj kontami &rarr;</a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4 col-sm-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center">
                <div class="rounded-3 bg-danger-subtle text-danger p-3 me-3 fs-3">
                    <i class="bi bi-ticket-perforated"></i>
                </div>
                <div>
                    <div class="text-muted small">Aktywne Tokeny / Zgody (Grants)</div>
                    <div class="fs-4 fw-bold text-dark">@Model.GrantsCount</div>
                    <a href="/Admin/Grants" class="small text-decoration-none">Przeglądaj sesje &rarr;</a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4 col-sm-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center">
                <div class="rounded-3 bg-warning-subtle text-warning p-3 me-3 fs-3">
                    <i class="bi bi-diagram-3"></i>
                </div>
                <div>
                    <div class="text-muted small">Dynamiczne Federacje OIDC</div>
                    <div class="fs-4 fw-bold text-dark">@Model.FederationsCount</div>
                    <a href="/Admin/Federations" class="small text-decoration-none">Dostawcy SSO (w locie) &rarr;</a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4 col-sm-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center">
                <div class="rounded-3 bg-info-subtle text-info p-3 me-3 fs-3">
                    <i class="bi bi-router"></i>
                </div>
                <div>
                    <div class="text-muted small">Trasy API Gateway (Proxy)</div>
                    <div class="fs-4 fw-bold text-dark">@Model.GatewayRoutesCount</div>
                    <a href="/Admin/Gateway" class="small text-decoration-none">Zarządzaj Gateway &rarr;</a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3">
        <h5 class="card-title mb-0 fs-6 fw-bold"><i class="bi bi-info-circle me-2 text-primary"></i>Informacje o pakiecie NuGet</h5>
    </div>
    <div class="card-body">
        <ul class="list-unstyled mb-0 d-flex flex-column gap-2 small">
            <li><i class="bi bi-box-seam text-primary me-2"></i><strong>Pakiet NuGet:</strong> Quorum.Backend.AdminUI v1.0.0 (Razor Class Library)</li>
            <li><i class="bi bi-check2-circle text-success me-2"></i><strong>Framework:</strong> .NET 10.0 (C# 13) z Open.IdentityServer v2.0.0 (Rock Solid Knowledge)</li>
            <li><i class="bi bi-check2-circle text-success me-2"></i><strong>Przechowywanie danych:</strong> Entity Framework Core (Wymienne: SQLite / PostgreSQL)</li>
            <li><i class="bi bi-check2-circle text-success me-2"></i><strong>Zarządzanie Użytkownikami:</strong> ASP.NET Core Identity (Konta lokalne z haszowaniem haseł)</li>
            <li><i class="bi bi-check2-circle text-success me-2"></i><strong>Warstwa GUI:</strong> Server-Side Razor Pages z Bootstrap 5 i automatyczną polityką autoryzacyjną</li>
        </ul>
    </div>
</div>
