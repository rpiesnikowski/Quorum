@page
@model Quorum.Backend.AdminUI.Areas.Admin.Pages.ApiScopes.IndexModel
@{
    ViewData["Title"] = "Zakresy API (ApiScopes)";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h4 mb-1"><i class="bi bi-key-fill text-warning me-2"></i>Zakresy API (ApiScopes)</h2>
        <p class="text-muted small mb-0">Definiuj i konfiguruj uprawnienia zasobów API (OAuth2 / OIDC Scopes)</p>
    </div>
    <a asp-page="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Dodaj Nowy Zakres
    </a>
</div>

<!-- Statystyki -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body d-flex align-items-center py-3">
                <div class="rounded-circle bg-primary bg-opacity-10 p-3 me-3 text-primary">
                    <i class="bi bi-key fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small">Wszystkie Zakresy</div>
                    <div class="fs-4 fw-bold">@(Model.ActiveCount + Model.DisabledCount)</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body d-flex align-items-center py-3">
                <div class="rounded-circle bg-success bg-opacity-10 p-3 me-3 text-success">
                    <i class="bi bi-check-circle fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small">Aktywne</div>
                    <div class="fs-4 fw-bold">@Model.ActiveCount</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body d-flex align-items-center py-3">
                <div class="rounded-circle bg-secondary bg-opacity-10 p-3 me-3 text-secondary">
                    <i class="bi bi-dash-circle fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small">Wyłączone</div>
                    <div class="fs-4 fw-bold">@Model.DisabledCount</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Pasek wyszukiwania i filtrów -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-6 col-lg-5">
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="Search" value="@Model.Search" class="form-control" placeholder="Szukaj po nazwie, nazwie wyświetlanej lub opisie..." />
                    @if (!string.IsNullOrWhiteSpace(Model.Search))
                    {
                        <a asp-page="Index" asp-route-statusFilter="@Model.StatusFilter" asp-route-pageSize="@Model.PageSize" class="btn btn-outline-secondary" title="Wyczyść szukanie">
                            <i class="bi bi-x-lg"></i>
                        </a>
                    }
                </div>
            </div>
            <div class="col-md-3 col-lg-3">
                <select name="StatusFilter" class="form-select" onchange="this.form.submit()">
                    <option value="" selected="@(string.IsNullOrEmpty(Model.StatusFilter))">Wszystkie statusy</option>
                    <option value="active" selected="@(Model.StatusFilter == "active")">Tylko aktywne</option>
                    <option value="disabled" selected="@(Model.StatusFilter == "disabled")">Tylko wyłączone</option>
                </select>
            </div>
            <div class="col-md-3 col-lg-2">
                <select name="PageSize" class="form-select" onchange="this.form.submit()">
                    <option value="5" selected="@(Model.PageSize == 5)">5 na stronę</option>
                    <option value="10" selected="@(Model.PageSize == 10)">10 na stronę</option>
                    <option value="25" selected="@(Model.PageSize == 25)">25 na stronę</option>
                    <option value="50" selected="@(Model.PageSize == 50)">50 na stronę</option>
                </select>
            </div>
            <div class="col-md-12 col-lg-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-funnel me-1"></i> Filtruj
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Tabela zakresów (Grid) -->
<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <QuickGrid Items="@Model.Scopes.AsQueryable()" Class="table table-hover align-middle mb-0" ResizableColumns="true">
            <TemplateColumn Title="Nazwa Scope" Sortable="true" SortBy="@(GridSort<Open.IdentityServer.EntityFramework.Entities.ApiScope>.ByAscending(s => s.Name))">
                <div class="d-flex align-items-center">
                    <span class="badge bg-light text-primary border font-monospace px-2 py-1 fs-6 me-2">@context.Name</span>
                </div>
            </TemplateColumn>
            <PropertyColumn Property="@(s => s.DisplayName)" Title="Nazwa Wyświetlana" Sortable="true" Class="fw-semibold" />
            <TemplateColumn Title="Opis">
                @if (!string.IsNullOrWhiteSpace(context.Description))
                {
                    <span class="text-muted small">@context.Description</span>
                }
                else
                {
                    <span class="text-muted fst-italic small">— brak opisu —</span>
                }
            </TemplateColumn>
            <TemplateColumn Title="Wymagany" Sortable="true" SortBy="@(GridSort<Open.IdentityServer.EntityFramework.Entities.ApiScope>.ByAscending(s => s.Required))">
                @if (context.Required)
                {
                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">
                        <i class="bi bi-lock-fill me-1"></i>Tak
                    </span>
                }
                else
                {
                    <span class="badge bg-light text-secondary border">Nie</span>
                }
            </TemplateColumn>
            <TemplateColumn Title="Wyróżniony" Sortable="true" SortBy="@(GridSort<Open.IdentityServer.EntityFramework.Entities.ApiScope>.ByAscending(s => s.Emphasize))">
                @if (context.Emphasize)
                {
                    <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle">
                        <i class="bi bi-star-fill me-1"></i>Tak
                    </span>
                }
                else
                {
                    <span class="badge bg-light text-secondary border">Nie</span>
                }
            </TemplateColumn>
            <TemplateColumn Title="Status" Sortable="true" SortBy="@(GridSort<Open.IdentityServer.EntityFramework.Entities.ApiScope>.ByAscending(s => s.Enabled))">
                @if (context.Enabled)
                {
                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                        <i class="bi bi-check-circle me-1"></i>Aktywny
                    </span>
                }
                else
                {
                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">
                        <i class="bi bi-dash-circle me-1"></i>Wyłączony
                    </span>
                }
            </TemplateColumn>
            <TemplateColumn Title="Akcje" Class="text-end">
                <div class="btn-group btn-group-sm">
                    <a asp-page="Edit" asp-route-id="@context.Id" class="btn btn-outline-primary" title="Edytuj zakres">
                        <i class="bi bi-pencil me-1"></i> Edytuj
                    </a>
                    <form method="post" asp-page-handler="Delete" asp-route-id="@context.Id" class="d-inline" onsubmit="return confirm('Czy na pewno chcesz usunąć zakres API \'@context.Name\'?');">
                        <input type="hidden" name="search" value="@Model.Search" />
                        <input type="hidden" name="statusFilter" value="@Model.StatusFilter" />
                        <input type="hidden" name="currentPage" value="@Model.CurrentPage" />
                        <input type="hidden" name="pageSize" value="@Model.PageSize" />
                        <button type="submit" class="btn btn-outline-danger border-start-0" title="Usuń zakres">
                            <i class="bi bi-trash"></i>
                        </button>
                    </form>
                </div>
            </TemplateColumn>
        </QuickGrid>
        @if (Model.Scopes.Count == 0)
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary opacity-50"></i>
                @if (!string.IsNullOrWhiteSpace(Model.Search) || !string.IsNullOrWhiteSpace(Model.StatusFilter))
                {
                    <span>Nie znaleziono zakresów API spełniających podane kryteria filtrowania.</span>
                    <div class="mt-2">
                        <a asp-page="Index" class="btn btn-sm btn-outline-primary">Wyczyść filtry</a>
                    </div>
                }
                else
                {
                    <span>Brak zdefiniowanych zakresów API w bazie.</span>
                }
            </div>
        }
    </div>

    <!-- Paginacja -->
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
            <div class="text-muted small">
                Wyświetlanie <strong>@(((Model.CurrentPage - 1) * Model.PageSize) + 1)</strong> - <strong>@(Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalItems))</strong> z <strong>@Model.TotalItems</strong> zakresów
            </div>
            <nav aria-label="Nawigacja stron">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link" asp-page="Index" asp-route-currentPage="@(Model.CurrentPage - 1)" asp-route-pageSize="@Model.PageSize" asp-route-search="@Model.Search" asp-route-statusFilter="@Model.StatusFilter">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                    </li>

                    @for (int p = Math.Max(1, Model.CurrentPage - 2); p <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); p++)
                    {
                        <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-page="Index" asp-route-currentPage="@p" asp-route-pageSize="@Model.PageSize" asp-route-search="@Model.Search" asp-route-statusFilter="@Model.StatusFilter">@p</a>
                        </li>
                    }

                    <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-page="Index" asp-route-currentPage="@(Model.CurrentPage + 1)" asp-route-pageSize="@Model.PageSize" asp-route-search="@Model.Search" asp-route-statusFilter="@Model.StatusFilter">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
