@page
@model Quorum.Backend.AdminUI.Areas.Admin.Pages.IdentityResources.IndexModel
@{
    ViewData["Title"] = "Zasoby Tożsamości";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h4 mb-1"><i class="bi bi-person-vcard me-2 text-success"></i>Zasoby Tożsamości (IdentityResources)</h2>
        <p class="text-muted small mb-0">Zdefiniowane zakresy danych użytkownika zwracane w id_token (np. openid, profile, email)</p>
    </div>
    <div>
        <a asp-page="Create" class="btn btn-success btn-sm px-3">
            <i class="bi bi-plus-lg me-1"></i> Dodaj Zasób Tożsamości
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<component type="typeof(IdentityResourcesGrid)" render-mode="Static" param-Resources="@Model.Resources" />
