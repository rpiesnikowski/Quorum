@page
@model Quorum.Backend.AdminUI.Areas.Admin.Pages.Grants.IndexModel
@{
    ViewData["Title"] = "Aktywne Zgody i Tokeny";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h4 mb-1"><i class="bi bi-ticket-perforated me-2 text-danger"></i>Aktywne Tokeny i Zgody (Persisted Grants)</h2>
        <p class="text-muted small mb-0">Podgląd aktywnych Refresh Tokens, kodów autoryzacyjnych oraz zapisanych zgód użytkowników</p>
    </div>
</div>

<component type="typeof(GrantsGrid)" render-mode="Static" param-Grants="@Model.Grants" />
