@page
@model Quorum.Backend.AdminUI.Areas.Admin.Pages.Users.CreateModel
@{
    ViewData["Title"] = "Nowy Użytkownik";
}

<div class="mb-4">
    <a asp-page="Index" class="text-decoration-none small text-muted">
        <i class="bi bi-arrow-left me-1"></i> Powrót do listy użytkowników
    </a>
    <h2 class="h4 mt-2">Utwórz Nowe Konto Użytkownika</h2>
</div>

<div class="card border-0 shadow-sm col-lg-7">
    <div class="card-body p-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="mb-3">
                <label asp-for="Input.UserName" class="form-label fw-semibold">Login / Nazwa Użytkownika <span class="text-danger">*</span></label>
                <input asp-for="Input.UserName" class="form-control font-monospace" placeholder="np. tomasz.nowak" />
                <span asp-validation-for="Input.UserName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.FullName" class="form-label fw-semibold">Imię i Nazwisko</label>
                <input asp-for="Input.FullName" class="form-control" placeholder="np. Tomasz Nowak" />
            </div>

            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label fw-semibold">Adres Email <span class="text-danger">*</span></label>
                <input asp-for="Input.Email" class="form-control" type="email" placeholder="np. tomasz.nowak@firma.pl" />
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label fw-semibold">Hasło <span class="text-danger">*</span></label>
                <input asp-for="Input.Password" class="form-control" type="password" placeholder="Minimum 6 znaków" />
                <span asp-validation-for="Input.Password" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Input.Role" class="form-label fw-semibold">Rola w Systemie</label>
                <select asp-for="Input.Role" class="form-select">
                    <option value="User">User (Standardowy użytkownik)</option>
                    <option value="Manager">Manager (Dostęp rozszerzony)</option>
                    <option value="Admin">Admin (Pełny dostęp do Panelu Admina CRUD)</option>
                </select>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary px-4">
                    <i class="bi bi-check-lg me-1"></i> Utwórz Użytkownika
                </button>
                <a asp-page="Index" class="btn btn-outline-secondary">Anuluj</a>
            </div>
        </form>
    </div>
</div>
