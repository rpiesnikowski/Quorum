@page
@model Quorum.Backend.AdminUI.Areas.Admin.Pages.Users.IndexModel
@{
    ViewData["Title"] = "Konta Użytkowników";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h4 mb-1"><i class="bi bi-people me-2 text-primary"></i>Konta Użytkowników (AspNetIdentity)</h2>
        <p class="text-muted small mb-0">Zarządzaj tożsamościami użytkowników, hasłami, danymi profilu i rolami dostępowymi</p>
    </div>
    <a asp-page="Create" class="btn btn-primary shadow-sm">
        <i class="bi bi-person-plus me-1"></i> Dodaj Użytkownika
    </a>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Wyszukiwarka i statystyki -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Szukaj po loginie, emailu lub telefonie..." />
                    @if (!string.IsNullOrWhiteSpace(Model.Search))
                    {
                        <a asp-page="Index" class="btn btn-outline-secondary">Wyczyść</a>
                    }
                    <button type="submit" class="btn btn-dark">Szukaj</button>
                </div>
            </div>
            <div class="col-md-7 text-md-end mt-2 mt-md-0">
                <span class="badge bg-light text-dark border me-2 py-2 px-3">
                    <i class="bi bi-people-fill text-primary me-1"></i> Łącznie kont: <strong>@Model.TotalCount</strong>
                </span>
                <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 py-2 px-3">
                    <i class="bi bi-shield-fill-check me-1"></i> Administratorzy: <strong>@Model.AdminCount</strong>
                </span>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <QuickGrid Items="@Model.Users.AsQueryable()" Class="table table-hover align-middle mb-0" ResizableColumns="true">
            <TemplateColumn Title="Nazwa Użytkownika (Login)" Sortable="true" SortBy="@(GridSort<Quorum.Backend.AdminUI.Services.AdminUserDto>.ByAscending(u => u.UserName))">
                <a asp-page="Edit" asp-route-id="@context.Id" class="text-decoration-none fw-bold text-dark d-inline-flex align-items-center">
                    <i class="bi bi-person-circle text-primary me-2 fs-5"></i>
                    <span>@context.UserName</span>
                </a>
            </TemplateColumn>
            <PropertyColumn Property="@(u => string.IsNullOrEmpty(u.FullName) ? "-" : u.FullName)" Title="Imię i Nazwisko" Sortable="true" />
            <TemplateColumn Title="Adres Email" Sortable="true" SortBy="@(GridSort<Quorum.Backend.AdminUI.Services.AdminUserDto>.ByAscending(u => u.Email))">
                <span class="d-inline-flex align-items-center gap-1">
                    @context.Email
                    @if (context.EmailConfirmed)
                    {
                        <i class="bi bi-patch-check-fill text-success" title="Email potwierdzony"></i>
                    }
                </span>
            </TemplateColumn>
            <TemplateColumn Title="Role">
                @foreach (var role in context.Roles)
                {
                    var badgeClass = role == "Admin" ? "bg-danger text-white" : (role == "Manager" ? "bg-warning-subtle text-dark" : "bg-primary-subtle text-primary");
                    <span class="badge @badgeClass me-1">@role</span>
                }
            </TemplateColumn>
            <TemplateColumn Title="Status" Sortable="true" SortBy="@(GridSort<Quorum.Backend.AdminUI.Services.AdminUserDto>.ByAscending(u => u.IsLockedOut))">
                @if (context.IsLockedOut)
                {
                    <span class="badge bg-danger"><i class="bi bi-lock-fill me-1"></i>Zablokowany</span>
                }
                else
                {
                    <span class="badge bg-success-subtle text-success"><i class="bi bi-check-circle me-1"></i>Aktywny</span>
                }

                @if (context.TwoFactorEnabled)
                {
                    <span class="badge bg-info-subtle text-dark ms-1" title="Uwierzytelnianie dwuskładnikowe włączone">2FA</span>
                }
            </TemplateColumn>
            <PropertyColumn Property="@(u => u.CreatedAt.ToString("yyyy-MM-dd HH:mm"))" Title="Data Utworzenia" Sortable="true" Class="text-muted small" />
            <TemplateColumn Title="Akcje" Class="text-end">
                <div class="btn-group btn-group-sm">
                    <a asp-page="Edit" asp-route-id="@context.Id" class="btn btn-outline-primary" title="Edytuj dane, role i hasło">
                        <i class="bi bi-pencil-square me-1"></i> Edytuj
                    </a>
                    @if (context.UserName != "admin")
                    {
                        <form method="post" asp-page-handler="Delete" asp-route-id="@context.Id" class="d-inline" onsubmit="return confirm('Czy na pewno chcesz bezpowrotnie usunąć konto @context.UserName?');">
                            <button type="submit" class="btn btn-outline-danger" title="Usuń konto">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    }
                </div>
            </TemplateColumn>
        </QuickGrid>
        @if (Model.Users.Count == 0)
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-person-x display-6 d-block mb-2 text-secondary opacity-50"></i>
                Nie znaleziono żadnych użytkowników spełniających kryteria.
            </div>
        }
    </div>
</div>
