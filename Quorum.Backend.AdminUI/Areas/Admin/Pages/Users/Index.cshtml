@page
@model Quorum.Backend.AdminUI.Areas.Admin.Pages.Users.IndexModel
@{
    ViewData["Title"] = "Konta Użytkowników";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h4 mb-1"><i class="bi bi-people me-2 text-primary"></i>Konta Użytkowników (AspNetIdentity)</h2>
        <p class="text-muted small mb-0">Zarządzaj tożsamościami użytkowników, hasłami, danymi profilu i rolami dostępowymi</p>
    </div>
    <a asp-page="Create" class="btn btn-primary shadow-sm">
        <i class="bi bi-person-plus me-1"></i> Dodaj Użytkownika
    </a>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Wyszukiwarka i statystyki -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Szukaj po loginie, emailu lub telefonie..." />
                    @if (!string.IsNullOrWhiteSpace(Model.Search))
                    {
                        <a asp-page="Index" class="btn btn-outline-secondary">Wyczyść</a>
                    }
                    <button type="submit" class="btn btn-dark">Szukaj</button>
                </div>
            </div>
            <div class="col-md-7 text-md-end mt-2 mt-md-0">
                <span class="badge bg-light text-dark border me-2 py-2 px-3">
                    <i class="bi bi-people-fill text-primary me-1"></i> Łącznie kont: <strong>@Model.TotalCount</strong>
                </span>
                <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 py-2 px-3">
                    <i class="bi bi-shield-fill-check me-1"></i> Administratorzy: <strong>@Model.AdminCount</strong>
                </span>
            </div>
        </form>
    </div>
</div>

<component type="typeof(UsersGrid)" render-mode="Static" param-Users="@Model.Users" />
