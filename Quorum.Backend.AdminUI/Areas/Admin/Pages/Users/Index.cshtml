@page
@model Quorum.Backend.AdminUI.Areas.Admin.Pages.Users.IndexModel
@{
    ViewData["Title"] = "Konta Użytkowników";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h4 mb-1"><i class="bi bi-people me-2 text-primary"></i>Konta Użytkowników (AspNetIdentity)</h2>
        <p class="text-muted small mb-0">Zarządzaj tożsamościami użytkowników, hasłami, danymi profilu i rolami dostępowymi</p>
    </div>
    <a asp-page="Create" class="btn btn-primary shadow-sm">
        <i class="bi bi-person-plus me-1"></i> Dodaj Użytkownika
    </a>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Wyszukiwarka i statystyki -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Szukaj po loginie, emailu lub telefonie..." />
                    @if (!string.IsNullOrWhiteSpace(Model.Search))
                    {
                        <a asp-page="Index" class="btn btn-outline-secondary">Wyczyść</a>
                    }
                    <button type="submit" class="btn btn-dark">Szukaj</button>
                </div>
            </div>
            <div class="col-md-7 text-md-end mt-2 mt-md-0">
                <span class="badge bg-light text-dark border me-2 py-2 px-3">
                    <i class="bi bi-people-fill text-primary me-1"></i> Łącznie kont: <strong>@Model.TotalCount</strong>
                </span>
                <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 py-2 px-3">
                    <i class="bi bi-shield-fill-check me-1"></i> Administratorzy: <strong>@Model.AdminCount</strong>
                </span>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Nazwa Użytkownika (Login)</th>
                    <th>Imię i Nazwisko</th>
                    <th>Adres Email</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Data Utworzenia</th>
                    <th class="text-end">Akcje</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Users.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-person-x display-6 d-block mb-2 text-secondary opacity-50"></i>
                            Nie znaleziono żadnych użytkowników spełniających kryteria.
                        </td>
                    </tr>
                }
                @foreach (var user in Model.Users)
                {
                    <tr>
                        <td>
                            <a asp-page="Edit" asp-route-id="@user.Id" class="text-decoration-none fw-bold text-dark d-inline-flex align-items-center">
                                <i class="bi bi-person-circle text-primary me-2 fs-5"></i>
                                <span>@user.UserName</span>
                            </a>
                        </td>
                        <td>@(string.IsNullOrEmpty(user.FullName) ? "-" : user.FullName)</td>
                        <td>
                            <span class="d-inline-flex align-items-center gap-1">
                                @user.Email
                                @if (user.EmailConfirmed)
                                {
                                    <i class="bi bi-patch-check-fill text-success" title="Email potwierdzony"></i>
                                }
                            </span>
                        </td>
                        <td>
                            @foreach (var role in user.Roles)
                            {
                                var badgeClass = role == "Admin" ? "bg-danger text-white" : (role == "Manager" ? "bg-warning-subtle text-dark" : "bg-primary-subtle text-primary");
                                <span class="badge @badgeClass me-1">@role</span>
                            }
                        </td>
                        <td>
                            @if (user.IsLockedOut)
                            {
                                <span class="badge bg-danger"><i class="bi bi-lock-fill me-1"></i>Zablokowany</span>
                            }
                            else
                            {
                                <span class="badge bg-success-subtle text-success"><i class="bi bi-check-circle me-1"></i>Aktywny</span>
                            }

                            @if (user.TwoFactorEnabled)
                            {
                                <span class="badge bg-info-subtle text-dark ms-1" title="Uwierzytelnianie dwuskładnikowe włączone">2FA</span>
                            }
                        </td>
                        <td class="text-muted small">@user.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <a asp-page="Edit" asp-route-id="@user.Id" class="btn btn-outline-primary" title="Edytuj dane, role i hasło">
                                    <i class="bi bi-pencil-square me-1"></i> Edytuj
                                </a>
                                @if (user.UserName != "admin")
                                {
                                    <form method="post" asp-page-handler="Delete" asp-route-id="@user.Id" class="d-inline" onsubmit="return confirm('Czy na pewno chcesz bezpowrotnie usunąć konto @user.UserName?');">
                                        <button type="submit" class="btn btn-outline-danger" title="Usuń konto">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
