@page
@model Quorum.Backend.AdminUI.Areas.Admin.Pages.Users.IndexModel
@{
    ViewData["Title"] = "Konta Użytkowników";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h4 mb-1"><i class="bi bi-people me-2 text-primary"></i>Konta Użytkowników (AspNetIdentity)</h2>
        <p class="text-muted small mb-0">Zarządzaj tożsamościami użytkowników, hasłami i rolami dostępowymi do aplikacji</p>
    </div>
    <a asp-page="Create" class="btn btn-primary">
        <i class="bi bi-person-plus me-1"></i> Dodaj Użytkownika
    </a>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Nazwa Użytkownika (Login)</th>
                    <th>Imię i Nazwisko</th>
                    <th>Adres Email</th>
                    <th>Role</th>
                    <th>Data Utworzenia</th>
                    <th class="text-end">Akcje</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Users)
                {
                    <tr>
                        <td class="fw-bold">
                            <i class="bi bi-person-circle text-secondary me-2"></i>
                            @user.UserName
                        </td>
                        <td>@(string.IsNullOrEmpty(user.FullName) ? "-" : user.FullName)</td>
                        <td>@user.Email</td>
                        <td>
                            @foreach (var role in user.Roles)
                            {
                                var badgeClass = role == "Admin" ? "bg-danger text-white" : "bg-primary-subtle text-primary";
                                <span class="badge @badgeClass me-1">@role</span>
                            }
                        </td>
                        <td class="text-muted small">@user.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="text-end">
                            @if (user.UserName != "admin")
                            {
                                <form method="post" asp-page-handler="Delete" asp-route-id="@user.Id" class="d-inline" onsubmit="return confirm('Czy na pewno chcesz usunąć konto @user.UserName?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary small">Konto Główne</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
