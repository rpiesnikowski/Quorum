@page "{id}"
@model Quorum.Backend.AdminUI.Areas.Admin.Pages.Users.EditModel
@{
    ViewData["Title"] = $"Edycja Użytkownika: {Model.Input.UserName}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 small">
                <li class="breadcrumb-item"><a asp-page="/Index">Admin</a></li>
                <li class="breadcrumb-item"><a asp-page="Index">Użytkownicy</a></li>
                <li class="breadcrumb-item active">@Model.Input.UserName</li>
            </ol>
        </nav>
        <h2 class="h4 mb-0">
            <i class="bi bi-person-gear me-2 text-primary"></i>Edycja Użytkownika: 
            <span class="font-monospace text-primary">@Model.Input.UserName</span>
        </h2>
    </div>
    <div class="d-flex gap-2">
        <a asp-page="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Powrót do listy
        </a>
    </div>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4">
    <!-- Główna kolumna z formularzem edycji -->
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white border-bottom py-3">
                <ul class="nav nav-tabs card-header-tabs m-0" id="userEditTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active fw-semibold" id="tab-profile" data-bs-toggle="tab" data-bs-target="#profile" type="button" role="tab">
                            <i class="bi bi-person-vcard me-1 text-primary"></i> Dane Profilu &amp; Role
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link fw-semibold" id="tab-security" data-bs-toggle="tab" data-bs-target="#security" type="button" role="tab">
                            <i class="bi bi-shield-lock me-1 text-warning"></i> Zmiana Hasła
                        </button>
                    </li>
                </ul>
            </div>

            <div class="card-body p-4">
                <div class="tab-content" id="userEditTabsContent">
                    <!-- Zakładka 1: Dane profilowe i role -->
                    <div class="tab-pane fade show active" id="profile" role="tabpanel">
                        <form method="post" asp-page-handler="Update" asp-route-id="@Model.Input.Id">
                            <input type="hidden" asp-for="Input.Id" />
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                            <div class="row g-3 mb-4">
                                <div class="col-md-6">
                                    <label asp-for="Input.UserName" class="form-label fw-semibold">Login / Nazwa Konta <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light text-muted"><i class="bi bi-person-badge"></i></span>
                                        <input asp-for="Input.UserName" class="form-control font-monospace" />
                                    </div>
                                    <span asp-validation-for="Input.UserName" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="Input.FullName" class="form-label fw-semibold">Imię i Nazwisko</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light text-muted"><i class="bi bi-person"></i></span>
                                        <input asp-for="Input.FullName" class="form-control" placeholder="np. Jan Kowalski" />
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="Input.Email" class="form-label fw-semibold">Adres Email <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light text-muted"><i class="bi bi-envelope"></i></span>
                                        <input asp-for="Input.Email" type="email" class="form-control" />
                                    </div>
                                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                                    <div class="form-check mt-2">
                                        <input asp-for="Input.EmailConfirmed" class="form-check-input" id="emailConfirmedCheck" />
                                        <label class="form-check-label small text-secondary" for="emailConfirmedCheck">
                                            Adres email zweryfikowany / potwierdzony
                                        </label>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="Input.PhoneNumber" class="form-label fw-semibold">Numer Telefonu</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light text-muted"><i class="bi bi-telephone"></i></span>
                                        <input asp-for="Input.PhoneNumber" class="form-control" placeholder="+48 123 456 789" />
                                    </div>
                                    <span asp-validation-for="Input.PhoneNumber" class="text-danger small"></span>
                                </div>
                            </div>

                            <hr class="my-4" />

                            <h5 class="h6 fw-bold mb-3"><i class="bi bi-shield-check me-2 text-primary"></i>Uprawnienia i Role w Systemie</h5>
                            <p class="text-muted small mb-3">Zaznacz role, które mają zostać przypisane do tego konta:</p>

                            <div class="row g-2 mb-4">
                                @foreach (var role in Model.AvailableRoles)
                                {
                                    var isChecked = Model.Input.SelectedRoles.Contains(role, StringComparer.OrdinalIgnoreCase);
                                    var badgeColor = role == "Admin" ? "border-danger text-danger bg-danger-subtle" : "border-primary text-primary bg-primary-subtle";
                                    var icon = role == "Admin" ? "bi-shield-fill-exclamation" : (role == "Manager" ? "bi-briefcase-fill" : "bi-person-fill");
                                    
                                    <div class="col-md-4">
                                        <div class="card border p-3 rounded-3 h-100">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" name="Input.SelectedRoles" value="@role" id="role_@role" @(isChecked ? "checked" : "") />
                                                <label class="form-check-label fw-semibold d-flex align-items-center gap-1" for="role_@role">
                                                    <i class="bi @icon me-1"></i> @role
                                                </label>
                                            </div>
                                            <div class="small text-muted mt-1 ps-4">
                                                @if (role == "Admin")
                                                {
                                                    <span>Pełny dostęp administracyjny do konsoli Quorum Admin UI.</span>
                                                }
                                                else if (role == "Manager")
                                                {
                                                    <span>Dostęp menedżerski i rozszerzone uprawnienia biznesowe.</span>
                                                }
                                                else
                                                {
                                                    <span>Standardowe uprawnienia użytkownika aplikacji klienckich.</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>

                            <hr class="my-4" />

                            <h5 class="h6 fw-bold mb-3"><i class="bi bi-sliders me-2 text-primary"></i>Ustawienia Zaawansowane Konta</h5>
                            <div class="row g-3 mb-4">
                                <div class="col-md-6">
                                    <div class="form-check form-switch">
                                        <input asp-for="Input.LockoutEnabled" class="form-check-input" id="lockoutSwitch" />
                                        <label class="form-check-label fw-semibold" for="lockoutSwitch">Blokada konta przy błędnych hasłach</label>
                                        <div class="form-text text-muted small">Włącza automatyczną blokadę konta po przekroczeniu limitu nieudanych prób logowania.</div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-check form-switch">
                                        <input asp-for="Input.TwoFactorEnabled" class="form-check-input" id="twoFactorSwitch" />
                                        <label class="form-check-label fw-semibold" for="twoFactorSwitch">Wymagane Uwierzytelnianie Dwuskładnikowe (2FA)</label>
                                        <div class="form-text text-muted small">Wymusza wprowadzanie dodatkowego kodu weryfikacyjnego podczas logowania.</div>
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-primary px-4">
                                    <i class="bi bi-save me-1"></i> Zapisz Zmiany
                                </button>
                                <a asp-page="Index" class="btn btn-outline-secondary">Anuluj</a>
                            </div>
                        </form>
                    </div>

                    <!-- Zakładka 2: Zmiana hasła -->
                    <div class="tab-pane fade" id="security" role="tabpanel">
                        <form method="post" asp-page-handler="ResetPassword" asp-route-id="@Model.Input.Id">
                            <div class="alert alert-warning border-0 bg-warning-subtle py-2 px-3 small mb-4 d-flex align-items-center gap-2">
                                <i class="bi bi-key-fill text-warning fs-5"></i>
                                <span>Bezpośrednia zmiana hasła przez administratora natychmiast unieważnia poprzednie sesje użytkownika.</span>
                            </div>

                            <div class="mb-3 col-md-8">
                                <label asp-for="PasswordInput.NewPassword" class="form-label fw-semibold">Nowe Hasło <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted"><i class="bi bi-key"></i></span>
                                    <input asp-for="PasswordInput.NewPassword" class="form-control" type="password" placeholder="Minimum 6 znaków" />
                                </div>
                                <span asp-validation-for="PasswordInput.NewPassword" class="text-danger small"></span>
                            </div>

                            <div class="mb-4 col-md-8">
                                <label asp-for="PasswordInput.ConfirmPassword" class="form-label fw-semibold">Potwierdź Nowe Hasło <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted"><i class="bi bi-check2-circle"></i></span>
                                    <input asp-for="PasswordInput.ConfirmPassword" class="form-control" type="password" placeholder="Wprowadź ponownie to samo hasło" />
                                </div>
                                <span asp-validation-for="PasswordInput.ConfirmPassword" class="text-danger small"></span>
                            </div>

                            <button type="submit" class="btn btn-warning fw-semibold px-4">
                                <i class="bi bi-shield-lock-fill me-1"></i> Zmień Hasło Użytkownika
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Prawa kolumna - Karta Statusu & Akcje niebezpieczne -->
    <div class="col-lg-4">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="mb-0 fw-bold"><i class="bi bi-info-circle text-primary me-2"></i>Status Konta</h6>
            </div>
            <div class="card-body p-3">
                <div class="list-group list-group-flush small">
                    <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                        <span class="text-muted">Identyfikator:</span>
                        <code class="text-dark">@Model.Input.Id</code>
                    </div>
                    <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                        <span class="text-muted">Status blokady:</span>
                        @if (Model.CurrentUser?.IsLockedOut == true)
                        {
                            <span class="badge bg-danger"><i class="bi bi-lock-fill me-1"></i>Zablokowane</span>
                        }
                        else
                        {
                            <span class="badge bg-success-subtle text-success"><i class="bi bi-check-circle me-1"></i>Aktywne</span>
                        }
                    </div>
                    <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                        <span class="text-muted">Błędne próby logowania:</span>
                        <span class="fw-semibold">@(Model.CurrentUser?.AccessFailedCount ?? 0)</span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                        <span class="text-muted">Data utworzenia:</span>
                        <span>@(Model.CurrentUser?.CreatedAt.ToString("yyyy-MM-dd HH:mm") ?? "-")</span>
                    </div>
                </div>

                @if (Model.CurrentUser?.IsLockedOut == true)
                {
                    <form method="post" asp-page-handler="Unlock" asp-route-id="@Model.Input.Id" class="mt-3">
                        <button type="submit" class="btn btn-outline-success btn-sm w-100">
                            <i class="bi bi-unlock-fill me-1"></i> Odblokuj Konto
                        </button>
                    </form>
                }
            </div>
        </div>

        @if (Model.Input.UserName != "admin")
        {
            <div class="card shadow-sm border-danger border-opacity-50">
                <div class="card-header bg-danger bg-opacity-10 text-danger border-danger border-opacity-25 py-2">
                    <h6 class="mb-0 fw-bold small"><i class="bi bi-exclamation-octagon-fill me-1"></i>Strefa Niebezpieczna</h6>
                </div>
                <div class="card-body p-3">
                    <p class="small text-muted mb-3">Usunięcie konta użytkownika jest nieodwracalne i spowoduje odebranie dostępu do wszystkich powiązanych usług.</p>
                    <form method="post" asp-page-handler="Delete" asp-route-id="@Model.Input.Id" onsubmit="return confirm('Czy na pewno chcesz bezpowrotnie usunąć konto @Model.Input.UserName?');">
                        <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                            <i class="bi bi-trash me-1"></i> Usuń to konto użytkownika
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>
