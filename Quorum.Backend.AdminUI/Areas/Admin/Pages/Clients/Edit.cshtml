@page "{id:int}"
@model Quorum.Backend.AdminUI.Areas.Admin.Pages.Clients.EditModel
@{
    ViewData["Title"] = $"Edycja Klienta: {Model.Input.ClientId}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 small">
                <li class="breadcrumb-item"><a asp-page="/Index">Admin</a></li>
                <li class="breadcrumb-item"><a asp-page="Index">Klienci</a></li>
                <li class="breadcrumb-item active">@Model.Input.ClientId</li>
            </ol>
        </nav>
        <h2 class="h4 mb-0"><i class="bi bi-pencil-square me-2 text-primary"></i>Edycja Klienta: <span class="font-monospace text-primary">@Model.Input.ClientId</span></h2>
    </div>
    <div class="d-flex gap-2">
        <a asp-page="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Powrót do listy
        </a>
    </div>
</div>

<form method="post">
    <input type="hidden" asp-for="Input.Id" />
    
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-4"></div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white border-bottom p-0">
            <ul class="nav nav-tabs card-header-tabs m-0 px-3 pt-2" id="clientTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active fw-semibold" id="tab-basics" data-bs-toggle="tab" data-bs-target="#basics" type="button" role="tab">
                        <i class="bi bi-info-circle me-1 text-primary"></i> Podstawowe
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link fw-semibold" id="tab-secrets" data-bs-toggle="tab" data-bs-target="#secrets" type="button" role="tab">
                        <i class="bi bi-key me-1 text-warning"></i> Sekrety &amp; Uwierzytelnianie
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link fw-semibold" id="tab-flows" data-bs-toggle="tab" data-bs-target="#flows" type="button" role="tab">
                        <i class="bi bi-diagram-3 me-1 text-info"></i> Przepływy &amp; PKCE
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link fw-semibold" id="tab-urls" data-bs-toggle="tab" data-bs-target="#urls" type="button" role="tab">
                        <i class="bi bi-link-45deg me-1 text-success"></i> URIs &amp; Wylogowanie
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link fw-semibold" id="tab-scopes" data-bs-toggle="tab" data-bs-target="#scopes" type="button" role="tab">
                        <i class="bi bi-shield-check me-1 text-danger"></i> Scopes &amp; Zgody
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link fw-semibold" id="tab-tokens" data-bs-toggle="tab" data-bs-target="#tokens" type="button" role="tab">
                        <i class="bi bi-clock-history me-1 text-secondary"></i> Tokeny &amp; Ważność
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link fw-semibold" id="tab-claims" data-bs-toggle="tab" data-bs-target="#claims" type="button" role="tab">
                        <i class="bi bi-person-badge me-1 text-dark"></i> Claims &amp; Dostawcy
                    </button>
                </li>
            </ul>
        </div>

        <div class="card-body p-4">
            <div class="tab-content" id="clientTabsContent">
                
                <!-- 1. PODSTAWOWE -->
                <div class="tab-pane fade show active" id="basics" role="tabpanel">
                    <h5 class="fw-bold mb-3 text-secondary">Główna tożsamość aplikacji</h5>
                    
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Input.ClientId" class="form-label fw-semibold small">Client ID <span class="text-danger">*</span></label>
                            <input asp-for="Input.ClientId" class="form-control font-monospace" />
                            <div class="form-text">Unikalny identyfikator aplikacji klienckiej (np. <code>spa-client</code>, <code>backend-service</code>).</div>
                            <span asp-validation-for="Input.ClientId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Input.ClientName" class="form-label fw-semibold small">Nazwa Wyświetlana <span class="text-danger">*</span></label>
                            <input asp-for="Input.ClientName" class="form-control" />
                            <div class="form-text">Czytelna nazwa aplikacji prezentowana użytkownikowi na ekranie zgody (Consent).</div>
                            <span asp-validation-for="Input.ClientName" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Input.Description" class="form-label fw-semibold small">Opis Klienta</label>
                            <input asp-for="Input.Description" class="form-control" placeholder="np. Aplikacja mobilna dla klientów indywidualnych" />
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Input.ProtocolType" class="form-label fw-semibold small">Typ Protokołu</label>
                            <input asp-for="Input.ProtocolType" class="form-control" />
                            <div class="form-text">Domyślnie: <code>oidc</code> (OpenID Connect / OAuth 2.0).</div>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Input.ClientUri" class="form-label fw-semibold small">Strona Główna Klienta (ClientUri)</label>
                            <input asp-for="Input.ClientUri" class="form-control" placeholder="https://myapp.example.com" />
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Input.LogoUri" class="form-label fw-semibold small">Adres URL Logo (LogoUri)</label>
                            <input asp-for="Input.LogoUri" class="form-control" placeholder="https://myapp.example.com/logo.png" />
                        </div>

                        <div class="col-12 mt-4">
                            <div class="p-3 bg-light rounded-3 border">
                                <div class="form-check form-switch mb-2">
                                    <input asp-for="Input.Enabled" class="form-check-input" type="checkbox" id="enabledSwitch" />
                                    <label class="form-check-label fw-semibold" for="enabledSwitch">Klient Aktywny (Enabled)</label>
                                    <div class="text-muted small">Wyłączenie zablokuje wszelkie próby logowania i wydawania tokenów dla tego klienta.</div>
                                </div>
                                <div class="form-check form-switch">
                                    <input asp-for="Input.EnableLocalLogin" class="form-check-input" type="checkbox" id="enableLocalLoginSwitch" />
                                    <label class="form-check-label fw-semibold" for="enableLocalLoginSwitch">Zezwalaj na Logowanie Lokalne (EnableLocalLogin)</label>
                                    <div class="text-muted small">Pozwala użytkownikom logować się loginem i hasłem z ASP.NET Core Identity.</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 2. SEKRETY & UWIERZYTELNIANIE -->
                <div class="tab-pane fade" id="secrets" role="tabpanel">
                    <h5 class="fw-bold mb-3 text-secondary">Uwierzytelnianie Klienta &amp; Sekrety</h5>

                    <div class="mb-4 p-3 bg-light rounded-3 border">
                        <div class="form-check form-switch">
                            <input asp-for="Input.RequireClientSecret" class="form-check-input" type="checkbox" id="requireSecretSwitch" />
                            <label class="form-check-label fw-semibold" for="requireSecretSwitch">Wymagaj Sekretu Klienta (RequireClientSecret)</label>
                            <div class="text-muted small">
                                Dla klientów publicznych (np. SPA React/Angular, aplikacje mobilne z PKCE) to pole powinno mieć wartość <code>false</code>. 
                                Jeśli klient nie ma zdefiniowanych żadnych sekretów, Open.IdentityServer uznaje <code>RequireClientSecret = false</code>.
                            </div>
                        </div>
                    </div>

                    <!-- Lista istniejących sekretów -->
                    <div class="mb-4">
                        <h6 class="fw-bold small text-uppercase text-muted mb-2">Istniejące Sekrety w Bazie Danych</h6>
                        @if (Model.Input.ExistingSecrets != null && Model.Input.ExistingSecrets.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-bordered table-sm align-middle bg-white">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Typ</th>
                                            <th>Hash / Wartość</th>
                                            <th>Opis</th>
                                            <th>Wygasa</th>
                                            <th class="text-center" style="width: 120px;">Usuń</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (int i = 0; i < Model.Input.ExistingSecrets.Count; i++)
                                        {
                                            <tr>
                                                <td>
                                                    <input type="hidden" asp-for="Input.ExistingSecrets[i].Id" />
                                                    <span class="badge bg-secondary">@Model.Input.ExistingSecrets[i].Type</span>
                                                </td>
                                                <td><code class="text-muted">@Model.Input.ExistingSecrets[i].ValuePreview</code></td>
                                                <td>@(Model.Input.ExistingSecrets[i].Description ?? "—")</td>
                                                <td>@(Model.Input.ExistingSecrets[i].Expiration?.ToString("yyyy-MM-dd HH:mm") ?? "Nigdy")</td>
                                                <td class="text-center bg-danger-subtle">
                                                    <div class="form-check d-inline-block">
                                                        <input asp-for="Input.ExistingSecrets[i].Delete" class="form-check-input border-danger" type="checkbox" id="del_@i" />
                                                        <label class="form-check-label text-danger small fw-semibold" for="del_@i">Usuń</label>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info py-2 small mb-3">
                                <i class="bi bi-info-circle me-1"></i> Ten klient nie posiada obecnie żadnych sekretów w bazie (klient publiczny).
                            </div>
                        }
                    </div>

                    <!-- Formularz dodania nowego sekretu -->
                    <div class="card bg-light border-primary-subtle border">
                        <div class="card-header bg-primary-subtle py-2">
                            <h6 class="fw-bold mb-0 text-primary small"><i class="bi bi-plus-circle me-1"></i> Dodaj Nowy Sekret dla Klienta</h6>
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-5">
                                    <label asp-for="Input.NewSecretValue" class="form-label fw-semibold small">Nowa Wartość Sekretu (tekst jawny)</label>
                                    <input asp-for="Input.NewSecretValue" type="text" class="form-control font-monospace" placeholder="np. super_tajne_haslo_123!" autocomplete="off" />
                                    <div class="form-text">Zostanie automatycznie zashashowany algorytmem SHA-256 przed zapisem do bazy.</div>
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="Input.NewSecretType" class="form-label fw-semibold small">Typ Sekretu</label>
                                    <select asp-for="Input.NewSecretType" class="form-select">
                                        <option value="SharedSecret">SharedSecret (Klucz symetryczny)</option>
                                        <option value="X509Thumbprint">X509Thumbprint (Odcisk certyfikatu)</option>
                                        <option value="X509Name">X509Name</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="Input.NewSecretExpiration" class="form-label fw-semibold small">Data Wygaśnięcia (opcjonalnie)</label>
                                    <input asp-for="Input.NewSecretExpiration" type="datetime-local" class="form-control" />
                                </div>
                                <div class="col-12">
                                    <label asp-for="Input.NewSecretDescription" class="form-label fw-semibold small">Opis Sekretu</label>
                                    <input asp-for="Input.NewSecretDescription" type="text" class="form-control" placeholder="np. Klucz produkcyjny backendu 2026" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 3. PRZEPŁYWY & PKCE -->
                <div class="tab-pane fade" id="flows" role="tabpanel">
                    <h5 class="fw-bold mb-3 text-secondary">Typy Przepływów OAuth2 (Grant Types) &amp; PKCE</h5>

                    <!-- Zarządzanie Dozwolonymi Typami Przepływów -->
                    <div class="card border-primary shadow-sm mb-4">
                        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-2">
                            <span class="fw-semibold"><i class="bi bi-diagram-3-fill me-2"></i>Dozwolone Typy Przepływów (AllowedGrantTypes) <span class="text-warning">*</span></span>
                            <span id="grantCountBadge" class="badge bg-light text-primary">Wybrano: 0</span>
                        </div>
                        <div class="card-body p-3">
                            <p class="text-muted small mb-3">
                                Wybierz protokoły i metody wymiany tokenów, z których ten klient ma prawo korzystać. Kliknij na dostępny typ poniżej, aby go dodać lub usunąć.
                            </p>

                            <!-- Ukryte pole zsynchronizowane z formularzem -->
                            <input asp-for="Input.AllowedGrantTypes" id="grantTypesInput" type="hidden" />
                            <span asp-validation-for="Input.AllowedGrantTypes" class="text-danger small d-block mb-2"></span>

                            <!-- Kontener aktualnie wybranych typów -->
                            <div class="mb-3">
                                <label class="form-label small fw-bold text-uppercase text-secondary">Aktualnie Aktywne Typy Przepływów dla Klienta:</label>
                                <div id="selectedGrantsContainer" class="p-3 bg-light rounded-3 border d-flex flex-wrap gap-2 align-items-center min-h-50">
                                    <!-- Renderowane dynamicznie przez JS -->
                                </div>
                            </div>

                            <!-- Szybkie szablony -->
                            <div class="mb-3 p-2 bg-body-tertiary rounded border">
                                <div class="d-flex flex-wrap align-items-center gap-2">
                                    <span class="small fw-semibold text-muted me-1"><i class="bi bi-magic me-1 text-primary"></i>Gotowe profile:</span>
                                    <button type="button" class="btn btn-xs btn-outline-primary" onclick="applyPreset(['authorization_code'])">
                                        <i class="bi bi-browser-chrome me-1"></i>SPA / Web (Code + PKCE)
                                    </button>
                                    <button type="button" class="btn btn-xs btn-outline-primary" onclick="applyPreset(['client_credentials'])">
                                        <i class="bi bi-hdd-network me-1"></i>Backend M2M (Client Credentials)
                                    </button>
                                    <button type="button" class="btn btn-xs btn-outline-primary" onclick="applyPreset(['authorization_code', 'urn:ietf:params:oauth:grant-type:device_code'])">
                                        <i class="bi bi-tv me-1"></i>Web + Smart TV / CLI (Device Flow)
                                    </button>
                                    <button type="button" class="btn btn-xs btn-outline-secondary" onclick="applyPreset(['hybrid'])">
                                        Hybrid (MVC)
                                    </button>
                                    <button type="button" class="btn btn-xs btn-outline-danger" onclick="applyPreset([])">
                                        <i class="bi bi-x-circle me-1"></i>Wyczyść wszystko
                                    </button>
                                </div>
                            </div>

                            <!-- Klikalne standardowe typy przepływów -->
                            <div class="mb-3">
                                <label class="form-label small fw-bold text-uppercase text-secondary">Kliknij element, aby dodać lub usunąć z listy:</label>
                                <div class="row g-2" id="availableGrantsList">
                                    
                                    <div class="col-md-6">
                                        <div class="p-2 border rounded d-flex justify-content-between align-items-center grant-item-card" id="grant-card-authorization_code" style="cursor: pointer;" onclick="toggleGrantType('authorization_code')">
                                            <div>
                                                <div class="fw-bold font-monospace small text-primary">authorization_code</div>
                                                <div class="text-muted" style="font-size: 0.75rem;">Standardowy przepływ dla Web, SPA (React, Vue, Angular) i Mobile z PKCE</div>
                                            </div>
                                            <div id="grant-status-authorization_code" class="ms-2"></div>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="p-2 border rounded d-flex justify-content-between align-items-center grant-item-card" id="grant-card-client_credentials" style="cursor: pointer;" onclick="toggleGrantType('client_credentials')">
                                            <div>
                                                <div class="fw-bold font-monospace small text-primary">client_credentials</div>
                                                <div class="text-muted" style="font-size: 0.75rem;">Dla serwisów backendowych, demonów i mikrousług (M2M)</div>
                                            </div>
                                            <div id="grant-status-client_credentials" class="ms-2"></div>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="p-2 border rounded d-flex justify-content-between align-items-center grant-item-card" id="grant-card-urn_ietf_params_oauth_grant-type_device_code" style="cursor: pointer;" onclick="toggleGrantType('urn:ietf:params:oauth:grant-type:device_code')">
                                            <div>
                                                <div class="fw-bold font-monospace small text-primary">urn:ietf:params:oauth:grant-type:device_code</div>
                                                <div class="text-muted" style="font-size: 0.75rem;">Device Flow dla Smart TV, konsoli, IoT i narzędzi CLI</div>
                                            </div>
                                            <div id="grant-status-urn_ietf_params_oauth_grant-type_device_code" class="ms-2"></div>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="p-2 border rounded d-flex justify-content-between align-items-center grant-item-card" id="grant-card-refresh_token" style="cursor: pointer;" onclick="toggleGrantType('refresh_token')">
                                            <div>
                                                <div class="fw-bold font-monospace small text-primary">refresh_token</div>
                                                <div class="text-muted" style="font-size: 0.75rem;">Dla odnawiania wygasłych Access Tokenów w tle (offline_access)</div>
                                            </div>
                                            <div id="grant-status-refresh_token" class="ms-2"></div>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="p-2 border rounded d-flex justify-content-between align-items-center grant-item-card" id="grant-card-hybrid" style="cursor: pointer;" onclick="toggleGrantType('hybrid')">
                                            <div>
                                                <div class="fw-bold font-monospace small text-secondary">hybrid</div>
                                                <div class="text-muted" style="font-size: 0.75rem;">Połączenie Code i Implicit dla tradycyjnych aplikacji MVC</div>
                                            </div>
                                            <div id="grant-status-hybrid" class="ms-2"></div>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="p-2 border rounded d-flex justify-content-between align-items-center grant-item-card" id="grant-card-implicit" style="cursor: pointer;" onclick="toggleGrantType('implicit')">
                                            <div>
                                                <div class="fw-bold font-monospace small text-secondary">implicit</div>
                                                <div class="text-muted" style="font-size: 0.75rem;">Starszy przepływ przeglądarkowy (odradzany na rzecz PKCE)</div>
                                            </div>
                                            <div id="grant-status-implicit" class="ms-2"></div>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="p-2 border rounded d-flex justify-content-between align-items-center grant-item-card" id="grant-card-password" style="cursor: pointer;" onclick="toggleGrantType('password')">
                                            <div>
                                                <div class="fw-bold font-monospace small text-secondary">password</div>
                                                <div class="text-muted" style="font-size: 0.75rem;">Resource Owner Password Credentials (legacy, bezpośrednie hasło)</div>
                                            </div>
                                            <div id="grant-status-password" class="ms-2"></div>
                                        </div>
                                    </div>

                                </div>
                            </div>

                            <!-- Dodaj niestandardowy Grant Type -->
                            <div class="p-3 bg-light rounded border">
                                <h6 class="fw-bold small mb-2 text-primary"><i class="bi bi-plus-circle me-1"></i>Dodaj Niestandardowy / Własny Typ Przepływu (Custom Grant)</h6>
                                <div class="row g-2 align-items-end">
                                    <div class="col-md-9">
                                        <label for="customGrantInput" class="form-label small fw-semibold">Identyfikator lub URI przepływu</label>
                                        <input type="text" id="customGrantInput" class="form-control form-control-sm font-monospace" placeholder="np. urn:openid:params:grant-type:ciba lub delegation" />
                                    </div>
                                    <div class="col-md-3">
                                        <button type="button" class="btn btn-sm btn-primary w-100 fw-semibold" onclick="addCustomGrant()">
                                            <i class="bi bi-plus-lg me-1"></i> Dodaj do listy
                                        </button>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>

                    <div class="p-3 bg-light rounded-3 border mt-4">
                        <h6 class="fw-bold small text-uppercase text-muted mb-3">Zabezpieczenia PKCE &amp; Przeglądarka</h6>
                        
                        <div class="form-check form-switch mb-3">
                            <input asp-for="Input.RequirePkce" class="form-check-input" type="checkbox" id="requirePkceSwitch" />
                            <label class="form-check-label fw-semibold" for="requirePkceSwitch">Wymagaj PKCE (RequirePkce)</label>
                            <div class="text-muted small">Wymaga przesłania <code>code_challenge</code> i <code>code_verifier</code> (RFC 7636). Bezwzględnie zalecane dla SPA i aplikacji mobilnych.</div>
                        </div>

                        <div class="form-check form-switch mb-3">
                            <input asp-for="Input.AllowPlainTextPkce" class="form-check-input" type="checkbox" id="plainTextPkceSwitch" />
                            <label class="form-check-label fw-semibold" for="plainTextPkceSwitch">Zezwalaj na Plain-Text PKCE (AllowPlainTextPkce)</label>
                            <div class="text-muted small">Domyślnie wyłączone. Zezwala na niestosowanie hashowania S256 dla PKCE.</div>
                        </div>

                        <div class="form-check form-switch mb-3">
                            <input asp-for="Input.AllowAccessTokensViaBrowser" class="form-check-input" type="checkbox" id="browserTokensSwitch" />
                            <label class="form-check-label fw-semibold" for="browserTokensSwitch">Zezwalaj na wydawanie Access Tokenów w Przeglądarce (AllowAccessTokensViaBrowser)</label>
                            <div class="text-muted small">Wymagane tylko dla starszych przepływów Implicit / Hybrid.</div>
                        </div>

                        <div class="form-check form-switch">
                            <input asp-for="Input.RequireRequestObject" class="form-check-input" type="checkbox" id="requireRequestObjSwitch" />
                            <label class="form-check-label fw-semibold" for="requireRequestObjSwitch">Wymagaj JWT Request Object (RequireRequestObject)</label>
                            <div class="text-muted small">Wymaga podpisanych obiektów żądań (JAR - JWT Secured Authorization Request).</div>
                        </div>
                    </div>
                </div>

                <!-- 4. URIS & WYLOGOWANIE -->
                <div class="tab-pane fade" id="urls" role="tabpanel">
                    <h5 class="fw-bold mb-3 text-secondary">Adresy Przekierowań, CORS &amp; Wylogowanie</h5>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Input.RedirectUris" class="form-label fw-semibold small">Adresy Przekierowania po Zalogowaniu (RedirectUris)</label>
                            <textarea asp-for="Input.RedirectUris" class="form-control font-monospace" rows="4" placeholder="https://myapp.example.com/signin-oidc&#10;https://localhost:3000/callback"></textarea>
                            <div class="form-text">Dozwolone adresy powrotne po autoryzacji (jeden URI w wierszu).</div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Input.PostLogoutRedirectUris" class="form-label fw-semibold small">Adresy Przekierowania po Wylogowaniu (PostLogoutRedirectUris)</label>
                            <textarea asp-for="Input.PostLogoutRedirectUris" class="form-control font-monospace" rows="4" placeholder="https://myapp.example.com/signout-callback-oidc&#10;https://localhost:3000/"></textarea>
                            <div class="form-text">Dozwolone adresy docelowe po wylogowaniu użytkownika (jeden URI w wierszu).</div>
                        </div>

                        <div class="col-12">
                            <label asp-for="Input.AllowedCorsOrigins" class="form-label fw-semibold small">Dozwolone Domeny CORS (AllowedCorsOrigins)</label>
                            <textarea asp-for="Input.AllowedCorsOrigins" class="form-control font-monospace" rows="2" placeholder="https://myapp.example.com&#10;https://localhost:3000"></textarea>
                            <div class="form-text">Domeny aplikacji JavaScript dozwolone do wykonywania zapytań CORS do punktów końcowych IdentityServer.</div>
                        </div>

                        <div class="col-md-6 mt-3">
                            <div class="p-3 bg-light rounded-3 border h-100">
                                <h6 class="fw-bold small text-primary mb-2">Front-Channel Logout</h6>
                                <label asp-for="Input.FrontChannelLogoutUri" class="form-label small">Adres FrontChannelLogoutUri</label>
                                <input asp-for="Input.FrontChannelLogoutUri" class="form-control font-monospace mb-2" placeholder="https://myapp.example.com/signout-frontchannel" />
                                <div class="form-check form-switch">
                                    <input asp-for="Input.FrontChannelLogoutSessionRequired" class="form-check-input" type="checkbox" id="frontSessionReq" />
                                    <label class="form-check-label small" for="frontSessionReq">Wymagaj identyfikatora sesji (FrontChannelLogoutSessionRequired)</label>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6 mt-3">
                            <div class="p-3 bg-light rounded-3 border h-100">
                                <h6 class="fw-bold small text-primary mb-2">Back-Channel Logout</h6>
                                <label asp-for="Input.BackChannelLogoutUri" class="form-label small">Adres BackChannelLogoutUri</label>
                                <input asp-for="Input.BackChannelLogoutUri" class="form-control font-monospace mb-2" placeholder="https://myapp.example.com/signout-backchannel" />
                                <div class="form-check form-switch">
                                    <input asp-for="Input.BackChannelLogoutSessionRequired" class="form-check-input" type="checkbox" id="backSessionReq" />
                                    <label class="form-check-label small" for="backSessionReq">Wymagaj identyfikatora sesji (BackChannelLogoutSessionRequired)</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 5. SCOPES & ZGODY -->
                <div class="tab-pane fade" id="scopes" role="tabpanel">
                    <h5 class="fw-bold mb-3 text-secondary">Zakresy Danych (Allowed Scopes) &amp; Zgody Użytkownika</h5>

                    <!-- SEKCJA SCOPES: Autocomplete, Lista tagów i Tabela wyboru -->
                    <div class="card border bg-light mb-4">
                        <div class="card-header bg-white py-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-key-fill text-warning me-2"></i>Dozwolone Zakresy (Allowed Scopes)</h6>
                                    <span class="text-muted small">Wybierz zakresy z tabeli poniżej lub wpisz z podpowiedziami</span>
                                </div>
                                <span class="badge bg-primary-subtle text-primary border" id="scopeCountBadge">0 wybranych</span>
                            </div>
                        </div>
                        <div class="card-body">
                            <!-- Pole tekstowe z autocomplete i tagami -->
                            <div class="mb-3">
                                <label asp-for="Input.AllowedScopes" class="form-label fw-semibold small">Wybrane Zakresy (AllowedScopes)</label>
                                <div class="position-relative">
                                    <div class="input-group">
                                        <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                                        <input type="text" id="scopeAutocompleteInput" class="form-control" placeholder="Wpisz nazwę scope, aby szybko dodać z podpowiedzi..." autocomplete="off" />
                                    </div>
                                    <!-- Lista dropdown autopodpowiedzi -->
                                    <div id="autocompleteDropdown" class="list-group position-absolute w-100 shadow-sm border mt-1" style="display:none; z-index: 1050; max-height: 220px; overflow-y: auto;"></div>
                                </div>

                                <!-- Ukryte / Widoczne pole docelowe formularza -->
                                <input asp-for="Input.AllowedScopes" id="scopesInput" class="form-control font-monospace mt-2" readonly />
                                <div class="form-text small">Wartości są przekazywane do serwera rozdzielone spacją. Aby umożliwić pobieranie Refresh Tokenów, dodaj zakres <code>offline_access</code>.</div>
                                <span asp-validation-for="Input.AllowedScopes" class="text-danger small"></span>

                                <!-- Kontener na dynamiczne chipy / tagi -->
                                <div class="mt-2 d-flex flex-wrap gap-1 align-items-center" id="selectedScopesTags">
                                    <!-- Renderowane przez JS -->
                                </div>
                            </div>

                            <!-- Tabela Grid do zaznaczania Scope -->
                            <div class="mt-3">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <label class="form-label fw-semibold small mb-0"><i class="bi bi-table me-1"></i>Katalog dostępnych zakresów (Zaznacz wiersz lub checkbox, aby dodać/usunąć)</label>
                                    <div class="input-group input-group-sm w-auto" style="max-width: 250px;">
                                        <input type="text" id="filterScopesTableInput" class="form-control form-control-sm" placeholder="Filtruj tabelę..." />
                                        <span class="input-group-text bg-white text-muted"><i class="bi bi-funnel"></i></span>
                                    </div>
                                </div>

                                <div class="table-responsive bg-white rounded border" style="max-height: 280px; overflow-y: auto;">
                                    <table class="table table-hover table-sm align-middle mb-0" id="scopesTable">
                                        <thead class="table-light sticky-top">
                                            <tr>
                                                <th style="width: 40px;" class="text-center">#</th>
                                                <th style="width: 200px;">Identyfikator Scope</th>
                                                <th>Nazwa Wyświetlana / Opis</th>
                                                <th style="width: 140px;">Typ</th>
                                                <th style="width: 80px;" class="text-end">Akcja</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var scope in Model.AvailableScopes)
                                            {
                                                <tr class="scope-row" style="cursor: pointer;" data-scope-name="@scope.Name" data-display-name="@scope.DisplayName" data-description="@(scope.Description ?? "")" data-type="@scope.Type">
                                                    <td class="text-center" onclick="event.stopPropagation();">
                                                        <input type="checkbox" class="form-check-input scope-checkbox" value="@scope.Name" id="chk_edit_@scope.Name" />
                                                    </td>
                                                    <td>
                                                        <span class="badge bg-light text-primary border font-monospace px-2 py-1">@scope.Name</span>
                                                        @if (scope.Emphasize)
                                                        {
                                                            <i class="bi bi-star-fill text-warning small ms-1" title="Wyróżniony"></i>
                                                        }
                                                    </td>
                                                    <td>
                                                        <div class="fw-semibold small">@scope.DisplayName</div>
                                                        @if (!string.IsNullOrWhiteSpace(scope.Description))
                                                        {
                                                            <div class="text-muted text-truncate" style="max-width: 400px; font-size: 0.8rem;">@scope.Description</div>
                                                        }
                                                    </td>
                                                    <td>
                                                        <span class="badge bg-secondary-subtle text-secondary border small">@scope.Type</span>
                                                    </td>
                                                    <td class="text-end" onclick="event.stopPropagation();">
                                                        <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2 toggle-scope-btn" data-scope="@scope.Name">
                                                            <i class="bi bi-plus-lg"></i>
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="p-3 bg-light rounded-3 border">
                        <h6 class="fw-bold small text-uppercase text-muted mb-3">Ekran Zgody Użytkownika (Consent Screen)</h6>

                        <div class="form-check form-switch mb-3">
                            <input asp-for="Input.RequireConsent" class="form-check-input" type="checkbox" id="requireConsentSwitch" />
                            <label class="form-check-label fw-semibold" for="requireConsentSwitch">Wymagaj Ekranu Zgody (RequireConsent)</label>
                            <div class="text-muted small">Wyświetla użytkownikowi stronę z listą uprawnień do zatwierdzenia.</div>
                        </div>

                        <div class="form-check form-switch mb-3">
                            <input asp-for="Input.AllowRememberConsent" class="form-check-input" type="checkbox" id="rememberConsentSwitch" />
                            <label class="form-check-label fw-semibold" for="rememberConsentSwitch">Zezwalaj na Zapamiętanie Zgody (AllowRememberConsent)</label>
                            <div class="text-muted small">Użytkownik nie musi ponownie zatwierdzać zgody przy kolejnych logowaniach.</div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <label asp-for="Input.ConsentLifetime" class="form-label small fw-semibold">Czas Ważności Zgody (w sekundach)</label>
                                <input asp-for="Input.ConsentLifetime" type="number" class="form-control" placeholder="Puste = bezterminowo" />
                                <div class="form-text">Czas, po którym zapamiętana zgoda wygaśnie (np. <code>2592000</code> dla 30 dni).</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 6. TOKENY & WAŻNOŚĆ -->
                <div class="tab-pane fade" id="tokens" role="tabpanel">
                    <h5 class="fw-bold mb-3 text-secondary">Czas Życia Tokenów &amp; Refresh Tokens</h5>

                    <div class="p-3 bg-light rounded-3 border mb-4">
                        <div class="form-check form-switch">
                            <input asp-for="Input.AllowOfflineAccess" class="form-check-input" type="checkbox" id="offlineAccessSwitch" />
                            <label class="form-check-label fw-semibold" for="offlineAccessSwitch">Zezwalaj na Offline Access (AllowOfflineAccess)</label>
                            <div class="text-muted small">Umożliwia wystawianie <strong>Refresh Tokenów</strong> dla tego klienta.</div>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label asp-for="Input.AccessTokenLifetime" class="form-label fw-semibold small">Czas życia Access Token (w sekundach)</label>
                            <input asp-for="Input.AccessTokenLifetime" type="number" class="form-control font-monospace" />
                            <div class="form-text">Domyślnie: 3600 (1 godzina).</div>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Input.IdentityTokenLifetime" class="form-label fw-semibold small">Czas życia Identity Token (w sekundach)</label>
                            <input asp-for="Input.IdentityTokenLifetime" type="number" class="form-control font-monospace" />
                            <div class="form-text">Domyślnie: 300 (5 minut).</div>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Input.AuthorizationCodeLifetime" class="form-label fw-semibold small">Czas życia Kodu Autoryzacji (w sekundach)</label>
                            <input asp-for="Input.AuthorizationCodeLifetime" type="number" class="form-control font-monospace" />
                            <div class="form-text">Domyślnie: 300 (5 minut).</div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Input.AbsoluteRefreshTokenLifetime" class="form-label fw-semibold small">Bezwzględny czas życia Refresh Token (w sekundach)</label>
                            <input asp-for="Input.AbsoluteRefreshTokenLifetime" type="number" class="form-control font-monospace" />
                            <div class="form-text">Maksymalny całkowity czas życia (np. 2592000 = 30 dni).</div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Input.SlidingRefreshTokenLifetime" class="form-label fw-semibold small">Ruchomy czas życia Refresh Token (w sekundach)</label>
                            <input asp-for="Input.SlidingRefreshTokenLifetime" type="number" class="form-control font-monospace" />
                            <div class="form-text">Czas odnowienia przy każdym użyciu (np. 1296000 = 15 dni).</div>
                        </div>
                    </div>

                    <div class="row g-3 p-3 bg-light rounded-3 border">
                        <div class="col-md-4">
                            <label asp-for="Input.AccessTokenType" class="form-label fw-semibold small">Typ Access Tokena</label>
                            <select asp-for="Input.AccessTokenType" class="form-select">
                                <option value="0">0: JWT Token (Samozawarty)</option>
                                <option value="1">1: Reference Token (Weryfikowany w bazie)</option>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Input.RefreshTokenUsage" class="form-label fw-semibold small">Tryb Użycia Refresh Tokena</label>
                            <select asp-for="Input.RefreshTokenUsage" class="form-select">
                                <option value="1">1: ReUse (Ten sam token do wygaśnięcia)</option>
                                <option value="0">0: OneTime (Jednorazowy - rotacja tokenów)</option>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Input.RefreshTokenExpiration" class="form-label fw-semibold small">Sposób Wygasania Refresh Tokena</label>
                            <select asp-for="Input.RefreshTokenExpiration" class="form-select">
                                <option value="1">1: Absolute (Stała data wygaśnięcia)</option>
                                <option value="0">0: Sliding (Przesuwany przy aktywności)</option>
                            </select>
                        </div>

                        <div class="col-md-6 mt-3">
                            <div class="form-check form-switch">
                                <input asp-for="Input.UpdateAccessTokenClaimsOnRefresh" class="form-check-input" type="checkbox" id="updateClaimsSwitch" />
                                <label class="form-check-label small fw-semibold" for="updateClaimsSwitch">Aktualizuj Claims przy Refresh (UpdateAccessTokenClaimsOnRefresh)</label>
                            </div>
                        </div>

                        <div class="col-md-6 mt-3">
                            <label asp-for="Input.AllowedIdentityTokenSigningAlgorithms" class="form-label small fw-semibold">Algorytmy Podpisu IdToken (opcjonalnie)</label>
                            <input asp-for="Input.AllowedIdentityTokenSigningAlgorithms" class="form-control font-monospace" placeholder="RS256, ES256" />
                        </div>
                    </div>
                </div>

                <!-- 7. CLAIMS & DOSTAWCY -->
                <div class="tab-pane fade" id="claims" role="tabpanel">
                    <h5 class="fw-bold mb-3 text-secondary">Mapowanie Claims &amp; Ograniczenia Dostawców Tożsamości</h5>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <div class="form-check form-switch mb-3">
                                <input asp-for="Input.AlwaysIncludeUserClaimsInIdToken" class="form-check-input" type="checkbox" id="alwaysUserClaimsSwitch" />
                                <label class="form-check-label fw-semibold small" for="alwaysUserClaimsSwitch">Zawsze dołączaj claims użytkownika w IdToken</label>
                                <div class="text-muted small">Jeśli wyłączone, claims są pobierane oddzielnie z endpointu <code>/connect/userinfo</code>.</div>
                            </div>

                            <div class="form-check form-switch mb-3">
                                <input asp-for="Input.AlwaysSendClientClaims" class="form-check-input" type="checkbox" id="alwaysClientClaimsSwitch" />
                                <label class="form-check-label fw-semibold small" for="alwaysClientClaimsSwitch">Zawsze wysyłaj claims klienta (AlwaysSendClientClaims)</label>
                            </div>

                            <div class="form-check form-switch mb-3">
                                <input asp-for="Input.IncludeJwtId" class="form-check-input" type="checkbox" id="includeJwtIdSwitch" />
                                <label class="form-check-label fw-semibold small" for="includeJwtIdSwitch">Dołączaj unikalny JWT ID (IncludeJwtId)</label>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Input.ClientClaimsPrefix" class="form-label fw-semibold small">Prefiks Claims Klienta (ClientClaimsPrefix)</label>
                                <input asp-for="Input.ClientClaimsPrefix" class="form-control font-monospace" />
                                <div class="form-text">Domyślnie: <code>client_</code>. Ustaw puste, jeśli nie chcesz prefiksu.</div>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Input.PairWiseSubjectSalt" class="form-label fw-semibold small">Sól PairWise Subject (PairWiseSubjectSalt)</label>
                                <input asp-for="Input.PairWiseSubjectSalt" class="form-control font-monospace" placeholder="opcjonalna sól dla anonimizacji sub" />
                            </div>
                        </div>
                    </div>

                    <!-- Statyczne Claims Klienta -->
                    <div class="card border mb-4">
                        <div class="card-header bg-light d-flex justify-content-between align-items-center py-2">
                            <span class="fw-semibold small"><i class="bi bi-tags me-1 text-primary"></i>Statyczne Claims Klienta (Client Claims)</span>
                            <span class="badge bg-secondary-subtle text-secondary small">Ilość: @Model.Input.ExistingClaims.Count</span>
                        </div>
                        <div class="card-body p-3">
                            <p class="text-muted small mb-3">
                                Claims dodane do klienta będą automatycznie dołączane do wydawanych tokenów (np. <code>client_id</code>, role aplikacyjne, typ konta M2M).
                            </p>

                            @if (Model.Input.ExistingClaims.Any())
                            {
                                <div class="table-responsive mb-3">
                                    <table class="table table-sm table-bordered align-middle mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th style="width: 40%;">Typ (Claim Type)</th>
                                                <th>Wartość (Value)</th>
                                                <th style="width: 12%;" class="text-center text-danger">Usuń</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @for (int i = 0; i < Model.Input.ExistingClaims.Count; i++)
                                            {
                                                <tr>
                                                    <td>
                                                        <input type="hidden" asp-for="Input.ExistingClaims[i].Id" />
                                                        <span class="font-monospace fw-semibold text-primary">@Model.Input.ExistingClaims[i].Type</span>
                                                    </td>
                                                    <td>
                                                        <span class="font-monospace">@Model.Input.ExistingClaims[i].Value</span>
                                                    </td>
                                                    <td class="text-center bg-danger-subtle">
                                                        <div class="form-check form-check-inline m-0">
                                                            <input asp-for="Input.ExistingClaims[i].Delete" class="form-check-input border-danger" type="checkbox" />
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="text-muted small fst-italic mb-3">Brak zdefiniowanych statycznych claims dla tego klienta.</div>
                            }

                            <!-- Dodaj nowy claim -->
                            <div class="p-3 bg-light rounded border">
                                <h6 class="fw-bold small mb-2 text-primary"><i class="bi bi-plus-circle me-1"></i>Dodaj Nowy Claim Klienta</h6>
                                <div class="row g-2">
                                    <div class="col-md-6">
                                        <label asp-for="Input.NewClaimType" class="form-label small fw-semibold">Typ (np. role, client_department)</label>
                                        <input asp-for="Input.NewClaimType" class="form-control form-control-sm font-monospace" placeholder="np. role lub tier" />
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="Input.NewClaimValue" class="form-label small fw-semibold">Wartość (Value)</label>
                                        <input asp-for="Input.NewClaimValue" class="form-control form-control-sm font-monospace" placeholder="np. microservice-admin lub gold" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="p-3 bg-light rounded-3 border">
                        <h6 class="fw-bold small text-uppercase text-muted mb-3">Dostawcy Zewnętrzni &amp; Device Flow</h6>
                        
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Input.IdentityProviderRestrictions" class="form-label small fw-semibold">Ograniczenie Dostawców IdP (IdentityProviderRestrictions)</label>
                                <input asp-for="Input.IdentityProviderRestrictions" class="form-control font-monospace" placeholder="Google Microsoft (rozdzielone spacją)" />
                                <div class="form-text">Pozostaw puste, aby umożliwić logowanie przez wszystkich skonfigurowanych dostawców.</div>
                            </div>

                            <div class="col-md-3">
                                <label asp-for="Input.UserSsoLifetime" class="form-label small fw-semibold">User SSO Lifetime (sekundy)</label>
                                <input asp-for="Input.UserSsoLifetime" type="number" class="form-control font-monospace" placeholder="Puste = domyślne" />
                            </div>

                            <div class="col-md-3">
                                <label asp-for="Input.DeviceCodeLifetime" class="form-label small fw-semibold">Device Code Lifetime (sekundy)</label>
                                <input asp-for="Input.DeviceCodeLifetime" type="number" class="form-control font-monospace" />
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <div class="card-footer bg-light p-3 d-flex justify-content-between align-items-center">
            <a asp-page="Index" class="btn btn-outline-secondary">
                Anuluj
            </a>
            <button type="submit" class="btn btn-primary px-4 fw-semibold">
                <i class="bi bi-check-lg me-1"></i> Zapisz Zmiany w Bazie Danych
            </button>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // --- Zarządzanie Dozwolonymi Typami Przepływów (AllowedGrantTypes) ---
        let selectedGrants = new Set();

        function initGrantTypes() {
            const inputVal = document.getElementById('grantTypesInput').value;
            if (inputVal && inputVal.trim()) {
                const parts = inputVal.trim().split(/\s+/);
                parts.forEach(p => {
                    if (p.trim()) selectedGrants.add(p.trim());
                });
            }
            renderGrantTypes();
        }

        function renderGrantTypes() {
            const container = document.getElementById('selectedGrantsContainer');
            const hiddenInput = document.getElementById('grantTypesInput');
            const countBadge = document.getElementById('grantCountBadge');

            const grantsArray = Array.from(selectedGrants);
            hiddenInput.value = grantsArray.join(' ');
            if (countBadge) countBadge.textContent = 'Wybrano: ' + grantsArray.length;

            if (grantsArray.length === 0) {
                container.innerHTML = '<span class="text-danger small fst-italic"><i class="bi bi-exclamation-triangle-fill me-1"></i>Nie wybrano żadnego typu przepływu. Kliknij poniżej na kafelki, aby dodać (wymagany minimum 1 typ).</span>';
            } else {
                container.innerHTML = grantsArray.map(grant => `
                    <span class="badge bg-primary text-white fs-6 p-2 px-3 d-inline-flex align-items-center gap-2 shadow-sm rounded-pill">
                        <i class="bi bi-check-circle-fill"></i>
                        <span class="font-monospace">${grant}</span>
                        <button type="button" class="btn btn-sm btn-link text-white p-0 text-decoration-none ms-1 opacity-75 hover-opacity-100" 
                                onclick="removeGrantType('${grant}')" title="Usuń ${grant}">
                            <i class="bi bi-x-circle-fill fs-5"></i>
                        </button>
                    </span>
                `).join('');
            }

            // Aktualizacja wyglądu dostępnych standardowych kafelków
            const knownGrants = [
                'authorization_code',
                'client_credentials',
                'urn:ietf:params:oauth:grant-type:device_code',
                'refresh_token',
                'hybrid',
                'implicit',
                'password'
            ];

            knownGrants.forEach(grant => {
                const safeId = grant.replace(/:/g, '_').replace(/\./g, '_');
                const card = document.getElementById('grant-card-' + safeId);
                const status = document.getElementById('grant-status-' + safeId);
                if (card && status) {
                    if (selectedGrants.has(grant)) {
                        card.classList.add('border-success', 'bg-success-subtle');
                        card.classList.remove('border', 'bg-white');
                        status.innerHTML = '<span class="badge bg-success px-2 py-1"><i class="bi bi-check2 me-1"></i>Aktywny</span>';
                    } else {
                        card.classList.remove('border-success', 'bg-success-subtle');
                        card.classList.add('border');
                        status.innerHTML = '<span class="badge bg-light text-secondary border px-2 py-1"><i class="bi bi-plus-lg me-1"></i>Dodaj</span>';
                    }
                }
            });
        }

        function toggleGrantType(grant) {
            if (selectedGrants.has(grant)) {
                selectedGrants.delete(grant);
            } else {
                selectedGrants.add(grant);
            }
            renderGrantTypes();
        }

        function removeGrantType(grant) {
            selectedGrants.delete(grant);
            renderGrantTypes();
        }

        function addCustomGrant() {
            const input = document.getElementById('customGrantInput');
            if (input && input.value.trim()) {
                const parts = input.value.trim().split(/\s+/);
                parts.forEach(p => {
                    if (p.trim()) selectedGrants.add(p.trim());
                });
                input.value = '';
                renderGrantTypes();
            }
        }

        function applyPreset(presetGrants) {
            selectedGrants.clear();
            presetGrants.forEach(g => selectedGrants.add(g));
            renderGrantTypes();
        }

        // --- Zarządzanie Zakresami (Scopes) ---
        const availableScopes = [
            @foreach (var s in Model.AvailableScopes)
            {
                <text>{ name: "@Html.Raw(s.Name)", displayName: "@Html.Raw(s.DisplayName.Replace("\"", "\\\""))", description: "@Html.Raw((s.Description ?? "").Replace("\"", "\\\""))", type: "@Html.Raw(s.Type)" },</text>
            }
        ];

        let selectedScopes = new Set();

        function initSelectedScopes() {
            const rawVal = document.getElementById('scopesInput').value;
            if (rawVal) {
                rawVal.trim().split(/\s+/).forEach(s => {
                    if (s) selectedScopes.add(s);
                });
            }
            syncScopesUI();
        }

        function syncScopesUI() {
            const scopesArr = Array.from(selectedScopes);
            const hiddenInput = document.getElementById('scopesInput');
            if (hiddenInput) {
                hiddenInput.value = scopesArr.join(' ');
            }

            const badge = document.getElementById('scopeCountBadge');
            if (badge) {
                badge.innerText = `${scopesArr.length} wybranych`;
            }

            // Render tagów
            const tagsContainer = document.getElementById('selectedScopesTags');
            if (tagsContainer) {
                if (scopesArr.length === 0) {
                    tagsContainer.innerHTML = '<span class="text-muted small fst-italic">Brak wybranych zakresów. Zaznacz poniżej lub wpisz w wyszukiwarce.</span>';
                } else {
                    tagsContainer.innerHTML = scopesArr.map(s => `
                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary-subtle d-inline-flex align-items-center py-1 px-2 font-monospace">
                            ${escapeHtml(s)}
                            <button type="button" class="btn-close btn-close-sm ms-2" style="font-size: 0.65rem;" onclick="removeScope('${escapeHtml(s)}')"></button>
                        </span>
                    `).join('');
                }
            }

            // Zaktualizuj stan checkboxów i podświetlenie wierszy tabeli
            document.querySelectorAll('#scopesTable tbody tr.scope-row').forEach(row => {
                const scopeName = row.getAttribute('data-scope-name');
                const isSelected = selectedScopes.has(scopeName);
                const chk = row.querySelector('.scope-checkbox');
                const btn = row.querySelector('.toggle-scope-btn');

                if (chk) chk.checked = isSelected;

                if (isSelected) {
                    row.classList.add('table-primary');
                    if (btn) {
                        btn.className = 'btn btn-sm btn-danger py-0 px-2 toggle-scope-btn';
                        btn.innerHTML = '<i class="bi bi-dash-lg"></i>';
                        btn.title = 'Usuń zakres';
                    }
                } else {
                    row.classList.remove('table-primary');
                    if (btn) {
                        btn.className = 'btn btn-sm btn-outline-primary py-0 px-2 toggle-scope-btn';
                        btn.innerHTML = '<i class="bi bi-plus-lg"></i>';
                        btn.title = 'Dodaj zakres';
                    }
                }
            });
        }

        function addScope(scope) {
            if (!scope) return;
            const cleaned = scope.trim();
            if (cleaned) {
                selectedScopes.add(cleaned);
                syncScopesUI();
            }
        }

        function removeScope(scope) {
            if (!scope) return;
            selectedScopes.delete(scope.trim());
            syncScopesUI();
        }

        function toggleScope(scope) {
            if (selectedScopes.has(scope)) {
                removeScope(scope);
            } else {
                addScope(scope);
            }
        }

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.innerText = text;
            return div.innerHTML;
        }

        // Inicjalizacja po załadowaniu drzewa DOM
        document.addEventListener('DOMContentLoaded', function() {
            initGrantTypes();
            initSelectedScopes();

            // Kliknięcie wiersza w tabeli przełącza zakres
            document.querySelectorAll('#scopesTable tbody tr.scope-row').forEach(row => {
                row.addEventListener('click', function(e) {
                    const scopeName = this.getAttribute('data-scope-name');
                    toggleScope(scopeName);
                });
            });

            // Checkbox zmiana
            document.querySelectorAll('#scopesTable .scope-checkbox').forEach(chk => {
                chk.addEventListener('change', function(e) {
                    toggleScope(this.value);
                });
            });

            // Button zmiana
            document.querySelectorAll('#scopesTable .toggle-scope-btn').forEach(btn => {
                btn.addEventListener('click', function(e) {
                    e.stopPropagation();
                    const scope = this.getAttribute('data-scope');
                    toggleScope(scope);
                });
            });

            // Filtrowanie w tabeli
            const filterInput = document.getElementById('filterScopesTableInput');
            if (filterInput) {
                filterInput.addEventListener('input', function() {
                    const term = this.value.toLowerCase().trim();
                    document.querySelectorAll('#scopesTable tbody tr.scope-row').forEach(row => {
                        const name = (row.getAttribute('data-scope-name') || '').toLowerCase();
                        const disp = (row.getAttribute('data-display-name') || '').toLowerCase();
                        const desc = (row.getAttribute('data-description') || '').toLowerCase();
                        if (name.includes(term) || disp.includes(term) || desc.includes(term)) {
                            row.style.display = '';
                        } else {
                            row.style.display = 'none';
                        }
                    });
                });
            }

            // Autocomplete podpowiedzi
            const autoInput = document.getElementById('scopeAutocompleteInput');
            const dropdown = document.getElementById('autocompleteDropdown');

            if (autoInput && dropdown) {
                autoInput.addEventListener('input', function() {
                    const term = this.value.toLowerCase().trim();
                    if (!term) {
                        dropdown.style.display = 'none';
                        dropdown.innerHTML = '';
                        return;
                    }

                    const matches = availableScopes.filter(s =>
                        s.name.toLowerCase().includes(term) ||
                        s.displayName.toLowerCase().includes(term) ||
                        (s.description && s.description.toLowerCase().includes(term))
                    );

                    if (matches.length === 0) {
                        dropdown.innerHTML = `
                            <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-2" onclick="addCustomScope('${escapeHtml(term)}')">
                                <div>
                                    <span class="badge bg-light text-primary border font-monospace me-2">${escapeHtml(term)}</span>
                                    <span class="small text-muted">Dodaj niestandardowy zakres</span>
                                </div>
                                <i class="bi bi-plus-circle text-primary"></i>
                            </div>
                        `;
                        dropdown.style.display = 'block';
                        return;
                    }

                    dropdown.innerHTML = matches.map(s => {
                        const isSelected = selectedScopes.has(s.name);
                        return `
                            <a href="javascript:void(0)" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-2 ${isSelected ? 'active text-white' : ''}" onclick="selectFromAutocomplete('${escapeHtml(s.name)}')">
                                <div>
                                    <span class="badge ${isSelected ? 'bg-light text-dark' : 'bg-light text-primary'} border font-monospace me-2">${escapeHtml(s.name)}</span>
                                    <span class="fw-semibold small">${escapeHtml(s.displayName)}</span>
                                    ${s.description ? `<div class="small opacity-75 text-truncate" style="max-width: 400px;">${escapeHtml(s.description)}</div>` : ''}
                                </div>
                                <span class="badge ${isSelected ? 'bg-white text-primary' : 'bg-secondary-subtle text-secondary'}">${escapeHtml(s.type)}</span>
                            </a>
                        `;
                    }).join('');

                    dropdown.style.display = 'block';
                });

                // Ukrywanie dropdown po kliknięciu poza
                document.addEventListener('click', function(e) {
                    if (!autoInput.contains(e.target) && !dropdown.contains(e.target)) {
                        dropdown.style.display = 'none';
                    }
                });

                // Enter na polu autocomplete
                autoInput.addEventListener('keydown', function(e) {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        const val = this.value.trim();
                        if (val) {
                            addScope(val);
                            this.value = '';
                            dropdown.style.display = 'none';
                        }
                    }
                });
            }
        });

        window.selectFromAutocomplete = function(scope) {
            addScope(scope);
            const autoInput = document.getElementById('scopeAutocompleteInput');
            const dropdown = document.getElementById('autocompleteDropdown');
            if (autoInput) autoInput.value = '';
            if (dropdown) dropdown.style.display = 'none';
        };

        window.addCustomScope = function(scope) {
            addScope(scope);
            const autoInput = document.getElementById('scopeAutocompleteInput');
            const dropdown = document.getElementById('autocompleteDropdown');
            if (autoInput) autoInput.value = '';
            if (dropdown) dropdown.style.display = 'none';
        };
    </script>
}
