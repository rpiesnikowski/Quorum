@page
@model Quorum.Backend.AdminUI.Areas.Admin.Pages.Clients.IndexModel
@{
    ViewData["Title"] = "Klienci OAuth2 / OIDC";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h4 mb-1"><i class="bi bi-laptop me-2 text-info"></i>Klienci OAuth2 / OIDC</h2>
        <p class="text-muted small mb-0">Zarządzaj aplikacjami klienckimi uprawnionymi do autoryzacji w Open.IdentityServer</p>
    </div>
    <a asp-page="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Dodaj Nowego Klienta
    </a>
</div>

<component type="typeof(ClientsGrid)" render-mode="Static" param-Clients="@Model.Clients" />
