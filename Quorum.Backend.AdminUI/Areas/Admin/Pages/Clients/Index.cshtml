@page
@model Quorum.Backend.AdminUI.Areas.Admin.Pages.Clients.IndexModel
@{
    ViewData["Title"] = "Klienci OAuth2 / OIDC";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h4 mb-1"><i class="bi bi-laptop me-2 text-info"></i>Klienci OAuth2 / OIDC</h2>
        <p class="text-muted small mb-0">Zarządzaj aplikacjami klienckimi uprawnionymi do autoryzacji w Open.IdentityServer</p>
    </div>
    <a asp-page="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Dodaj Nowego Klienta
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <QuickGrid Items="@Model.Clients.AsQueryable()" Class="table table-hover align-middle mb-0" ResizableColumns="true">
            <PropertyColumn Property="@(c => c.ClientId)" Title="Client ID" Sortable="true" Class="fw-bold font-monospace text-primary" />
            <PropertyColumn Property="@(c => c.ClientName)" Title="Nazwa Klienta" Sortable="true" />
            <TemplateColumn Title="Typy Przepływów (Grant Types)">
                @foreach (var grant in context.AllowedGrantTypes)
                {
                    <span class="badge bg-secondary-subtle text-secondary me-1">@grant.GrantType</span>
                }
            </TemplateColumn>
            <TemplateColumn Title="Dozwolone Scopes">
                @foreach (var scope in context.AllowedScopes)
                {
                    <span class="badge bg-info-subtle text-info me-1">@scope.Scope</span>
                }
            </TemplateColumn>
            <TemplateColumn Title="PKCE" Sortable="true" SortBy="@(GridSort<Open.IdentityServer.EntityFramework.Entities.Client>.ByAscending(c => c.RequirePkce))">
                @(context.RequirePkce ? "Wymagane" : "Opcjonalne")
            </TemplateColumn>
            <TemplateColumn Title="Status" Sortable="true" SortBy="@(GridSort<Open.IdentityServer.EntityFramework.Entities.Client>.ByAscending(c => c.Enabled))">
                @if (context.Enabled)
                {
                    <span class="badge bg-success-subtle text-success">Aktywny</span>
                }
                else
                {
                    <span class="badge bg-danger-subtle text-danger">Nieaktywny</span>
                }
            </TemplateColumn>
            <TemplateColumn Title="Akcje" Class="text-end text-nowrap">
                <a asp-page="Edit" asp-route-id="@context.Id" class="btn btn-sm btn-outline-primary me-1" title="Edytuj">
                    <i class="bi bi-pencil-square me-1"></i> Edytuj
                </a>
                <form method="post" asp-page-handler="Delete" asp-route-id="@context.Id" class="d-inline" onsubmit="return confirm('Czy na pewno chcesz usunąć klienta @context.ClientId?');">
                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Usuń">
                        <i class="bi bi-trash"></i>
                    </button>
                </form>
            </TemplateColumn>
        </QuickGrid>
        @if (Model.Clients.Count == 0)
        {
            <div class="text-center py-4 text-muted">
                <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                Brak zarejestrowanych klientów w bazie danych.
            </div>
        }
    </div>
</div>
