<!DOCTYPE html>
<html lang="pl" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Open.IdentityServer Manager</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        .sidebar {
            min-height: calc(100vh - 56px);
            box-shadow: inset -1px 0 0 rgba(0, 0, 0, .1);
        }
        .nav-link.active {
            font-weight: 600;
            background-color: rgba(13, 110, 253, 0.1);
            color: #0d6efd !important;
            border-radius: 6px;
        }
    </style>
</head>
<body class="bg-body-tertiary">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top px-3 shadow-sm">
        <a class="navbar-brand fw-bold d-flex align-items-center gap-2" href="/Admin">
            <i class="bi bi-shield-lock-fill text-warning fs-5"></i>
            <span>Open.IdentityServer Admin</span>
            <span class="badge bg-secondary ms-2 small">.NET 10 (RCL NuGet)</span>
        </a>
        <div class="ms-auto d-flex align-items-center gap-3">
            <span class="text-light small d-none d-sm-inline">Zalogowany: <strong>@User.Identity?.Name</strong></span>
            <form method="post" asp-controller="Account" asp-action="Logout" class="m-0">
                <button type="submit" class="btn btn-sm btn-outline-danger">
                    <i class="bi bi-box-arrow-right me-1"></i>Wyloguj
                </button>
            </form>
        </div>
    </nav>

    <div class="container-fluid">
        <div class="row">
            <nav class="col-md-3 col-lg-2 d-md-block bg-body sidebar py-3 px-3">
                <div class="d-flex flex-column gap-1">
                    <div class="text-uppercase text-secondary fw-semibold small px-2 mb-2">Konfiguracja OIDC</div>
                    <a href="/Admin" class="nav-link text-body px-2 py-2 d-flex align-items-center gap-2">
                        <i class="bi bi-speedometer2 text-primary"></i> Pulpit
                    </a>
                    <a href="/Admin/Clients" class="nav-link text-body px-2 py-2 d-flex align-items-center gap-2">
                        <i class="bi bi-laptop text-info"></i> Klienci (Clients)
                    </a>
                    <a href="/Admin/ApiScopes" class="nav-link text-body px-2 py-2 d-flex align-items-center gap-2">
                        <i class="bi bi-key text-warning"></i> Zakresy API (Scopes)
                    </a>
                    <a href="/Admin/IdentityResources" class="nav-link text-body px-2 py-2 d-flex align-items-center gap-2">
                        <i class="bi bi-person-vcard text-success"></i> Zasoby Tożsamości
                    </a>
                    <a href="/Admin/Federations" class="nav-link text-body px-2 py-2 d-flex align-items-center justify-content-between">
                        <span class="d-flex align-items-center gap-2">
                            <i class="bi bi-diagram-3-fill text-warning"></i> Federacje OIDC
                        </span>
                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle small">Dynamic</span>
                    </a>

                    <hr class="my-3" />
                    <div class="text-uppercase text-secondary fw-semibold small px-2 mb-2">Użytkownicy i Sesje</div>
                    <a href="/Admin/Users" class="nav-link text-body px-2 py-2 d-flex align-items-center gap-2">
                        <i class="bi bi-people text-primary"></i> Konta Użytkowników
                    </a>
                    <a href="/Admin/Grants" class="nav-link text-body px-2 py-2 d-flex align-items-center gap-2">
                        <i class="bi bi-ticket-perforated text-danger"></i> Tokeny i Zgody
                    </a>

                    <hr class="my-3" />
                    <div class="p-2 bg-light rounded-3 border small">
                        <div class="fw-semibold text-dark"><i class="bi bi-database me-1 text-primary"></i>Baza danych:</div>
                        <div class="text-muted">Entity Framework Core</div>
                        <div class="badge bg-primary-subtle text-primary mt-1">SQLite / PostgreSQL</div>
                    </div>
                </div>
            </nav>

            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @RenderBody()
            </main>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
