@page
@model Quorum.Backend.AdminUI.Areas.Admin.Pages.Gateway.TestModel
@{
    ViewData["Title"] = "Tester API Gateway - Ewaluacja i Proxy";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold mb-1">
            <i class="bi bi-lightning-charge-fill text-warning me-2"></i>Tester API Gateway &amp; Symulator Proxy
        </h2>
        <p class="text-muted mb-0">
            Wprowadź ścieżkę żądania, metodę HTTP i nagłówki. Silnik Gateway wyliczy pasującą regułę routingu, skonstruuje docelowy URL (Upstream) i opcjonalnie wykona rzeczywiste zapytanie do backendu.
        </p>
    </div>
    <div class="d-flex gap-2">
        <a asp-page="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Lista Tras Gateway
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- Formularz testowy (Parametry Wejściowe) -->
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm rounded-4 sticky-lg-top" style="top: 1rem; z-index: 10;">
            <div class="card-header bg-white border-bottom p-3 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                    <i class="bi bi-send-fill text-primary"></i> Parametry Żądania Wejściowego
                </h5>
                @if (Model.AllRoutes.Any())
                {
                    <div class="dropdown">
                        <button class="btn btn-sm btn-outline-primary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-magic me-1"></i> Wypełnij z trasy
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm" style="max-height: 320px; overflow-y: auto;">
                            <li><h6 class="dropdown-header">Wybierz zarejestrowaną trasę:</h6></li>
                            @foreach (var r in Model.AllRoutes)
                            {
                                <li>
                                    <button type="button" class="dropdown-item small d-flex flex-column py-2" onclick="fillFromRoute('@r.MatchPattern', '@(!string.IsNullOrEmpty(r.AddressBasePath) ? r.AddressBasePath : "/api/sample")', '@r.HttpMethods', '@(r.Headers?.Replace("\r", "")?.Replace("\n", "\\n"))')">
                                        <span class="fw-bold text-dark">@(string.IsNullOrEmpty(r.RouteName) ? r.MatchPattern : r.RouteName)</span>
                                        <span class="text-muted font-monospace" style="font-size: 0.75rem;">@r.MatchPattern &rarr; @r.Scheme://@r.AddressHost:@r.AddressPort</span>
                                    </button>
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>

            <div class="card-body p-3 p-md-4">
                <form method="post" id="gatewayTestForm">
                    <!-- Metoda HTTP i Ścieżka URL -->
                    <div class="mb-3">
                        <label asp-for="Input.RequestUrl" class="form-label fw-semibold text-dark">
                            Ścieżka wejściowa / URL żądania <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <select asp-for="Input.HttpMethod" class="form-select bg-light fw-bold" style="max-width: 120px;" id="httpMethodSelect" onchange="updateMethodColor(this)">
                                <option value="GET">GET</option>
                                <option value="POST">POST</option>
                                <option value="PUT">PUT</option>
                                <option value="DELETE">DELETE</option>
                                <option value="PATCH">PATCH</option>
                                <option value="HEAD">HEAD</option>
                                <option value="OPTIONS">OPTIONS</option>
                            </select>
                            <input type="text" asp-for="Input.RequestUrl" class="form-control font-monospace" placeholder="/api/v1/users/profile?details=true" required id="requestUrlInput" />
                        </div>
                        <span asp-validation-for="Input.RequestUrl" class="text-danger small"></span>
                        <div class="form-text">
                            Możesz podać ścieżkę względną (np. <code>/api/v1/users/42?active=true</code>) lub pełny adres bramki.
                        </div>
                    </div>

                    <!-- Nagłówki HTTP -->
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label asp-for="Input.RawHeaders" class="form-label fw-semibold text-dark mb-0">
                                Nagłówki wejściowe (HTTP Headers)
                            </label>
                            <div class="btn-group btn-group-sm">
                                <button type="button" class="btn btn-outline-secondary py-0 px-2" style="font-size: 0.75rem;" onclick="appendHeader('Authorization', 'Bearer eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9...')">
                                    + Bearer Token
                                </button>
                                <button type="button" class="btn btn-outline-secondary py-0 px-2" style="font-size: 0.75rem;" onclick="appendHeader('Accept', 'application/json')">
                                    + JSON Accept
                                </button>
                            </div>
                        </div>
                        <textarea asp-for="Input.RawHeaders" class="form-control font-monospace small" rows="4" placeholder="Accept: application/json&#10;Authorization: Bearer <token>&#10;X-Custom-Header: value" id="headersTextarea"></textarea>
                        <div class="form-text">Format: <code>Klucz: Wartość</code> w każdej linii lub format JSON.</div>
                    </div>

                    <!-- Ciało żądania (dla POST/PUT/PATCH) -->
                    <div class="mb-3" id="requestBodyContainer">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label asp-for="Input.RequestBody" class="form-label fw-semibold text-dark mb-0">
                                Ciało żądania (Request Body)
                            </label>
                            <select asp-for="Input.ContentType" class="form-select form-select-sm py-0 bg-light" style="width: auto; font-size: 0.8rem;">
                                <option value="application/json">application/json</option>
                                <option value="text/plain">text/plain</option>
                                <option value="application/x-www-form-urlencoded">x-www-form-urlencoded</option>
                                <option value="application/xml">application/xml</option>
                            </select>
                        </div>
                        <textarea asp-for="Input.RequestBody" class="form-control font-monospace small" rows="4" placeholder='{&#10;  "username": "jan.kowalski",&#10;  "email": "jan@example.com"&#10;}' id="bodyTextarea"></textarea>
                    </div>

                    <!-- Opcje wykonania -->
                    <div class="bg-light p-3 rounded-3 mb-3 border">
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" role="switch" asp-for="Input.ExecuteLiveRequest" id="executeLiveSwitch" />
                            <label class="form-check-label fw-semibold text-dark" for="executeLiveSwitch">
                                Wykonaj żądanie HTTP do upstream serwera (Live Proxy)
                            </label>
                            <div class="text-muted small">
                                Jeśli odznaczone, wykonana zostanie wyłącznie symulacja dopasowania reguły (Dry Run).
                            </div>
                        </div>

                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" role="switch" asp-for="Input.IgnoreSslErrors" id="ignoreSslSwitch" />
                            <label class="form-check-label text-dark small" for="ignoreSslSwitch">
                                Ignoruj błędy certyfikatów SSL/TLS (Self-Signed / dev certs)
                            </label>
                        </div>

                        <div class="row align-items-center mt-2">
                            <div class="col-auto">
                                <label asp-for="Input.CustomTimeoutSeconds" class="col-form-label text-muted small">
                                    Limit czasu (Timeout):
                                </label>
                            </div>
                            <div class="col-auto">
                                <div class="input-group input-group-sm" style="max-width: 120px;">
                                    <input type="number" asp-for="Input.CustomTimeoutSeconds" class="form-control" placeholder="30" min="1" max="300" />
                                    <span class="input-group-text">sek.</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Przycisk Uruchomienia Testu -->
                    <button type="submit" class="btn btn-primary btn-lg w-100 shadow-sm d-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-play-circle-fill fs-5"></i>
                        <span>Przetestuj Routing &amp; Wykonaj Żądanie</span>
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Panel Wyników (Ewaluacja Reguły + Odpowiedź HTTP) -->
    <div class="col-lg-7">
        @if (Model.TestResult == null)
        {
            <!-- Stan Początkowy / Brak Testu -->
            <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white h-100 d-flex flex-column justify-content-center align-items-center">
                <div class="rounded-circle bg-primary-subtle text-primary p-4 mb-3 fs-1 d-inline-flex">
                    <i class="bi bi-cpu"></i>
                </div>
                <h4 class="fw-bold text-dark mb-2">Gotowy do testowania reguł Gateway</h4>
                <p class="text-muted mb-4" style="max-width: 500px;">
                    Wprowadź adres i metodę po lewej stronie lub wybierz jedną z zarejestrowanych tras z menu <strong>"Wypełnij z trasy"</strong>, aby sprawdzić silnik routingu.
                </p>
                <div class="d-flex flex-wrap gap-2 justify-content-center">
                    <button type="button" class="btn btn-outline-primary btn-sm" onclick="setQuickSample('/api/v1/users/profile', 'GET')">
                        <i class="bi bi-person me-1"></i> Profil Użytkownika (GET /api/v1/users/profile)
                    </button>
                    <button type="button" class="btn btn-outline-info btn-sm" onclick="setQuickSample('/api/v1/catalog/items', 'GET')">
                        <i class="bi bi-box me-1"></i> Katalog Produktów (GET /api/v1/catalog/items)
                    </button>
                    <button type="button" class="btn btn-outline-success btn-sm" onclick="setQuickSample('/api/v1/orders', 'POST')">
                        <i class="bi bi-cart me-1"></i> Nowe Zamówienie (POST /api/v1/orders)
                    </button>
                </div>
            </div>
        }
        else
        {
            var evalResult = Model.TestResult.Evaluation;
            var execResult = Model.TestResult.Execution;

            <!-- KROK 1: WYNIK EWALUACJI REGUŁY ROUTINGU -->
            <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
                <div class="card-header @(evalResult.IsMatched ? "bg-success text-white" : "bg-danger text-white") p-3 d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi @(evalResult.IsMatched ? "bi-check-circle-fill fs-4" : "bi-x-circle-fill fs-4")"></i>
                        <div>
                            <div class="fw-bold fs-6">KROK 1: Ewaluacja i Wybór Reguły API Gateway</div>
                            <div class="small opacity-75">
                                @(evalResult.IsMatched ? $"Dopasowano regułę #{evalResult.MatchedRoute?.Id} ({evalResult.MatchedRoute?.MatchPattern})" : "Brak pasującej reguły routingu")
                            </div>
                        </div>
                    </div>
                    @if (evalResult.IsMatched && evalResult.MatchedRoute != null)
                    {
                        <span class="badge bg-white text-dark px-3 py-2 fs-6">
                            Priorytet: @evalResult.MatchedRoute.Priority
                        </span>
                    }
                </div>

                <div class="card-body p-4">
                    @if (!evalResult.IsMatched)
                    {
                        <div class="alert alert-danger mb-3">
                            <h6 class="fw-bold mb-1"><i class="bi bi-exclamation-octagon-fill me-2"></i>Żadna reguła API Gateway nie pasuje do tego żądania</h6>
                            <p class="mb-0 small">
                                Przeanalizowano wszystkie zarejestrowane trasy. Żadna aktywna reguła nie spełniła jednocześnie kryteriów wzorca Regex dla ścieżki <code>@evalResult.NormalizedPath</code> oraz metody <code>@Model.TestResult.Request.HttpMethod</code>.
                            </p>
                        </div>
                    }
                    else
                    {
                        var route = evalResult.MatchedRoute!;

                        <!-- Podsumowanie wyliczonej reguły -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <div class="p-3 bg-light rounded-3 border h-100">
                                    <div class="text-muted small text-uppercase fw-semibold mb-1">Wybrana Trasa (Matched Route)</div>
                                    <div class="fw-bold text-dark fs-6">
                                        @(string.IsNullOrEmpty(route.RouteName) ? $"Trasa #{route.Id}" : route.RouteName)
                                    </div>
                                    <div class="font-monospace text-primary small mt-1 text-break">
                                        Regex: <code>@route.MatchPattern</code>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(route.Description))
                                    {
                                        <div class="text-muted small mt-1">@route.Description</div>
                                    }
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-3 bg-light rounded-3 border h-100">
                                    <div class="text-muted small text-uppercase fw-semibold mb-1">Weryfikacja Zabezpieczeń (Auth)</div>
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <span class="@evalResult.AuthStatusBadge px-2 py-1">
                                            <i class="bi @(evalResult.AuthPassed ? "bi-shield-check" : "bi-shield-exclamation") me-1"></i>
                                            @(route.AllowAnonymous ? "AllowAnonymous" : (route.AuthenticationSchemes ?? "Bearer"))
                                        </span>
                                        @if (route.RequiredScope)
                                        {
                                            <span class="badge bg-warning text-dark">Scope: @(route.ScopeName ?? "ApiScope")</span>
                                        }
                                    </div>
                                    <div class="small text-muted">@evalResult.AuthSummary</div>
                                </div>
                            </div>
                        </div>

                        <!-- Wyliczony docelowy adres Upstream URI -->
                        <div class="mb-3">
                            <label class="form-label fw-bold text-dark small text-uppercase mb-1">
                                Wyliczony docelowy adres URL (Calculated Upstream URI):
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-dark text-white font-monospace small">UPSTREAM</span>
                                <input type="text" class="form-control font-monospace fw-bold text-primary bg-light" value="@evalResult.CalculatedUpstreamUrl" readonly id="calculatedUrlField" />
                                <button class="btn btn-outline-secondary" type="button" onclick="copyToClipboard('calculatedUrlField')" title="Kopiuj URL">
                                    <i class="bi bi-clipboard"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Obliczone nagłówki wychodzące do Upstream -->
                        <div class="mb-0">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label class="form-label fw-bold text-dark small text-uppercase mb-0">
                                    Nagłówki przekazywane do backendu (Upstream Headers):
                                </label>
                                <span class="badge bg-secondary-subtle text-secondary">@evalResult.CalculatedHeaders.Count nagłówków</span>
                            </div>
                            <div class="table-responsive border rounded-3 bg-light" style="max-height: 180px;">
                                <table class="table table-sm table-borderless font-monospace mb-0" style="font-size: 0.8rem;">
                                    <tbody>
                                        @foreach (var h in evalResult.CalculatedHeaders)
                                        {
                                            <tr class="border-bottom">
                                                <td class="ps-3 fw-bold text-dark" style="width: 220px;">@h.Key:</td>
                                                <td class="text-secondary text-break pe-3">@h.Value</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }

                    <!-- Ślad decyzyjny silnika routingu (Dlaczego ta reguła?) -->
                    <div class="accordion mt-3" id="evalAccordion">
                        <div class="accordion-item border rounded-3">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed py-2 px-3 small bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#collapseEvalTrail">
                                    <i class="bi bi-list-check me-2 text-primary"></i>
                                    <strong>Szczegółowy ślad decyzyjny algorytmu routingu</strong> (Sprawdzono @evalResult.CandidateEvaluations.Count reguł)
                                </button>
                            </h2>
                            <div id="collapseEvalTrail" class="accordion-collapse collapse" data-bs-parent="#evalAccordion">
                                <div class="accordion-body p-0">
                                    <div class="table-responsive">
                                        <table class="table table-sm table-hover align-middle mb-0 font-monospace" style="font-size: 0.78rem;">
                                            <thead class="table-light">
                                                <tr>
                                                    <th class="ps-3">Priorytet</th>
                                                    <th>ID / Nazwa</th>
                                                    <th>Wzorzec MatchPattern</th>
                                                    <th>Metody</th>
                                                    <th>Regex</th>
                                                    <th>Metoda</th>
                                                    <th>Werdykt Silnika</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var cand in evalResult.CandidateEvaluations)
                                                {
                                                    <tr class="@(cand.IsWinner ? "table-success fw-bold" : "")">
                                                        <td class="ps-3">@cand.Priority</td>
                                                        <td>#@cand.RouteId @cand.RouteName</td>
                                                        <td class="text-break">@cand.MatchPattern</td>
                                                        <td>@cand.AllowedMethods</td>
                                                        <td>
                                                            @if (cand.IsRegexMatch)
                                                            {
                                                                <span class="text-success"><i class="bi bi-check-lg"></i> TAK</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-muted"><i class="bi bi-x-lg"></i> NIE</span>
                                                            }
                                                        </td>
                                                        <td>
                                                            @if (cand.IsMethodMatch)
                                                            {
                                                                <span class="text-success"><i class="bi bi-check-lg"></i> TAK</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-muted"><i class="bi bi-x-lg"></i> NIE</span>
                                                            }
                                                        </td>
                                                        <td>
                                                            @if (cand.IsWinner)
                                                            {
                                                                <span class="badge bg-success">ZWYCIĘZCA</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-muted">@cand.EvaluationStatus</span>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- KROK 2: WYNIK WYKONANIA ŻĄDANIA HTTP DO UPSTREAM -->
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-white border-bottom p-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-arrow-down-left-square-fill text-info fs-4"></i>
                        <div>
                            <h5 class="fw-bold mb-0 text-dark">KROK 2: Odpowiedź z Backend / Upstream</h5>
                            <div class="small text-muted">Rzeczywiste żądanie HTTP wykonane przez mechanizm proxy</div>
                        </div>
                    </div>

                    @if (execResult.Executed)
                    {
                        <div class="d-flex align-items-center gap-2">
                            <!-- Kod statusu HTTP -->
                            @if (execResult.StatusCode.HasValue)
                            {
                                var sc = execResult.StatusCode.Value;
                                string badgeClass = sc >= 200 && sc < 300 ? "bg-success" :
                                                   sc >= 300 && sc < 400 ? "bg-info text-dark" :
                                                   sc >= 400 && sc < 500 ? "bg-warning text-dark" : "bg-danger";

                                <span class="badge @badgeClass fs-6 px-3 py-2 shadow-sm font-monospace">
                                    @sc @execResult.StatusPhrase
                                </span>
                            }

                            <!-- Czas wykonania -->
                            <span class="badge bg-dark-subtle text-dark border font-monospace px-2 py-2">
                                <i class="bi bi-stopwatch me-1"></i>@execResult.ExecutionTimeMs ms
                            </span>
                        </div>
                    }
                </div>

                <div class="card-body p-4">
                    @if (!execResult.Executed)
                    {
                        <div class="alert alert-secondary mb-0 d-flex align-items-center gap-3">
                            <i class="bi bi-info-circle fs-3 text-secondary"></i>
                            <div>
                                <h6 class="fw-bold mb-1">Żądanie HTTP nie zostało wykonane</h6>
                                <p class="mb-0 small">
                                    @(evalResult.IsMatched
                                        ? "Opcja 'Wykonaj żądanie HTTP (Live Proxy)' została wyłączona. Zaprezentowano wyłącznie ewaluację reguły routingu."
                                        : "Żądanie do serwera docelowego nie mogło zostać wykonane, ponieważ żadna reguła API Gateway nie pasuje do podanej ścieżki.")
                                </p>
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- Błąd komunikacji sieciowej (jeśli wystąpił) -->
                        @if (!string.IsNullOrEmpty(execResult.ErrorMessage))
                        {
                            <div class="alert alert-danger mb-4 shadow-sm">
                                <h6 class="fw-bold mb-1 d-flex align-items-center gap-2">
                                    <i class="bi bi-exclamation-triangle-fill"></i>
                                    <span>Błąd komunikacji z Upstream (@execResult.StatusCode @execResult.StatusPhrase)</span>
                                </h6>
                                <p class="mb-2 small">@execResult.ErrorMessage</p>
                                @if (!string.IsNullOrEmpty(execResult.ErrorDetails))
                                {
                                    <details class="small mt-2 font-monospace">
                                        <summary class="text-danger fw-semibold" style="cursor: pointer;">Pokaż szczegóły wyjątku (Stack Trace)</summary>
                                        <pre class="bg-dark text-light p-3 rounded-3 mt-2 overflow-auto" style="max-height: 200px;">@execResult.ErrorDetails</pre>
                                    </details>
                                }
                            </div>
                        }

                        <!-- Nagłówki i metadane odpowiedzi -->
                        <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                            <div class="d-flex align-items-center gap-2 small text-muted font-monospace">
                                <span><strong>Content-Type:</strong> @(execResult.ResponseContentType ?? "brak")</span>
                                @if (execResult.ContentLength.HasValue)
                                {
                                    <span>&bull;</span>
                                    <span><strong>Rozmiar:</strong> @execResult.ContentLength B</span>
                                }
                            </div>
                        </div>

                        <!-- Zakładki dla Ciała odpowiedzi i Nagłówków odpowiedzi -->
                        <ul class="nav nav-tabs mb-3" id="responseTabs" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active fw-semibold" id="body-tab" data-bs-toggle="tab" data-bs-target="#responseBodyTab" type="button" role="tab">
                                    <i class="bi bi-file-earmark-code me-1"></i> Ciało Odpowiedzi (Response Body)
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link fw-semibold" id="headers-tab" data-bs-toggle="tab" data-bs-target="#responseHeadersTab" type="button" role="tab">
                                    <i class="bi bi-list-columns me-1"></i> Nagłówki Odpowiedzi (@execResult.ResponseHeaders.Count)
                                </button>
                            </li>
                        </ul>

                        <div class="tab-content" id="responseTabsContent">
                            <!-- Tab: Ciało odpowiedzi -->
                            <div class="tab-pane fade show active" id="responseBodyTab" role="tabpanel">
                                <div class="position-relative">
                                    <div class="d-flex justify-content-end mb-1">
                                        <button class="btn btn-sm btn-outline-secondary py-0 px-2" style="font-size: 0.75rem;" onclick="copyToClipboard('rawResponseBody')">
                                            <i class="bi bi-clipboard me-1"></i> Kopiuj treść odpowiedzi
                                        </button>
                                    </div>
                                    <pre class="bg-dark text-light p-3 rounded-3 font-monospace small mb-0 overflow-auto border" style="max-height: 400px; min-height: 120px;" id="rawResponseBody">@(string.IsNullOrWhiteSpace(execResult.FormattedResponseBody ?? execResult.ResponseBody) ? "/* [Pusta odpowiedź z serwera] */" : (execResult.FormattedResponseBody ?? execResult.ResponseBody))</pre>
                                </div>
                            </div>

                            <!-- Tab: Nagłówki odpowiedzi -->
                            <div class="tab-pane fade" id="responseHeadersTab" role="tabpanel">
                                @if (execResult.ResponseHeaders.Any())
                                {
                                    <div class="table-responsive border rounded-3 bg-light" style="max-height: 350px;">
                                        <table class="table table-sm table-striped font-monospace mb-0" style="font-size: 0.8rem;">
                                            <thead class="table-dark">
                                                <tr>
                                                    <th class="ps-3" style="width: 260px;">Nagłówek HTTP</th>
                                                    <th class="pe-3">Wartość</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var rh in execResult.ResponseHeaders)
                                                {
                                                    <tr>
                                                        <td class="ps-3 fw-bold text-dark">@rh.Key</td>
                                                        <td class="pe-3 text-secondary text-break">@rh.Value</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                                else
                                {
                                    <div class="text-muted small py-3 text-center">Brak zwróconych nagłówków HTTP.</div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function fillFromRoute(pattern, samplePath, methods, headers) {
            document.getElementById('requestUrlInput').value = samplePath || pattern;
            
            if (methods && methods !== 'ALL') {
                const firstMethod = methods.split(/[,;\s]+/)[0];
                if (firstMethod) {
                    const methodSelect = document.getElementById('httpMethodSelect');
                    methodSelect.value = firstMethod.toUpperCase();
                    updateMethodColor(methodSelect);
                }
            }
            
            if (headers) {
                const unescapedHeaders = headers.replace(/\\n/g, '\n');
                document.getElementById('headersTextarea').value = 'Accept: application/json\n' + unescapedHeaders;
            }
        }

        function setQuickSample(url, method) {
            document.getElementById('requestUrlInput').value = url;
            const methodSelect = document.getElementById('httpMethodSelect');
            methodSelect.value = method;
            updateMethodColor(methodSelect);
        }

        function appendHeader(key, value) {
            const textarea = document.getElementById('headersTextarea');
            const line = key + ': ' + value;
            if (textarea.value.trim().length > 0) {
                textarea.value = textarea.value.trim() + '\n' + line;
            } else {
                textarea.value = line;
            }
        }

        function updateMethodColor(select) {
            const method = select.value;
            const bodyContainer = document.getElementById('requestBodyContainer');
            if (method === 'POST' || method === 'PUT' || method === 'PATCH') {
                bodyContainer.style.display = 'block';
            }
        }

        function copyToClipboard(elementId) {
            const el = document.getElementById(elementId);
            if (!el) return;
            const text = el.tagName === 'INPUT' || el.tagName === 'TEXTAREA' ? el.value : el.innerText;
            navigator.clipboard.writeText(text).then(function() {
                alert('Skopiowano do schowka!');
            });
        }

        // Inicjalizacja przy załadowaniu strony
        document.addEventListener('DOMContentLoaded', function() {
            const methodSelect = document.getElementById('httpMethodSelect');
            if (methodSelect) {
                updateMethodColor(methodSelect);
            }
        });
    </script>
}
