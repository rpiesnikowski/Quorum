@page
@model Quorum.Backend.AdminUI.Areas.Admin.Pages.Gateway.ScopesModel
@{
    ViewData["Title"] = "Mapowanie Tras i Zakresów API (Route - Scope Mappings)";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-page="Index">API Gateway</a></li>
                <li class="breadcrumb-item active">Mapowanie Zakresów (Scopes)</li>
            </ol>
        </nav>
        <h2 class="fw-bold mb-1">
            <i class="bi bi-diagram-3-fill text-warning me-2"></i>Mapowanie Tras i Zakresów API
        </h2>
        <p class="text-muted mb-0">
            Zarządzaj relacjami wiele-do-wielu (Many-to-Many) pomiędzy regułami routingu API Gateway a wymaganymi zakresami uprawnień (API Scopes &amp; Identity Resources).
        </p>
    </div>
    <div class="d-flex gap-2">
        <a asp-page="Index" class="btn btn-outline-secondary shadow-sm">
            <i class="bi bi-arrow-left me-1"></i> Lista Tras Gateway
        </a>
        <a asp-page="Test" class="btn btn-outline-warning text-dark shadow-sm">
            <i class="bi bi-lightning-charge-fill me-1 text-warning"></i> Tester Gateway
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Zamknij"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Zamknij"></button>
    </div>
}

<!-- Kafelki ze Statystykami -->
<div class="row g-3 mb-4">
    <div class="col-md-3 col-sm-6">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body d-flex align-items-center">
                <div class="rounded-3 bg-warning-subtle text-warning p-3 me-3 fs-4">
                    <i class="bi bi-link-45deg"></i>
                </div>
                <div>
                    <div class="text-muted small">Aktywne Powiązania (M:N)</div>
                    <div class="fs-4 fw-bold text-dark">@Model.TotalMappingsCount</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body d-flex align-items-center">
                <div class="rounded-3 bg-primary-subtle text-primary p-3 me-3 fs-4">
                    <i class="bi bi-shield-lock-fill"></i>
                </div>
                <div>
                    <div class="text-muted small">Trasy z Zakresami</div>
                    <div class="fs-4 fw-bold text-dark">@Model.RoutesWithScopesCount <span class="text-muted fs-6 fw-normal">/ @Model.AllRoutes.Count</span></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body d-flex align-items-center">
                <div class="rounded-3 bg-info-subtle text-info p-3 me-3 fs-4">
                    <i class="bi bi-key-fill"></i>
                </div>
                <div>
                    <div class="text-muted small">Katalog Zakresów OIDC</div>
                    <div class="fs-4 fw-bold text-dark">@Model.AvailableScopesCount</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body d-flex align-items-center">
                <div class="rounded-3 bg-secondary-subtle text-secondary p-3 me-3 fs-4">
                    <i class="bi bi-unlock-fill"></i>
                </div>
                <div>
                    <div class="text-muted small">Trasy bez Zakresów</div>
                    <div class="fs-4 fw-bold text-dark">@Model.UnmappedRoutesCount</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Lewa Kolumna: Formularz Przypisywania Zakresu do Trasy -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 sticky-top" style="top: 80px; z-index: 10;">
            <div class="card-header bg-white py-3 border-0">
                <h5 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                    <i class="bi bi-plus-circle-fill text-primary"></i> Przypisz Zakres do Trasy
                </h5>
            </div>
            <div class="card-body pt-0">
                <form method="post" asp-page-handler="AddScope" id="addScopeForm">
                    <div class="mb-3">
                        <label asp-for="AddInput.RouteId" class="form-label fw-semibold small"></label>
                        <select asp-for="AddInput.RouteId" class="form-select" id="routeSelect">
                            <option value="">-- Wybierz trasę docelową --</option>
                            @foreach (var r in Model.AllRoutes)
                            {
                                var assignedCount = r.Scopes.Count;
                                <option value="@r.Id" selected="@(Model.RouteId == r.Id)">
                                    @r.MatchPattern @(!string.IsNullOrEmpty(r.RouteName) ? $"({r.RouteName})" : "") [@assignedCount scope(s)]
                                </option>
                            }
                        </select>
                        <span asp-validation-for="AddInput.RouteId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="AddInput.SelectedScope" class="form-label fw-semibold small"></label>
                        <select asp-for="AddInput.SelectedScope" class="form-select" id="scopeCatalogSelect">
                            <option value="">-- Wybierz z katalogu OIDC --</option>
                            @foreach (var s in Model.AvailableScopes)
                            {
                                <option value="@s.Name">@s.Name (@s.Type) - @s.DisplayName</option>
                            }
                        </select>
                        <div class="form-text small">Wybierz zakres zdefiniowany w IdentityServer / OpenIddict.</div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="AddInput.CustomScope" class="form-label fw-semibold small"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light font-monospace text-muted small"><i class="bi bi-pencil"></i></span>
                            <input asp-for="AddInput.CustomScope" class="form-control font-monospace" placeholder="np. custom.read, orders.write" id="customScopeInput" />
                        </div>
                        <div class="form-text small">Wpisz niestandardowy zakres, jeśli nie znajduje się w katalogu powyżej.</div>
                        <span asp-validation-for="AddInput.CustomScope" class="text-danger small"></span>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary shadow-sm">
                            <i class="bi bi-link-45deg me-1"></i> Dodaj Powiązanie
                        </button>
                    </div>
                </form>

                <hr class="my-4" />

                <!-- Szybkie Narzędzie Filtrowania -->
                <div>
                    <h6 class="fw-bold small text-dark mb-2">
                        <i class="bi bi-funnel-fill text-secondary me-1"></i> Filtrowanie Powiązań
                    </h6>
                    <form method="get" class="d-flex flex-column gap-2">
                        <div>
                            <select name="routeId" class="form-select form-select-sm" onchange="this.form.submit()">
                                <option value="">Wszystkie trasy (@Model.AllRoutes.Count)</option>
                                @foreach (var r in Model.AllRoutes)
                                {
                                    <option value="@r.Id" selected="@(Model.RouteId == r.Id)">
                                        @r.MatchPattern @(!string.IsNullOrEmpty(r.RouteName) ? $"({r.RouteName})" : "")
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="input-group input-group-sm">
                            <input type="text" name="searchTerm" class="form-control" placeholder="Szukaj wzorca, scope..." value="@Model.SearchTerm" />
                            <button type="submit" class="btn btn-secondary">
                                <i class="bi bi-search"></i>
                            </button>
                            @if (Model.RouteId.HasValue || !string.IsNullOrWhiteSpace(Model.SearchTerm))
                            {
                                <a asp-page="Scopes" class="btn btn-outline-danger" title="Wyczyść filtry">
                                    <i class="bi bi-x-lg"></i>
                                </a>
                            }
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Prawa Kolumna: Tabela Powiązań Many-to-Many & Przegląd Tras -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <h5 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                        <i class="bi bi-table text-primary"></i> Powiązania Many-to-Many (Gateway Route &harr; Scope)
                    </h5>
                    <div class="text-muted small">Znaleziono: <strong>@Model.Mappings.Count</strong> powiązań</div>
                </div>
                @if (Model.RouteId.HasValue || !string.IsNullOrWhiteSpace(Model.SearchTerm))
                {
                    <span class="badge bg-primary-subtle text-primary border">
                        Aktywne filtry
                    </span>
                }
            </div>

            <div class="table-responsive">
                <QuickGrid Items="@Model.Mappings.AsQueryable()" Class="table table-hover align-middle mb-0" ResizableColumns="true">
                    <PropertyColumn Property="@(m => m.MappingId)" Title="#" Sortable="true" Class="text-center font-monospace text-muted small" />
                    <TemplateColumn Title="Trasa Gateway (MatchPattern)" Sortable="true" SortBy="@(GridSort<Quorum.Backend.AdminUI.Areas.Admin.Pages.Gateway.RouteScopeMappingViewModel>.ByAscending(m => m.MatchPattern))">
                        <div class="d-flex align-items-center gap-2">
                            <a asp-page="Edit" asp-route-id="@context.RouteId" class="fw-bold text-dark font-monospace text-decoration-none">
                                @context.MatchPattern
                            </a>
                            @if (!context.RouteIsEnabled)
                            {
                                <span class="badge bg-secondary-subtle text-secondary" style="font-size: 0.65rem;">Wyłączona</span>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(context.RouteName))
                        {
                            <div class="text-muted small text-truncate" style="max-width: 250px;">
                                <i class="bi bi-tag me-1"></i>@context.RouteName
                            </div>
                        }
                        <div class="small">
                            <span class="badge bg-light text-muted border font-monospace" style="font-size: 0.7rem;">@context.HttpMethods</span>
                        </div>
                    </TemplateColumn>
                    <TemplateColumn Title="Wymagany Zakres (Scope)" Sortable="true" SortBy="@(GridSort<Quorum.Backend.AdminUI.Areas.Admin.Pages.Gateway.RouteScopeMappingViewModel>.ByAscending(m => m.Scope))">
                        <div class="d-flex align-items-center gap-1">
                            <span class="badge bg-warning text-dark font-monospace px-2 py-1 fs-6">
                                <i class="bi bi-key-fill me-1"></i>@context.Scope
                            </span>
                        </div>
                        @if (!string.IsNullOrEmpty(context.ScopeDisplayName) && context.ScopeDisplayName != context.Scope)
                        {
                            <div class="text-muted small mt-1">@context.ScopeDisplayName</div>
                        }
                    </TemplateColumn>
                    <TemplateColumn Title="Typ Scope">
                        <span class="badge bg-info-subtle text-info border">
                            @context.ScopeType
                        </span>
                    </TemplateColumn>
                    <TemplateColumn Title="Serwer Upstream">
                        <span class="font-monospace small text-muted text-truncate d-inline-block" style="max-width: 180px;" title="@context.Upstream">
                            @context.Upstream
                        </span>
                    </TemplateColumn>
                    <TemplateColumn Title="Akcje" Class="text-end">
                        <div class="btn-group btn-group-sm">
                            <a asp-page="Edit" asp-route-id="@context.RouteId" class="btn btn-outline-secondary" title="Edytuj trasę">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form method="post" asp-page-handler="DeleteMapping" asp-route-mappingId="@context.MappingId" asp-route-routeId="@Model.RouteId" asp-route-searchTerm="@Model.SearchTerm" class="d-inline" onsubmit="return confirm('Czy na pewno chcesz usunąć to powiązanie trasy z zakresem?');">
                                <button type="submit" class="btn btn-outline-danger" title="Usuń powiązanie">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </div>
                    </TemplateColumn>
                </QuickGrid>
                @if (!Model.Mappings.Any())
                {
                    <div class="text-center py-5">
                        <div class="text-muted">
                            <i class="bi bi-slash-circle fs-2 d-block mb-2 text-secondary"></i>
                            <span class="fw-semibold">Brak powiązań spełniających kryteria wyszukiwania.</span>
                            <p class="small text-muted mt-1">Użyj formularza po lewej stronie, aby przypisać zakresy do wybranej trasy.</p>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Zbiorcze Zestawienie Tras (Route Aggregate Overview Card) -->
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h5 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                    <i class="bi bi-collection-fill text-info"></i> Przegląd Wszystkich Tras i Przypisanych Zakresów
                </h5>
                <span class="badge bg-light text-dark border">@Model.AllRoutes.Count tras w systemie</span>
            </div>
            <div class="card-body pt-0">
                <div class="table-responsive">
                    <QuickGrid Items="@Model.AllRoutes.AsQueryable()" Class="table table-hover align-middle mb-0" style="font-size: 0.88rem;" ResizableColumns="true">
                        <TemplateColumn Title="Trasa (MatchPattern)" Sortable="true" SortBy="@(GridSort<Quorum.Backend.EntityFramework.Models.GatewayRoute>.ByAscending(r => r.MatchPattern))">
                            <div class="fw-bold font-monospace text-dark">@context.MatchPattern</div>
                            @if (!string.IsNullOrEmpty(context.RouteName))
                            {
                                <div class="text-muted small">@context.RouteName</div>
                            }
                        </TemplateColumn>
                        <TemplateColumn Title="Przypisane Zakresy (Scopes)">
                            @{
                                var routeScopes = context.Scopes != null && context.Scopes.Any()
                                    ? context.Scopes.Select(s => s.Scope).ToList()
                                    : (context.ScopeName ?? "").Split(new[] { ' ', ',', ';' }, StringSplitOptions.RemoveEmptyEntries).ToList();
                            }
                            @if (routeScopes.Any())
                            {
                                <div class="d-flex flex-wrap gap-1 align-items-center">
                                    @foreach (var sc in routeScopes)
                                    {
                                        <span class="badge bg-warning-subtle text-dark border border-warning-subtle font-monospace d-inline-flex align-items-center gap-1">
                                            <i class="bi bi-key-fill text-warning"></i> @sc
                                            <form method="post" asp-page-handler="RemoveScope" asp-route-routeId="@context.Id" asp-route-scopeName="@sc" class="d-inline" onsubmit="return confirm('Usunąć zakres @sc z tej trasy?');">
                                                <button type="submit" class="btn-close btn-close-sm ms-1" style="font-size: 0.6rem;" aria-label="Usuń"></button>
                                            </form>
                                        </span>
                                    }
                                </div>
                            }
                            else
                            {
                                <span class="text-muted small fst-italic">Brak przypisanych zakresów (otwarta / publiczna)</span>
                            }
                        </TemplateColumn>
                        <TemplateColumn Title="Wymagaj" Class="text-center" Sortable="true" SortBy="@(GridSort<Quorum.Backend.EntityFramework.Models.GatewayRoute>.ByAscending(r => r.RequiredScope))">
                            @if (context.RequiredScope)
                            {
                                <span class="badge bg-success-subtle text-success border">TAK</span>
                            }
                            else
                            {
                                <span class="badge bg-light text-muted border">NIE</span>
                            }
                        </TemplateColumn>
                        <TemplateColumn Title="Zarządzaj" Class="text-end">
                            @{
                                var currentScopes = context.Scopes != null && context.Scopes.Any()
                                    ? context.Scopes.Select(s => s.Scope).ToList()
                                    : (context.ScopeName ?? "").Split(new[] { ' ', ',', ';' }, StringSplitOptions.RemoveEmptyEntries).ToList();
                            }
                            <div class="btn-group btn-group-sm">
                                <button type="button" class="btn btn-outline-primary" onclick="openQuickAssignModal(@context.Id, '@Html.Raw(context.MatchPattern.Replace("'", "\\'"))', '@Html.Raw(string.Join(" ", currentScopes))')" title="Edytuj zakresy trasy">
                                    <i class="bi bi-sliders"></i> Edytuj
                                </button>
                                <a asp-page="Edit" asp-route-id="@context.Id" class="btn btn-outline-secondary" title="Konfiguracja trasy">
                                    <i class="bi bi-gear"></i>
                                </a>
                            </div>
                        </TemplateColumn>
                    </QuickGrid>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Szybkiej Edycji Zakresów Trasy -->
<div class="modal fade" id="quickAssignModal" tabindex="-1" aria-labelledby="quickAssignModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <form method="post" asp-page-handler="SyncRouteScopes" id="quickAssignForm">
                <input type="hidden" name="routeId" id="modalRouteId" />
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold" id="quickAssignModalLabel">
                        <i class="bi bi-sliders text-primary me-2"></i>Edytuj Zakresy Trasy
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zamknij"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label text-muted small mb-1">Trasa API Gateway</label>
                        <div class="form-control font-monospace bg-light" id="modalRoutePattern" readonly></div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Przypisane Zakresy (oddzielone spacją)</label>
                        <textarea name="scopes" id="modalScopesInput" class="form-control font-monospace" rows="3" placeholder="np. api1 openid profile orders.read"></textarea>
                        <div class="form-text small">Wpisz lub zmodyfikuj listę zakresów dla wybranej trasy.</div>
                    </div>

                    <div class="mb-2">
                        <label class="form-label text-muted small mb-1">Szybki wybór z katalogu</label>
                        <div class="d-flex flex-wrap gap-1" style="max-height: 120px; overflow-y: auto;">
                            @foreach (var s in Model.AvailableScopes)
                            {
                                <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 font-monospace" style="font-size: 0.75rem;" onclick="appendScopeToModal('@s.Name')">
                                    + @s.Name
                                </button>
                            }
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Anuluj</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg me-1"></i> Zapisz Zakresy
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function openQuickAssignModal(routeId, pattern, scopes) {
            document.getElementById('modalRouteId').value = routeId;
            document.getElementById('modalRoutePattern').innerText = pattern;
            document.getElementById('modalScopesInput').value = scopes;

            const modal = new bootstrap.Modal(document.getElementById('quickAssignModal'));
            modal.show();
        }

        function appendScopeToModal(scopeName) {
            const input = document.getElementById('modalScopesInput');
            if (!input) return;

            let current = input.value.trim();
            const scopes = current ? current.split(/\s+/) : [];
            if (!scopes.includes(scopeName)) {
                scopes.push(scopeName);
                input.value = scopes.join(' ');
            }
        }

        // Kiedy użytkownik wybierze z katalogu w lewym formularzu, wyczyść pole customScope
        document.getElementById('scopeCatalogSelect')?.addEventListener('change', function() {
            if (this.value) {
                const customInput = document.getElementById('customScopeInput');
                if (customInput) customInput.value = '';
            }
        });

        // Kiedy użytkownik pisze w polu customScope, zresetuj select katalogu
        document.getElementById('customScopeInput')?.addEventListener('input', function() {
            if (this.value) {
                const select = document.getElementById('scopeCatalogSelect');
                if (select) select.value = '';
            }
        });
    </script>
}
