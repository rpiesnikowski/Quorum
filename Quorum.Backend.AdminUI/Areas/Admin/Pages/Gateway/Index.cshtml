@page
@model Quorum.Backend.AdminUI.Areas.Admin.Pages.Gateway.IndexModel
@{
    ViewData["Title"] = "API Gateway - Reguły Routingu i Proxy";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold mb-1">
            <i class="bi bi-router-fill text-info me-2"></i>API Gateway &amp; Reverse Proxy
        </h2>
        <p class="text-muted mb-0">
            Zarządzaj trasami routingu, wzorcami Regex, parametrami URI docelowych serwisów, weryfikacją JWT/Scope oraz klasycznym proxy dla zewnętrznych mikroserwisów.
        </p>
    </div>
    <div class="d-flex gap-2">
        <a asp-page="Test" class="btn btn-outline-warning text-dark shadow-sm">
            <i class="bi bi-lightning-charge-fill me-1 text-warning"></i> Tester Gateway (Proxy)
        </a>
        <a asp-page="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Dodaj Nową Trasę (Route)
        </a>
    </div>
</div>

<!-- Kafelki ze statystykami -->
<div class="row g-3 mb-4">
    <div class="col-md-3 col-sm-6">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body d-flex align-items-center">
                <div class="rounded-3 bg-primary-subtle text-primary p-3 me-3 fs-4">
                    <i class="bi bi-diagram-2"></i>
                </div>
                <div>
                    <div class="text-muted small">Wszystkie Trasy</div>
                    <div class="fs-4 fw-bold text-dark">@Model.TotalRoutes</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body d-flex align-items-center">
                <div class="rounded-3 bg-success-subtle text-success p-3 me-3 fs-4">
                    <i class="bi bi-check-circle-fill"></i>
                </div>
                <div>
                    <div class="text-muted small">Aktywne (Enabled)</div>
                    <div class="fs-4 fw-bold text-dark">@Model.EnabledRoutes</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body d-flex align-items-center">
                <div class="rounded-3 bg-warning-subtle text-warning p-3 me-3 fs-4">
                    <i class="bi bi-shield-lock-fill"></i>
                </div>
                <div>
                    <div class="text-muted small">Chronione JWT / Scope</div>
                    <div class="fs-4 fw-bold text-dark">@Model.ProtectedRoutes</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body d-flex align-items-center">
                <div class="rounded-3 bg-secondary-subtle text-secondary p-3 me-3 fs-4">
                    <i class="bi bi-unlock-fill"></i>
                </div>
                <div>
                    <div class="text-muted small">Anonimowe (Classic Proxy)</div>
                    <div class="fs-4 fw-bold text-dark">@Model.AnonymousRoutes</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Karta z Filtrami i Szukajką -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" asp-for="SearchTerm" class="form-control bg-light border-start-0" placeholder="Szukaj po wzorcu Regex, hoście, ścieżce, nazwie lub scope..." />
                </div>
            </div>
            <div class="col-md-2">
                <select asp-for="StatusFilter" class="form-select bg-light">
                    <option value="">Wszystkie statusy</option>
                    <option value="enabled">Tylko Aktywne</option>
                    <option value="disabled">Tylko Wyłączone</option>
                </select>
            </div>
            <div class="col-md-2">
                <select asp-for="AuthFilter" class="form-select bg-light">
                    <option value="">Wszystkie typy auth</option>
                    <option value="protected">Wymaga Auth / Scope</option>
                    <option value="anonymous">Anonimowe (Public)</option>
                </select>
            </div>
            <div class="col-md-1">
                <select asp-for="PageSize" class="form-select bg-light" title="Liczba pozycji na stronę">
                    <option value="5">5 / str.</option>
                    <option value="10">10 / str.</option>
                    <option value="25">25 / str.</option>
                    <option value="50">50 / str.</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-funnel-fill me-1"></i> Filtruj</button>
                <a asp-page="Index" class="btn btn-outline-secondary" title="Wyczyść filtry"><i class="bi bi-x-circle"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Tabela Grid Tras API Gateway -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4" style="width: 80px;">Priorytet</th>
                        <th>Wzorzec Dopasowania (MatchPattern Regex)</th>
                        <th>Cel Proxy (Host, Port, BasePath)</th>
                        <th>Zabezpieczenia &amp; Scope</th>
                        <th>Metody HTTP</th>
                        <th>Status</th>
                        <th class="text-end pe-4" style="width: 140px;">Akcje</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.RoutesResult.Items.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-router fs-1 d-block mb-2 text-secondary"></i>
                                Nie znaleziono tras API Gateway spełniających kryteria.<br />
                                <a asp-page="Create" class="btn btn-sm btn-outline-primary mt-2">Dodaj pierwszą regułę routingu</a>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var route in Model.RoutesResult.Items)
                        {
                            <tr class="@(!route.IsEnabled ? "opacity-75 bg-light" : "")">
                                <td class="ps-4">
                                    <span class="badge bg-secondary-subtle text-secondary border font-monospace px-2 py-1 fs-6">
                                        @route.Priority
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge bg-dark-subtle text-dark border font-monospace px-2 py-1 text-break">
                                            @route.MatchPattern
                                        </span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(route.RouteName))
                                    {
                                        <div class="fw-bold text-dark mt-1 small">@route.RouteName</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(route.Description))
                                    {
                                        <div class="text-muted small text-truncate" style="max-width: 320px;">@route.Description</div>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-1 font-monospace small">
                                        <span class="badge @(route.Scheme == "https" ? "bg-success-subtle text-success" : "bg-warning-subtle text-warning") border">
                                            @route.Scheme.ToUpper()
                                        </span>
                                        <strong>@route.AddressHost</strong><span class="text-muted">:@route.AddressPort</span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(route.AddressBasePath))
                                    {
                                        <div class="text-muted small font-monospace">
                                            <i class="bi bi-arrow-return-right text-secondary me-1"></i>Path: <code>@route.AddressBasePath</code>
                                        </div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(route.AddressQueryString))
                                    {
                                        <div class="text-muted small font-monospace">
                                            <i class="bi bi-question-circle text-secondary me-1"></i>Query: <span class="text-truncate d-inline-block" style="max-width: 200px;">@route.AddressQueryString</span>
                                        </div>
                                    }
                                </td>
                                <td>
                                    @if (route.AllowAnonymous)
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border d-inline-flex align-items-center gap-1">
                                            <i class="bi bi-unlock"></i> AllowAnonymous
                                        </span>
                                    }
                                    else
                                    {
                                        <div class="d-flex flex-column gap-1 align-items-start">
                                            <span class="badge bg-primary-subtle text-primary border d-inline-flex align-items-center gap-1">
                                                <i class="bi bi-shield-check"></i> @(route.AuthenticationSchemes ?? "Bearer")
                                            </span>
                                            @if (route.RequiredScope)
                                            {
                                                var scopesList = route.Scopes != null && route.Scopes.Any() 
                                                    ? route.Scopes.Select(s => s.Scope).ToList()
                                                    : (route.ScopeName ?? "").Split(new[] { ' ', ',', ';' }, StringSplitOptions.RemoveEmptyEntries).ToList();

                                                if (scopesList.Any())
                                                {
                                                    <div class="d-flex flex-wrap gap-1 mt-1" style="max-width: 220px;">
                                                        @foreach (var sc in scopesList)
                                                        {
                                                            <span class="badge bg-warning-subtle text-warning border font-monospace" style="font-size: 0.72rem;" title="Wymagany Scope: @sc">
                                                                <i class="bi bi-key-fill"></i> @sc
                                                            </span>
                                                        }
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning-subtle text-warning border d-inline-flex align-items-center gap-1">
                                                        <i class="bi bi-key-fill"></i> Scope: Wymagany
                                                    </span>
                                                }
                                            }
                                        </div>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex flex-wrap gap-1">
                                        @if (route.HttpMethods == "ALL" || string.IsNullOrWhiteSpace(route.HttpMethods))
                                        {
                                            <span class="badge bg-light text-dark border">ALL</span>
                                        }
                                        else
                                        {
                                            @foreach (var m in route.HttpMethods.Split(',', StringSplitOptions.RemoveEmptyEntries))
                                            {
                                                <span class="badge bg-info-subtle text-info border small font-monospace">@m.Trim()</span>
                                            }
                                        }
                                    </div>
                                    <div class="text-muted" style="font-size: 0.75rem;">Timeout: @(route.TimeoutSeconds)s</div>
                                </td>
                                <td>
                                    <form method="post" asp-page-handler="ToggleStatus" asp-route-id="@route.Id" class="d-inline">
                                        <input type="hidden" name="SearchTerm" value="@Model.SearchTerm" />
                                        <input type="hidden" name="StatusFilter" value="@Model.StatusFilter" />
                                        <input type="hidden" name="AuthFilter" value="@Model.AuthFilter" />
                                        <input type="hidden" name="PageIndex" value="@Model.PageIndex" />
                                        <input type="hidden" name="PageSize" value="@Model.PageSize" />
                                        <button type="submit" class="btn btn-sm p-0 border-0 bg-transparent text-decoration-none" title="Kliknij, aby przełączyć status">
                                            @if (route.IsEnabled)
                                            {
                                                <span class="badge bg-success d-inline-flex align-items-center gap-1">
                                                    <i class="bi bi-check-circle-fill"></i> Aktywny
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary d-inline-flex align-items-center gap-1">
                                                    <i class="bi bi-pause-circle"></i> Wyłączony
                                                </span>
                                            }
                                        </button>
                                    </form>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-page="Test" asp-route-routeId="@route.Id" class="btn btn-outline-warning text-dark" title="Przetestuj tę trasę w Testerze">
                                            <i class="bi bi-play-circle"></i>
                                        </a>
                                        <a asp-page="Edit" asp-route-id="@route.Id" class="btn btn-outline-secondary" title="Edytuj trasę">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form method="post" asp-page-handler="Delete" asp-route-id="@route.Id" class="d-inline" onsubmit="return confirm('Czy na pewno chcesz usunąć tę regułę routingu API Gateway?');">
                                            <input type="hidden" name="SearchTerm" value="@Model.SearchTerm" />
                                            <input type="hidden" name="StatusFilter" value="@Model.StatusFilter" />
                                            <input type="hidden" name="AuthFilter" value="@Model.AuthFilter" />
                                            <input type="hidden" name="PageIndex" value="@Model.PageIndex" />
                                            <input type="hidden" name="PageSize" value="@Model.PageSize" />
                                            <button type="submit" class="btn btn-outline-danger" title="Usuń trasę">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Pasek Paginacji -->
        @if (Model.RoutesResult.TotalPages > 1)
        {
            <div class="d-flex justify-content-between align-items-center p-3 border-top flex-wrap gap-2">
                <div class="text-muted small">
                    Pokazano <strong>@(((Model.PageIndex - 1) * Model.PageSize) + 1)</strong> - <strong>@(Math.Min(Model.PageIndex * Model.PageSize, Model.RoutesResult.TotalCount))</strong> z <strong>@Model.RoutesResult.TotalCount</strong> tras
                </div>
                <nav aria-label="Nawigacja stron">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(!Model.RoutesResult.HasPreviousPage ? "disabled" : "")">
                            <a class="page-link" asp-page="Index"
                               asp-route-PageIndex="@(Model.PageIndex - 1)"
                               asp-route-PageSize="@Model.PageSize"
                               asp-route-SearchTerm="@Model.SearchTerm"
                               asp-route-StatusFilter="@Model.StatusFilter"
                               asp-route-AuthFilter="@Model.AuthFilter">Poprzednia</a>
                        </li>

                        @for (int i = 1; i <= Model.RoutesResult.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                                <a class="page-link" asp-page="Index"
                                   asp-route-PageIndex="@i"
                                   asp-route-PageSize="@Model.PageSize"
                                   asp-route-SearchTerm="@Model.SearchTerm"
                                   asp-route-StatusFilter="@Model.StatusFilter"
                                   asp-route-AuthFilter="@Model.AuthFilter">@i</a>
                            </li>
                        }

                        <li class="page-item @(!Model.RoutesResult.HasNextPage ? "disabled" : "")">
                            <a class="page-link" asp-page="Index"
                               asp-route-PageIndex="@(Model.PageIndex + 1)"
                               asp-route-PageSize="@Model.PageSize"
                               asp-route-SearchTerm="@Model.SearchTerm"
                               asp-route-StatusFilter="@Model.StatusFilter"
                               asp-route-AuthFilter="@Model.AuthFilter">Następna</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

<!-- Informacje o architekturze API Gateway -->
<div class="row g-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-white">
            <div class="card-body">
                <h5 class="fw-bold text-dark d-flex align-items-center gap-2">
                    <i class="bi bi-shield-check text-primary"></i> Walidacja Uwierzytelniania &amp; Uprawnień
                </h5>
                <p class="text-muted small">
                    Bramka API Gateway pozwala na centralne zabezpieczenie zasobów w oparciu o standardy OpenID Connect / OAuth2:
                </p>
                <ul class="list-unstyled small text-muted mb-0">
                    <li class="mb-2"><i class="bi bi-check2-circle text-success me-2"></i><strong>AllowAnonymous:</strong> Wycofuje wymóg tokenu JWT dla klasycznego Reverse Proxy (np. katalog produktów, publiczne health-checki).</li>
                    <li class="mb-2"><i class="bi bi-check2-circle text-success me-2"></i><strong>Weryfikacja Scope:</strong> Powiązanie z tabelą <code>ApiScopes</code> gwarantuje, że tylko tokeny zawierające wymagany zakres uzyskają dostęp.</li>
                    <li><i class="bi bi-check2-circle text-success me-2"></i><strong>Schematy uwierzytelniania:</strong> Możliwość wskazania konkretnego mechanizmu (np. <code>Bearer</code>, <code>Cookies</code>, federacje OIDC).</li>
                </ul>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-white">
            <div class="card-body">
                <h5 class="fw-bold text-dark d-flex align-items-center gap-2">
                    <i class="bi bi-arrow-left-right text-info"></i> Segmenty URI &amp; Zaawansowany Routing
                </h5>
                <p class="text-muted small">
                    Każda reguła pozwala na precyzyjną dekompozycję i transformację docelowego adresu URL (Upstream):
                </p>
                <ul class="list-unstyled small text-muted mb-0">
                    <li class="mb-2"><i class="bi bi-code-slash text-primary me-2"></i><strong>MatchPattern:</strong> Wyrażenia regularne Regex (np. <code>^/api/v1/users/.*</code>).</li>
                    <li class="mb-2"><i class="bi bi-hdd-network text-primary me-2"></i><strong>Docelowy Host &amp; Port:</strong> Pełna izolacja adresów wewnętrznej sieci mikroserwisów (np. <code>orders-service:8080</code>).</li>
                    <li><i class="bi bi-send text-primary me-2"></i><strong>Nagłówki &amp; X-Forwarded:</strong> Automatyczne przekazywanie lub nadpisywanie nagłówków HTTP (JSON/Dictionary).</li>
                </ul>
            </div>
        </div>
    </div>
</div>
