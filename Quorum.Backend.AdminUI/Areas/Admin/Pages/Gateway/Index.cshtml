@page
@model Quorum.Backend.AdminUI.Areas.Admin.Pages.Gateway.IndexModel
@{
    ViewData["Title"] = "API Gateway - Reguły Routingu i Proxy";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold mb-1">
            <i class="bi bi-router-fill text-info me-2"></i>API Gateway &amp; Reverse Proxy
        </h2>
        <p class="text-muted mb-0">
            Zarządzaj trasami routingu, wzorcami Regex, parametrami URI docelowych serwisów, weryfikacją JWT/Scope oraz klasycznym proxy dla zewnętrznych mikroserwisów.
        </p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-page="Scopes" class="btn btn-outline-warning text-dark shadow-sm">
            <i class="bi bi-diagram-3-fill me-1 text-warning"></i> Mapowanie Zakresów (Scopes)
        </a>
        <a asp-page="Test" class="btn btn-outline-info text-dark shadow-sm">
            <i class="bi bi-lightning-charge-fill me-1 text-warning"></i> Tester Gateway (Proxy)
        </a>
        <a asp-page="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Dodaj Nową Trasę (Route)
        </a>
    </div>
</div>

<!-- Kafelki ze statystykami -->
<div class="row g-3 mb-4">
    <div class="col-md-3 col-sm-6">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body d-flex align-items-center">
                <div class="rounded-3 bg-primary-subtle text-primary p-3 me-3 fs-4">
                    <i class="bi bi-diagram-2"></i>
                </div>
                <div>
                    <div class="text-muted small">Wszystkie Trasy</div>
                    <div class="fs-4 fw-bold text-dark">@Model.TotalRoutes</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body d-flex align-items-center">
                <div class="rounded-3 bg-success-subtle text-success p-3 me-3 fs-4">
                    <i class="bi bi-check-circle-fill"></i>
                </div>
                <div>
                    <div class="text-muted small">Aktywne (Enabled)</div>
                    <div class="fs-4 fw-bold text-dark">@Model.EnabledRoutes</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body d-flex align-items-center">
                <div class="rounded-3 bg-warning-subtle text-warning p-3 me-3 fs-4">
                    <i class="bi bi-shield-lock-fill"></i>
                </div>
                <div>
                    <div class="text-muted small">Chronione JWT / Scope</div>
                    <div class="fs-4 fw-bold text-dark">@Model.ProtectedRoutes</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body d-flex align-items-center">
                <div class="rounded-3 bg-secondary-subtle text-secondary p-3 me-3 fs-4">
                    <i class="bi bi-unlock-fill"></i>
                </div>
                <div>
                    <div class="text-muted small">Anonimowe (Classic Proxy)</div>
                    <div class="fs-4 fw-bold text-dark">@Model.AnonymousRoutes</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Karta z Filtrami i Szukajką -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" asp-for="SearchTerm" class="form-control bg-light border-start-0" placeholder="Szukaj po wzorcu Regex, hoście, ścieżce, nazwie lub scope..." />
                </div>
            </div>
            <div class="col-md-2">
                <select asp-for="StatusFilter" class="form-select bg-light">
                    <option value="">Wszystkie statusy</option>
                    <option value="enabled">Tylko Aktywne</option>
                    <option value="disabled">Tylko Wyłączone</option>
                </select>
            </div>
            <div class="col-md-2">
                <select asp-for="AuthFilter" class="form-select bg-light">
                    <option value="">Wszystkie typy auth</option>
                    <option value="protected">Wymaga Auth / Scope</option>
                    <option value="anonymous">Anonimowe (Public)</option>
                </select>
            </div>
            <div class="col-md-1">
                <select asp-for="PageSize" class="form-select bg-light" title="Liczba pozycji na stronę">
                    <option value="5">5 / str.</option>
                    <option value="10">10 / str.</option>
                    <option value="25">25 / str.</option>
                    <option value="50">50 / str.</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-funnel-fill me-1"></i> Filtruj</button>
                <a asp-page="Index" class="btn btn-outline-secondary" title="Wyczyść filtry"><i class="bi bi-x-circle"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Tabela Grid Tras API Gateway -->
<component type="typeof(GatewayRoutesGrid)" render-mode="Static" 
           param-Routes="@Model.RoutesResult.Items" 
           param-SearchTerm="@Model.SearchTerm" 
           param-StatusFilter="@Model.StatusFilter" 
           param-AuthFilter="@Model.AuthFilter" 
           param-PageIndex="@Model.PageIndex" 
           param-PageSize="@Model.PageSize" />

<!-- Pasek Paginacji -->
@if (Model.RoutesResult.TotalPages > 1)
{
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="d-flex justify-content-between align-items-center p-3 border-top flex-wrap gap-2">
            <div class="text-muted small">
                Pokazano <strong>@(((Model.PageIndex - 1) * Model.PageSize) + 1)</strong> - <strong>@(Math.Min(Model.PageIndex * Model.PageSize, Model.RoutesResult.TotalCount))</strong> z <strong>@Model.RoutesResult.TotalCount</strong> tras
            </div>
            <nav aria-label="Nawigacja stron">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(!Model.RoutesResult.HasPreviousPage ? "disabled" : "")">
                        <a class="page-link" asp-page="Index"
                           asp-route-PageIndex="@(Model.PageIndex - 1)"
                           asp-route-PageSize="@Model.PageSize"
                           asp-route-SearchTerm="@Model.SearchTerm"
                           asp-route-StatusFilter="@Model.StatusFilter"
                           asp-route-AuthFilter="@Model.AuthFilter">Poprzednia</a>
                    </li>

                    @for (int i = 1; i <= Model.RoutesResult.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                            <a class="page-link" asp-page="Index"
                               asp-route-PageIndex="@i"
                               asp-route-PageSize="@Model.PageSize"
                               asp-route-SearchTerm="@Model.SearchTerm"
                               asp-route-StatusFilter="@Model.StatusFilter"
                               asp-route-AuthFilter="@Model.AuthFilter">@i</a>
                        </li>
                    }

                    <li class="page-item @(!Model.RoutesResult.HasNextPage ? "disabled" : "")">
                        <a class="page-link" asp-page="Index"
                           asp-route-PageIndex="@(Model.PageIndex + 1)"
                           asp-route-PageSize="@Model.PageSize"
                           asp-route-SearchTerm="@Model.SearchTerm"
                           asp-route-StatusFilter="@Model.StatusFilter"
                           asp-route-AuthFilter="@Model.AuthFilter">Następna</a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>
}

<!-- Informacje o architekturze API Gateway -->
<div class="row g-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-white">
            <div class="card-body">
                <h5 class="fw-bold text-dark d-flex align-items-center gap-2">
                    <i class="bi bi-shield-check text-primary"></i> Walidacja Uwierzytelniania &amp; Uprawnień
                </h5>
                <p class="text-muted small">
                    Bramka API Gateway pozwala na centralne zabezpieczenie zasobów w oparciu o standardy OpenID Connect / OAuth2:
                </p>
                <ul class="list-unstyled small text-muted mb-0">
                    <li class="mb-2"><i class="bi bi-check2-circle text-success me-2"></i><strong>AllowAnonymous:</strong> Wycofuje wymóg tokenu JWT dla klasycznego Reverse Proxy (np. katalog produktów, publiczne health-checki).</li>
                    <li class="mb-2"><i class="bi bi-check2-circle text-success me-2"></i><strong>Weryfikacja Scope:</strong> Powiązanie z tabelą <code>ApiScopes</code> gwarantuje, że tylko tokeny zawierające wymagany zakres uzyskają dostęp.</li>
                    <li><i class="bi bi-check2-circle text-success me-2"></i><strong>Schematy uwierzytelniania:</strong> Możliwość wskazania konkretnego mechanizmu (np. <code>Bearer</code>, <code>Cookies</code>, federacje OIDC).</li>
                </ul>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-white">
            <div class="card-body">
                <h5 class="fw-bold text-dark d-flex align-items-center gap-2">
                    <i class="bi bi-arrow-left-right text-info"></i> Segmenty URI &amp; Zaawansowany Routing
                </h5>
                <p class="text-muted small">
                    Każda reguła pozwala na precyzyjną dekompozycję i transformację docelowego adresu URL (Upstream):
                </p>
                <ul class="list-unstyled small text-muted mb-0">
                    <li class="mb-2"><i class="bi bi-code-slash text-primary me-2"></i><strong>MatchPattern:</strong> Wyrażenia regularne Regex (np. <code>^/api/v1/users/.*</code>).</li>
                    <li class="mb-2"><i class="bi bi-hdd-network text-primary me-2"></i><strong>Docelowy Host &amp; Port:</strong> Pełna izolacja adresów wewnętrznej sieci mikroserwisów (np. <code>orders-service:8080</code>).</li>
                    <li><i class="bi bi-send text-primary me-2"></i><strong>Nagłówki &amp; X-Forwarded:</strong> Automatyczne przekazywanie lub nadpisywanie nagłówków HTTP (JSON/Dictionary).</li>
                </ul>
            </div>
        </div>
    </div>
</div>
