@page "/Admin/Account/Login"
@model Quorum.Backend.AdminUI.Areas.Admin.Pages.Account.LoginModel
@{
    Layout = null;
    ViewData["Title"] = "Panel Administratora - Logowanie";
}
<!DOCTYPE html>
<html lang="pl" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body {
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0f172a 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .admin-card {
            background: #ffffff;
            border-radius: 1rem;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3), 0 8px 10px -6px rgba(0, 0, 0, 0.3);
        }
        .brand-header {
            background: #0f172a;
            color: #ffffff;
            border-top-left-radius: 1rem;
            border-top-right-radius: 1rem;
            padding: 2rem 1.5rem 1.5rem 1.5rem;
            text-align: center;
        }
    </style>
</head>
<body>
    <div class="container py-4">
        <div class="row justify-content-center">
            <div class="col-11 col-sm-9 col-md-7 col-lg-5 col-xl-4">
                <div class="admin-card border-0 overflow-hidden">
                    <div class="brand-header">
                        <div class="d-inline-flex p-3 rounded-circle bg-warning bg-opacity-10 text-warning mb-2 border border-warning border-opacity-25">
                            <i class="bi bi-shield-lock-fill fs-1"></i>
                        </div>
                        <h4 class="fw-bold mb-1">Quorum Admin Console</h4>
                        <div class="d-flex justify-content-center align-items-center gap-2">
                            <span class="badge bg-danger text-uppercase fw-semibold" style="letter-spacing: 0.5px;">Dostęp tylko dla Administratorów</span>
                        </div>
                    </div>

                    <div class="p-4 p-md-4">
                        <div class="alert alert-secondary py-2 px-3 small d-flex align-items-center gap-2 mb-3 border-0 bg-light">
                            <i class="bi bi-info-circle text-primary"></i>
                            <span>Dedykowana, odizolowana sesja administracyjna (<code>Quorum.Admin.Auth</code>).</span>
                        </div>

                        <form method="post" asp-page="/Account/Login" asp-route-returnUrl="@Model.ReturnUrl">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                            <div class="mb-3">
                                <label asp-for="Input.Username" class="form-label fw-semibold small text-secondary"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted"><i class="bi bi-person-badge"></i></span>
                                    <input asp-for="Input.Username" class="form-control" placeholder="admin" autofocus />
                                </div>
                                <span asp-validation-for="Input.Username" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Input.Password" class="form-label fw-semibold small text-secondary"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted"><i class="bi bi-key"></i></span>
                                    <input asp-for="Input.Password" class="form-control" placeholder="••••••••" />
                                </div>
                                <span asp-validation-for="Input.Password" class="text-danger small"></span>
                            </div>

                            <div class="form-check mb-4">
                                <input asp-for="Input.RememberMe" class="form-check-input" id="adminRememberMe" />
                                <label class="form-check-label small text-secondary" for="adminRememberMe">
                                    Zapamiętaj sesję administratora
                                </label>
                            </div>

                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-dark py-2 fw-semibold shadow-sm d-flex align-items-center justify-content-center gap-2">
                                    <i class="bi bi-box-arrow-in-right"></i>
                                    <span>Zaloguj do Panelu Admina</span>
                                </button>
                            </div>
                        </form>

                        <div class="mt-4 pt-3 border-top text-center">
                            <a href="/Account/Login" class="text-decoration-none small text-muted d-inline-flex align-items-center gap-1">
                                <i class="bi bi-arrow-left"></i> Przejdź do logowania użytkowników (Quorum Backend)
                            </a>
                        </div>
                    </div>
                </div>

                <div class="text-center mt-3 text-white-50 small">
                    Domyślne konto: <code class="text-warning">admin</code> / <code class="text-warning">Pass123$</code>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
