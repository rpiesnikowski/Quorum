@page "/Admin/Account/Logout"
@model Quorum.Backend.AdminUI.Areas.Admin.Pages.Account.LogoutModel
@{
    Layout = null;
    ViewData["Title"] = "Wylogowanie Administratora";
}
<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content="1;url=/Admin/Account/Login" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
</head>
<body class="bg-dark text-white d-flex align-items-center justify-content-center" style="min-height: 100vh;">
    <div class="text-center">
        <div class="spinner-border text-warning mb-3" role="status"></div>
        <h4>Wylogowywanie z panelu administratora...</h4>
        <p class="text-muted small">Za chwilę nastąpi przekierowanie do okna logowania.</p>
        <a href="/Admin/Account/Login" class="btn btn-outline-light btn-sm mt-2">Przejdź teraz</a>
    </div>
</body>
</html>
