@page
@model Quorum.Backend.AdminUI.Areas.Admin.Pages.Federations.CreateModel
@{
    ViewData["Title"] = "Dodaj Dostawcę OIDC";
}

<div class="mb-4">
    <a asp-page="Index" class="btn btn-sm btn-outline-secondary mb-2">
        <i class="bi bi-arrow-left me-1"></i> Wróć do listy federacji
    </a>
    <h2 class="fw-bold mb-1">
        <i class="bi bi-plus-circle text-primary me-2"></i>Dodaj Nowego Dostawcę OIDC
    </h2>
    <p class="text-muted">
        Wybierz gotowy szablon dostawcy (Entra ID, Azure B2C, Google) lub skonfiguruj dowolnego zgodnego providera OpenID Connect.
    </p>
</div>

<!-- Szablony Presetów -->
<div class="card border-0 shadow-sm rounded-4 mb-4 bg-light">
    <div class="card-body p-4">
        <h6 class="fw-bold text-dark mb-3">Szybkie Szablony Konfiguracji:</h6>
        <div class="row g-3">
            <div class="col-md-3">
                <a asp-page="Create" asp-route-preset="entra" class="card text-decoration-none border shadow-sm h-100 p-3 bg-white hover-shadow transition">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-3 p-2 text-white bg-primary">
                            <i class="bi bi-microsoft fs-4"></i>
                        </div>
                        <div>
                            <div class="fw-bold text-dark">Microsoft Entra ID</div>
                            <div class="text-muted small">Azure Active Directory</div>
                        </div>
                    </div>
                </a>
            </div>
            <div class="col-md-3">
                <a asp-page="Create" asp-route-preset="azure-b2c" class="card text-decoration-none border shadow-sm h-100 p-3 bg-white hover-shadow transition">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-3 p-2 text-white" style="background-color: #0089D6;">
                            <i class="bi bi-cloud-check-fill fs-4"></i>
                        </div>
                        <div>
                            <div class="fw-bold text-dark">Azure AD B2C</div>
                            <div class="text-muted small">Customer Identity (CIAM)</div>
                        </div>
                    </div>
                </a>
            </div>
            <div class="col-md-3">
                <a asp-page="Create" asp-route-preset="google" class="card text-decoration-none border shadow-sm h-100 p-3 bg-white hover-shadow transition">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-3 p-2 text-white" style="background-color: #4285F4;">
                            <i class="bi bi-google fs-4"></i>
                        </div>
                        <div>
                            <div class="fw-bold text-dark">Google Workspace</div>
                            <div class="text-muted small">Google Accounts OIDC</div>
                        </div>
                    </div>
                </a>
            </div>
            <div class="col-md-3">
                <a asp-page="Create" class="card text-decoration-none border shadow-sm h-100 p-3 bg-white hover-shadow transition">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-3 p-2 text-white bg-secondary">
                            <i class="bi bi-shield-lock-fill fs-4"></i>
                        </div>
                        <div>
                            <div class="fw-bold text-dark">Własny OIDC</div>
                            <div class="text-muted small">Generic OpenID Connect</div>
                        </div>
                    </div>
                </a>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-4 p-md-5">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

            <div class="row g-4">
                <div class="col-md-6">
                    <h5 class="fw-bold text-dark mb-3 border-bottom pb-2">
                        <i class="bi bi-card-heading text-primary me-2"></i>Podstawowe Informacje
                    </h5>

                    <div class="mb-3">
                        <label asp-for="Input.Scheme" class="form-label fw-semibold small">Unikalna Nazwa Schematu (Scheme)</label>
                        <input asp-for="Input.Scheme" class="form-control font-monospace" placeholder="np. entra-id, google-oidc, okta" />
                        <span asp-validation-for="Input.Scheme" class="text-danger small"></span>
                        <div class="form-text small">Wewnętrzny identyfikator schematu w potoku ASP.NET Core Authentication.</div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.DisplayName" class="form-label fw-semibold small">Nazwa Wyświetlana (Display Name)</label>
                        <input asp-for="Input.DisplayName" class="form-control" placeholder="np. Microsoft Entra ID" />
                        <span asp-validation-for="Input.DisplayName" class="text-danger small"></span>
                        <div class="form-text small">Etykieta widoczna na przycisku na ekranie logowania.</div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Authority" class="form-label fw-semibold small">Authority URL (Issuer OIDC)</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-globe"></i></span>
                            <input asp-for="Input.Authority" class="form-control" placeholder="https://login.microsoftonline.com/common/v2.0" />
                        </div>
                        <span asp-validation-for="Input.Authority" class="text-danger small"></span>
                        <div class="form-text small">Adres wystawcy tokenów OIDC zawierający dokument <code>/.well-known/openid-configuration</code>.</div>
                    </div>

                    <div class="row g-2">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Input.IconType" class="form-label fw-semibold small">Ikona Przycisku</label>
                            <select asp-for="Input.IconType" class="form-select">
                                <option value="microsoft">Microsoft / Entra</option>
                                <option value="azure">Azure Cloud / B2C</option>
                                <option value="google">Google</option>
                                <option value="openid">OpenID Connect</option>
                                <option value="generic">Uniwersalna Kłódka</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Input.ButtonColor" class="form-label fw-semibold small">Kolor Przycisku (HEX)</label>
                            <input asp-for="Input.ButtonColor" class="form-control" placeholder="#0078D4" />
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <h5 class="fw-bold text-dark mb-3 border-bottom pb-2">
                        <i class="bi bi-key text-primary me-2"></i>Poświadczenia i Endpointy
                    </h5>

                    <div class="mb-3">
                        <label asp-for="Input.ClientId" class="form-label fw-semibold small">Client ID (Application ID)</label>
                        <input asp-for="Input.ClientId" class="form-control font-monospace" placeholder="Wklej Client ID zewnętrznej aplikacji" />
                        <span asp-validation-for="Input.ClientId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.ClientSecret" class="form-label fw-semibold small">Client Secret (Klucz tajny)</label>
                        <input asp-for="Input.ClientSecret" class="form-control" placeholder="Wprowadź Client Secret (opcjonalny przy PKCE)" />
                        <span asp-validation-for="Input.ClientSecret" class="text-danger small"></span>
                    </div>

                    <div class="row g-2">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Input.CallbackPath" class="form-label fw-semibold small">Callback Path</label>
                            <input asp-for="Input.CallbackPath" class="form-control font-monospace" placeholder="/signin-oidc" />
                            <span asp-validation-for="Input.CallbackPath" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Input.SignedOutCallbackPath" class="form-label fw-semibold small">Signout Callback</label>
                            <input asp-for="Input.SignedOutCallbackPath" class="form-control font-monospace" placeholder="/signout-callback-oidc" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Scope" class="form-label fw-semibold small">Żądane Zakresy (Scopes)</label>
                        <input asp-for="Input.Scope" class="form-control font-monospace" placeholder="openid profile email" />
                        <span asp-validation-for="Input.Scope" class="text-danger small"></span>
                    </div>
                </div>

                <div class="col-12">
                    <h5 class="fw-bold text-dark mb-3 border-bottom pb-2">
                        <i class="bi bi-shield-check text-primary me-2"></i>Zasady Bezpieczeństwa & Auto-Provisioning
                    </h5>

                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="form-check form-switch p-3 bg-light rounded-3 border">
                                <input asp-for="Input.IsEnabled" class="form-check-input ms-0 me-2" type="checkbox" id="checkEnabled" />
                                <label class="form-check-label fw-semibold small" for="checkEnabled">Aktywny (Włączony od razu)</label>
                                <div class="text-muted small">Widoczny na ekranie logowania natychmiast po zapisaniu.</div>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-check form-switch p-3 bg-light rounded-3 border">
                                <input asp-for="Input.UsePkce" class="form-check-input ms-0 me-2" type="checkbox" id="checkPkce" />
                                <label class="form-check-label fw-semibold small" for="checkPkce">Wymuś PKCE</label>
                                <div class="text-muted small">Zabezpieczenie przed atakami przechwycenia kodu autoryzacyjnego.</div>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-check form-switch p-3 bg-light rounded-3 border">
                                <input asp-for="Input.AutoProvisionUsers" class="form-check-input ms-0 me-2" type="checkbox" id="checkAutoProv" />
                                <label class="form-check-label fw-semibold small" for="checkAutoProv">Auto-Provisioning w Identity</label>
                                <div class="text-muted small">Automatyczne tworzenie użytkownika przy 1. logowaniu.</div>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mt-2">
                        <div class="col-md-4">
                            <label asp-for="Input.DefaultRole" class="form-label fw-semibold small">Domyślna Rola Nowego Użytkownika</label>
                            <select asp-for="Input.DefaultRole" class="form-select">
                                <option value="User">User (Standardowy użytkownik)</option>
                                <option value="Manager">Manager</option>
                                <option value="Admin">Admin</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Input.Prompt" class="form-label fw-semibold small">Parametr Prompt (Opcjonalny)</label>
                            <input asp-for="Input.Prompt" class="form-control" placeholder="np. select_account, login, consent" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Input.AdditionalParametersJson" class="form-label fw-semibold small">Dodatkowe Parametry JSON</label>
                            <input asp-for="Input.AdditionalParametersJson" class="form-control font-monospace" placeholder='{"p": "b2c_1_susi"}' />
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                <a asp-page="Index" class="btn btn-outline-secondary px-4">Anuluj</a>
                <button type="submit" class="btn btn-primary px-4 fw-semibold">
                    <i class="bi bi-check-lg me-1"></i> Zapisz i Aktywuj w Locie
                </button>
            </div>
        </form>
    </div>
</div>
