@page
@model Quorum.Backend.AdminUI.Areas.Admin.Pages.Federations.TestModel
@{
    ViewData["Title"] = "Walidacja i Test Dostawcy OIDC";
}

<div class="mb-4">
    <a asp-page="Index" class="btn btn-sm btn-outline-secondary mb-2">
        <i class="bi bi-arrow-left me-1"></i> Wróć do listy federacji
    </a>
    <h2 class="fw-bold mb-1">
        <i class="bi bi-shield-check text-info me-2"></i>Test i Walidacja Metadanych OIDC Discovery
    </h2>
    <p class="text-muted">
        Narzędzie odpytuje endpoint <code>/.well-known/openid-configuration</code> zewnętrznego serwera tożsamości, weryfikuje klucze JWKS, format odpowiedzi oraz zgodność specyfikacji OpenID Connect Core 1.0.
    </p>
</div>

<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-4">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-9">
                <label class="form-label fw-semibold small">Adres Issuer / Authority URL</label>
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-globe"></i></span>
                    <input name="AuthorityUrl" value="@Model.AuthorityUrl" class="form-control font-monospace" placeholder="https://login.microsoftonline.com/common/v2.0 lub https://accounts.google.com" required />
                </div>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100 fw-semibold">
                    <i class="bi bi-arrow-repeat me-1"></i> Weryfikuj Endpoint
                </button>
            </div>
        </form>
    </div>
</div>

@if (Model.ValidationResult != null)
{
    @if (Model.ValidationResult.IsValid)
    {
        <div class="card border-0 shadow-sm rounded-4 border-start border-success border-4 mb-4">
            <div class="card-body p-4">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="bg-success text-white rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                        <i class="bi bi-check2-circle fs-4"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold text-success mb-0">Dokument OpenID Discovery Prawidłowy!</h4>
                        <div class="text-muted small">Serwer tożsamości pomyślnie udostępnia wszystkie wymagane punkty końcowe OIDC.</div>
                    </div>
                </div>

                <div class="row g-3 mt-2">
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3 border">
                            <div class="text-secondary small fw-semibold">Issuer URL:</div>
                            <div class="font-monospace text-dark text-break">@Model.ValidationResult.Issuer</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3 border">
                            <div class="text-secondary small fw-semibold">Authorization Endpoint:</div>
                            <div class="font-monospace text-dark text-break">@Model.ValidationResult.AuthorizationEndpoint</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3 border">
                            <div class="text-secondary small fw-semibold">Token Endpoint:</div>
                            <div class="font-monospace text-dark text-break">@Model.ValidationResult.TokenEndpoint</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3 border">
                            <div class="text-secondary small fw-semibold">JWKS URI (Klucze publiczne):</div>
                            <div class="font-monospace text-dark text-break">@Model.ValidationResult.JwksUri</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3 border">
                            <div class="text-secondary small fw-semibold">UserInfo Endpoint:</div>
                            <div class="font-monospace text-dark text-break">@(Model.ValidationResult.UserInfoEndpoint ?? "Brak (UserInfo opcjonalny)")</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3 border">
                            <div class="text-secondary small fw-semibold">End Session (Logout) Endpoint:</div>
                            <div class="font-monospace text-dark text-break">@(Model.ValidationResult.EndSessionEndpoint ?? "Brak (Single Sign-Out nieobsługiwany)")</div>
                        </div>
                    </div>
                </div>

                <div class="mt-3 pt-3 border-top">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="fw-semibold small mb-2">Obsługiwane Zakresy (Scopes):</div>
                            <div class="d-flex flex-wrap gap-1">
                                @foreach (var scope in Model.ValidationResult.ScopesSupported)
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border">@scope</span>
                                }
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="fw-semibold small mb-2">Obsługiwane Response Types:</div>
                            <div class="d-flex flex-wrap gap-1">
                                @foreach (var rt in Model.ValidationResult.ResponseTypesSupported)
                                {
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">@rt</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 border-start border-danger border-4 mb-4">
            <div class="card-body p-4">
                <div class="d-flex align-items-center gap-3 mb-2">
                    <div class="bg-danger text-white rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                        <i class="bi bi-x-circle fs-4"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold text-danger mb-0">Błąd podczas pobierania dokumentu Discovery</h5>
                        <div class="text-muted small">Nie udało się zweryfikować konfiguracji serwera OIDC pod wskazanym adresem.</div>
                    </div>
                </div>
                <div class="alert alert-danger mb-0 mt-3 font-monospace small">
                    @Model.ValidationResult.ErrorMessage
                </div>
            </div>
        </div>
    }
}
