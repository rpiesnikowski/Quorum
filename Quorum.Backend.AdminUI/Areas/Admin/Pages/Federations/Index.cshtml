@page
@model Quorum.Backend.AdminUI.Areas.Admin.Pages.Federations.IndexModel
@{
    ViewData["Title"] = "Dynamiczne Federacje OIDC";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold mb-1">
            <i class="bi bi-diagram-3-fill text-primary me-2"></i>Dynamiczne Federacje OIDC
        </h2>
        <p class="text-muted mb-0">
            Zarządzaj zewnętrznymi dostawcami tożsamości OpenID Connect (Entra ID, Azure AD B2C, Google itp.) z możliwością dodawania i modyfikacji <strong>w locie, bez restartu aplikacji</strong>.
        </p>
    </div>
    <div class="d-flex gap-2">
        <a asp-page="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Dodaj Dostawcę OIDC
        </a>
    </div>
</div>

<component type="typeof(FederationsGrid)" render-mode="Static" param-Federations="@Model.Federations" />

<div class="row g-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-white">
            <div class="card-body">
                <h5 class="fw-bold text-dark d-flex align-items-center gap-2">
                    <i class="bi bi-lightning-charge-fill text-warning"></i> Architektura Dynamic Schemes (.NET 10)
                </h5>
                <p class="text-muted small">
                    W przeciwieństwie do standardowego <code>services.AddAuthentication().AddOpenIdConnect()</code>, który wymaga restartu procesu przy każdej zmianie, mechanizm <strong>Dynamic OIDC Schemes</strong> wykorzystuje rozszerzony dostawca <code>IAuthenticationSchemeProvider</code> oraz <code>IOptionsMonitorCache&lt;OpenIdConnectOptions&gt;</code>.
                </p>
                <ul class="list-unstyled small text-muted mb-0">
                    <li class="mb-2"><i class="bi bi-check2-circle text-success me-2"></i>Zmiany w bazie danych są automatycznie synchronizowane z pamięcią podręczną serwera.</li>
                    <li class="mb-2"><i class="bi bi-check2-circle text-success me-2"></i>Ekran logowania (<code>/Account/Login</code>) renderuje dynamiczne przyciski SSO w czasie rzeczywistym.</li>
                    <li><i class="bi bi-check2-circle text-success me-2"></i>Auto-provisioning automatycznie rejestruje i wiąże konta w <code>AspNetIdentity</code>.</li>
                </ul>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-white">
            <div class="card-body">
                <h5 class="fw-bold text-dark d-flex align-items-center gap-2">
                    <i class="bi bi-info-circle-fill text-primary"></i> Wymagane URI Przekierowań (Redirect URIs)
                </h5>
                <p class="text-muted small">
                    Podczas rejestracji aplikacji w zewnętrznych dostawcach (Azure Portal / Google Cloud Console) wprowadź poniższe adresy URL:
                </p>
                <div class="bg-light p-2 rounded-3 border small font-monospace mb-2 text-break">
                    https://twoja-domena.pl/signin-oidc-{scheme}
                </div>
                <div class="text-muted small">
                    Np. dla Microsoft Entra ID: <code>https://localhost:5001/signin-oidc-entra</code>
                </div>
            </div>
        </div>
    </div>
</div>
