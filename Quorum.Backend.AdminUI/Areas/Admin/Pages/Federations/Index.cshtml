@page
@model Quorum.Backend.AdminUI.Areas.Admin.Pages.Federations.IndexModel
@{
    ViewData["Title"] = "Dynamiczne Federacje OIDC";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold mb-1">
            <i class="bi bi-diagram-3-fill text-primary me-2"></i>Dynamiczne Federacje OIDC
        </h2>
        <p class="text-muted mb-0">
            Zarządzaj zewnętrznymi dostawcami tożsamości OpenID Connect (Entra ID, Azure AD B2C, Google itp.) z możliwością dodawania i modyfikacji <strong>w locie, bez restartu aplikacji</strong>.
        </p>
    </div>
    <div class="d-flex gap-2">
        <a asp-page="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Dodaj Dostawcę OIDC
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <QuickGrid Items="@Model.Federations.AsQueryable()" Class="table table-hover align-middle mb-0" ResizableColumns="true">
                <TemplateColumn Title="Dostawca / Schemat" Class="ps-4" Sortable="true" SortBy="@(GridSort<Quorum.Backend.EntityFramework.Models.OidcFederationProvider>.ByAscending(f => f.DisplayName))">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-3 p-2 d-flex align-items-center justify-content-center text-white" 
                             style="width: 42px; height: 42px; background-color: @(context.ButtonColor ?? (context.IconType == "microsoft" ? "#0078D4" : context.IconType == "azure" ? "#0089D6" : context.IconType == "google" ? "#4285F4" : "#6c757d"));">
                            @if (context.IconType == "microsoft")
                            {
                                <i class="bi bi-microsoft fs-5"></i>
                            }
                            else if (context.IconType == "azure")
                            {
                                <i class="bi bi-cloud-check-fill fs-5"></i>
                            }
                            else if (context.IconType == "google")
                            {
                                <i class="bi bi-google fs-5"></i>
                            }
                            else
                            {
                                <i class="bi bi-shield-lock-fill fs-5"></i>
                            }
                        </div>
                        <div>
                            <div class="fw-bold text-dark">@context.DisplayName</div>
                            <div class="text-muted small">
                                <code class="text-primary">@context.Scheme</code>
                                @if (context.AutoProvisionUsers)
                                {
                                    <span class="badge bg-light text-secondary border ms-1">Auto-provision: @context.DefaultRole</span>
                                }
                            </div>
                        </div>
                    </div>
                </TemplateColumn>
                <TemplateColumn Title="Issuer (Authority URL)">
                    <div class="text-truncate small" style="max-width: 280px;" title="@context.Authority">
                        <i class="bi bi-link-45deg text-muted me-1"></i>@context.Authority
                    </div>
                    <div class="text-muted small">Callback: <code>@context.CallbackPath</code></div>
                </TemplateColumn>
                <PropertyColumn Property="@(f => f.ClientId)" Title="Client ID" Sortable="true" Class="small text-secondary font-monospace" />
                <TemplateColumn Title="Zabezpieczenia">
                    <div class="d-flex flex-wrap gap-1">
                        @if (context.UsePkce)
                        {
                            <span class="badge bg-success-subtle text-success border border-success-subtle">PKCE</span>
                        }
                        <span class="badge bg-info-subtle text-info border border-info-subtle">@context.ResponseType</span>
                    </div>
                </TemplateColumn>
                <TemplateColumn Title="Status" Sortable="true" SortBy="@(GridSort<Quorum.Backend.EntityFramework.Models.OidcFederationProvider>.ByAscending(f => f.IsEnabled))">
                    @if (context.IsEnabled)
                    {
                        <span class="badge bg-success d-inline-flex align-items-center gap-1">
                            <i class="bi bi-check-circle-fill"></i> Aktywny
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary d-inline-flex align-items-center gap-1">
                            <i class="bi bi-pause-circle"></i> Wyłączony
                        </span>
                    }
                </TemplateColumn>
                <TemplateColumn Title="Akcje" Class="text-end pe-4">
                    <div class="btn-group btn-group-sm">
                        <a asp-page="Test" asp-route-id="@context.Id" class="btn btn-outline-info" title="Testuj Discovery Document">
                            <i class="bi bi-search"></i> Testuj
                        </a>
                        <a asp-page="Edit" asp-route-id="@context.Id" class="btn btn-outline-secondary" title="Edytuj">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <form method="post" asp-page-handler="Toggle" asp-route-id="@context.Id" class="d-inline">
                            <button type="submit" class="btn @(context.IsEnabled ? "btn-outline-warning" : "btn-outline-success")" title="@(context.IsEnabled ? "Deaktywuj" : "Aktywuj")">
                                <i class="bi @(context.IsEnabled ? "bi-eye-slash" : "bi-eye")"></i>
                            </button>
                        </form>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@context.Id" class="d-inline" onsubmit="return confirm('Czy na pewno chcesz usunąć schemat @context.Scheme?');">
                            <button type="submit" class="btn btn-outline-danger" title="Usuń">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </div>
                </TemplateColumn>
            </QuickGrid>
            @if (!Model.Federations.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                    Brak skonfigurowanych dynamicznych dostawców OIDC.<br />
                    <a asp-page="Create" class="btn btn-sm btn-outline-primary mt-2">Dodaj pierwszą federację</a>
                </div>
            }
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-white">
            <div class="card-body">
                <h5 class="fw-bold text-dark d-flex align-items-center gap-2">
                    <i class="bi bi-lightning-charge-fill text-warning"></i> Architektura Dynamic Schemes (.NET 10)
                </h5>
                <p class="text-muted small">
                    W przeciwieństwie do standardowego <code>services.AddAuthentication().AddOpenIdConnect()</code>, który wymaga restartu procesu przy każdej zmianie, mechanizm <strong>Dynamic OIDC Schemes</strong> wykorzystuje rozszerzony dostawca <code>IAuthenticationSchemeProvider</code> oraz <code>IOptionsMonitorCache&lt;OpenIdConnectOptions&gt;</code>.
                </p>
                <ul class="list-unstyled small text-muted mb-0">
                    <li class="mb-2"><i class="bi bi-check2-circle text-success me-2"></i>Zmiany w bazie danych są automatycznie synchronizowane z pamięcią podręczną serwera.</li>
                    <li class="mb-2"><i class="bi bi-check2-circle text-success me-2"></i>Ekran logowania (<code>/Account/Login</code>) renderuje dynamiczne przyciski SSO w czasie rzeczywistym.</li>
                    <li><i class="bi bi-check2-circle text-success me-2"></i>Auto-provisioning automatycznie rejestruje i wiąże konta w <code>AspNetIdentity</code>.</li>
                </ul>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-white">
            <div class="card-body">
                <h5 class="fw-bold text-dark d-flex align-items-center gap-2">
                    <i class="bi bi-info-circle-fill text-primary"></i> Wymagane URI Przekierowań (Redirect URIs)
                </h5>
                <p class="text-muted small">
                    Podczas rejestracji aplikacji w zewnętrznych dostawcach (Azure Portal / Google Cloud Console) wprowadź poniższe adresy URL:
                </p>
                <div class="bg-light p-2 rounded-3 border small font-monospace mb-2 text-break">
                    https://twoja-domena.pl/signin-oidc-{scheme}
                </div>
                <div class="text-muted small">
                    Np. dla Microsoft Entra ID: <code>https://localhost:5001/signin-oidc-entra</code>
                </div>
            </div>
        </div>
    </div>
</div>
