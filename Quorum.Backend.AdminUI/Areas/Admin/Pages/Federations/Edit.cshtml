@page "{id}"
@model Quorum.Backend.AdminUI.Areas.Admin.Pages.Federations.EditModel
@{
    ViewData["Title"] = "Edycja Dostawcy OIDC";
}

<div class="mb-4">
    <a asp-page="Index" class="btn btn-sm btn-outline-secondary mb-2">
        <i class="bi bi-arrow-left me-1"></i> Wróć do listy federacji
    </a>
    <h2 class="fw-bold mb-1">
        <i class="bi bi-pencil-square text-primary me-2"></i>Edycja Dostawcy: @Model.Input.DisplayName
    </h2>
    <p class="text-muted">
        Wszelkie modyfikacje parametrów są natychmiast aplikowane w <code>IAuthenticationSchemeProvider</code> bez konieczności restartu aplikacji.
    </p>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-4 p-md-5">
        <form method="post">
            <input type="hidden" asp-for="Input.Id" />
            <input type="hidden" asp-for="Input.Scheme" />
            <input type="hidden" asp-for="Input.CreatedAt" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

            <div class="row g-4">
                <div class="col-md-6">
                    <h5 class="fw-bold text-dark mb-3 border-bottom pb-2">
                        <i class="bi bi-card-heading text-primary me-2"></i>Podstawowe Informacje
                    </h5>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Identyfikator Schematu (Scheme)</label>
                        <input value="@Model.Input.Scheme" class="form-control font-monospace bg-light" readonly />
                        <div class="form-text small">Nazwa schematu jest stałym kluczem powiązanym z routingiem OIDC.</div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.DisplayName" class="form-label fw-semibold small">Nazwa Wyświetlana</label>
                        <input asp-for="Input.DisplayName" class="form-control" />
                        <span asp-validation-for="Input.DisplayName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Authority" class="form-label fw-semibold small">Authority URL (Issuer OIDC)</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-globe"></i></span>
                            <input asp-for="Input.Authority" class="form-control" />
                        </div>
                        <span asp-validation-for="Input.Authority" class="text-danger small"></span>
                    </div>

                    <div class="row g-2">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Input.IconType" class="form-label fw-semibold small">Ikona Przycisku</label>
                            <select asp-for="Input.IconType" class="form-select">
                                <option value="microsoft">Microsoft / Entra</option>
                                <option value="azure">Azure Cloud / B2C</option>
                                <option value="google">Google</option>
                                <option value="openid">OpenID Connect</option>
                                <option value="generic">Uniwersalna Kłódka</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Input.ButtonColor" class="form-label fw-semibold small">Kolor Przycisku (HEX)</label>
                            <input asp-for="Input.ButtonColor" class="form-control" />
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <h5 class="fw-bold text-dark mb-3 border-bottom pb-2">
                        <i class="bi bi-key text-primary me-2"></i>Poświadczenia i Endpointy
                    </h5>

                    <div class="mb-3">
                        <label asp-for="Input.ClientId" class="form-label fw-semibold small">Client ID (Application ID)</label>
                        <input asp-for="Input.ClientId" class="form-control font-monospace" />
                        <span asp-validation-for="Input.ClientId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.ClientSecret" class="form-label fw-semibold small">Client Secret (Klucz tajny)</label>
                        <input asp-for="Input.ClientSecret" class="form-control" placeholder="Wprowadź nowy klucz lub pozostaw aktualny" />
                        <span asp-validation-for="Input.ClientSecret" class="text-danger small"></span>
                    </div>

                    <div class="row g-2">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Input.CallbackPath" class="form-label fw-semibold small">Callback Path</label>
                            <input asp-for="Input.CallbackPath" class="form-control font-monospace" />
                            <span asp-validation-for="Input.CallbackPath" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Input.SignedOutCallbackPath" class="form-label fw-semibold small">Signout Callback</label>
                            <input asp-for="Input.SignedOutCallbackPath" class="form-control font-monospace" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Scope" class="form-label fw-semibold small">Scopes</label>
                        <input asp-for="Input.Scope" class="form-control font-monospace" />
                        <span asp-validation-for="Input.Scope" class="text-danger small"></span>
                    </div>
                </div>

                <div class="col-12">
                    <h5 class="fw-bold text-dark mb-3 border-bottom pb-2">
                        <i class="bi bi-shield-check text-primary me-2"></i>Zaawansowane Bezpieczeństwo i Auto-Provisioning
                    </h5>

                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="form-check form-switch p-3 bg-light rounded-3 border">
                                <input asp-for="Input.IsEnabled" class="form-check-input ms-0 me-2" type="checkbox" id="checkEnabled" />
                                <label class="form-check-label fw-semibold small" for="checkEnabled">Aktywny (Włączony)</label>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-check form-switch p-3 bg-light rounded-3 border">
                                <input asp-for="Input.UsePkce" class="form-check-input ms-0 me-2" type="checkbox" id="checkPkce" />
                                <label class="form-check-label fw-semibold small" for="checkPkce">Wymuś PKCE</label>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-check form-switch p-3 bg-light rounded-3 border">
                                <input asp-for="Input.AutoProvisionUsers" class="form-check-input ms-0 me-2" type="checkbox" id="checkAutoProv" />
                                <label class="form-check-label fw-semibold small" for="checkAutoProv">Auto-Provisioning Kont</label>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mt-2">
                        <div class="col-md-4">
                            <label asp-for="Input.DefaultRole" class="form-label fw-semibold small">Domyślna Rola Identity</label>
                            <select asp-for="Input.DefaultRole" class="form-select">
                                <option value="User">User (Standardowy użytkownik)</option>
                                <option value="Manager">Manager</option>
                                <option value="Admin">Admin</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Input.Prompt" class="form-label fw-semibold small">Parametr Prompt</label>
                            <input asp-for="Input.Prompt" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Input.AdditionalParametersJson" class="form-label fw-semibold small">Dodatkowe Parametry URL (JSON)</label>
                            <input asp-for="Input.AdditionalParametersJson" class="form-control font-monospace" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                <a asp-page="Test" asp-route-id="@Model.Input.Id" class="btn btn-outline-info">
                    <i class="bi bi-search me-1"></i> Testuj Discovery Endpoint
                </a>
                <div class="d-flex gap-2">
                    <a asp-page="Index" class="btn btn-outline-secondary px-4">Anuluj</a>
                    <button type="submit" class="btn btn-primary px-4 fw-semibold">
                        <i class="bi bi-save me-1"></i> Zapisz Zmiany w Locie
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>
