@using Quorum.Backend.AdminUI.Areas.Admin.Pages.Gateway
@namespace Quorum.Backend.AdminUI.Components

<RadzenCard class="rz-p-0 rz-shadow-1">
    <RadzenDataGrid Data="@Mappings" TItem="ScopesModel.RouteScopeMappingDto" 
                    AllowSorting="true" 
                    AllowFiltering="true" 
                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" 
                    FilterMode="FilterMode.Simple"
                    AllowPaging="true" 
                    PageSize="10" 
                    ShowPagingSummary="true"
                    PagingSummaryFormat="Strona {0} z {1} (łącznie {2} powiązań)"
                    AllowColumnResize="true"
                    Density="Density.Compact"
                    Responsive="true"
                    EmptyText="Brak powiązań spełniających kryteria wyszukiwania.">
        <Columns>
            <RadzenDataGridColumn Property="@nameof(ScopesModel.RouteScopeMappingDto.MappingId)" Title="#" Sortable="true" Filterable="true" Width="60px" TextAlign="TextAlign.Center">
                <Template Context="context">
                    <span class="text-center font-monospace text-muted small">@context.MappingId</span>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="@nameof(ScopesModel.RouteScopeMappingDto.MatchPattern)" Title="Trasa Gateway (MatchPattern)" Sortable="true" Filterable="true">
                <Template Context="context">
                    <div class="d-flex align-items-center gap-2">
                        <a href="Gateway/Edit?id=@context.RouteId" class="fw-bold text-dark font-monospace text-decoration-none">
                            @context.MatchPattern
                        </a>
                        @if (!context.RouteIsEnabled)
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Secondary" Text="Wyłączona" IsPill="true" />
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(context.RouteName))
                    {
                        <div class="text-muted small text-truncate" style="max-width: 250px;">
                            <i class="bi bi-tag me-1"></i>@context.RouteName
                        </div>
                    }
                    <div class="small">
                        <span class="badge bg-light text-muted border font-monospace" style="font-size: 0.7rem;">@context.HttpMethods</span>
                    </div>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="@nameof(ScopesModel.RouteScopeMappingDto.Scope)" Title="Wymagany Zakres (Scope)" Sortable="true" Filterable="true">
                <Template Context="context">
                    <div class="d-flex align-items-center gap-1">
                        <RadzenBadge BadgeStyle="BadgeStyle.Warning" Text="@context.Scope" />
                    </div>
                    @if (!string.IsNullOrEmpty(context.ScopeDisplayName) && context.ScopeDisplayName != context.Scope)
                    {
                        <div class="text-muted small mt-1">@context.ScopeDisplayName</div>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="@nameof(ScopesModel.RouteScopeMappingDto.ScopeType)" Title="Typ Scope" Sortable="true" Filterable="true" Width="130px">
                <Template Context="context">
                    <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="@context.ScopeType" IsPill="true" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="@nameof(ScopesModel.RouteScopeMappingDto.Upstream)" Title="Serwer Upstream" Sortable="true" Filterable="true">
                <Template Context="context">
                    <span class="font-monospace small text-muted text-truncate d-inline-block" style="max-width: 180px;" title="@context.Upstream">
                        @context.Upstream
                    </span>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Title="Akcje" Sortable="false" Filterable="false" TextAlign="TextAlign.Right" Width="120px">
                <Template Context="context">
                    <div class="btn-group btn-group-sm">
                        <a href="Gateway/Edit?id=@context.RouteId" class="btn btn-outline-secondary" title="Edytuj trasę">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <form method="post" action="Gateway/Scopes?handler=DeleteMapping&mappingId=@context.MappingId&routeId=@RouteId&searchTerm=@SearchTerm" class="d-inline" onsubmit="return confirm('Czy na pewno chcesz usunąć to powiązanie trasy z zakresem?');">
                            <button type="submit" class="btn btn-outline-danger" title="Usuń powiązanie">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </div>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
        <EmptyTemplate>
            <div class="text-center py-5">
                <div class="text-muted">
                    <i class="bi bi-slash-circle fs-2 d-block mb-2 text-secondary"></i>
                    <span class="fw-semibold">Brak powiązań spełniających kryteria wyszukiwania.</span>
                    <p class="small text-muted mt-1">Użyj formularza po lewej stronie, aby przypisać zakresy do wybranej trasy.</p>
                </div>
            </div>
        </EmptyTemplate>
    </RadzenDataGrid>
</RadzenCard>

@code {
    [Parameter]
    public IEnumerable<ScopesModel.RouteScopeMappingDto>? Mappings { get; set; }

    [Parameter]
    public int? RouteId { get; set; }

    [Parameter]
    public string? SearchTerm { get; set; }
}
