@namespace Quorum.Backend.AdminUI.Components

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <RadzenDataGrid Data="@Resources" TItem="IdentityResource" AllowSorting="true" AllowFiltering="true" 
                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" FilterMode="FilterMode.Simple"
                        EmptyText="Brak zarejestrowanych zasobów tożsamości w bazie danych."
                        Class="table table-hover align-middle mb-0">
            <Columns>
                <RadzenDataGridColumn Property="@nameof(IdentityResource.Name)" Title="Nazwa Zasobu" Sortable="true" Filterable="true">
                    <Template Context="r">
                        <span class="fw-bold font-monospace text-success">@r.Name</span>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Property="@nameof(IdentityResource.DisplayName)" Title="Nazwa Wyświetlana" Sortable="true" Filterable="true">
                    <Template Context="r">
                        @(string.IsNullOrWhiteSpace(r.DisplayName) ? "-" : r.DisplayName)
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Property="@nameof(IdentityResource.Description)" Title="Opis" Sortable="true" Filterable="true">
                    <Template Context="r">
                        <span class="text-muted small">@(string.IsNullOrWhiteSpace(r.Description) ? "-" : r.Description)</span>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Title="Skojarzone Claims" Sortable="false" Filterable="false">
                    <Template Context="r">
                        @if (r.UserClaims != null && r.UserClaims.Any())
                        {
                            @foreach (var claim in r.UserClaims)
                            {
                                <span class="badge bg-secondary-subtle text-secondary me-1">@claim.Type</span>
                            }
                        }
                        else
                        {
                            <span class="text-muted small fst-italic">Brak claims</span>
                        }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Property="@nameof(IdentityResource.Required)" Title="Wymagany" Sortable="true">
                    <Template Context="r">
                        @if (r.Required)
                        {
                            <span class="badge bg-danger-subtle text-danger">Tak</span>
                        }
                        else
                        {
                            <span class="badge bg-light text-muted border">Opcjonalny</span>
                        }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Property="@nameof(IdentityResource.ShowInDiscoveryDocument)" Title="W Discovery" Sortable="true">
                    <Template Context="r">
                        @if (r.ShowInDiscoveryDocument)
                        {
                            <span class="badge bg-success-subtle text-success">Tak</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary-subtle text-secondary">Ukryty</span>
                        }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Title="Akcje" Sortable="false" Filterable="false" TextAlign="TextAlign.Right">
                    <Template Context="r">
                        <a href="IdentityResources/Edit?id=@r.Id" class="btn btn-sm btn-outline-primary me-1">
                            <i class="bi bi-pencil me-1"></i> Edytuj
                        </a>
                        <form method="post" action="IdentityResources/Index?handler=Delete&id=@r.Id" class="d-inline" onsubmit="return confirm('Czy na pewno chcesz usunąć zasób tożsamości @r.Name?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
            <EmptyTemplate>
                <div class="text-center py-4 text-muted">
                    <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                    Brak zarejestrowanych zasobów tożsamości w bazie danych.
                </div>
            </EmptyTemplate>
        </RadzenDataGrid>
    </div>
</div>

@code {
    [Parameter]
    public IEnumerable<IdentityResource>? Resources { get; set; }
}
