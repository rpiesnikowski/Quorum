@namespace Quorum.Backend.AdminUI.Components
@using Open.IdentityServer.EntityFramework.Entities
@inject NavigationManager NavigationManager

<RadzenCard class="rz-p-0 rz-shadow-1">
    <RadzenDataGrid Data="@Resources" TItem="IdentityResource" 
                    AllowSorting="true" 
                    AllowFiltering="true" 
                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" 
                    FilterMode="FilterMode.Simple"
                    AllowPaging="true" 
                    PageSize="10" 
                    ShowPagingSummary="true"
                    PagingSummaryFormat="Strona {0} z {1} (łącznie {2} zasobów)"
                    AllowColumnResize="true"
                    Density="Density.Compact"
                    Responsive="true"
                    EmptyText="Brak zarejestrowanych zasobów tożsamości w bazie danych.">
        <Columns>
            <RadzenDataGridColumn Property="@nameof(IdentityResource.Name)" Title="Nazwa Zasobu" Sortable="true" Filterable="true" Width="200px">
                <Template Context="r">
                    <span class="fw-bold font-monospace text-success">@r.Name</span>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="@nameof(IdentityResource.DisplayName)" Title="Nazwa Wyświetlana" Sortable="true" Filterable="true" Width="220px">
                <Template Context="r">
                    <span>@(string.IsNullOrWhiteSpace(r.DisplayName) ? r.Name : r.DisplayName)</span>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="@nameof(IdentityResource.Description)" Title="Opis" Sortable="true" Filterable="true">
                <Template Context="r">
                    <span class="text-muted small">@(string.IsNullOrWhiteSpace(r.Description) ? "— brak opisu —" : r.Description)</span>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Title="Skojarzone Claims" Sortable="false" Filterable="false">
                <Template Context="r">
                    @if (r.UserClaims != null && r.UserClaims.Any())
                    {
                        <div class="d-flex flex-wrap gap-1">
                            @foreach (var claim in r.UserClaims)
                            {
                                <RadzenBadge BadgeStyle="BadgeStyle.Secondary" Text="@claim.Type" IsPill="true" />
                            }
                        </div>
                    }
                    else
                    {
                        <span class="text-muted small fst-italic">Brak claims</span>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="@nameof(IdentityResource.Required)" Title="Wymagany" Sortable="true" Width="120px" TextAlign="TextAlign.Center">
                <Template Context="r">
                    <RadzenBadge BadgeStyle="@(r.Required ? BadgeStyle.Danger : BadgeStyle.Light)" 
                                 Text="@(r.Required ? "Tak" : "Opcjonalny")" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="@nameof(IdentityResource.ShowInDiscoveryDocument)" Title="W Discovery" Sortable="true" Width="120px" TextAlign="TextAlign.Center">
                <Template Context="r">
                    <RadzenBadge BadgeStyle="@(r.ShowInDiscoveryDocument ? BadgeStyle.Success : BadgeStyle.Secondary)" 
                                 Text="@(r.ShowInDiscoveryDocument ? "Tak" : "Ukryty")" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Title="Akcje" Sortable="false" Filterable="false" TextAlign="TextAlign.Right" Width="140px">
                <Template Context="r">
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.25rem">
                        <RadzenButton Icon="edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@(() => NavigationManager.NavigateTo($"Admin/IdentityResources/Edit/{r.Id}"))" />
                        <RadzenButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Click="@(() => OnDeleteResource.InvokeAsync(r))" />
                    </RadzenStack>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
        <EmptyTemplate>
            <div class="text-center py-4 text-muted">
                <RadzenIcon Icon="inbox" Style="font-size: 2rem; display: block; margin-bottom: 0.5rem;" />
                Brak zarejestrowanych zasobów tożsamości w bazie danych.
            </div>
        </EmptyTemplate>
    </RadzenDataGrid>
</RadzenCard>

@code {
    [Parameter]
    public IEnumerable<IdentityResource>? Resources { get; set; }

    [Parameter]
    public EventCallback<IdentityResource> OnDeleteResource { get; set; }
}
