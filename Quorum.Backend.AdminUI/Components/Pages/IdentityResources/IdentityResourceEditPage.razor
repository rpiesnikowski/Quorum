@page "/Admin/IdentityResources/Edit/{Id:int}"
@using Microsoft.EntityFrameworkCore
@using Open.IdentityServer.EntityFramework.DbContexts
@using Open.IdentityServer.EntityFramework.Entities
@inject ConfigurationDbContext ConfigContext
@inject NotificationService NotificationService
@inject NavigationManager NavigationManager

<PageTitle>Edycja Zasobu Tożsamości - Admin</PageTitle>

<RadzenStack Gap="1.5rem">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
        <div>
            <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" class="rz-mb-0">Edycja Zasobu Tożsamości</RadzenText>
            <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary-color">
                Modyfikuj ustawienia zasobu oraz powiązane oświadczenia (claims).
            </RadzenText>
        </div>
        <RadzenButton Text="Powrót do listy" Icon="arrow_back" ButtonStyle="ButtonStyle.Light" Click="@(() => NavigationManager.NavigateTo("Admin/IdentityResources"))" />
    </RadzenStack>

    @if (model == null)
    {
        <RadzenProgressBar Value="100" Mode="ProgressBarMode.Indeterminate" />
    }
    else
    {
        <RadzenCard>
            <RadzenTemplateForm TItem="IdentityResourceEditModel" Data="@model" Submit="@HandleSubmit">
                <RadzenStack Gap="1rem">
                    <RadzenRow Gaps="1rem">
                        <RadzenColumn Size="12" SizeMD="6">
                            <RadzenFormField Text="Nazwa Zasobu *" Style="width: 100%;">
                                <RadzenTextBox @bind-Value="model.Name" Name="Name" Style="width: 100%;" Disabled="@model.NonEditable" />
                            </RadzenFormField>
                            <RadzenRequiredValidator Component="Name" Text="Nazwa zasobu jest wymagana" />
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="6">
                            <RadzenFormField Text="Nazwa Wyświetlana" Style="width: 100%;">
                                <RadzenTextBox @bind-Value="model.DisplayName" Style="width: 100%;" />
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>

                    <RadzenFormField Text="Opis" Style="width: 100%;">
                        <RadzenTextArea @bind-Value="model.Description" Style="width: 100%;" Rows="2" />
                    </RadzenFormField>

                    <RadzenFormField Text="Skojarzone Typy Claims (rozdzielane spacją, przecinkiem lub nową linią)" Style="width: 100%;">
                        <RadzenTextArea @bind-Value="model.UserClaims" Style="width: 100%; font-family: monospace;" Rows="2" />
                    </RadzenFormField>

                    <RadzenRow Gaps="1rem" AlignItems="AlignItems.Center">
                        <RadzenColumn Size="12" SizeMD="3">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                <RadzenSwitch @bind-Value="model.Enabled" />
                                <RadzenLabel Text="Zasób Aktywny" />
                            </RadzenStack>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="3">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                <RadzenSwitch @bind-Value="model.Required" />
                                <RadzenLabel Text="Wymagany" />
                            </RadzenStack>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="3">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                <RadzenSwitch @bind-Value="model.Emphasize" />
                                <RadzenLabel Text="Wyróżnij" />
                            </RadzenStack>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="3">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                <RadzenSwitch @bind-Value="model.ShowInDiscoveryDocument" />
                                <RadzenLabel Text="W Discovery Document" />
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>

                    <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" JustifyContent="JustifyContent.End" class="rz-mt-4">
                        <RadzenButton Text="Anuluj" ButtonStyle="ButtonStyle.Light" Click="@(() => NavigationManager.NavigateTo("Admin/IdentityResources"))" />
                        <RadzenButton Text="Zapisz Zmiany" Icon="save" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary" />
                    </RadzenStack>
                </RadzenStack>
            </RadzenTemplateForm>
        </RadzenCard>
    }
</RadzenStack>

@code {
    [Parameter]
    public int Id { get; set; }

    private IdentityResourceEditModel? model;

    protected override async Task OnInitializedAsync()
    {
        var res = await ConfigContext.IdentityResources
            .Include(r => r.UserClaims)
            .FirstOrDefaultAsync(r => r.Id == Id);

        if (res == null)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Błąd", "Nie znaleziono zasobu tożsamości.");
            NavigationManager.NavigateTo("Admin/IdentityResources");
            return;
        }

        model = new IdentityResourceEditModel
        {
            Id = res.Id,
            Name = res.Name,
            DisplayName = res.DisplayName,
            Description = res.Description,
            Enabled = res.Enabled,
            Required = res.Required,
            Emphasize = res.Emphasize,
            ShowInDiscoveryDocument = res.ShowInDiscoveryDocument,
            NonEditable = res.NonEditable,
            UserClaims = string.Join(" ", res.UserClaims.Select(c => c.Type))
        };
    }

    private async Task HandleSubmit(IdentityResourceEditModel resModel)
    {
        var res = await ConfigContext.IdentityResources
            .Include(r => r.UserClaims)
            .FirstOrDefaultAsync(r => r.Id == Id);

        if (res == null) return;

        var trimmedName = resModel.Name.Trim().ToLowerInvariant();
        var duplicateExists = await ConfigContext.IdentityResources
            .AnyAsync(r => r.Name.ToLower() == trimmedName && r.Id != Id);

        if (duplicateExists)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Błąd", $"Inny zasób tożsamości ma już nazwę '{resModel.Name}'.");
            return;
        }

        if (!res.NonEditable)
        {
            res.Name = resModel.Name.Trim();
        }
        res.DisplayName = resModel.DisplayName?.Trim();
        res.Description = resModel.Description?.Trim();
        res.Enabled = resModel.Enabled;
        res.Required = resModel.Required;
        res.Emphasize = resModel.Emphasize;
        res.ShowInDiscoveryDocument = resModel.ShowInDiscoveryDocument;

        res.UserClaims.Clear();
        if (!string.IsNullOrWhiteSpace(resModel.UserClaims))
        {
            var claims = resModel.UserClaims.Split(new[] { ' ', ',', '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Distinct();
            foreach (var claim in claims)
            {
                res.UserClaims.Add(new IdentityResourceClaim { Type = claim });
            }
        }

        await ConfigContext.SaveChangesAsync();

        NotificationService.Notify(NotificationSeverity.Success, "Sukces", "Zasób tożsamości został zaktualizowany.");
        NavigationManager.NavigateTo("Admin/IdentityResources");
    }

    public class IdentityResourceEditModel
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string? DisplayName { get; set; }
        public string? Description { get; set; }
        public bool Enabled { get; set; }
        public bool Required { get; set; }
        public bool Emphasize { get; set; }
        public bool ShowInDiscoveryDocument { get; set; }
        public bool NonEditable { get; set; }
        public string? UserClaims { get; set; }
    }
}
