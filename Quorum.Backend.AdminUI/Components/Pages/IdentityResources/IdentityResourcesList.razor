@page "/admin/identityresources"
@layout AdminLayout

<PageTitle>Zasoby Tożsamości | Quorum Admin UI</PageTitle>

<RadzenStack Gap="1.5rem">
    <RadzenRow JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
        <RadzenColumn Size="12" SizeMD="7">
            <RadzenText TextStyle="TextStyle.H4" Class="fw-bold mb-1">Zasoby Tożsamości (Identity Resources)</RadzenText>
            <RadzenText TextStyle="TextStyle.Body2" Class="text-muted">Standardowe i niestandardowe oświadczenia tożsamości OIDC (openid, profile, email, address, phone).</RadzenText>
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="5" Class="d-flex justify-content-md-end gap-2">
            <RadzenButton Icon="auto_fix_high" Text="Zainicjuj Standardowe" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Outlined" Click="@SeedStandardAsync" />
            <RadzenButton Icon="add" Text="Dodaj Zasób" ButtonStyle="ButtonStyle.Primary" Click="@(() => NavigationManager.NavigateTo("admin/identityresources/create"))" />
            <RadzenButton Icon="refresh" ButtonStyle="ButtonStyle.Light" Click="@LoadDataAsync" />
        </RadzenColumn>
    </RadzenRow>

    <RadzenCard Class="rz-p-3">
        <RadzenRow AlignItems="AlignItems.Center" Gap="1rem" Class="mb-3">
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenTextBox Placeholder="Szukaj po nazwie zasobu..." @bind-Value="searchTerm" Class="w-100" @oninput="@OnSearchInput" />
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6" Class="d-flex justify-content-md-end gap-2">
                <RadzenButton Icon="filter_alt_off" Text="Wyczyść filtry" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Click="@ResetFiltersAsync" />
            </RadzenColumn>
        </RadzenRow>

        <RadzenDataGrid @ref="grid"
                        Data="@resources"
                        AllowFiltering="true"
                        FilterMode="FilterMode.SimpleWithMenu"
                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                        AllowSorting="true"
                        AllowPaging="true"
                        PageSize="10"
                        PageSizeOptions="@(new int[] { 5, 10, 25, 50, 100 })"
                        ShowPagingSummary="true"
                        PagingSummaryFormat="Strona {0} z {1} (łącznie {2} pozycji)"
                        AllowColumnResize="true"
                        IsLoading="@isLoading"
                        TItem="IdentityResourceAdminModel"
                        EmptyText="Brak zasobów tożsamości spełniających wybrane kryteria filtrowania.">
            <Columns>
                <RadzenDataGridColumn TItem="IdentityResourceAdminModel" Property="Name" Title="Nazwa Zasobu" Width="180px">
                    <Template Context="res">
                        <div class="fw-bold text-primary">@res.Name</div>
                        <div class="text-muted" style="font-size: 0.78rem;">@(res.DisplayName ?? "-")</div>
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="IdentityResourceAdminModel" Property="Description" Title="Opis" />

                <RadzenDataGridColumn TItem="IdentityResourceAdminModel" Property="UserClaimsSummary" Title="Skojarzone Claims" Width="260px">
                    <Template Context="res">
                        <div class="d-flex flex-wrap gap-1">
                            @if (res.UserClaims != null && res.UserClaims.Count > 0)
                            {
                                @foreach (var c in res.UserClaims.Take(5))
                                {
                                    <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@c" IsPill="true" />
                                }
                                @if (res.UserClaims.Count > 5)
                                {
                                    <RadzenBadge BadgeStyle="BadgeStyle.Secondary" Text="@($"+{res.UserClaims.Count - 5}")" IsPill="true" />
                                }
                            }
                        </div>
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="IdentityResourceAdminModel" Property="StatusSummary" Title="Status" Width="130px">
                    <Template Context="res">
                        @if (res.Enabled)
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="Aktywny" IsPill="true" />
                        }
                        else
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="Wyłączony" IsPill="true" />
                        }
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="IdentityResourceAdminModel" Title="Akcje" Width="140px" Sortable="false" Filterable="false" TextAlign="TextAlign.End">
                    <Template Context="res">
                        <div class="d-flex justify-content-end gap-1">
                            <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Flat" Size="ButtonSize.Small" Click="@(() => NavigationManager.NavigateTo($"admin/identityresources/{res.Id}/edit"))" Tooltip="Edytuj zasób" />
                            <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Small" Click="@(() => ConfirmDeleteAsync(res))" Tooltip="Usuń zasób" />
                        </div>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </RadzenCard>
</RadzenStack>
