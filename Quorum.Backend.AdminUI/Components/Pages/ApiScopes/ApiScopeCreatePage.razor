@page "/Admin/ApiScopes/Create"
@using Microsoft.EntityFrameworkCore
@using Open.IdentityServer.EntityFramework.DbContexts

@inject NotificationService NotificationService
@inject NavigationManager NavigationManager
@inject ConfigurationDbContext ConfigContext

<PageTitle>Nowy Zakres API - Admin</PageTitle>

<RadzenStack Gap="1.5rem">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
        <div>
            <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" class="rz-mb-0">Nowy Zakres API (Scope)</RadzenText>
            <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary-color">
                Zarejestruj nowy zakres uprawnień w Open.IdentityServer.
            </RadzenText>
        </div>
        <RadzenButton Text="Powrót do listy" Icon="arrow_back" ButtonStyle="ButtonStyle.Light" Click="@(() => NavigationManager.NavigateTo("Admin/ApiScopes"))" />
    </RadzenStack>

    <RadzenCard>
        <RadzenTemplateForm TItem="ApiScopeModel" Data="@model" Submit="@HandleSubmit">
            <RadzenStack Gap="1rem">
                <RadzenRow Gaps="1rem">
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="Identyfikator Scope (np. orders.read) *" Style="width: 100%;">
                            <RadzenTextBox @bind-Value="model.Name" Name="Name" Style="width: 100%;" />
                        </RadzenFormField>
                        <RadzenRequiredValidator Component="Name" Text="Identyfikator Scope jest wymagany" />
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="Nazwa Wyświetlana *" Style="width: 100%;">
                            <RadzenTextBox @bind-Value="model.DisplayName" Name="DisplayName" Style="width: 100%;" />
                        </RadzenFormField>
                        <RadzenRequiredValidator Component="DisplayName" Text="Nazwa wyświetlana jest wymagana" />
                    </RadzenColumn>
                </RadzenRow>

                <RadzenFormField Text="Opis" Style="width: 100%;">
                    <RadzenTextArea @bind-Value="model.Description" Style="width: 100%;" Rows="2" />
                </RadzenFormField>

                <RadzenRow Gaps="1rem" AlignItems="AlignItems.Center">
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                            <RadzenSwitch @bind-Value="model.Enabled" />
                            <RadzenLabel Text="Scope Aktywny" />
                        </RadzenStack>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                            <RadzenSwitch @bind-Value="model.Required" />
                            <RadzenLabel Text="Wymagany" />
                        </RadzenStack>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                            <RadzenSwitch @bind-Value="model.Emphasize" />
                            <RadzenLabel Text="Wyróżniony na ekranie zgody" />
                        </RadzenStack>
                    </RadzenColumn>
                </RadzenRow>

                <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" JustifyContent="JustifyContent.End" class="rz-mt-4">
                    <RadzenButton Text="Anuluj" ButtonStyle="ButtonStyle.Light" Click="@(() => NavigationManager.NavigateTo("Admin/ApiScopes"))" />
                    <RadzenButton Text="Zapisz Scope" Icon="save" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary" />
                </RadzenStack>
            </RadzenStack>
        </RadzenTemplateForm>
    </RadzenCard>
</RadzenStack>

@code {
    private ApiScopeModel model = new() { Enabled = true };

    private async Task HandleSubmit(ApiScopeModel scopeModel)
    {
        var normalizedName = scopeModel.Name.Trim();
        var exists = await ConfigContext.ApiScopes.AnyAsync(s => s.Name == normalizedName);
        if (exists)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Błąd", $"Zakres API '{normalizedName}' już istnieje.");
            return;
        }

        var scope = new ApiScope
        {
            Name = normalizedName,
            DisplayName = scopeModel.DisplayName.Trim(),
            Description = string.IsNullOrWhiteSpace(scopeModel.Description) ? null : scopeModel.Description.Trim(),
            Required = scopeModel.Required,
            Emphasize = scopeModel.Emphasize,
            Enabled = scopeModel.Enabled
        };

        ConfigContext.ApiScopes.Add(scope);
        await ConfigContext.SaveChangesAsync();

        NotificationService.Notify(NotificationSeverity.Success, "Sukces", "Zakres API został utworzony.");
        NavigationManager.NavigateTo("Admin/ApiScopes");
    }

    public class ApiScopeModel
    {
        public string Name { get; set; } = string.Empty;
        public string DisplayName { get; set; } = string.Empty;
        public string? Description { get; set; }
        public bool Required { get; set; }
        public bool Emphasize { get; set; }
        public bool Enabled { get; set; } = true;
    }
}
