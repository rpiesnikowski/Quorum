@page "/Admin/ApiScopes"
@using Microsoft.EntityFrameworkCore
@using Open.IdentityServer.EntityFramework.DbContexts
@using Open.IdentityServer.EntityFramework.Entities
@inject ConfigurationDbContext ConfigContext
@inject DialogService DialogService
@inject NotificationService NotificationService
@inject NavigationManager NavigationManager

<PageTitle>Zakresy API (ApiScopes) - Admin</PageTitle>

<RadzenStack Gap="1.5rem">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
        <div>
            <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" class="rz-mb-0">Zakresy API (ApiScopes)</RadzenText>
            <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary-color">
                Zarządzaj uprawnieniami i dostępem do zasobów API dla klientów OAuth 2.0
            </RadzenText>
        </div>
        <RadzenButton Text="Dodaj Zakres API" Icon="add_circle" ButtonStyle="ButtonStyle.Primary" Click="@(() => NavigationManager.NavigateTo("Admin/ApiScopes/Create"))" />
    </RadzenStack>

    @if (isLoading)
    {
        <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
    }
    else
    {
        <ApiScopesGrid Scopes="@scopes" OnDeleteScope="@HandleDeleteScope" />
    }
</RadzenStack>

@code {
    private List<ApiScope> scopes = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadScopesAsync();
    }

    private async Task LoadScopesAsync()
    {
        isLoading = true;
        try
        {
            scopes = await ConfigContext.ApiScopes
                .AsNoTracking()
                .OrderBy(s => s.Name)
                .ToListAsync();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleDeleteScope(ApiScope scope)
    {
        var confirm = await DialogService.Confirm(
            $"Czy na pewno chcesz usunąć zakres API '{scope.Name}'?",
            "Potwierdzenie Usunięcia Zakresu",
            new ConfirmOptions { OkButtonText = "Usuń", CancelButtonText = "Anuluj" });

        if (confirm == true)
        {
            var entity = await ConfigContext.ApiScopes.FindAsync(scope.Id);
            if (entity != null)
            {
                ConfigContext.ApiScopes.Remove(entity);
                await ConfigContext.SaveChangesAsync();
                NotificationService.Notify(NotificationSeverity.Success, "Sukces", $"Zakres '{scope.Name}' został usunięty.");
                await LoadScopesAsync();
            }
        }
    }
}
