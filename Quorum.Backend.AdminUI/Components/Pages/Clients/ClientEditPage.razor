@page "/Admin/Clients/Edit/{Id:int}"
@using Microsoft.EntityFrameworkCore
@using Open.IdentityServer.EntityFramework.DbContexts
@using Open.IdentityServer.EntityFramework.Entities
@inject ConfigurationDbContext ConfigContext
@inject NotificationService NotificationService
@inject DialogService DialogService
@inject NavigationManager NavigationManager

<PageTitle>Edycja Klienta - Admin</PageTitle>

<RadzenStack Gap="1.5rem">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
        <div>
            <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" class="rz-mb-0">Edycja Klienta: @clientEntity?.ClientId</RadzenText>
            <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary-color">
                Zarządzaj zaawansowaną konfiguracją klienta OAuth 2.0 / OpenID Connect
            </RadzenText>
        </div>
        <RadzenButton Text="Powrót do listy" Icon="arrow_back" ButtonStyle="ButtonStyle.Light" Click="@(() => NavigationManager.NavigateTo("Admin/Clients"))" />
    </RadzenStack>

    @if (isLoading)
    {
        <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
    }
    else if (clientEntity == null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" Title="Błąd">Nie znaleziono klienta o podanym identyfikatorze.</RadzenAlert>
    }
    else
    {
        <RadzenTemplateForm TItem="ClientEditModel" Data="@model" Submit="@HandleSubmit">
            <RadzenCard>
                <RadzenStack Gap="1.25rem">
                    <RadzenRow Gaps="1rem">
                        <RadzenColumn Size="12" SizeMD="6">
                            <RadzenFormField Text="Client ID *" Style="width: 100%;">
                                <RadzenTextBox @bind-Value="model.ClientId" Name="ClientId" Style="width: 100%; font-family: monospace;" />
                            </RadzenFormField>
                            <RadzenRequiredValidator Component="ClientId" Text="Client ID jest wymagany" />
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="6">
                            <RadzenFormField Text="Nazwa Klienta *" Style="width: 100%;">
                                <RadzenTextBox @bind-Value="model.ClientName" Name="ClientName" Style="width: 100%;" />
                            </RadzenFormField>
                            <RadzenRequiredValidator Component="ClientName" Text="Nazwa Klienta jest wymagana" />
                        </RadzenColumn>
                    </RadzenRow>

                    <RadzenRow Gaps="1rem">
                        <RadzenColumn Size="12">
                            <RadzenFormField Text="Opis Klienta" Style="width: 100%;">
                                <RadzenTextBox @bind-Value="model.Description" Style="width: 100%;" />
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>

                    <RadzenRow Gaps="1rem">
                        <RadzenColumn Size="12" SizeMD="4">
                            <RadzenCheckBox @bind-Value="model.Enabled" Name="Enabled" />
                            <RadzenLabel Text="Klient Aktywny" Component="Enabled" class="rz-ms-2" />
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="4">
                            <RadzenCheckBox @bind-Value="model.RequirePkce" Name="RequirePkce" />
                            <RadzenLabel Text="Wymagaj PKCE" Component="RequirePkce" class="rz-ms-2" />
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="4">
                            <RadzenCheckBox @bind-Value="model.AllowOfflineAccess" Name="AllowOfflineAccess" />
                            <RadzenLabel Text="Dostęp Offline (Refresh Token)" Component="AllowOfflineAccess" class="rz-ms-2" />
                        </RadzenColumn>
                    </RadzenRow>

                    <RadzenRow Gaps="1rem">
                        <RadzenColumn Size="12">
                            <RadzenFormField Text="Dozwolone Typy Grantów (oddzielone spacjami)" Style="width: 100%;">
                                <RadzenTextBox @bind-Value="model.AllowedGrantTypes" Style="width: 100%; font-family: monospace;" />
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>

                    <RadzenRow Gaps="1rem">
                        <RadzenColumn Size="12">
                            <RadzenFormField Text="Dozwolone Scopes (oddzielone spacjami)" Style="width: 100%;">
                                <RadzenTextBox @bind-Value="model.AllowedScopes" Style="width: 100%; font-family: monospace;" />
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>

                    <RadzenRow Gaps="1rem">
                        <RadzenColumn Size="12">
                            <RadzenFormField Text="Adresy Przekierowania Logowania (Redirect URIs) - po jednym w wierszu" Style="width: 100%;">
                                <RadzenTextArea @bind-Value="model.RedirectUris" Rows="2" Style="width: 100%; font-family: monospace;" />
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>

                    <RadzenRow Gaps="1rem">
                        <RadzenColumn Size="12">
                            <RadzenFormField Text="Adresy Po Wylogowaniu (Post Logout Redirect URIs)" Style="width: 100%;">
                                <RadzenTextArea @bind-Value="model.PostLogoutRedirectUris" Rows="2" Style="width: 100%; font-family: monospace;" />
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>

                    <RadzenRow Gaps="1rem">
                        <RadzenColumn Size="12">
                            <RadzenFormField Text="Dozwolone Domeny CORS (Origins)" Style="width: 100%;">
                                <RadzenTextArea @bind-Value="model.AllowedCorsOrigins" Rows="2" Style="width: 100%; font-family: monospace;" />
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>

                    <RadzenRow Gaps="1rem">
                        <RadzenColumn Size="12" SizeMD="6">
                            <RadzenFormField Text="Czas Życia Tokena Dostępu (AccessTokenLifetime w sek.)" Style="width: 100%;">
                                <RadzenNumeric @bind-Value="model.AccessTokenLifetime" Style="width: 100%;" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="6">
                            <RadzenFormField Text="Nowy Sekret Klienta (opcjonalny - zahaszuje SHA256)" Style="width: 100%;">
                                <RadzenTextBox @bind-Value="model.NewSecret" Style="width: 100%; font-family: monospace;" Placeholder="Wpisz nowe hasło klienta" />
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>

                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="1rem" class="rz-mt-3">
                        <RadzenButton Text="Anuluj" ButtonStyle="ButtonStyle.Light" Click="@(() => NavigationManager.NavigateTo("Admin/Clients"))" />
                        <RadzenButton Text="Zapisz Zmiany" Icon="save" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary" IsBusy="@isSaving" />
                    </RadzenStack>
                </RadzenStack>
            </RadzenCard>
        </RadzenTemplateForm>
    }
</RadzenStack>

@code {
    [Parameter]
    public int Id { get; set; }

    private Client? clientEntity;
    private ClientEditModel model = new();
    private bool isLoading = true;
    private bool isSaving = false;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        try
        {
            clientEntity = await ConfigContext.Clients
                .Include(c => c.AllowedGrantTypes)
                .Include(c => c.AllowedScopes)
                .Include(c => c.RedirectUris)
                .Include(c => c.PostLogoutRedirectUris)
                .Include(c => c.AllowedCorsOrigins)
                .Include(c => c.ClientSecrets)
                .FirstOrDefaultAsync(c => c.Id == Id);

            if (clientEntity != null)
            {
                model = new ClientEditModel
                {
                    Id = clientEntity.Id,
                    ClientId = clientEntity.ClientId,
                    ClientName = clientEntity.ClientName ?? "",
                    Description = clientEntity.Description,
                    Enabled = clientEntity.Enabled,
                    RequirePkce = clientEntity.RequirePkce,
                    AllowOfflineAccess = clientEntity.AllowOfflineAccess,
                    AccessTokenLifetime = clientEntity.AccessTokenLifetime,
                    AllowedGrantTypes = string.Join(" ", clientEntity.AllowedGrantTypes.Select(g => g.GrantType)),
                    AllowedScopes = string.Join(" ", clientEntity.AllowedScopes.Select(s => s.Scope)),
                    RedirectUris = string.Join("\n", clientEntity.RedirectUris.Select(r => r.RedirectUri)),
                    PostLogoutRedirectUris = string.Join("\n", clientEntity.PostLogoutRedirectUris.Select(r => r.PostLogoutRedirectUri)),
                    AllowedCorsOrigins = string.Join("\n", clientEntity.AllowedCorsOrigins.Select(r => r.Origin))
                };
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleSubmit()
    {
        if (clientEntity == null) return;

        isSaving = true;
        try
        {
            clientEntity.ClientId = model.ClientId.Trim();
            clientEntity.ClientName = model.ClientName.Trim();
            clientEntity.Description = model.Description?.Trim();
            clientEntity.Enabled = model.Enabled;
            clientEntity.RequirePkce = model.RequirePkce;
            clientEntity.AllowOfflineAccess = model.AllowOfflineAccess;
            clientEntity.AccessTokenLifetime = model.AccessTokenLifetime;

            // Grant types
            clientEntity.AllowedGrantTypes.Clear();
            var grants = (model.AllowedGrantTypes ?? "").Split(new[] { ' ', ',', '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries);
            foreach (var g in grants)
            {
                clientEntity.AllowedGrantTypes.Add(new ClientGrantType { GrantType = g.Trim(), ClientId = clientEntity.Id });
            }

            // Scopes
            clientEntity.AllowedScopes.Clear();
            var scopes = (model.AllowedScopes ?? "").Split(new[] { ' ', ',', '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries);
            foreach (var s in scopes)
            {
                clientEntity.AllowedScopes.Add(new ClientScope { Scope = s.Trim(), ClientId = clientEntity.Id });
            }

            // Redirect URIs
            clientEntity.RedirectUris.Clear();
            var redirects = (model.RedirectUris ?? "").Split(new[] { '\r', '\n', ',' }, StringSplitOptions.RemoveEmptyEntries);
            foreach (var r in redirects)
            {
                clientEntity.RedirectUris.Add(new ClientRedirectUri { RedirectUri = r.Trim(), ClientId = clientEntity.Id });
            }

            // Post Logout URIs
            clientEntity.PostLogoutRedirectUris.Clear();
            var postLogouts = (model.PostLogoutRedirectUris ?? "").Split(new[] { '\r', '\n', ',' }, StringSplitOptions.RemoveEmptyEntries);
            foreach (var r in postLogouts)
            {
                clientEntity.PostLogoutRedirectUris.Add(new ClientPostLogoutRedirectUri { PostLogoutRedirectUri = r.Trim(), ClientId = clientEntity.Id });
            }

            // Cors Origins
            clientEntity.AllowedCorsOrigins.Clear();
            var cors = (model.AllowedCorsOrigins ?? "").Split(new[] { '\r', '\n', ',' }, StringSplitOptions.RemoveEmptyEntries);
            foreach (var c in cors)
            {
                clientEntity.AllowedCorsOrigins.Add(new ClientCorsOrigin { Origin = c.Trim(), ClientId = clientEntity.Id });
            }

            // New Secret
            if (!string.IsNullOrWhiteSpace(model.NewSecret))
            {
                var secretHash = Open.IdentityServer.Models.HashExtensions.Sha256(model.NewSecret.Trim());
                clientEntity.ClientSecrets.Add(new ClientSecret
                {
                    Value = secretHash,
                    Type = "SharedSecret",
                    Created = DateTime.UtcNow,
                    ClientId = clientEntity.Id
                });
            }

            await ConfigContext.SaveChangesAsync();
            NotificationService.Notify(NotificationSeverity.Success, "Sukces", "Dane klienta zostały zaktualizowane.");
            NavigationManager.NavigateTo("Admin/Clients");
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Błąd Zapisu", ex.Message);
        }
        finally
        {
            isSaving = false;
        }
    }

    public class ClientEditModel
    {
        public int Id { get; set; }
        public string ClientId { get; set; } = string.Empty;
        public string ClientName { get; set; } = string.Empty;
        public string? Description { get; set; }
        public bool Enabled { get; set; } = true;
        public bool RequirePkce { get; set; } = true;
        public bool AllowOfflineAccess { get; set; } = false;
        public int AccessTokenLifetime { get; set; } = 3600;
        public string? AllowedGrantTypes { get; set; } = "client_credentials";
        public string? AllowedScopes { get; set; } = "openid profile";
        public string? RedirectUris { get; set; }
        public string? PostLogoutRedirectUris { get; set; }
        public string? AllowedCorsOrigins { get; set; }
        public string? NewSecret { get; set; }
    }
}
