@page "/admin/clients/create"
@page "/admin/clients/{Id:int}/edit"
@layout AdminLayout
@inject IAdminClientStore ClientStore
@inject IAdminApiScopeStore ApiScopeStore
@inject IAdminIdentityResourceStore IdentityResourceStore
@inject NotificationService NotificationService
@inject DialogService DialogService
@inject NavigationManager NavigationManager

<PageTitle>@(IsNew ? "Nowy Klient OAuth" : "Edycja Klienta OAuth") | Quorum Admin UI</PageTitle>

<RadzenStack Gap="1.5rem">
    <RadzenRow JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
        <RadzenColumn Size="12" SizeMD="8">
            <RadzenText TextStyle="TextStyle.H4" Class="fw-bold mb-1">
                @(IsNew ? "Dodaj Nowego Klienta OAuth / OIDC" : $"Edycja Klienta: {model.ClientId}")
            </RadzenText>
            <RadzenText TextStyle="TextStyle.Body2" Class="text-muted">
                Konfiguracja przepływów autoryzacji (PKCE, Code Flow, Client Credentials), dozwolonych adresów zwrotnych, sekretów i zakresów uprawnień.
            </RadzenText>
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="4" Class="d-flex justify-content-md-end gap-2">
            <RadzenButton Icon="arrow_back" Text="Powrót do listy" ButtonStyle="ButtonStyle.Light" Click="@(() => NavigationManager.NavigateTo("admin/clients"))" />
        </RadzenColumn>
    </RadzenRow>

    <RadzenCard Class="rz-p-4">
        <RadzenTemplateForm TItem="ClientAdminModel" Data="@model" Submit="@HandleSubmitAsync">
            <RadzenTabs>
                <Tabs>
                    <!-- KROK 1: Podstawowe Ustawienia -->
                    <RadzenTabsItem Text="Podstawowe Informacje" Icon="info">
                        <RadzenStack Gap="1.25rem" Class="pt-3">
                            <RadzenRow Gap="1rem">
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField Text="Client ID (Identyfikator)" Class="w-100">
                                        <RadzenTextBox @bind-Value="model.ClientId" Name="ClientId" Class="w-100" Disabled="@(!IsNew)" />
                                    </RadzenFormField>
                                    <RadzenRequiredValidator Component="ClientId" Text="ClientId jest wymagany." />
                                </RadzenColumn>

                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField Text="Nazwa Klienta (Client Name)" Class="w-100">
                                        <RadzenTextBox @bind-Value="model.ClientName" Name="ClientName" Class="w-100" />
                                    </RadzenFormField>
                                    <RadzenRequiredValidator Component="ClientName" Text="Nazwa klienta jest wymagana." />
                                </RadzenColumn>

                                <RadzenColumn Size="12" SizeMD="12">
                                    <RadzenFormField Text="Opis Klienta" Class="w-100">
                                        <RadzenTextArea @bind-Value="model.Description" Rows="2" Class="w-100" />
                                    </RadzenFormField>
                                </RadzenColumn>

                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField Text="URL Klienta (ClientUri)" Class="w-100">
                                        <RadzenTextBox @bind-Value="model.ClientUri" Class="w-100" Placeholder="https://app.example.com" />
                                    </RadzenFormField>
                                </RadzenColumn>

                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField Text="URL Logo (LogoUri)" Class="w-100">
                                        <RadzenTextBox @bind-Value="model.LogoUri" Class="w-100" Placeholder="https://app.example.com/logo.png" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenRow Gap="1rem">
                                <RadzenColumn Size="12" SizeMD="4">
                                    <div class="d-flex align-items-center gap-2">
                                        <RadzenCheckBox @bind-Value="model.Enabled" Name="Enabled" />
                                        <RadzenLabel Text="Klient aktywny" Component="Enabled" />
                                    </div>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="4">
                                    <div class="d-flex align-items-center gap-2">
                                        <RadzenCheckBox @bind-Value="model.RequirePkce" Name="RequirePkce" />
                                        <RadzenLabel Text="Wymagaj PKCE (S256)" Component="RequirePkce" />
                                    </div>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="4">
                                    <div class="d-flex align-items-center gap-2">
                                        <RadzenCheckBox @bind-Value="model.RequireClientSecret" Name="RequireClientSecret" />
                                        <RadzenLabel Text="Wymagaj Client Secret" Component="RequireClientSecret" />
                                    </div>
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenStack>
                    </RadzenTabsItem>

                    <!-- KROK 2: Przepływy & Scopes -->
                    <RadzenTabsItem Text="Przepływy & Uprawnienia" Icon="vpn_key">
                        <RadzenStack Gap="1.25rem" Class="pt-3">
                            <RadzenFormField Text="Typy Przepływów (Grant Types)" Class="w-100">
                                <RadzenDropDown @bind-Value="model.AllowedGrantTypes" Data="@availableGrantTypes" Multiple="true" AllowClear="true" Placeholder="Wybierz typy przepływów..." Class="w-100" />
                            </RadzenFormField>

                            <div class="d-flex flex-wrap gap-2 align-items-center">
                                <span class="text-muted small me-1">Szybkie Szablony:</span>
                                <RadzenButton Text="Szablon: SPA (PKCE)" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@SetSpaTemplate" />
                                <RadzenButton Text="Szablon: Web App (Code Flow)" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@SetWebAppTemplate" />
                                <RadzenButton Text="Szablon: M2M (Client Credentials)" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@SetM2MTemplate" />
                            </div>

                            <!-- Sekcja Dozwolonych Zakresów: ChipList -->
                            <RadzenFieldset Text="Wybrane Dozwolone Zakresy (Allowed Scopes)" Class="rz-p-3">
                                @if (model.AllowedScopes == null || model.AllowedScopes.Count == 0)
                                {
                                    <div class="d-flex align-items-center gap-2 p-3 text-muted bg-light rounded border border-dashed">
                                        <RadzenIcon Icon="info" Style="font-size: 1.25rem; color: #64748b;" />
                                        <span>Brak przypisanych zakresów. Kliknij wiersz w poniższej tabeli, aby dodać uprawnienia dla tego klienta.</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="d-flex flex-wrap gap-2 align-items-center p-3 rounded border bg-light">
                                        @foreach (var scope in model.AllowedScopes)
                                        {
                                            var scopeInfo = allScopesList.FirstOrDefault(s => s.Name.Equals(scope, StringComparison.OrdinalIgnoreCase));
                                            var isIdentity = scopeInfo?.IsIdentity ?? (scope == "openid" || scope == "profile" || scope == "email" || scope == "roles" || scope == "offline_access");

                                            <div class="d-inline-flex align-items-center gap-2 px-3 py-1.5 rounded-pill shadow-sm border bg-white" style="font-size: 0.875rem;">
                                                <RadzenIcon Icon="@(isIdentity ? "badge" : "api")" Style="@(isIdentity ? "font-size: 1.1rem; color: var(--rz-primary);" : "font-size: 1.1rem; color: var(--rz-info);")" />
                                                <span class="fw-semibold text-dark">@scope</span>
                                                @if (scopeInfo != null && !string.IsNullOrWhiteSpace(scopeInfo.DisplayName) && scopeInfo.DisplayName != scope)
                                                {
                                                    <span class="text-muted" style="font-size: 0.75rem;">(@scopeInfo.DisplayName)</span>
                                                }
                                                <button type="button" 
                                                        class="btn btn-sm btn-link text-danger p-0 ms-1 d-inline-flex align-items-center" 
                                                        style="text-decoration: none; line-height: 1;" 
                                                        title="Usuń zakres @scope" 
                                                        @onclick="@(() => RemoveScope(scope))" 
                                                        @onclick:stopPropagation="true">
                                                    <RadzenIcon Icon="close" Style="font-size: 1rem;" />
                                                </button>
                                            </div>
                                        }
                                        <div class="ms-auto d-flex gap-2">
                                            <RadzenButton Text="Wyczyść wszystkie" 
                                                          Icon="clear_all" 
                                                          Size="ButtonSize.ExtraSmall" 
                                                          ButtonStyle="ButtonStyle.Light" 
                                                          Variant="Variant.Outlined" 
                                                          Click="@ClearAllScopes" />
                                        </div>
                                    </div>
                                }
                            </RadzenFieldset>

                            <!-- Tabela dostępnych zakresów pod spodem z opcją dodawania po kliknięciu w wiersz -->
                            <RadzenStack Gap="0.75rem">
                                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                    <div>
                                        <RadzenText TextStyle="TextStyle.Subtitle2" Class="fw-bold mb-0">Dostępne Zakresy i Zasoby Tożsamości</RadzenText>
                                        <RadzenText TextStyle="TextStyle.Caption" Class="text-muted">Kliknij w wiersz w tabeli, aby dodać lub odpiąć zakres z listy uprawnień klienta.</RadzenText>
                                    </div>
                                    <div class="d-flex align-items-center gap-2">
                                        <RadzenTextBox @bind-Value="scopeSearchTerm" 
                                                       Placeholder="Filtruj zakresy..." 
                                                       @oninput="@((ChangeEventArgs e) => scopeSearchTerm = e.Value?.ToString() ?? string.Empty)" 
                                                       Class="rz-textbox-sm" 
                                                       Style="width: 220px;" />
                                        @if (!string.IsNullOrEmpty(scopeSearchTerm))
                                        {
                                            <RadzenButton Icon="close" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Light" Click="@(() => scopeSearchTerm = string.Empty)" />
                                        }
                                    </div>
                                </div>

                                <RadzenDataGrid @ref="scopesGrid"
                                                Data="@FilteredScopes"
                                                TItem="ScopeItemModel"
                                                AllowPaging="true"
                                                PageSize="6"
                                                AllowSorting="true"
                                                RowClick="@OnScopeRowClick"
                                                Style="cursor: pointer;"
                                                Class="rz-shadow-1">
                                    <Columns>
                                        <RadzenDataGridColumn TItem="ScopeItemModel" Property="Name" Title="Nazwa (Scope)" Width="180px">
                                            <Template Context="s">
                                                <div class="d-flex align-items-center gap-2">
                                                    <RadzenIcon Icon="@(s.IsIdentity ? "badge" : "api")" Style="@(s.IsIdentity ? "color: var(--rz-primary);" : "color: var(--rz-info);")" />
                                                    <span class="fw-bold">@s.Name</span>
                                                </div>
                                            </Template>
                                        </RadzenDataGridColumn>
                                        <RadzenDataGridColumn TItem="ScopeItemModel" Property="DisplayName" Title="Nazwa Wyświetlana" Width="200px">
                                            <Template Context="s">
                                                @(string.IsNullOrWhiteSpace(s.DisplayName) ? s.Name : s.DisplayName)
                                            </Template>
                                        </RadzenDataGridColumn>
                                        <RadzenDataGridColumn TItem="ScopeItemModel" Property="Type" Title="Typ" Width="150px">
                                            <Template Context="s">
                                                <RadzenBadge BadgeStyle="@(s.IsIdentity ? BadgeStyle.Primary : BadgeStyle.Info)" Text="@s.Type" IsPill="true" />
                                            </Template>
                                        </RadzenDataGridColumn>
                                        <RadzenDataGridColumn TItem="ScopeItemModel" Property="Description" Title="Opis">
                                            <Template Context="s">
                                                <span class="text-muted small">@(string.IsNullOrWhiteSpace(s.Description) ? "Brak opisu" : s.Description)</span>
                                            </Template>
                                        </RadzenDataGridColumn>
                                        <RadzenDataGridColumn TItem="ScopeItemModel" Title="Status / Akcja" Width="150px" TextAlign="TextAlign.Center" Sortable="false">
                                            <Template Context="s">
                                                @if (model.AllowedScopes.Contains(s.Name))
                                                {
                                                    <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="Przypisany ✓" IsPill="true" />
                                                }
                                                else
                                                {
                                                    <RadzenButton Icon="add" Text="Dodaj" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Flat" Click="@(() => AddScope(s.Name))" @onclick:stopPropagation="true" />
                                                }
                                            </Template>
                                        </RadzenDataGridColumn>
                                    </Columns>
                                </RadzenDataGrid>
                            </RadzenStack>

                            <RadzenRow Gap="1rem" Class="mt-2">
                                <RadzenColumn Size="12" SizeMD="6">
                                    <div class="d-flex align-items-center gap-2">
                                        <RadzenCheckBox @bind-Value="model.AllowOfflineAccess" Name="AllowOfflineAccess" />
                                        <RadzenLabel Text="Zezwalaj na Refresh Token (offline_access)" Component="AllowOfflineAccess" />
                                    </div>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="6">
                                    <div class="d-flex align-items-center gap-2">
                                        <RadzenCheckBox @bind-Value="model.AlwaysIncludeUserClaimsInIdToken" Name="AlwaysIncludeUserClaimsInIdToken" />
                                        <RadzenLabel Text="Dołączaj roszczenia użytkownika do ID Tokena" Component="AlwaysIncludeUserClaimsInIdToken" />
                                    </div>
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenStack>
                    </RadzenTabsItem>

                    <!-- KROK 3: Adresy URL i Przekierowania -->
                    <RadzenTabsItem Text="Adresy URL i CORS" Icon="link">
                        <RadzenStack Gap="1.25rem" Class="pt-3">
                            <RadzenFormField Text="Dozwolone Adresy Zwrotne (Redirect URIs - jeden na linię)" Class="w-100">
                                <RadzenTextArea @bind-Value="model.RedirectUrisText" Rows="3" Class="w-100" Placeholder="https://app.example.com/signin-oidc&#10;http://localhost:3000/callback" />
                            </RadzenFormField>

                            <RadzenFormField Text="Adresy Zwrotne po Wylogowaniu (Post Logout Redirect URIs)" Class="w-100">
                                <RadzenTextArea @bind-Value="model.PostLogoutRedirectUrisText" Rows="2" Class="w-100" Placeholder="https://app.example.com/signout-callback-oidc" />
                            </RadzenFormField>

                            <RadzenFormField Text="Dozwolone Źródła CORS (Allowed CORS Origins)" Class="w-100">
                                <RadzenTextArea @bind-Value="model.AllowedCorsOriginsText" Rows="2" Class="w-100" Placeholder="https://app.example.com&#10;http://localhost:3000" />
                            </RadzenFormField>
                        </RadzenStack>
                    </RadzenTabsItem>

                    <!-- KROK 4: Sekrety & Czas Życia Tokenów -->
                    <RadzenTabsItem Text="Sekrety i Czas Życia" Icon="lock">
                        <RadzenStack Gap="1.25rem" Class="pt-3">
                            @if (!IsNew && model.ClientSecrets.Count > 0)
                            {
                                <RadzenText TextStyle="TextStyle.Subtitle2" Class="fw-bold">Zapisane Sekrety Klienta</RadzenText>
                                <RadzenDataGrid Data="@model.ClientSecrets" TItem="ClientSecretModel" AllowPaging="false">
                                    <Columns>
                                        <RadzenDataGridColumn TItem="ClientSecretModel" Property="Description" Title="Opis" />
                                        <RadzenDataGridColumn TItem="ClientSecretModel" Property="Type" Title="Typ" Width="140px" />
                                        <RadzenDataGridColumn TItem="ClientSecretModel" Property="Created" Title="Utworzono" Width="160px">
                                            <Template Context="sec">@sec.Created.ToShortDateString()</Template>
                                        </RadzenDataGridColumn>
                                        <RadzenDataGridColumn TItem="ClientSecretModel" Title="Akcje" Width="100px" TextAlign="TextAlign.End">
                                            <Template Context="sec">
                                                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Variant="Variant.Flat" Click="@(() => RemoveSecretAsync(sec.Id))" />
                                            </Template>
                                        </RadzenDataGridColumn>
                                    </Columns>
                                </RadzenDataGrid>
                            }

                            <RadzenFieldset Text="Dodaj Nowy Sekret Klienta">
                                <RadzenRow Gap="1rem">
                                    <RadzenColumn Size="12" SizeMD="6">
                                        <RadzenFormField Text="Wartość Sekretu (Value)" Class="w-100">
                                            <RadzenPassword @bind-Value="model.NewSecretValue" Class="w-100" Placeholder="np. TajneHaslo123!" />
                                        </RadzenFormField>
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeMD="6">
                                        <RadzenFormField Text="Opis Sekretu" Class="w-100">
                                            <RadzenTextBox @bind-Value="model.NewSecretDescription" Class="w-100" Placeholder="np. Domyślny klucz produkcyjny" />
                                        </RadzenFormField>
                                    </RadzenColumn>
                                </RadzenRow>
                            </RadzenFieldset>

                            <RadzenFieldset Text="Czas Życia Tokenów (w sekundach)">
                                <RadzenRow Gap="1rem">
                                    <RadzenColumn Size="12" SizeMD="4">
                                        <RadzenFormField Text="Access Token Lifetime" Class="w-100">
                                            <RadzenNumeric @bind-Value="model.AccessTokenLifetime" Class="w-100" />
                                        </RadzenFormField>
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeMD="4">
                                        <RadzenFormField Text="Identity Token Lifetime" Class="w-100">
                                            <RadzenNumeric @bind-Value="model.IdentityTokenLifetime" Class="w-100" />
                                        </RadzenFormField>
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeMD="4">
                                        <RadzenFormField Text="Authorization Code Lifetime" Class="w-100">
                                            <RadzenNumeric @bind-Value="model.AuthorizationCodeLifetime" Class="w-100" />
                                        </RadzenFormField>
                                    </RadzenColumn>
                                </RadzenRow>
                            </RadzenFieldset>
                        </RadzenStack>
                    </RadzenTabsItem>
                </Tabs>
            </RadzenTabs>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <RadzenButton Text="Anuluj" ButtonStyle="ButtonStyle.Light" Click="@(() => NavigationManager.NavigateTo("admin/clients"))" />
                <RadzenButton ButtonType="ButtonType.Submit" Text="@(IsNew ? "Utwórz Klienta" : "Zapisz Zmiany")" Icon="save" ButtonStyle="ButtonStyle.Primary" IsBusy="@isSubmitting" />
            </div>
        </RadzenTemplateForm>
    </RadzenCard>
</RadzenStack>
