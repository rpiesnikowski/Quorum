@page "/Admin/Clients/Create"
@using Microsoft.EntityFrameworkCore
@using Open.IdentityServer.EntityFramework.DbContexts
@using Open.IdentityServer.EntityFramework.Mappers
@using Open.IdentityServer.Models
@inject ConfigurationDbContext ConfigContext
@inject NotificationService NotificationService
@inject NavigationManager NavigationManager

<PageTitle>Dodaj Klienta OAuth / OIDC - Admin</PageTitle>

<RadzenStack Gap="1.5rem">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
        <div>
            <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" class="rz-mb-0">Dodaj Nowego Klienta</RadzenText>
            <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary-color">
                Rejestracja nowej aplikacji klienckiej w Open.IdentityServer
            </RadzenText>
        </div>
        <RadzenButton Text="Powrót do listy" Icon="arrow_back" ButtonStyle="ButtonStyle.Light" Click="@(() => NavigationManager.NavigateTo("Admin/Clients"))" />
    </RadzenStack>

    <RadzenTemplateForm TItem="ClientCreateModel" Data="@model" Submit="@HandleSubmit">
        <RadzenCard>
            <RadzenStack Gap="1.25rem">
                <RadzenRow Gaps="1rem">
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="Client ID *" Style="width: 100%;">
                            <RadzenTextBox @bind-Value="model.ClientId" Name="ClientId" Style="width: 100%; font-family: monospace;" Placeholder="np. spa-app lub machine-worker" />
                        </RadzenFormField>
                        <RadzenRequiredValidator Component="ClientId" Text="Client ID jest wymagany" />
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="Nazwa Wyświetlana Klienta *" Style="width: 100%;">
                            <RadzenTextBox @bind-Value="model.ClientName" Name="ClientName" Style="width: 100%;" Placeholder="np. Portal Klienta lub Serwis Płatności" />
                        </RadzenFormField>
                        <RadzenRequiredValidator Component="ClientName" Text="Nazwa Klienta jest wymagana" />
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow Gaps="1rem">
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="Typ Przepływu (Grant Type) *" Style="width: 100%;">
                            <RadzenDropDown @bind-Value="model.GrantType" Data="@grantTypeOptions" TextProperty="Text" ValueProperty="Value" Style="width: 100%;" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="Sekret Klienta (Client Secret) (opcjonalny)" Style="width: 100%;">
                            <RadzenTextBox @bind-Value="model.ClientSecret" Style="width: 100%; font-family: monospace;" Placeholder="Wpisz hasło klienta lub pozostaw puste dla aplikacji publicznych" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>

                @if (model.GrantType == "authorization_code")
                {
                    <RadzenRow Gaps="1rem">
                        <RadzenColumn Size="12">
                            <RadzenFormField Text="Adresy Przekierowania (Redirect URIs) - po jednym w wierszu lub po przecinku" Style="width: 100%;">
                                <RadzenTextArea @bind-Value="model.RedirectUris" Rows="2" Style="width: 100%; font-family: monospace;" Placeholder="https://mojadomena.pl/signin-oidc" />
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>

                    <RadzenRow Gaps="1rem">
                        <RadzenColumn Size="12">
                            <RadzenCheckBox @bind-Value="model.RequirePkce" Name="RequirePkce" />
                            <RadzenLabel Text="Wymagaj PKCE (Proof Key for Code Exchange) - zalecane dla SPA i aplikacji mobilnych" Component="RequirePkce" class="rz-ms-2" />
                        </RadzenColumn>
                    </RadzenRow>
                }

                <RadzenRow Gaps="1rem">
                    <RadzenColumn Size="12">
                        <RadzenFormField Text="Dozwolone Zakresy (Allowed Scopes) - oddzielone spacjami" Style="width: 100%;">
                            <RadzenTextBox @bind-Value="model.AllowedScopes" Style="width: 100%; font-family: monospace;" Placeholder="openid profile api1" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>

                @if (availableScopes.Any())
                {
                    <div>
                        <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-mb-1">Dostępne zakresy w systemie (kliknij, aby dodać):</RadzenText>
                        <div class="d-flex flex-wrap gap-1">
                            @foreach (var scope in availableScopes)
                            {
                                <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@scope" Style="cursor: pointer;" @onclick="@(() => AddScopeToInput(scope))" />
                            }
                        </div>
                    </div>
                }

                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="1rem" class="rz-mt-3">
                    <RadzenButton Text="Anuluj" ButtonStyle="ButtonStyle.Light" Click="@(() => NavigationManager.NavigateTo("Admin/Clients"))" />
                    <RadzenButton Text="Utwórz Klienta" Icon="save" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary" IsBusy="@isSaving" />
                </RadzenStack>
            </RadzenStack>
        </RadzenCard>
    </RadzenTemplateForm>
</RadzenStack>

@code {
    private ClientCreateModel model = new();
    private List<string> availableScopes = new();
    private bool isSaving = false;

    private readonly List<dynamic> grantTypeOptions = new()
    {
        new { Text = "Client Credentials (Machine to Machine)", Value = "client_credentials" },
        new { Text = "Authorization Code z PKCE (Aplikacje Web / SPA / Mobile)", Value = "authorization_code" }
    };

    protected override async Task OnInitializedAsync()
    {
        var idScopes = await ConfigContext.IdentityResources.Select(s => s.Name).ToListAsync();
        var apiScopes = await ConfigContext.ApiScopes.Select(s => s.Name).ToListAsync();
        availableScopes = idScopes.Concat(apiScopes).Concat(new[] { "offline_access" }).Distinct().OrderBy(s => s).ToList();
    }

    private void AddScopeToInput(string scope)
    {
        var current = (model.AllowedScopes ?? "").Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries).ToList();
        if (!current.Contains(scope, StringComparer.OrdinalIgnoreCase))
        {
            current.Add(scope);
            model.AllowedScopes = string.Join(" ", current);
        }
    }

    private async Task HandleSubmit()
    {
        isSaving = true;
        try
        {
            var normalizedClientId = model.ClientId.Trim();
            var exists = await ConfigContext.Clients.AnyAsync(c => c.ClientId == normalizedClientId);
            if (exists)
            {
                NotificationService.Notify(NotificationSeverity.Error, "Błąd", $"Klient o identyfikatorze '{normalizedClientId}' już istnieje w bazie danych.");
                return;
            }

            var isClient = new Client
            {
                ClientId = normalizedClientId,
                ClientName = model.ClientName.Trim(),
                Enabled = true,
                RequirePkce = model.RequirePkce
            };

            if (model.GrantType == "client_credentials")
            {
                isClient.AllowedGrantTypes = GrantTypes.ClientCredentials;
            }
            else
            {
                isClient.AllowedGrantTypes = GrantTypes.Code;
                isClient.AllowOfflineAccess = true;
                if (!string.IsNullOrWhiteSpace(model.RedirectUris))
                {
                    isClient.RedirectUris = model.RedirectUris.Split(new[] { ',', '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
                }
            }

            if (!string.IsNullOrWhiteSpace(model.ClientSecret))
            {
                isClient.ClientSecrets = new List<Secret> { new Secret(model.ClientSecret.Sha256()) };
            }

            if (!string.IsNullOrWhiteSpace(model.AllowedScopes))
            {
                isClient.AllowedScopes = model.AllowedScopes.Split(new[] { ' ', ',', '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
            }

            ConfigContext.Clients.Add(isClient.ToEntity());
            await ConfigContext.SaveChangesAsync();

            NotificationService.Notify(NotificationSeverity.Success, "Sukces", $"Klient '{normalizedClientId}' został pomyślnie utworzony.");
            NavigationManager.NavigateTo("Admin/Clients");
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Błąd Zapisu", ex.Message);
        }
        finally
        {
            isSaving = false;
        }
    }

    public class ClientCreateModel
    {
        public string ClientId { get; set; } = string.Empty;
        public string ClientName { get; set; } = string.Empty;
        public string? ClientSecret { get; set; }
        public string GrantType { get; set; } = "client_credentials";
        public string AllowedScopes { get; set; } = "openid profile api1";
        public string? RedirectUris { get; set; }
        public bool RequirePkce { get; set; } = true;
    }
}
