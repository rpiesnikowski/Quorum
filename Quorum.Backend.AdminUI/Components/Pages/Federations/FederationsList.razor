@page "/admin/federations"
@layout AdminLayout

<PageTitle>Federacje OIDC (SSO) | Quorum Admin UI</PageTitle>

<RadzenStack Gap="1.5rem">
    <RadzenRow JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
        <RadzenColumn Size="12" SizeMD="8">
            <RadzenText TextStyle="TextStyle.H4" Class="fw-bold mb-1">Dostawcy Federacji OIDC (Single Sign-On)</RadzenText>
            <RadzenText TextStyle="TextStyle.Body2" Class="text-muted">Dynamiczna integracja z zewnętrznymi dostawcami tożsamości (Microsoft Entra ID, Google, Okta, Auth0) bez konieczności restartu serwera.</RadzenText>
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="4" Class="d-flex justify-content-md-end gap-2">
            <RadzenButton Icon="add" Text="Dodaj Dostawcę OIDC" ButtonStyle="ButtonStyle.Primary" Click="@(() => NavigationManager.NavigateTo("admin/federations/create"))" />
            <RadzenButton Icon="refresh" ButtonStyle="ButtonStyle.Light" Click="@LoadDataAsync" />
        </RadzenColumn>
    </RadzenRow>

    <RadzenCard Class="rz-p-3">
        <RadzenRow AlignItems="AlignItems.Center" Gap="1rem" Class="mb-3">
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenTextBox Placeholder="Szukaj po nazwie, schemacie, adresie Authority..." @bind-Value="searchTerm" Class="w-100" @oninput="@OnSearchInput" />
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6" Class="d-flex justify-content-md-end gap-2">
                <RadzenButton Icon="filter_alt_off" Text="Wyczyść filtry" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Click="@ResetFiltersAsync" />
            </RadzenColumn>
        </RadzenRow>

        <RadzenDataGrid @ref="grid"
                        Data="@providers"
                        AllowFiltering="true"
                        FilterMode="FilterMode.SimpleWithMenu"
                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                        AllowSorting="true"
                        AllowPaging="true"
                        PageSize="10"
                        PageSizeOptions="@(new int[] { 5, 10, 25, 50, 100 })"
                        ShowPagingSummary="true"
                        PagingSummaryFormat="Strona {0} z {1} (łącznie {2} pozycji)"
                        AllowColumnResize="true"
                        IsLoading="@isLoading"
                        TItem="FederationAdminModel"
                        EmptyText="Brak skonfigurowanych dostawców federacji spełniających wybrane kryteria.">
            <Columns>
                <RadzenDataGridColumn TItem="FederationAdminModel" Property="DisplayName" Title="Dostawca OIDC" Width="200px">
                    <Template Context="fed">
                        <div class="d-flex align-items-center gap-2">
                            <RadzenIcon Icon="hub" Style="font-size: 1.5rem; color: #0284c7;" />
                            <div>
                                <div class="fw-bold">@fed.DisplayName</div>
                                <div class="text-muted" style="font-size: 0.75rem;">Schemat: <span class="badge bg-light text-dark">@fed.Scheme</span></div>
                            </div>
                        </div>
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="FederationAdminModel" Property="Scheme" Title="Schemat" Width="140px" />

                <RadzenDataGridColumn TItem="FederationAdminModel" Property="Authority" Title="Authority & Client ID">
                    <Template Context="fed">
                        <div class="text-truncate" style="max-width: 340px; font-family: monospace; font-size: 0.85rem;" title="@fed.Authority">
                            @fed.Authority
                        </div>
                        <div class="text-muted" style="font-size: 0.78rem;">Client ID: @fed.ClientId</div>
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="FederationAdminModel" Property="ProvisioningSummary" Title="Auto-Provisioning" Width="180px">
                    <Template Context="fed">
                        @if (fed.AutoProvisionUsers)
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="Auto-Provisioning" IsPill="true" />
                            <div class="text-muted" style="font-size: 0.75rem; margin-top: 2px;">Rola: @(fed.DefaultRoles ?? "User")</div>
                        }
                        else
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="Tylko powiązane" IsPill="true" />
                        }
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="FederationAdminModel" Property="StatusSummary" Title="Status" Width="130px">
                    <Template Context="fed">
                        @if (fed.IsEnabled)
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="Włączony" IsPill="true" />
                        }
                        else
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="Wyłączony" IsPill="true" />
                        }
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="FederationAdminModel" Title="Akcje" Width="180px" Sortable="false" Filterable="false" TextAlign="TextAlign.End">
                    <Template Context="fed">
                        <div class="d-flex justify-content-end gap-1">
                            <RadzenButton Icon="@(fed.IsEnabled ? "toggle_on" : "toggle_off")" ButtonStyle="@(fed.IsEnabled ? ButtonStyle.Success : ButtonStyle.Light)" Variant="Variant.Flat" Size="ButtonSize.Small" Click="@(() => ToggleStatusAsync(fed))" Tooltip="@(fed.IsEnabled ? "Wyłącz dostawcę" : "Włącz dostawcę")" />
                            <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Flat" Size="ButtonSize.Small" Click="@(() => NavigationManager.NavigateTo($"admin/federations/{fed.Id}/edit"))" Tooltip="Edytuj dostawcę" />
                            <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Small" Click="@(() => ConfirmDeleteAsync(fed))" Tooltip="Usuń dostawcę" />
                        </div>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </RadzenCard>
</RadzenStack>
