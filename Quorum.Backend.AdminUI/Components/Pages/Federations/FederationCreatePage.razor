@page "/Admin/Federations/Create"

@inject IFederationAdminService FederationService
@inject NotificationService NotificationService
@inject NavigationManager NavigationManager

<PageTitle>Nowy Dostawca OIDC - Admin</PageTitle>

<RadzenStack Gap="1.5rem">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
        <div>
            <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" class="rz-mb-0">Nowy Dostawca Federacji OIDC</RadzenText>
            <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary-color">
                Zarejestruj dynamicznego dostawcę tożsamości z natychmiastowym ładowaniem w pamięci.
            </RadzenText>
        </div>
        <RadzenButton Text="Powrót do listy" Icon="arrow_back" ButtonStyle="ButtonStyle.Light" Click="@(() => NavigationManager.NavigateTo("Admin/Federations"))" />
    </RadzenStack>

    <RadzenCard>
        <RadzenStack Gap="1rem" class="rz-mb-4">
            <RadzenText TextStyle="TextStyle.Subtitle2">Szablony dostawców:</RadzenText>
            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                <RadzenButton Text="Microsoft Entra ID" Icon="work" ButtonStyle="ButtonStyle.Info" Size="ButtonSize.Small" Click="@(() => ApplyPreset("entra"))" />
                <RadzenButton Text="Google Workspace" Icon="public" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@(() => ApplyPreset("google"))" />
                <RadzenButton Text="Azure AD B2C" Icon="cloud" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small" Click="@(() => ApplyPreset("azure-b2c"))" />
            </RadzenStack>
        </RadzenStack>

        <RadzenTemplateForm TItem="OidcFederationProvider" Data="@model" Submit="@HandleSubmit">
            <RadzenStack Gap="1rem">
                <RadzenRow Gaps="1rem">
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="Identyfikator Schematu (np. google-oidc) *" Style="width: 100%;">
                            <RadzenTextBox @bind-Value="model.Scheme" Name="Scheme" Style="width: 100%;" />
                        </RadzenFormField>
                        <RadzenRequiredValidator Component="Scheme" Text="Identyfikator schematu jest wymagany" />
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="Nazwa Wyświetlana *" Style="width: 100%;">
                            <RadzenTextBox @bind-Value="model.DisplayName" Name="DisplayName" Style="width: 100%;" />
                        </RadzenFormField>
                        <RadzenRequiredValidator Component="DisplayName" Text="Nazwa wyświetlana jest wymagana" />
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow Gaps="1rem">
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="Adres Issuer (Authority URL) *" Style="width: 100%;">
                            <RadzenTextBox @bind-Value="model.Authority" Name="Authority" Style="width: 100%;" />
                        </RadzenFormField>
                        <RadzenRequiredValidator Component="Authority" Text="Authority URL jest wymagany" />
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="Client ID *" Style="width: 100%;">
                            <RadzenTextBox @bind-Value="model.ClientId" Name="ClientId" Style="width: 100%;" />
                        </RadzenFormField>
                        <RadzenRequiredValidator Component="ClientId" Text="Client ID jest wymagany" />
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow Gaps="1rem">
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="Client Secret (opcjonalny dla PKCE)" Style="width: 100%;">
                            <RadzenPassword @bind-Value="model.ClientSecret" Style="width: 100%;" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="Scopes (np. openid profile email)" Style="width: 100%;">
                            <RadzenTextBox @bind-Value="model.Scope" Style="width: 100%;" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow Gaps="1rem">
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="Ścieżka CallbackPath *" Style="width: 100%;">
                            <RadzenTextBox @bind-Value="model.CallbackPath" Name="CallbackPath" Style="width: 100%;" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="Ścieżka Wylogowania (SignedOutCallbackPath)" Style="width: 100%;">
                            <RadzenTextBox @bind-Value="model.SignedOutCallbackPath" Style="width: 100%;" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow Gaps="1rem" AlignItems="AlignItems.Center">
                    <RadzenColumn Size="12" SizeMD="3">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                            <RadzenSwitch @bind-Value="model.IsEnabled" />
                            <RadzenLabel Text="Dostawca Aktywny" />
                        </RadzenStack>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="3">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                            <RadzenSwitch @bind-Value="model.UsePkce" />
                            <RadzenLabel Text="Włącz PKCE" />
                        </RadzenStack>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="3">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                            <RadzenSwitch @bind-Value="model.AutoProvisionUsers" />
                            <RadzenLabel Text="Auto-provision Użytkowników" />
                        </RadzenStack>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="3">
                        <RadzenFormField Text="Domyślna Rola">
                            <RadzenTextBox @bind-Value="model.DefaultRole" Style="width: 100%;" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>

                <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" JustifyContent="JustifyContent.End" class="rz-mt-4">
                    <RadzenButton Text="Anuluj" ButtonStyle="ButtonStyle.Light" Click="@(() => NavigationManager.NavigateTo("Admin/Federations"))" />
                    <RadzenButton Text="Zarejestruj Dostawcę" Icon="save" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary" />
                </RadzenStack>
            </RadzenStack>
        </RadzenTemplateForm>
    </RadzenCard>
</RadzenStack>

@code {
    private OidcFederationProvider model = new()
    {
        Scheme = "custom-oidc",
        DisplayName = "Zewnętrzny Dostawca OIDC",
        Authority = "https://identity.example.com",
        ClientId = "my-client-id",
        ResponseType = "code",
        Scope = "openid profile email",
        CallbackPath = "/signin-oidc-custom",
        SignedOutCallbackPath = "/signout-callback-oidc",
        UsePkce = true,
        GetClaimsFromUserInfoEndpoint = true,
        SaveTokens = true,
        IsEnabled = true,
        AutoProvisionUsers = true,
        DefaultRole = "User",
        IconType = "openid"
    };

    private void ApplyPreset(string preset)
    {
        if (preset == "entra")
        {
            model.Scheme = "entra-id";
            model.DisplayName = "Microsoft Entra ID";
            model.Authority = "https://login.microsoftonline.com/organizations/v2.0";
            model.ClientId = "00000000-0000-0000-0000-000000000000";
            model.ResponseType = "code";
            model.Scope = "openid profile email";
            model.CallbackPath = "/signin-oidc-entra";
            model.IconType = "microsoft";
            model.ButtonColor = "#0078D4";
            model.Prompt = "select_account";
        }
        else if (preset == "google")
        {
            model.Scheme = "google-oidc";
            model.DisplayName = "Google Workspace";
            model.Authority = "https://accounts.google.com";
            model.ClientId = "000000000000-xxxxxx.apps.googleusercontent.com";
            model.ResponseType = "code";
            model.Scope = "openid profile email";
            model.CallbackPath = "/signin-oidc-google";
            model.IconType = "google";
            model.ButtonColor = "#4285F4";
            model.Prompt = "select_account";
        }
        else if (preset == "azure-b2c")
        {
            model.Scheme = "azure-b2c";
            model.DisplayName = "Azure AD B2C";
            model.Authority = "https://mytenant.b2clogin.com/mytenant.onmicrosoft.com/b2c_1_susi/v2.0/";
            model.ClientId = "00000000-0000-0000-0000-000000000000";
            model.ResponseType = "code";
            model.Scope = "openid profile email";
            model.CallbackPath = "/signin-oidc-b2c";
            model.IconType = "azure";
            model.ButtonColor = "#0089D6";
        }
    }

    private async Task HandleSubmit(OidcFederationProvider provider)
    {
        var success = await FederationService.CreateFederationAsync(provider);
        if (!success)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Błąd", $"Schemat o nazwie '{provider.Scheme}' już istnieje.");
            return;
        }

        NotificationService.Notify(NotificationSeverity.Success, "Sukces", $"Dostawca OIDC '{provider.DisplayName}' został zarejestrowany.");
        NavigationManager.NavigateTo("Admin/Federations");
    }
}
