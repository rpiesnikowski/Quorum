                  type: int
                  autoIncrement: true
                  constraints:
                    primaryKey: true
                    nullable: false
              - column:
                  name: MatchPattern
                  type: varchar(255)
                  constraints:
                    nullable: false
              - column:
                  name: RouteName
                  type: varchar(128)
                  constraints:
                    nullable: true

  - changeSet:
      id: quorum-col-GatewayRoutes-RouteName
      author: Quorum.Backend
      preConditions:
        - onFail: MARK_RAN
        - and:
            - tableExists:
                tableName: GatewayRoutes
            - not:
