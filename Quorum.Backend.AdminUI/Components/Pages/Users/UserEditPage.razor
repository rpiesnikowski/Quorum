@page "/Admin/Users/Edit/{Id}"
@using Quorum.Backend.AdminUI.Services
@inject IUserAdminService UserService
@inject NotificationService NotificationService
@inject NavigationManager NavigationManager

<PageTitle>Edycja Użytkownika - Admin</PageTitle>

<RadzenStack Gap="1.5rem">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
        <div>
            <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" class="rz-mb-0">Edycja Użytkownika</RadzenText>
            <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary-color">
                Zarządzaj profilem, przypisanymi rolami oraz resetowaniem hasła.
            </RadzenText>
        </div>
        <RadzenButton Text="Powrót do listy" Icon="arrow_back" ButtonStyle="ButtonStyle.Light" Click="@(() => NavigationManager.NavigateTo("Admin/Users"))" />
    </RadzenStack>

    @if (model == null)
    {
        <RadzenProgressBar Value="100" Mode="ProgressBarMode.Indeterminate" />
    }
    else
    {
        <RadzenRow Gaps="1.5rem">
            <RadzenColumn Size="12" SizeLG="8">
                <RadzenCard>
                    <RadzenText TextStyle="TextStyle.H6" class="rz-mb-3">Dane Użytkownika i Role</RadzenText>
                    <RadzenTemplateForm TItem="UserEditModel" Data="@model" Submit="@HandleSubmit">
                        <RadzenStack Gap="1rem">
                            <RadzenRow Gaps="1rem">
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField Text="Nazwa Użytkownika / Login *" Style="width: 100%;">
                                        <RadzenTextBox @bind-Value="model.UserName" Name="UserName" Style="width: 100%;" />
                                    </RadzenFormField>
                                    <RadzenRequiredValidator Component="UserName" Text="Login jest wymagany" />
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField Text="Adres Email *" Style="width: 100%;">
                                        <RadzenTextBox @bind-Value="model.Email" Name="Email" Style="width: 100%;" />
                                    </RadzenFormField>
                                    <RadzenRequiredValidator Component="Email" Text="Email jest wymagany" />
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenRow Gaps="1rem">
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField Text="Imię i Nazwisko" Style="width: 100%;">
                                        <RadzenTextBox @bind-Value="model.FullName" Style="width: 100%;" />
                                    </RadzenFormField>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField Text="Numer Telefonu" Style="width: 100%;">
                                        <RadzenTextBox @bind-Value="model.PhoneNumber" Style="width: 100%;" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenFormField Text="Przypisane Role" Style="width: 100%;">
                                <RadzenDropDown @bind-Value="model.SelectedRoles" Multiple="true" AllowClear="true"
                                                Data="@availableRoles" Style="width: 100%;" />
                            </RadzenFormField>

                            <RadzenRow Gaps="1rem" AlignItems="AlignItems.Center">
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                        <RadzenSwitch @bind-Value="model.EmailConfirmed" />
                                        <RadzenLabel Text="Email Potwierdzony" />
                                    </RadzenStack>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                        <RadzenSwitch @bind-Value="model.TwoFactorEnabled" />
                                        <RadzenLabel Text="Uwierzytelnianie 2FA" />
                                    </RadzenStack>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                        <RadzenSwitch @bind-Value="model.LockoutEnabled" />
                                        <RadzenLabel Text="Blokada Konta Włączona" />
                                    </RadzenStack>
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" JustifyContent="JustifyContent.End" class="rz-mt-4">
                                <RadzenButton Text="Zapisz Dane" Icon="save" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary" />
                            </RadzenStack>
                        </RadzenStack>
                    </RadzenTemplateForm>
                </RadzenCard>
            </RadzenColumn>

            <RadzenColumn Size="12" SizeLG="4">
                <RadzenCard>
                    <RadzenText TextStyle="TextStyle.H6" class="rz-mb-3">Zresetuj Hasło</RadzenText>
                    <RadzenTemplateForm TItem="PasswordModel" Data="@passwordModel" Submit="@HandlePasswordReset">
                        <RadzenStack Gap="1rem">
                            <RadzenFormField Text="Nowe Hasło *" Style="width: 100%;">
                                <RadzenPassword @bind-Value="passwordModel.NewPassword" Name="NewPassword" Style="width: 100%;" />
                            </RadzenFormField>
                            <RadzenRequiredValidator Component="NewPassword" Text="Wpisz nowe hasło" />
                            <RadzenLengthValidator Component="NewPassword" Min="6" Text="Hasło min. 6 znaków" />

                            <RadzenButton Text="Zmień Hasło" Icon="key" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Warning" Style="width: 100%;" />
                        </RadzenStack>
                    </RadzenTemplateForm>
                </RadzenCard>
            </RadzenColumn>
        </RadzenRow>
    }
</RadzenStack>

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    private UserEditModel? model;
    private PasswordModel passwordModel = new();
    private IList<string> availableRoles = new List<string>();

    protected override async Task OnInitializedAsync()
    {
        var user = await UserService.GetUserByIdAsync(Id);
        if (user == null)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Błąd", "Nie znaleziono użytkownika.");
            NavigationManager.NavigateTo("Admin/Users");
            return;
        }

        availableRoles = await UserService.GetAvailableRolesAsync();

        model = new UserEditModel
        {
            Id = user.Id,
            UserName = user.UserName,
            Email = user.Email,
            EmailConfirmed = user.EmailConfirmed,
            FullName = user.FullName,
            PhoneNumber = user.PhoneNumber,
            TwoFactorEnabled = user.TwoFactorEnabled,
            LockoutEnabled = user.LockoutEnabled,
            SelectedRoles = user.Roles.ToList()
        };
    }

    private async Task HandleSubmit(UserEditModel userModel)
    {
        var (success, error) = await UserService.UpdateUserAsync(
            userModel.Id,
            userModel.UserName,
            userModel.Email,
            userModel.FullName,
            userModel.PhoneNumber,
            userModel.EmailConfirmed,
            userModel.TwoFactorEnabled,
            userModel.LockoutEnabled,
            userModel.SelectedRoles);

        if (!success)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Błąd", error ?? "Nie udało się zaktualizować użytkownika.");
            return;
        }

        NotificationService.Notify(NotificationSeverity.Success, "Sukces", "Dane użytkownika zostały zaktualizowane.");
    }

    private async Task HandlePasswordReset(PasswordModel passModel)
    {
        var (success, error) = await UserService.ResetPasswordAsync(Id, passModel.NewPassword);
        if (!success)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Błąd", error ?? "Nie udało się zmienić hasła.");
            return;
        }

        passwordModel = new PasswordModel();
        NotificationService.Notify(NotificationSeverity.Success, "Sukces", "Hasło użytkownika zostało pomyślnie zmienione.");
    }

    public class UserEditModel
    {
        public string Id { get; set; } = string.Empty;
        public string UserName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public bool EmailConfirmed { get; set; }
        public string? FullName { get; set; }
        public string? PhoneNumber { get; set; }
        public bool TwoFactorEnabled { get; set; }
        public bool LockoutEnabled { get; set; }
        public IList<string> SelectedRoles { get; set; } = new List<string>();
    }

    public class PasswordModel
    {
        public string NewPassword { get; set; } = string.Empty;
    }
}
