@page "/Admin/Users/Create"
@using Quorum.Backend.AdminUI.Services
@inject IUserAdminService UserService
@inject NotificationService NotificationService
@inject NavigationManager NavigationManager

<PageTitle>Nowy Użytkownik - Admin</PageTitle>

<RadzenStack Gap="1.5rem">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
        <div>
            <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" class="rz-mb-0">Nowy Użytkownik</RadzenText>
            <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary-color">
                Zarejestruj nowe konto w bazie tożsamości Identity.
            </RadzenText>
        </div>
        <RadzenButton Text="Powrót do listy" Icon="arrow_back" ButtonStyle="ButtonStyle.Light" Click="@(() => NavigationManager.NavigateTo("Admin/Users"))" />
    </RadzenStack>

    <RadzenCard>
        <RadzenTemplateForm TItem="UserCreateModel" Data="@model" Submit="@HandleSubmit">
            <RadzenStack Gap="1rem">
                <RadzenRow Gaps="1rem">
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="Nazwa Użytkownika / Login *" Style="width: 100%;">
                            <RadzenTextBox @bind-Value="model.UserName" Name="UserName" Style="width: 100%;" />
                        </RadzenFormField>
                        <RadzenRequiredValidator Component="UserName" Text="Login jest wymagany" />
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="Adres Email *" Style="width: 100%;">
                            <RadzenTextBox @bind-Value="model.Email" Name="Email" Style="width: 100%;" />
                        </RadzenFormField>
                        <RadzenRequiredValidator Component="Email" Text="Email jest wymagany" />
                        <RadzenEmailValidator Component="Email" Text="Niepoprawny format email" />
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow Gaps="1rem">
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="Imię i Nazwisko" Style="width: 100%;">
                            <RadzenTextBox @bind-Value="model.FullName" Style="width: 100%;" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="Numer Telefonu" Style="width: 100%;">
                            <RadzenTextBox @bind-Value="model.PhoneNumber" Style="width: 100%;" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>

                <RadzenFormField Text="Hasło (min. 6 znaków) *" Style="width: 100%;">
                    <RadzenPassword @bind-Value="model.Password" Name="Password" Style="width: 100%;" />
                </RadzenFormField>
                <RadzenRequiredValidator Component="Password" Text="Hasło jest wymagane" />
                <RadzenLengthValidator Component="Password" Min="6" Text="Hasło musi mieć co najmniej 6 znaków" />

                <RadzenFormField Text="Przypisane Role" Style="width: 100%;">
                    <RadzenDropDown @bind-Value="model.SelectedRoles" Multiple="true" AllowClear="true"
                                    Data="@availableRoles" Style="width: 100%;" />
                </RadzenFormField>

                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenSwitch @bind-Value="model.EmailConfirmed" />
                    <RadzenLabel Text="Email automatycznie potwierdzony" />
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" JustifyContent="JustifyContent.End" class="rz-mt-4">
                    <RadzenButton Text="Anuluj" ButtonStyle="ButtonStyle.Light" Click="@(() => NavigationManager.NavigateTo("Admin/Users"))" />
                    <RadzenButton Text="Utwórz Użytkownika" Icon="person_add" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary" />
                </RadzenStack>
            </RadzenStack>
        </RadzenTemplateForm>
    </RadzenCard>
</RadzenStack>

@code {
    private UserCreateModel model = new()
    {
        EmailConfirmed = true,
        SelectedRoles = new List<string> { "User" }
    };
    private IList<string> availableRoles = new List<string>();

    protected override async Task OnInitializedAsync()
    {
        availableRoles = await UserService.GetAvailableRolesAsync();
    }

    private async Task HandleSubmit(UserCreateModel userModel)
    {
        var (success, error, createdUserId) = await UserService.CreateUserAsync(
            userModel.UserName,
            userModel.Email,
            userModel.Password,
            userModel.FullName,
            userModel.PhoneNumber,
            userModel.EmailConfirmed,
            userModel.SelectedRoles);

        if (!success)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Błąd", error ?? "Nie udało się utworzyć użytkownika.");
            return;
        }

        NotificationService.Notify(NotificationSeverity.Success, "Sukces", $"Użytkownik '{userModel.UserName}' został utworzony.");
        NavigationManager.NavigateTo($"Admin/Users/Edit/{createdUserId}");
    }

    public class UserCreateModel
    {
        public string UserName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string? FullName { get; set; }
        public string? PhoneNumber { get; set; }
        public string Password { get; set; } = string.Empty;
        public bool EmailConfirmed { get; set; }
        public IList<string> SelectedRoles { get; set; } = new List<string>();
    }
}
