@page "/Admin/Gateway/Scopes"
@using Microsoft.EntityFrameworkCore
@using Open.IdentityServer.EntityFramework.DbContexts
@using Quorum.Backend.AdminUI.Components.Layout
@using Quorum.Backend.AdminUI.Services
@using Quorum.Backend.EntityFramework.DbContexts
@using Quorum.Backend.EntityFramework.Entities
@layout AdminLayout
@inject IGatewayAdminService GatewayService
@inject IConfigurationDbContext ConfigContext
@inject QuorumGatewayDbContext GatewayContext
@inject NotificationService NotificationService
@inject NavigationManager NavigationManager

<PageTitle>Mapowania Scopes Gateway - Admin</PageTitle>

<RadzenStack Gap="1.5rem">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
        <div>
            <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" class="rz-mb-0">Mapowania Scopes API Gateway</RadzenText>
            <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary-color">
                Zarządzaj powiązaniami tras proxy z wymaganymi uprawnieniami (Scopes).
            </RadzenText>
        </div>
        <RadzenButton Text="Powrót do tras" Icon="arrow_back" ButtonStyle="ButtonStyle.Light" Click="@(() => NavigationManager.NavigateTo("Admin/Gateway"))" />
    </RadzenStack>

    <RadzenCard>
        <RadzenText TextStyle="TextStyle.H6" class="rz-mb-3">Dodaj Powiązanie Scope do Trasy</RadzenText>
        <RadzenRow Gaps="1rem" AlignItems="AlignItems.End">
            <RadzenColumn Size="12" SizeMD="5">
                <RadzenFormField Text="Wybierz Trasę Gateway *" Style="width: 100%;">
                    <RadzenDropDown @bind-Value="selectedRouteId" Data="@routes" TextProperty="MatchPattern" ValueProperty="Id" Style="width: 100%; font-family: monospace;" />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenFormField Text="Scope (Wybierz lub Wpisz)" Style="width: 100%;">
                    <RadzenTextBox @bind-Value="newScopeName" Style="width: 100%; font-family: monospace;" Placeholder="np. api.read" />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="3">
                <RadzenButton Text="Przypisz Scope" Icon="add_link" ButtonStyle="ButtonStyle.Primary" Click="@AddScopeMapping" Style="width: 100%;" />
            </RadzenColumn>
        </RadzenRow>
    </RadzenCard>

    <GatewayMappingsGrid Mappings="@mappings" />
</RadzenStack>

@code {
    private List<GatewayRoute> routes = new();
    private List<GatewayRouteScopeMapping> mappings = new();
    private int selectedRouteId;
    private string newScopeName = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        routes = await GatewayService.GetAllRoutesAsync();
        mappings = await GatewayContext.GatewayRouteScopeMappings
            .Include(m => m.Route)
            .AsNoTracking()
            .ToListAsync();

        if (routes.Any() && selectedRouteId == 0)
        {
            selectedRouteId = routes.First().Id;
        }
    }

    private async Task AddScopeMapping()
    {
        if (selectedRouteId == 0 || string.IsNullOrWhiteSpace(newScopeName))
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Uwaga", "Wybierz trasę i podaj nazwę zakresu.");
            return;
        }

        var success = await GatewayService.AddScopeToRouteAsync(selectedRouteId, newScopeName.Trim());
        if (!success)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Błąd", "Nie udało się dodać zakresu (może już istnieć w tej trasie).");
            return;
        }

        newScopeName = string.Empty;
        NotificationService.Notify(NotificationSeverity.Success, "Sukces", "Zakres został przypisany do trasy.");
        await LoadDataAsync();
    }
}
