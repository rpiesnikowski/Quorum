@page "/Admin/Gateway/Scopes"
@using Microsoft.EntityFrameworkCore
@using Open.IdentityServer.EntityFramework.DbContexts
@using Quorum.Backend.AdminUI.Areas.Admin.Pages.Gateway
@using Quorum.Backend.AdminUI.Services
@using Quorum.Backend.EntityFramework.Data
@using Quorum.Backend.EntityFramework.Models
@inject IGatewayAdminService GatewayService
@inject ConfigurationDbContext ConfigContext
@inject ApplicationDbContext AppContext
@inject NotificationService NotificationService
@inject NavigationManager NavigationManager

<PageTitle>Mapowania Scopes Gateway - Admin</PageTitle>

<RadzenStack Gap="1.5rem">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
        <div>
            <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" class="rz-mb-0">Mapowania Scopes API Gateway</RadzenText>
            <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary-color">
                Zarządzaj powiązaniami tras proxy z wymaganymi uprawnieniami (Scopes).
            </RadzenText>
        </div>
        <RadzenButton Text="Powrót do tras" Icon="arrow_back" ButtonStyle="ButtonStyle.Light" Click="@(() => NavigationManager.NavigateTo("Admin/Gateway"))" />
    </RadzenStack>

    <RadzenCard>
        <RadzenText TextStyle="TextStyle.H6" class="rz-mb-3">Dodaj Powiązanie Scope do Trasy</RadzenText>
        <RadzenRow Gaps="1rem" AlignItems="AlignItems.End">
            <RadzenColumn Size="12" SizeMD="5">
                <RadzenFormField Text="Wybierz Trasę Gateway *" Style="width: 100%;">
                    <RadzenDropDown @bind-Value="selectedRouteId" Data="@routes" TextProperty="MatchPattern" ValueProperty="Id" Style="width: 100%; font-family: monospace;" />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenFormField Text="Scope (Wybierz lub Wpisz)" Style="width: 100%;">
                    <RadzenTextBox @bind-Value="newScopeName" Style="width: 100%; font-family: monospace;" Placeholder="np. api.read" />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="3">
                <RadzenButton Text="Przypisz Scope" Icon="add_link" ButtonStyle="ButtonStyle.Primary" Click="@AddScopeMapping" Style="width: 100%;" />
            </RadzenColumn>
        </RadzenRow>
    </RadzenCard>

    <GatewayMappingsGrid Mappings="@mappings" />
</RadzenStack>

@code {
    private List<GatewayRoute> routes = new();
    private List<ScopesModel.RouteScopeMappingDto> mappings = new();
    private int selectedRouteId;
    private string newScopeName = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        routes = await GatewayService.GetAllRoutesAsync();
        
        var identityScopes = await ConfigContext.IdentityResources
            .AsNoTracking()
            .Where(r => r.Enabled)
            .OrderBy(r => r.Name)
            .Select(r => new { r.Name, DisplayName = r.DisplayName ?? r.Name, r.Description, Type = "Tożsamość (Identity)" })
            .ToListAsync();

        var apiScopes = await ConfigContext.ApiScopes
            .AsNoTracking()
            .Where(s => s.Enabled)
            .OrderBy(s => s.Name)
            .Select(s => new { s.Name, DisplayName = s.DisplayName ?? s.Name, s.Description, Type = "API Scope" })
            .ToListAsync();

        var availableScopes = identityScopes.Concat(apiScopes).ToList();
        var scopeDict = availableScopes.ToDictionary(s => s.Name, s => s, StringComparer.OrdinalIgnoreCase);

        var rawMappings = await AppContext.GatewayRouteScopes
            .Include(s => s.GatewayRoute)
            .AsNoTracking()
            .ToListAsync();

        mappings = rawMappings.Select(m =>
        {
            var route = m.GatewayRoute;
            scopeDict.TryGetValue(m.Scope, out var matchedScope);

            return new ScopesModel.RouteScopeMappingDto
            {
                MappingId = m.Id,
                RouteId = m.GatewayRouteId,
                MatchPattern = route?.MatchPattern ?? $"(Route #{m.GatewayRouteId})",
                RouteName = route?.RouteName,
                HttpMethods = route?.HttpMethods ?? "ALL",
                Upstream = route != null ? $"{route.Scheme}://{route.AddressHost}:{route.AddressPort}{route.AddressBasePath}" : "-",
                Scope = m.Scope,
                ScopeType = matchedScope?.Type ?? "Custom / External",
                ScopeDisplayName = matchedScope?.DisplayName,
                ScopeDescription = matchedScope?.Description,
                RouteIsEnabled = route?.IsEnabled ?? false,
                RouteRequiredScope = route?.RequiredScope ?? false,
                RouteAllowAnonymous = route?.AllowAnonymous ?? false,
                CreatedAt = route?.CreatedAt ?? DateTime.UtcNow
            };
        }).ToList();

        if (routes.Any() && selectedRouteId == 0)
        {
            selectedRouteId = routes.First().Id;
        }
    }

    private async Task AddScopeMapping()
    {
        if (selectedRouteId == 0 || string.IsNullOrWhiteSpace(newScopeName))
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Uwaga", "Wybierz trasę i podaj nazwę zakresu.");
            return;
        }

        var success = await GatewayService.AddScopeToRouteAsync(selectedRouteId, newScopeName.Trim());
        if (!success)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Błąd", "Nie udało się dodać zakresu (może już istnieć w tej trasie).");
            return;
        }

        newScopeName = string.Empty;
        NotificationService.Notify(NotificationSeverity.Success, "Sukces", "Zakres został przypisany do trasy.");
        await LoadDataAsync();
    }
}
