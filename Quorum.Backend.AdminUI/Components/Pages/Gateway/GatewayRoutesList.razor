@page "/admin/gateway"
@page "/admin/gateway/routes"
@layout AdminLayout

<PageTitle>Trasy API Gateway | Quorum Admin UI</PageTitle>

<RadzenStack Gap="1.5rem">
    <RadzenRow JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
        <RadzenColumn Size="12" SizeMD="5">
            <RadzenText TextStyle="TextStyle.H4" Class="fw-bold mb-1">Trasy API Gateway & Reverse Proxy</RadzenText>
            <RadzenText TextStyle="TextStyle.Body2" Class="text-muted">Routowanie zapytań HTTP do mikroserwisów wewnętrznych z egzekwowaniem nagłówków Bearer i autoryzacji Scopes.</RadzenText>
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="7" Class="d-flex justify-content-md-end gap-2 flex-wrap">
            <RadzenButton Icon="download" Text="Eksportuj (JSON)" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Outlined" Click="@ExportJsonAsync" />
            <RadzenButton Icon="upload" Text="Importuj (JSON)" ButtonStyle="ButtonStyle.Info" Variant="Variant.Outlined" Click="@OpenImportDialogAsync" />
            <RadzenButton Icon="science" Text="Symulator Trasy" ButtonStyle="ButtonStyle.Light" Variant="Variant.Outlined" Click="@(() => NavigationManager.NavigateTo("admin/gateway/test"))" />
            <RadzenButton Icon="add" Text="Dodaj Trasę" ButtonStyle="ButtonStyle.Primary" Click="@(() => NavigationManager.NavigateTo("admin/gateway/create"))" />
            <RadzenButton Icon="refresh" ButtonStyle="ButtonStyle.Light" Click="@LoadDataAsync" />
        </RadzenColumn>
    </RadzenRow>

    <RadzenCard Class="rz-p-3">
        <RadzenRow AlignItems="AlignItems.Center" Gap="1rem" Class="mb-3">
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenTextBox Placeholder="Szukaj po wzorcu ścieżki, nazwie, hoście docelowym..." @bind-Value="searchTerm" Class="w-100" @oninput="@OnSearchInput" />
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6" Class="d-flex justify-content-md-end gap-2">
                <RadzenButton Icon="filter_alt_off" Text="Wyczyść filtry" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Click="@ResetFiltersAsync" />
            </RadzenColumn>
        </RadzenRow>

        <RadzenDataGrid @ref="grid"
                        Data="@routes"
                        AllowFiltering="true"
                        FilterMode="FilterMode.SimpleWithMenu"
                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                        AllowSorting="true"
                        AllowPaging="true"
                        PageSize="10"
                        PageSizeOptions="@(new int[] { 5, 10, 25, 50, 100 })"
                        ShowPagingSummary="true"
                        PagingSummaryFormat="Strona {0} z {1} (łącznie {2} pozycji)"
                        AllowColumnResize="true"
                        IsLoading="@isLoading"
                        TItem="GatewayRouteAdminModel"
                        EmptyText="Brak tras API Gateway spełniających wybrane kryteria.">
            <Columns>
                <RadzenDataGridColumn TItem="GatewayRouteAdminModel" Property="Priority" Title="Prio" Width="75px" TextAlign="TextAlign.Center">
                    <Template Context="r">
                        <RadzenBadge BadgeStyle="BadgeStyle.Dark" Text="@r.Priority.ToString()" IsPill="true" />
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="GatewayRouteAdminModel" Property="MatchPattern" Title="Wzorzec & Nazwa" Width="260px">
                    <Template Context="r">
                        <div class="d-flex align-items-center gap-1">
                            <span class="fw-bold text-primary" style="font-family: monospace; font-size: 0.9rem;">@r.MatchPattern</span>
                            @if (r.IsTemplate)
                            {
                                <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="Template" IsPill="true" Style="font-size: 0.65rem;" />
                            }
                            else if (r.IsRegex)
                            {
                                <RadzenBadge BadgeStyle="BadgeStyle.Primary" Text="Regex" IsPill="true" Style="font-size: 0.65rem;" />
                            }
                        </div>
                        <div class="text-muted" style="font-size: 0.8rem;">@(r.RouteName ?? "-")</div>
                        @if (!string.IsNullOrWhiteSpace(r.Description))
                        {
                            <div class="text-muted text-truncate" style="font-size: 0.72rem;" title="@r.Description">@r.Description</div>
                        }
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="GatewayRouteAdminModel" Property="UpstreamHost" Title="Host Upstream & Metody">
                    <Template Context="r">
                        <div class="d-flex align-items-center gap-1 text-truncate">
                            <RadzenBadge BadgeStyle="@(r.Scheme == "https" ? BadgeStyle.Success : BadgeStyle.Warning)" Text="@r.Scheme?.ToUpperInvariant()" IsPill="true" Style="font-size: 0.65rem;" />
                            <span style="font-family: monospace; font-size: 0.85rem;" title="@r.UpstreamHost">@r.UpstreamHost</span>
                        </div>
                        <div class="d-flex flex-wrap gap-1 align-items-center mt-1">
                            <span class="text-muted" style="font-size: 0.72rem;">Metody:</span>
                            @if (r.AllowedHttpMethods == null || r.AllowedHttpMethods.Count == 0 || r.AllowedHttpMethods.Contains("ALL"))
                            {
                                <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="ALL" IsPill="true" Style="font-size: 0.65rem;" />
                            }
                            else
                            {
                                @foreach (var m in r.AllowedHttpMethods.Take(4))
                                {
                                    <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="@m" IsPill="true" Style="font-size: 0.65rem;" />
                                }
                                @if (r.AllowedHttpMethods.Count > 4)
                                {
                                    <span class="text-muted" style="font-size: 0.7rem;">+@(r.AllowedHttpMethods.Count - 4)</span>
                                }
                            }
                        </div>
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="GatewayRouteAdminModel" Property="ScopesSummary" Title="Autoryzacja & Scopes" Width="200px">
                    <Template Context="r">
                        @if (r.AllowAnonymous)
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="Anonimowy (Public)" IsPill="true" />
                        }
                        else if (r.RequiredScopes != null && r.RequiredScopes.Count > 0)
                        {
                            <div class="d-flex flex-wrap gap-1">
                                @foreach (var sc in r.RequiredScopes)
                                {
                                    <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="@sc" IsPill="true" Style="font-size: 0.7rem;" />
                                }
                            </div>
                        }
                        else
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Secondary" Text="Wymagany Token" IsPill="true" Style="font-size: 0.7rem;" />
                        }
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="GatewayRouteAdminModel" Property="ProxyFeaturesSummary" Title="Proxy & Caching" Width="150px">
                    <Template Context="r">
                        <div class="d-flex flex-column gap-1">
                            <span class="text-muted" style="font-size: 0.75rem;">Timeout: <strong>@(r.TimeoutSeconds)s</strong></span>
                            <div class="d-flex gap-1">
                                @if (r.EnableCaching)
                                {
                                    <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="Cache" IsPill="true" Style="font-size: 0.65rem;" />
                                }
                                @if (r.ForwardOriginalHost)
                                {
                                    <RadzenBadge BadgeStyle="BadgeStyle.Primary" Text="FwdHost" IsPill="true" Style="font-size: 0.65rem;" />
                                }
                            </div>
                        </div>
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="GatewayRouteAdminModel" Property="StatusSummary" Title="Status" Width="100px">
                    <Template Context="r">
                        @if (r.IsEnabled)
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="Aktywna" IsPill="true" />
                        }
                        else
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="Wyłączona" IsPill="true" />
                        }
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="GatewayRouteAdminModel" Title="Akcje" Width="120px" Sortable="false" Filterable="false" TextAlign="TextAlign.End">
                    <Template Context="r">
                        <div class="d-flex justify-content-end gap-1">
                            <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Flat" Size="ButtonSize.Small" Click="@(() => NavigationManager.NavigateTo($"admin/gateway/{r.Id}/edit"))" Tooltip="Edytuj trasę" />
                            <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Small" Click="@(() => ConfirmDeleteAsync(r))" Tooltip="Usuń trasę" />
                        </div>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </RadzenCard>
</RadzenStack>
