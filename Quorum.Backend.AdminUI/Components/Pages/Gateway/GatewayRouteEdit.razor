@page "/admin/gateway/create"
@page "/admin/gateway/{Id:int}/edit"
@layout AdminLayout
@using Quorum.Backend.EntityFramework.Models
@inject IAdminGatewayStore GatewayStore
@inject IAdminApiScopeStore ApiScopeStore
@inject IAdminIdentityResourceStore IdentityResourceStore
@inject NotificationService NotificationService
@inject NavigationManager NavigationManager

<PageTitle>@(IsNew ? "Nowa Trasa Gateway" : $"Edycja Trasy: {model.MatchPattern}") | Quorum Admin UI</PageTitle>

<RadzenStack Gap="1.5rem">
    <RadzenRow JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
        <RadzenColumn Size="12" SizeMD="8">
            <div class="d-flex align-items-center gap-2">
                <RadzenIcon Icon="alt_route" Style="font-size: 2rem; color: var(--rz-primary);" />
                <div>
                    <RadzenText TextStyle="TextStyle.H4" Class="fw-bold mb-0">
                        @(IsNew ? "Nowa Trasa API Gateway" : $"Edycja Trasy: {model.MatchPattern}")
                    </RadzenText>
                    <RadzenText TextStyle="TextStyle.Body2" Class="text-muted">
                        Konfiguracja dopasowania ścieżki URL, przekierowania do serwerów upstream, uwierzytelniania i parametrów Reverse Proxy.
                    </RadzenText>
                </div>
            </div>
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="4" Class="d-flex justify-content-md-end gap-2">
            @if (!IsNew)
            {
                <RadzenButton Icon="science" Text="Testuj w Symulatorze" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Outlined" Click="@NavigateToTester" />
            }
            <RadzenButton Icon="arrow_back" Text="Powrót do listy" ButtonStyle="ButtonStyle.Light" Click="@(() => NavigationManager.NavigateTo("admin/gateway"))" />
        </RadzenColumn>
    </RadzenRow>

    <RadzenCard Class="rz-p-4">
        <RadzenTemplateForm TItem="GatewayRouteAdminModel" Data="@model" Submit="@HandleSubmitAsync">
            <RadzenTabs SelectedIndex="0">
                <Tabs>
                    <!-- KARTA 1: Routing Przychodzący i Dopasowanie -->
                    <RadzenTabsItem Text="1. Dopasowanie Żądania (Inbound)">
                        <RadzenStack Gap="1.25rem" Class="mt-3">
                            <RadzenRow Gap="1rem">
                                <RadzenColumn Size="12" SizeMD="8">
                                    <RadzenFormField Text="Wzorzec Dopasowania Ścieżki (MatchPattern)" Class="w-100">
                                        <RadzenTextBox @bind-Value="model.MatchPattern" Name="MatchPattern" Class="w-100" Placeholder="np. /api/v1/{grupa1}/{grupa2} lub ^/api/v1/(?<grupa1>[^/]+)/(?<grupa2>[^/]+)" />
                                    </RadzenFormField>
                                    <RadzenRequiredValidator Component="MatchPattern" Text="Wzorzec ścieżki (MatchPattern) jest wymagany." />
                                    <div class="d-flex align-items-center gap-2 mt-1">
                                        <span class="text-muted small">Typ dopasowania:</span>
                                        @if (model.IsTemplate)
                                        {
                                            <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="Szablon Ścieżki z Parametrami {grupa}" IsPill="true" />
                                        }
                                        else if (model.IsRegex)
                                        {
                                            <RadzenBadge BadgeStyle="BadgeStyle.Primary" Text="Wyrażenie Regularne (Regex)" IsPill="true" />
                                        }
                                        else
                                        {
                                            <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="Dopasowanie Ścieżki / Prefiks" IsPill="true" />
                                        }
                                    </div>
                                    <span class="text-muted small d-block mt-1">
                                        Obsługuje szablony parametrów (np. <code>/api/v1/{grupa1}/{grupa2}</code>), grupy nazwane Regex (np. <code>(?&lt;grupa1&gt;[^/]+)</code>) i grupy indeksowane <code>(.*)</code>.
                                    </span>
                                </RadzenColumn>

                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenFormField Text="Priorytet Dopasowania (Priority)" Class="w-100">
                                        <RadzenNumeric @bind-Value="model.Priority" Class="w-100" />
                                    </RadzenFormField>
                                    <span class="text-muted small">Wyższa liczba = sprawdzana wcześniej</span>
                                </RadzenColumn>

                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField Text="Nazwa Trasy (RouteName)" Class="w-100">
                                        <RadzenTextBox @bind-Value="model.RouteName" Class="w-100" Placeholder="np. Orders Microservice API" />
                                    </RadzenFormField>
                                </RadzenColumn>

                                <RadzenColumn Size="12" SizeMD="6">
                                    <div class="d-flex align-items-center gap-3 p-3 bg-light rounded border h-100">
                                        <RadzenCheckBox @bind-Value="model.IsEnabled" Name="IsEnabled" />
                                        <div>
                                            <RadzenLabel Text="Trasa Aktywna w Gateway" Component="IsEnabled" Class="fw-bold d-block" />
                                            <span class="text-muted small">Wyłączenie powoduje pominięcie trasy w reverse proxy</span>
                                        </div>
                                    </div>
                                </RadzenColumn>

                                <RadzenColumn Size="12" SizeMD="6">
                                    <div class="d-flex align-items-center gap-3 p-3 bg-light rounded border h-100">
                                        <RadzenCheckBox @bind-Value="model.NotifyGateway" Name="NotifyGatewayTab" />
                                        <div>
                                            <RadzenLabel Text="Wyślij powiadomienie o aktualizacji" Component="NotifyGatewayTab" Class="fw-bold d-block" />
                                            <span class="text-muted small">Powiadamia w czasie rzeczywistym instancje bramki (SignalR)</span>
                                        </div>
                                    </div>
                                </RadzenColumn>

                                <RadzenColumn Size="12">
                                    <RadzenFormField Text="Dozwolone Metody HTTP (HttpMethods)" Class="w-100">
                                        <RadzenDropDown @bind-Value="model.AllowedHttpMethods" Data="@allHttpMethods" Multiple="true" AllowClear="true" Placeholder="Wybierz dozwolone metody HTTP..." Class="w-100" />
                                    </RadzenFormField>
                                    <div class="d-flex flex-wrap gap-2 align-items-center mt-2">
                                        <span class="text-muted small me-1">Szybki wybór metod:</span>
                                        <RadzenButton Text="Wszystkie (ALL)" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Light" Click="@(() => SetMethodsPreset("ALL"))" />
                                        <RadzenButton Text="REST (GET, POST, PUT, DELETE)" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Light" Click="@(() => SetMethodsPreset("REST"))" />
                                        <RadzenButton Text="Tylko Odczyt (GET, HEAD)" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Light" Click="@(() => SetMethodsPreset("READ"))" />
                                    </div>
                                </RadzenColumn>

                                <RadzenColumn Size="12">
                                    <RadzenFormField Text="Opis Funkcjonalny Trasy" Class="w-100">
                                        <RadzenTextArea @bind-Value="model.Description" Rows="2" Class="w-100" Placeholder="Szczegółowy opis przeznaczenia usługi, formatu zwracanych danych..." />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenStack>
                    </RadzenTabsItem>

                    <!-- KARTA 2: Cel Przekierowania (Upstream Host, URI, Nagłówki & Body) -->
                    <RadzenTabsItem Text="2. Upstream, Nagłówki & Body">
                        <RadzenStack Gap="1.25rem" Class="mt-3">
                            <!-- Podgląd docelowego URL w czasie rzeczywistym -->
                            <div class="p-3 rounded border bg-light">
                                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <RadzenIcon Icon="link" Style="color: var(--rz-primary);" />
                                        <span class="fw-bold">Podgląd Docelowego Adresu Upstream:</span>
                                    </div>
                                    <div class="d-flex flex-wrap gap-2">
                                        <RadzenButton Text="Szablon: Lokalny (5001)" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Light" Click="@SetLocalPreset" />
                                        <RadzenButton Text="Szablon: Kontener K8s" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Light" Click="@SetK8sPreset" />
                                        <RadzenButton Text="Szablon: Zewnętrzne HTTPS" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Light" Click="@SetExternalPreset" />
                                    </div>
                                </div>
                                <div class="p-2 bg-white rounded border" style="font-family: monospace; font-size: 0.95rem; color: #0284c7; word-break: break-all;">
                                    @GetCalculatedUpstreamPreview()
                                </div>
                            </div>

                            <RadzenRow Gap="1rem">
                                <RadzenColumn Size="12" SizeMD="3">
                                    <RadzenFormField Text="Protokół (Scheme)" Class="w-100">
                                        <RadzenDropDown @bind-Value="model.Scheme" Data="@schemesList" Class="w-100" />
                                    </RadzenFormField>
                                </RadzenColumn>

                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField Text="Host Docelowy (AddressHost)" Class="w-100">
                                        <RadzenTextBox @bind-Value="model.AddressHost" Name="AddressHost" Class="w-100" Placeholder="np. orders-service.internal lub api.example.com" />
                                    </RadzenFormField>
                                    <RadzenRequiredValidator Component="AddressHost" Text="Host docelowy (AddressHost) jest wymagany." />
                                </RadzenColumn>

                                <RadzenColumn Size="12" SizeMD="3">
                                    <RadzenFormField Text="Port Docelowy (AddressPort)" Class="w-100">
                                        <RadzenNumeric @bind-Value="model.AddressPort" Class="w-100" Min="1" Max="65535" />
                                    </RadzenFormField>
                                </RadzenColumn>

                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField Text="Ścieżka Bazowa Upstream (AddressBasePath)" Class="w-100">
                                        <RadzenTextBox @bind-Value="model.AddressBasePath" Class="w-100" Placeholder="np. /v1 lub (empty)" />
                                    </RadzenFormField>
                                    <span class="text-muted small">Doklejana przed ścieżką żądania. Wpisz <code>(empty)</code>, aby usunąć bazową ścieżkę.</span>
                                </RadzenColumn>

                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField Text="Nadpisanie Ścieżki Docelowej (AddressPath)" Class="w-100">
                                        <RadzenTextBox @bind-Value="model.AddressPath" Class="w-100" Placeholder="np. /{grupa1}/{grupa2}/v1/orders lub (empty)" />
                                    </RadzenFormField>
                                    <span class="text-muted small">
                                        Podstawianie grup: <code>{grupa1}</code>, <code>$1</code>. Wpisz <code>(empty)</code>, aby wyczyścić ścieżkę. Puste = zachowaj ścieżkę wejściową.
                                    </span>
                                </RadzenColumn>

                                <RadzenColumn Size="12">
                                    <RadzenFormField Text="Domyślne Parametry Zapytania (AddressQueryString)" Class="w-100">
                                        <RadzenTextBox @bind-Value="model.AddressQueryString" Class="w-100" Placeholder="np. format=json&version=2 lub (empty)" />
                                    </RadzenFormField>
                                    <span class="text-muted small">Parametry doklejane do URL. Wpisz <code>(empty)</code>, aby całkowicie wyczyścić query string w upstream.</span>
                                </RadzenColumn>

                                <RadzenColumn Size="12">
                                    <RadzenFormField Text="Niestandardowe Nagłówki HTTP (Headers)" Class="w-100">
                                        <RadzenTextArea @bind-Value="model.Headers" Rows="3" Class="w-100" Placeholder="np. X-Gateway-Proxy: Quorum&#10;Authorization: (empty)&#10;Cookie: (empty)" />
                                    </RadzenFormField>
                                    <span class="text-muted small">
                                        Dodatkowe nagłówki wstrzykiwane lub usuwane z zapytania upstream. Wpisanie wartości <code>(empty)</code> (np. <code>Authorization: (empty)</code>) usuwa dany nagłówek przed przekazaniem do serwera docelowego.
                                    </span>
                                </RadzenColumn>
                            </RadzenRow>

                            <!-- SEKCJA TRANSFORMACJI CIAŁA ŻĄDANIA (REQUEST BODY) -->
                            <div class="p-3 rounded border bg-light mt-2">
                                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                                    <div>
                                        <div class="d-flex align-items-center gap-2">
                                            <RadzenIcon Icon="code" Style="color: var(--rz-primary);" />
                                            <span class="fw-bold">Transformacja Treści Żądania (Request Body):</span>
                                        </div>
                                        <span class="text-muted small">
                                            Transformuj wejściowy JSON przed wysłaniem do serwera docelowego za pomocą szablonów <strong>Fluid (Liquid)</strong> lub <strong>JUST.net</strong>.
                                        </span>
                                    </div>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="small fw-bold">Silnik:</span>
                                        <RadzenSelectBar @bind-Value="model.BodyTransformType" TValue="string" Change="@((args) => OnBodySettingsChanged())" Size="ButtonSize.Small">
                                            <Items>
                                                <RadzenSelectBarItem Text="Fluid (Liquid: {{ body.prop }})" Value="@("Fluid")" />
                                                <RadzenSelectBarItem Text="JUST.net (JSON Transform)" Value="@("JUST")" />
                                            </Items>
                                        </RadzenSelectBar>
                                    </div>
                                </div>

                                <div class="d-flex flex-wrap gap-1 mb-2">
                                    <span class="small text-muted align-self-center me-1">Szablony pomocnicze:</span>
                                    @if (model.BodyTransformType == "JUST")
                                    {
                                        <button type="button" class="btn btn-xs btn-outline-secondary btn-sm" @onclick="@(() => SetJustPreset(1))">JUST: Mapowanie #valueof</button>
                                        <button type="button" class="btn btn-xs btn-outline-secondary btn-sm" @onclick="@(() => SetJustPreset(2))">JUST: #concat & #if</button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-xs btn-outline-secondary btn-sm" @onclick="@(() => SetFluidPreset(1))">Fluid: {{ body.JsonProperty }}</button>
                                        <button type="button" class="btn btn-xs btn-outline-secondary btn-sm" @onclick="@(() => SetFluidPreset(2))">Fluid: Warunki & Pętle</button>
                                    }
                                    <button type="button" class="btn btn-xs btn-outline-warning btn-sm" @onclick="SetEmptyBodyPreset">(empty) - Usuń treść</button>
                                    <button type="button" class="btn btn-xs btn-outline-danger btn-sm" @onclick="ClearBody">Wyczyść (brak transformacji)</button>
                                </div>

                                <RadzenFormField Text="Szablon Transformacji Body (Pozostaw puste, aby przekazać treść bez zmian)" Class="w-100">
                                    <RadzenTextArea @bind-Value="model.Body" @oninput="@((args) => OnBodyInputChanged(args.Value?.ToString()))" Rows="5" Class="w-100 font-monospace" Placeholder="@(model.BodyTransformType == "JUST" ? "{\n  \"targetId\": \"#valueof($.id)\",\n  \"userName\": \"#valueof($.name)\"\n}" : "{\n  \"userId\": {{ body.id }},\n  \"user\": \"{{ body.name }}\",\n  \"email\": \"{{ body.email }}\"\n}")" />
                                </RadzenFormField>

                                <div class="mt-2 text-muted small">
                                    @if (model.BodyTransformType == "JUST")
                                    {
                                        <span>
                                            <i class="bi bi-info-circle"></i> <strong>Składnia JUST.net:</strong> Używaj funkcji takich jak <code>#valueof($.sciezka)</code>, <code>#concat($.a, ' ', $.b)</code>, <code>#if(warunek, prawda, falsz)</code>. Wpisz <code>(empty)</code>, aby usunąć treść żądania.
                                        </span>
                                    }
                                    else
                                    {
                                        <span>
                                            <i class="bi bi-info-circle"></i> <strong>Składnia Fluid (Liquid):</strong> Odwołuj się do pól wejściowego JSON przez <code>{{ body.nazwaPola }}</code>, nagłówków <code>{{ headers.NazwaNaglowka }}</code> lub grup regex <code>{{ groups.nazwaGrupy }}</code>. Wpisz <code>(empty)</code>, aby usunąć treść żądania.
                                        </span>
                                    }
                                </div>

                                <!-- PODGLĄD TRANSFORMACJI BODY NA ŻYWO -->
                                <div class="mt-3 border-top pt-3">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="fw-bold small text-secondary">
                                            <i class="bi bi-play-circle me-1"></i> Podgląd Transformacji Body na Żywo:
                                        </span>
                                        <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none" @onclick="UpdateBodyPreview">
                                            <i class="bi bi-arrow-clockwise"></i> Odśwież podgląd
                                        </button>
                                    </div>

                                    <div class="row g-2">
                                        <div class="col-md-6">
                                            <label class="form-label small text-muted mb-1">Przykładowy wejściowy JSON żądania:</label>
                                            <textarea class="form-control form-control-sm font-monospace" rows="4" @bind="sampleBodyInput" @bind:event="oninput" @bind:after="UpdateBodyPreview"></textarea>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label small text-muted mb-1">Wygenerowany wynik wysyłany do Upstream:</label>
                                            @if (!string.IsNullOrEmpty(sampleBodyError))
                                            {
                                                <div class="alert alert-danger py-1 px-2 font-monospace small mb-0" style="height: 102px; overflow-y: auto;">
                                                    <i class="bi bi-exclamation-triangle-fill me-1"></i> @sampleBodyError
                                                </div>
                                            }
                                            else
                                            {
                                                <textarea class="form-control form-control-sm font-monospace bg-light" rows="4" readonly value="@sampleBodyOutput"></textarea>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </RadzenStack>
                    </RadzenTabsItem>

                    <!-- KARTA 3: Uwierzytelnianie & Uprawnienia Scopes -->
                    <RadzenTabsItem Text="3. Uwierzytelnianie & Scopes">
                        <RadzenStack Gap="1.25rem" Class="mt-3">
                            <RadzenRow Gap="1rem">
                                <RadzenColumn Size="12" SizeMD="6">
                                    <div class="d-flex align-items-center gap-3 p-3 bg-light rounded border h-100">
                                        <RadzenCheckBox @bind-Value="model.AllowAnonymous" Name="AllowAnonymous" />
                                        <div>
                                            <RadzenLabel Text="Zezwalaj na Dostęp Anonimowy (AllowAnonymous)" Component="AllowAnonymous" Class="fw-bold d-block" />
                                            <span class="text-muted small">Ruch do tej trasy nie wymaga nagłówka Authorization ani tokenu JWT</span>
                                        </div>
                                    </div>
                                </RadzenColumn>

                                <RadzenColumn Size="12" SizeMD="6">
                                    <div class="d-flex align-items-center gap-3 p-3 bg-light rounded border h-100">
                                        <RadzenCheckBox @bind-Value="model.RequiredScope" Name="RequiredScope" />
                                        <div>
                                            <RadzenLabel Text="Wymagaj Weryfikacji Scopes (RequiredScope)" Component="RequiredScope" Class="fw-bold d-block" />
                                            <span class="text-muted small">Egzekwuj obecność wymaganych zakresów w roszczeniach tokenu JWT</span>
                                        </div>
                                    </div>
                                </RadzenColumn>

                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField Text="Wymagany Schemat Uwierzytelniania (AuthenticationSchemes)" Class="w-100">
                                        <RadzenTextBox @bind-Value="model.AuthenticationSchemes" Class="w-100" Placeholder="Bearer" />
                                    </RadzenFormField>
                                    <span class="text-muted small">Domyślnie: Bearer (możliwe: Bearer, Cookies, OpenIdConnect)</span>
                                </RadzenColumn>

                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField Text="Powiązany Zasób API (ApiScopeId - opcjonalny)" Class="w-100">
                                        <RadzenDropDown @bind-Value="model.ApiScopeId" 
                                                        Data="@dbApiScopesList" 
                                                        TextProperty="DisplayNameOrName" 
                                                        ValueProperty="Id" 
                                                        AllowClear="true" 
                                                        Placeholder="Wybierz powiązany zasób z tabeli ApiScopes..." 
                                                        Class="w-100" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>

                            <!-- ChipList z wybranymi scopes -->
                            <RadzenFieldset Text="Wymagane Zakresy dla tej Trasy (Required Scopes)" Class="rz-p-3">
                                @if (model.RequiredScopes == null || model.RequiredScopes.Count == 0)
                                {
                                    <div class="d-flex align-items-center gap-2 p-3 text-muted bg-light rounded border border-dashed">
                                        <RadzenIcon Icon="info" Style="font-size: 1.25rem; color: #64748b;" />
                                        <span>Brak zdefiniowanych wymaganych scopes. Każdy uwierzytelniony token uzyska dostęp do trasy (lub anonimowy, jeśli zaznaczono AllowAnonymous).</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="d-flex flex-wrap gap-2 align-items-center p-3 rounded border bg-light">
                                        @foreach (var scope in model.RequiredScopes)
                                        {
                                            var scopeInfo = allAvailableScopesList.FirstOrDefault(s => s.Name.Equals(scope, StringComparison.OrdinalIgnoreCase));
                                            var isIdentity = scopeInfo?.IsIdentity ?? false;

                                            <div class="d-inline-flex align-items-center gap-2 px-3 py-1.5 rounded-pill shadow-sm border bg-white" style="font-size: 0.875rem;">
                                                <RadzenIcon Icon="@(isIdentity ? "badge" : "api")" Style="@(isIdentity ? "font-size: 1.1rem; color: var(--rz-primary);" : "font-size: 1.1rem; color: var(--rz-info);")" />
                                                <span class="fw-semibold text-dark">@scope</span>
                                                @if (scopeInfo != null && !string.IsNullOrWhiteSpace(scopeInfo.DisplayName) && scopeInfo.DisplayName != scope)
                                                {
                                                    <span class="text-muted" style="font-size: 0.75rem;">(@scopeInfo.DisplayName)</span>
                                                }
                                                <button type="button" 
                                                        class="btn btn-sm btn-link text-danger p-0 ms-1 d-inline-flex align-items-center" 
                                                        style="text-decoration: none; line-height: 1;" 
                                                        title="Usuń scope @scope" 
                                                        @onclick="@(() => RemoveScope(scope))" 
                                                        @onclick:stopPropagation="true">
                                                    <RadzenIcon Icon="close" Style="font-size: 1rem;" />
                                                </button>
                                            </div>
                                        }
                                        <div class="ms-auto d-flex gap-2">
                                            <RadzenButton Text="Wyczyść wszystkie" 
                                                          Icon="clear_all" 
                                                          Size="ButtonSize.ExtraSmall" 
                                                          ButtonStyle="ButtonStyle.Light" 
                                                          Variant="Variant.Outlined" 
                                                          Click="@ClearAllScopes" />
                                        </div>
                                    </div>
                                }
                            </RadzenFieldset>

                            <!-- Tabela do wyboru scopes przez kliknięcie -->
                            <RadzenStack Gap="0.75rem">
                                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                    <div>
                                        <RadzenText TextStyle="TextStyle.Subtitle2" Class="fw-bold mb-0">Dostępne Zakresy API i Tożsamości</RadzenText>
                                        <RadzenText TextStyle="TextStyle.Caption" Class="text-muted">Kliknij w wiersz, aby dodać lub odpiąć wymagany zakres dla tej trasy Gateway.</RadzenText>
                                    </div>
                                    <div class="d-flex align-items-center gap-2">
                                        <RadzenTextBox @bind-Value="scopeSearchTerm" 
                                                       Placeholder="Filtruj zakresy..." 
                                                       @oninput="@((ChangeEventArgs e) => scopeSearchTerm = e.Value?.ToString() ?? string.Empty)" 
                                                       Class="rz-textbox-sm" 
                                                       Style="width: 220px;" />
                                        @if (!string.IsNullOrEmpty(scopeSearchTerm))
                                        {
                                            <RadzenButton Icon="close" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Light" Click="@(() => scopeSearchTerm = string.Empty)" />
                                        }
                                    </div>
                                </div>

                                <RadzenDataGrid Data="@FilteredScopes"
                                                TItem="ScopeItemModel"
                                                AllowPaging="true"
                                                PageSize="5"
                                                AllowSorting="true"
                                                RowClick="@OnScopeRowClick"
                                                Style="cursor: pointer;"
                                                Class="rz-shadow-1">
                                    <Columns>
                                        <RadzenDataGridColumn TItem="ScopeItemModel" Property="Name" Title="Nazwa Zakresu (Scope)" Width="180px">
                                            <Template Context="s">
                                                <div class="d-flex align-items-center gap-2">
                                                    <RadzenIcon Icon="@(s.IsIdentity ? "badge" : "api")" Style="@(s.IsIdentity ? "color: var(--rz-primary);" : "color: var(--rz-info);")" />
                                                    <span class="fw-bold">@s.Name</span>
                                                </div>
                                            </Template>
                                        </RadzenDataGridColumn>
                                        <RadzenDataGridColumn TItem="ScopeItemModel" Property="DisplayName" Title="Nazwa Wyświetlana" Width="200px">
                                            <Template Context="s">
                                                @(string.IsNullOrWhiteSpace(s.DisplayName) ? s.Name : s.DisplayName)
                                            </Template>
                                        </RadzenDataGridColumn>
                                        <RadzenDataGridColumn TItem="ScopeItemModel" Property="Type" Title="Typ" Width="140px">
                                            <Template Context="s">
                                                <RadzenBadge BadgeStyle="@(s.IsIdentity ? BadgeStyle.Primary : BadgeStyle.Info)" Text="@s.Type" IsPill="true" />
                                            </Template>
                                        </RadzenDataGridColumn>
                                        <RadzenDataGridColumn TItem="ScopeItemModel" Property="Description" Title="Opis">
                                            <Template Context="s">
                                                <span class="text-muted small">@(string.IsNullOrWhiteSpace(s.Description) ? "Brak opisu" : s.Description)</span>
                                            </Template>
                                        </RadzenDataGridColumn>
                                        <RadzenDataGridColumn TItem="ScopeItemModel" Title="Status / Akcja" Width="140px" TextAlign="TextAlign.Center" Sortable="false">
                                            <Template Context="s">
                                                @if (model.RequiredScopes.Contains(s.Name))
                                                {
                                                    <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="Wymagany ✓" IsPill="true" />
                                                }
                                                else
                                                {
                                                    <RadzenButton Icon="add" Text="Dodaj" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Flat" Click="@(() => AddScope(s.Name))" @onclick:stopPropagation="true" />
                                                }
                                            </Template>
                                        </RadzenDataGridColumn>
                                    </Columns>
                                </RadzenDataGrid>
                            </RadzenStack>
                        </RadzenStack>
                    </RadzenTabsItem>

                    <!-- KARTA 4: Zaawansowane Parametry Proxy & Wydajność -->
                    <RadzenTabsItem Text="4. Zaawansowane Parametry Proxy">
                        <RadzenStack Gap="1.25rem" Class="mt-3">
                            <RadzenRow Gap="1rem">
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenFormField Text="Limit Czasu Żądania (Timeout w sekundach)" Class="w-100">
                                        <RadzenNumeric @bind-Value="model.TimeoutSeconds" Class="w-100" Min="1" Max="600" />
                                    </RadzenFormField>
                                    <span class="text-muted small">Domyślnie 30 sekund</span>
                                </RadzenColumn>

                                <RadzenColumn Size="12" SizeMD="4">
                                    <div class="d-flex align-items-center gap-3 p-3 bg-light rounded border h-100">
                                        <RadzenCheckBox @bind-Value="model.ForwardOriginalHost" Name="ForwardOriginalHost" />
                                        <div>
                                            <RadzenLabel Text="Przekazuj Nagłówek Host Klienta" Component="ForwardOriginalHost" Class="fw-bold d-block" />
                                            <span class="text-muted small">Forward Original Host do serwisu backendowego</span>
                                        </div>
                                    </div>
                                </RadzenColumn>

                                <RadzenColumn Size="12" SizeMD="4">
                                    <div class="d-flex align-items-center gap-3 p-3 bg-light rounded border h-100">
                                        <RadzenCheckBox @bind-Value="model.EnableCaching" Name="EnableCaching" />
                                        <div>
                                            <RadzenLabel Text="Buforowanie Odpowiedzi (Caching)" Component="EnableCaching" Class="fw-bold d-block" />
                                            <span class="text-muted small">Response Caching dla operacji idempotencyjnych</span>
                                        </div>
                                    </div>
                                </RadzenColumn>
                            </RadzenRow>

                            @if (!IsNew)
                            {
                                <div class="p-3 bg-light rounded border mt-2">
                                    <RadzenText TextStyle="TextStyle.Subtitle2" Class="fw-bold mb-2">Informacje o Rekordzie</RadzenText>
                                    <RadzenRow Gap="1rem">
                                        <RadzenColumn Size="12" SizeMD="6">
                                            <span class="text-muted small">Data utworzenia:</span>
                                            <span class="fw-bold ms-1">@model.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</span>
                                        </RadzenColumn>
                                        <RadzenColumn Size="12" SizeMD="6">
                                            <span class="text-muted small">Ostatnia modyfikacja:</span>
                                            <span class="fw-bold ms-1">@(model.UpdatedAt.HasValue ? model.UpdatedAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss") : "Brak wcześniejszych edycji")</span>
                                        </RadzenColumn>
                                    </RadzenRow>
                                </div>
                            }
                        </RadzenStack>
                    </RadzenTabsItem>
                </Tabs>
            </RadzenTabs>

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mt-4 pt-3 border-top">
                <div class="d-flex align-items-center gap-2">
                    <RadzenCheckBox @bind-Value="model.NotifyGateway" Name="NotifyGatewayFooter" />
                    <div>
                        <RadzenLabel Text="Wyślij powiadomienie o aktualizacji" Component="NotifyGatewayFooter" Class="fw-bold d-block mb-0" />
                        <span class="text-muted small">Powiadamia w czasie rzeczywistym instancje Quorum.Backend.Gateway (SignalR)</span>
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <RadzenButton Text="Anuluj" ButtonStyle="ButtonStyle.Light" Click="@(() => NavigationManager.NavigateTo("admin/gateway"))" />
                    <RadzenButton ButtonType="ButtonType.Submit" Text="@(IsNew ? "Utwórz Trasę API Gateway" : "Zapisz Zmiany")" Icon="save" ButtonStyle="ButtonStyle.Primary" IsBusy="@isSubmitting" />
                </div>
            </div>
        </RadzenTemplateForm>
    </RadzenCard>
</RadzenStack>

