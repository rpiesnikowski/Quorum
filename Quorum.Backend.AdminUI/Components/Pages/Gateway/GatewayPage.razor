@page "/Admin/Gateway"
@using Quorum.Backend.AdminUI.Services
@using Quorum.Backend.EntityFramework.Models
@inject IGatewayAdminService GatewayService
@inject DialogService DialogService
@inject NotificationService NotificationService
@inject NavigationManager NavigationManager

<PageTitle>API Gateway - Admin</PageTitle>

<RadzenStack Gap="1.5rem">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
        <div>
            <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" class="rz-mb-0">Trasy API Gateway</RadzenText>
            <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary-color">
                Konfiguracja odwrotnego proxy, reguł routingu Regex, autoryzacji Scopes oraz transformacji adresów.
            </RadzenText>
        </div>
        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
            <RadzenButton Text="Mapowania Scopes" Icon="link" ButtonStyle="ButtonStyle.Light" Click="@(() => NavigationManager.NavigateTo("Admin/Gateway/Scopes"))" />
            <RadzenButton Text="Tester Routingu" Icon="science" ButtonStyle="ButtonStyle.Info" Click="@(() => NavigationManager.NavigateTo("Admin/Gateway/Test"))" />
            <RadzenButton Text="Dodaj Trasę" Icon="add_circle" ButtonStyle="ButtonStyle.Primary" Click="@(() => NavigationManager.NavigateTo("Admin/Gateway/Create"))" />
        </RadzenStack>
    </RadzenStack>

    @if (isLoading)
    {
        <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
    }
    else
    {
        <GatewayRoutesGrid Routes="@routes" OnToggleRoute="@HandleToggleRoute" OnDeleteRoute="@HandleDeleteRoute" />
    }
</RadzenStack>

@code {
    private List<GatewayRoute> routes = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadRoutesAsync();
    }

    private async Task LoadRoutesAsync()
    {
        isLoading = true;
        try
        {
            routes = await GatewayService.GetAllRoutesAsync();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleToggleRoute(GatewayRoute route)
    {
        var success = await GatewayService.ToggleRouteStatusAsync(route.Id);
        if (success)
        {
            NotificationService.Notify(NotificationSeverity.Success, "Sukces", $"Zmieniono status trasy '{route.MatchPattern}'.");
            await LoadRoutesAsync();
        }
    }

    private async Task HandleDeleteRoute(GatewayRoute route)
    {
        var confirm = await DialogService.Confirm(
            $"Czy na pewno chcesz usunąć trasę '{route.MatchPattern}'?",
            "Potwierdzenie Usunięcia Trasy",
            new ConfirmOptions { OkButtonText = "Usuń", CancelButtonText = "Anuluj" });

        if (confirm == true)
        {
            var success = await GatewayService.DeleteRouteAsync(route.Id);
            if (success)
            {
                NotificationService.Notify(NotificationSeverity.Success, "Sukces", $"Trasa '{route.MatchPattern}' została usunięta.");
                await LoadRoutesAsync();
            }
        }
    }
}
