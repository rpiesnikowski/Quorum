@page "/Admin/Gateway/Test"
@using Quorum.Backend.AdminUI.Components.Layout
@using Quorum.Backend.AdminUI.Services
@using Quorum.Backend.EntityFramework.Entities
@layout AdminLayout
@inject IGatewayAdminService GatewayService
@inject NavigationManager NavigationManager

<PageTitle>Tester API Gateway - Admin</PageTitle>

<RadzenStack Gap="1.5rem">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
        <div>
            <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" class="rz-mb-0">Symulator Routingu API Gateway</RadzenText>
            <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary-color">
                Przetestuj dopasowywanie tras proxy, ewaluację Regex, weryfikację uprawnień Scopes i przekazywanie URI.
            </RadzenText>
        </div>
        <RadzenButton Text="Powrót do tras" Icon="arrow_back" ButtonStyle="ButtonStyle.Light" Click="@(() => NavigationManager.NavigateTo("Admin/Gateway"))" />
    </RadzenStack>

    <RadzenCard>
        <RadzenTemplateForm TItem="GatewayTestRequest" Data="@request" Submit="@HandleTest">
            <RadzenStack Gap="1rem">
                <RadzenRow Gaps="1rem">
                    <RadzenColumn Size="12" SizeMD="3">
                        <RadzenFormField Text="Metoda HTTP *" Style="width: 100%;">
                            <RadzenDropDown @bind-Value="request.HttpMethod" Data="@(new[] { "GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS", "HEAD" })" Style="width: 100%;" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="9">
                        <RadzenFormField Text="Ścieżka Żądania (Request URL / Path) *" Style="width: 100%;">
                            <RadzenTextBox @bind-Value="request.RequestUrl" Name="RequestUrl" Style="width: 100%; font-family: monospace;" Placeholder="/api/v1/orders/123" />
                        </RadzenFormField>
                        <RadzenRequiredValidator Component="RequestUrl" Text="Ścieżka żądania jest wymagana" />
                    </RadzenColumn>
                </RadzenRow>

                <RadzenFormField Text="Token Bearer (JWT) lub Claimy (opcjonalnie)" Style="width: 100%;">
                    <RadzenTextArea @bind-Value="request.BearerToken" Style="width: 100%; font-family: monospace;" Rows="2" Placeholder="Wklej token JWT lub pozostaw puste dla żądania anonimowego" />
                </RadzenFormField>

                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
                    <RadzenButton Text="Uruchom Test Routingu" Icon="play_arrow" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary" IsBusy="@isLoading" />
                </RadzenStack>
            </RadzenStack>
        </RadzenTemplateForm>
    </RadzenCard>

    @if (testResult != null)
    {
        <RadzenCard>
            <RadzenText TextStyle="TextStyle.H6" class="rz-mb-3">Wynik Dopasowania Trasy</RadzenText>
            
            @if (testResult.IsMatched)
            {
                <RadzenAlert AlertStyle="AlertStyle.Success" Title="Dopasowano Trasę" AllowClose="false">
                    Żądanie pomyślnie dopasowano do reguły: <b>@testResult.MatchedRoute?.MatchPattern</b> (@testResult.MatchedRoute?.RouteName)
                </RadzenAlert>

                <RadzenStack Gap="0.5rem" class="rz-mt-3">
                    <RadzenText TextStyle="TextStyle.Body2"><b>Docelowy URL Upstream:</b> <code>@testResult.TargetUpstreamUrl</code></RadzenText>
                    <RadzenText TextStyle="TextStyle.Body2"><b>Status Autoryzacji:</b> 
                        <RadzenBadge BadgeStyle="@(testResult.IsAuthorized ? BadgeStyle.Success : BadgeStyle.Danger)" 
                                     Text="@(testResult.IsAuthorized ? "AUTORYZOWANY" : "BRAK UPRAWNIEŃ")" />
                    </RadzenText>
                    @if (!string.IsNullOrEmpty(testResult.AuthDetails))
                    {
                        <RadzenText TextStyle="TextStyle.Body2"><b>Szczegóły:</b> @testResult.AuthDetails</RadzenText>
                    }
                </RadzenStack>
            }
            else
            {
                <RadzenAlert AlertStyle="AlertStyle.Warning" Title="Brak Dopasowania" AllowClose="false">
                    Żadna aktywna reguła proxy nie dopasowała podanej ścieżki i metody HTTP.
                </RadzenAlert>
            }
        </RadzenCard>
    }
</RadzenStack>

@code {
    private GatewayTestRequest request = new()
    {
        HttpMethod = "GET",
        RequestUrl = "/api/v1/sample"
    };

    private GatewayTestResponse? testResult;
    private bool isLoading = false;

    private async Task HandleTest(GatewayTestRequest testReq)
    {
        isLoading = true;
        try
        {
            testResult = await GatewayService.ExecuteGatewayTestAsync(testReq);
        }
        finally
        {
            isLoading = false;
        }
    }
}
