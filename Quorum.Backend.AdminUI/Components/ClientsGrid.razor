@namespace Quorum.Backend.AdminUI.Components

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <QuickGrid Items="@ClientsQuery" Class="table table-hover align-middle mb-0" ResizableColumns="true">
            <PropertyColumn Property="@(c => c.ClientId)" Title="Client ID" Sortable="true" Class="fw-bold font-monospace text-primary" />
            <PropertyColumn Property="@(c => c.ClientName)" Title="Nazwa Klienta" Sortable="true" />
            <TemplateColumn Title="Typy Przepływów (Grant Types)">
                @if (context.AllowedGrantTypes != null)
                {
                    @foreach (var grant in context.AllowedGrantTypes)
                    {
                        <span class="badge bg-secondary-subtle text-secondary me-1">@grant.GrantType</span>
                    }
                }
            </TemplateColumn>
            <TemplateColumn Title="Dozwolone Scopes">
                @if (context.AllowedScopes != null)
                {
                    @foreach (var scope in context.AllowedScopes)
                    {
                        <span class="badge bg-info-subtle text-info me-1">@scope.Scope</span>
                    }
                }
            </TemplateColumn>
            <TemplateColumn Title="PKCE" Sortable="true" SortBy="@(GridSort<Client>.ByAscending(c => c.RequirePkce))">
                @(context.RequirePkce ? "Wymagane" : "Opcjonalne")
            </TemplateColumn>
            <TemplateColumn Title="Status" Sortable="true" SortBy="@(GridSort<Client>.ByAscending(c => c.Enabled))">
                @if (context.Enabled)
                {
                    <span class="badge bg-success-subtle text-success">Aktywny</span>
                }
                else
                {
                    <span class="badge bg-danger-subtle text-danger">Nieaktywny</span>
                }
            </TemplateColumn>
            <TemplateColumn Title="Akcje" Class="text-end text-nowrap">
                <a href="Clients/Edit?id=@context.Id" class="btn btn-sm btn-outline-primary me-1" title="Edytuj">
                    <i class="bi bi-pencil-square me-1"></i> Edytuj
                </a>
                <form method="post" action="Clients/Index?handler=Delete&id=@context.Id" class="d-inline" onsubmit="return confirm('Czy na pewno chcesz usunąć klienta @context.ClientId?');">
                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Usuń">
                        <i class="bi bi-trash"></i>
                    </button>
                </form>
            </TemplateColumn>
        </QuickGrid>
        @if (Clients == null || !Clients.Any())
        {
            <div class="text-center py-4 text-muted">
                <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                Brak zarejestrowanych klientów w bazie danych.
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public IEnumerable<Client>? Clients { get; set; }

    private IQueryable<Client> ClientsQuery => (Clients ?? Enumerable.Empty<Client>()).AsQueryable();
}
