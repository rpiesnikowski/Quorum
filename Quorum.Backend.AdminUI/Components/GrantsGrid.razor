@namespace Quorum.Backend.AdminUI.Components
@using Open.IdentityServer.EntityFramework.Entities

<RadzenCard class="rz-p-0 rz-shadow-1">
    <RadzenDataGrid Data="@Grants" TItem="PersistedGrant" 
                    AllowSorting="true" 
                    AllowFiltering="true" 
                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" 
                    FilterMode="FilterMode.Simple"
                    AllowPaging="true" 
                    PageSize="10" 
                    ShowPagingSummary="true"
                    PagingSummaryFormat="Strona {0} z {1} (łącznie {2} tokenów)"
                    AllowColumnResize="true"
                    Density="Density.Compact"
                    Responsive="true"
                    EmptyText="Brak aktywnych sesji tokenów w magazynie operacyjnym bazy danych.">
        <Columns>
            <RadzenDataGridColumn Property="@nameof(PersistedGrant.Type)" Title="Typ Grantu" Sortable="true" Filterable="true" Width="160px">
                <Template Context="grant">
                    <RadzenBadge BadgeStyle="BadgeStyle.Secondary" Text="@grant.Type" IsPill="true" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="@nameof(PersistedGrant.SubjectId)" Title="Subject ID (Użytkownik)" Sortable="true" Filterable="true">
                <Template Context="grant">
                    <span class="font-monospace small">@grant.SubjectId</span>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="@nameof(PersistedGrant.ClientId)" Title="Client ID" Sortable="true" Filterable="true" Width="200px">
                <Template Context="grant">
                    <span class="fw-semibold text-primary font-monospace">@grant.ClientId</span>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="@nameof(PersistedGrant.CreationTime)" Title="Data Utworzenia" Sortable="true" Filterable="true" Width="180px">
                <Template Context="grant">
                    <span class="small text-muted">@grant.CreationTime.ToString("yyyy-MM-dd HH:mm:ss")</span>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="@nameof(PersistedGrant.Expiration)" Title="Wygasa" Sortable="true" Filterable="true" Width="180px">
                <Template Context="grant">
                    <span class="small text-muted">@(grant.Expiration.HasValue ? grant.Expiration.Value.ToString("yyyy-MM-dd HH:mm:ss") : "Nigdy")</span>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Title="Akcje" Sortable="false" Filterable="false" TextAlign="TextAlign.Right" Width="140px">
                <Template Context="grant">
                    <RadzenButton Text="Unieważnij" Icon="cancel" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Click="@(() => OnRevokeGrant.InvokeAsync(grant))" />
                </Template>
            </RadzenDataGridColumn>
        </Columns>
        <EmptyTemplate>
            <div class="text-center py-4 text-muted">
                <RadzenIcon Icon="verified_user" Style="font-size: 2rem; display: block; margin-bottom: 0.5rem;" />
                Brak aktywnych sesji tokenów w magazynie operacyjnym bazy danych.
            </div>
        </EmptyTemplate>
    </RadzenDataGrid>
</RadzenCard>

@code {
    [Parameter]
    public IEnumerable<PersistedGrant>? Grants { get; set; }

    [Parameter]
    public EventCallback<PersistedGrant> OnRevokeGrant { get; set; }
}
