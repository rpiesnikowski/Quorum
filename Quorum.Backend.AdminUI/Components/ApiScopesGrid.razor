@namespace Quorum.Backend.AdminUI.Components

<RadzenCard class="rz-p-0 rz-shadow-1">
    <RadzenDataGrid Data="@Scopes" TItem="ApiScope" 
                    AllowSorting="true" 
                    AllowFiltering="true" 
                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" 
                    FilterMode="FilterMode.Simple"
                    AllowPaging="true" 
                    PageSize="@PageSize" 
                    ShowPagingSummary="true"
                    PagingSummaryFormat="Strona {0} z {1} (łącznie {2} zakresów)"
                    AllowColumnResize="true"
                    Density="Density.Compact"
                    Responsive="true"
                    EmptyText="Brak zdefiniowanych zakresów API w bazie.">
        <Columns>
            <RadzenDataGridColumn Property="@nameof(ApiScope.Name)" Title="Nazwa Scope" Sortable="true" Filterable="true" Width="200px">
                <Template Context="scope">
                    <span class="badge bg-light text-primary border font-monospace px-2 py-1 fs-6">@scope.Name</span>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="@nameof(ApiScope.DisplayName)" Title="Nazwa Wyświetlana" Sortable="true" Filterable="true" Width="220px">
                <Template Context="scope">
                    <span>@(string.IsNullOrWhiteSpace(scope.DisplayName) ? scope.Name : scope.DisplayName)</span>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="@nameof(ApiScope.Description)" Title="Opis" Sortable="true" Filterable="true">
                <Template Context="scope">
                    @if (!string.IsNullOrWhiteSpace(scope.Description))
                    {
                        <span class="text-muted small">@scope.Description</span>
                    }
                    else
                    {
                        <span class="text-muted fst-italic small">— brak opisu —</span>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="@nameof(ApiScope.Required)" Title="Wymagany" Sortable="true" Width="120px" TextAlign="TextAlign.Center">
                <Template Context="scope">
                    <RadzenBadge BadgeStyle="@(scope.Required ? BadgeStyle.Warning : BadgeStyle.Light)" 
                                 Text="@(scope.Required ? "Tak" : "Nie")" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="@nameof(ApiScope.Emphasize)" Title="Wyróżniony" Sortable="true" Width="120px" TextAlign="TextAlign.Center">
                <Template Context="scope">
                    <RadzenBadge BadgeStyle="@(scope.Emphasize ? BadgeStyle.Info : BadgeStyle.Light)" 
                                 Text="@(scope.Emphasize ? "Tak" : "Nie")" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="@nameof(ApiScope.Enabled)" Title="Status" Sortable="true" Width="120px" TextAlign="TextAlign.Center">
                <Template Context="scope">
                    <RadzenBadge BadgeStyle="@(scope.Enabled ? BadgeStyle.Success : BadgeStyle.Secondary)" 
                                 Text="@(scope.Enabled ? "Aktywny" : "Wyłączony")" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Title="Akcje" Sortable="false" Filterable="false" TextAlign="TextAlign.Right" Width="140px">
                <Template Context="scope">
                    <div class="btn-group btn-group-sm">
                        <a href="ApiScopes/Edit?id=@scope.Id" class="btn btn-outline-primary" title="Edytuj zakres">
                            <i class="bi bi-pencil me-1"></i> Edytuj
                        </a>
                        <form method="post" action="ApiScopes/Index?handler=Delete&id=@scope.Id" class="d-inline" onsubmit="return confirm('Czy na pewno chcesz usunąć zakres API \'@scope.Name\'?');">
                            <input type="hidden" name="search" value="@Search" />
                            <input type="hidden" name="statusFilter" value="@StatusFilter" />
                            <input type="hidden" name="currentPage" value="@CurrentPage" />
                            <input type="hidden" name="pageSize" value="@PageSize" />
                            <button type="submit" class="btn btn-outline-danger border-start-0" title="Usuń zakres">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </div>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
        <EmptyTemplate>
            <div class="text-center py-5 text-muted">
                <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary opacity-50"></i>
                @if (!string.IsNullOrWhiteSpace(Search) || !string.IsNullOrWhiteSpace(StatusFilter))
                {
                    <span>Nie znaleziono zakresów API spełniających podane kryteria filtrowania.</span>
                    <div class="mt-2">
                        <a href="ApiScopes" class="btn btn-sm btn-outline-primary">Wyczyść filtry</a>
                    </div>
                }
                else
                {
                    <span>Brak zdefiniowanych zakresów API w bazie.</span>
                }
            </div>
        </EmptyTemplate>
    </RadzenDataGrid>
</RadzenCard>

@code {
    [Parameter]
    public IEnumerable<ApiScope>? Scopes { get; set; }

    [Parameter]
    public string? Search { get; set; }

    [Parameter]
    public string? StatusFilter { get; set; }

    [Parameter]
    public int CurrentPage { get; set; } = 1;

    [Parameter]
    public int PageSize { get; set; } = 10;
}
