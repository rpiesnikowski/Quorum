@namespace Quorum.Backend.AdminUI.Components
@using Quorum.Backend.EntityFramework.Models
@inject NavigationManager NavigationManager

<RadzenCard class="rz-p-0 rz-shadow-1">
    <RadzenDataGrid Data="@Routes" TItem="GatewayRoute" 
                    AllowSorting="true" 
                    AllowFiltering="true" 
                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" 
                    FilterMode="FilterMode.Simple"
                    AllowPaging="true" 
                    PageSize="10" 
                    ShowPagingSummary="true"
                    PagingSummaryFormat="Strona {0} z {1} (łącznie {2} tras)"
                    AllowColumnResize="true"
                    Density="Density.Compact"
                    Responsive="true"
                    EmptyText="Nie znaleziono tras API Gateway spełniających kryteria.">
        <Columns>
            <RadzenDataGridColumn Property="@nameof(GatewayRoute.Priority)" Title="Priorytet" Sortable="true" Width="90px" TextAlign="TextAlign.Center">
                <Template Context="context">
                    <span class="badge bg-secondary-subtle text-secondary border font-monospace px-2 py-1 fs-6">
                        @context.Priority
                    </span>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="@nameof(GatewayRoute.MatchPattern)" Title="Wzorzec (MatchPattern)" Sortable="true" Filterable="true">
                <Template Context="context">
                    <div>
                        <span class="badge bg-dark-subtle text-dark border font-monospace px-2 py-1 text-break">
                            @context.MatchPattern
                        </span>
                        @if (!string.IsNullOrWhiteSpace(context.RouteName))
                        {
                            <div class="fw-bold text-dark mt-1 small">@context.RouteName</div>
                        }
                    </div>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Title="Cel Proxy" Sortable="false" Filterable="false">
                <Template Context="context">
                    <div class="d-flex align-items-center gap-1 font-monospace small">
                        <RadzenBadge BadgeStyle="@(context.Scheme == "https" ? BadgeStyle.Success : BadgeStyle.Warning)" Text="@context.Scheme.ToUpper()" IsPill="true" />
                        <strong>@context.AddressHost</strong><span class="text-muted">:@context.AddressPort</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(context.AddressBasePath))
                    {
                        <div class="text-muted small font-monospace">Path: <code>@context.AddressBasePath</code></div>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="@nameof(GatewayRoute.HttpMethods)" Title="Metody HTTP" Sortable="true" Width="130px">
                <Template Context="context">
                    <span class="font-monospace small text-primary">@context.HttpMethods</span>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="@nameof(GatewayRoute.IsEnabled)" Title="Status" Sortable="true" Width="110px" TextAlign="TextAlign.Center">
                <Template Context="context">
                    <RadzenBadge BadgeStyle="@(context.IsEnabled ? BadgeStyle.Success : BadgeStyle.Secondary)" 
                                 Text="@(context.IsEnabled ? "Aktywny" : "Wyłączony")" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Title="Akcje" Sortable="false" Filterable="false" TextAlign="TextAlign.Right" Width="180px">
                <Template Context="context">
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.25rem">
                        <RadzenButton Icon="science" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Info" Click="@(() => NavigationManager.NavigateTo("Admin/Gateway/Test"))" />
                        <RadzenButton Icon="edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@(() => NavigationManager.NavigateTo($"Admin/Gateway/Edit/{context.Id}"))" />
                        <RadzenButton Icon="@(context.IsEnabled ? "visibility_off" : "visibility")" Size="ButtonSize.Small" ButtonStyle="@(context.IsEnabled ? ButtonStyle.Warning : ButtonStyle.Success)" Click="@(() => OnToggleRoute.InvokeAsync(context))" />
                        <RadzenButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Click="@(() => OnDeleteRoute.InvokeAsync(context))" />
                    </RadzenStack>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
        <EmptyTemplate>
            <div class="text-center py-5 text-muted">
                <RadzenIcon Icon="alt_route" Style="font-size: 2rem; display: block; margin-bottom: 0.5rem;" />
                Nie znaleziono tras API Gateway spełniających kryteria.
            </div>
        </EmptyTemplate>
    </RadzenDataGrid>
</RadzenCard>

@code {
    [Parameter]
    public IEnumerable<GatewayRoute>? Routes { get; set; }

    [Parameter]
    public EventCallback<GatewayRoute> OnToggleRoute { get; set; }

    [Parameter]
    public EventCallback<GatewayRoute> OnDeleteRoute { get; set; }
}
