@namespace Quorum.Backend.AdminUI.Components
@using Quorum.Backend.AdminUI.Services
@inject NavigationManager NavigationManager

<RadzenCard class="rz-p-0 rz-shadow-1">
    <RadzenDataGrid Data="@Users" TItem="AdminUserDto" 
                    AllowSorting="true" 
                    AllowFiltering="true" 
                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" 
                    FilterMode="FilterMode.Simple"
                    AllowPaging="true" 
                    PageSize="10" 
                    ShowPagingSummary="true"
                    PagingSummaryFormat="Strona {0} z {1} (łącznie {2} użytkowników)"
                    AllowColumnResize="true"
                    Density="Density.Compact"
                    Responsive="true"
                    EmptyText="Nie znaleziono żadnych użytkowników spełniających kryteria.">
        <Columns>
            <RadzenDataGridColumn Property="@nameof(AdminUserDto.UserName)" Title="Login / Użytkownik" Sortable="true" Filterable="true" Width="200px">
                <Template Context="user">
                    <span class="fw-bold text-dark font-monospace">@user.UserName</span>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="@nameof(AdminUserDto.FullName)" Title="Imię i Nazwisko" Sortable="true" Filterable="true" Width="200px">
                <Template Context="user">
                    @(string.IsNullOrEmpty(user.FullName) ? "-" : user.FullName)
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="@nameof(AdminUserDto.Email)" Title="Adres Email" Sortable="true" Filterable="true" Width="240px">
                <Template Context="user">
                    <span class="d-inline-flex align-items-center gap-1">
                        @user.Email
                        @if (user.EmailConfirmed)
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="Zweryfikowany" IsPill="true" />
                        }
                    </span>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Title="Role" Sortable="false" Filterable="false">
                <Template Context="user">
                    @if (user.Roles != null && user.Roles.Any())
                    {
                        <div class="d-flex flex-wrap gap-1">
                            @foreach (var role in user.Roles)
                            {
                                var badgeStyle = role == "Admin" ? BadgeStyle.Danger : (role == "Manager" ? BadgeStyle.Warning : BadgeStyle.Primary);
                                <RadzenBadge BadgeStyle="@badgeStyle" Text="@role" IsPill="true" />
                            }
                        </div>
                    }
                    else
                    {
                        <span class="text-muted small fst-italic">— brak ról —</span>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="@nameof(AdminUserDto.IsLockedOut)" Title="Status" Sortable="true" Width="150px" TextAlign="TextAlign.Center">
                <Template Context="user">
                    <div class="d-flex align-items-center justify-content-center gap-1">
                        @if (user.IsLockedOut)
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="Zablokowany" />
                        }
                        else
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="Aktywny" />
                        }

                        @if (user.TwoFactorEnabled)
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="2FA" IsPill="true" />
                        }
                    </div>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="@nameof(AdminUserDto.CreatedAt)" Title="Data Utworzenia" Sortable="true" Width="160px">
                <Template Context="user">
                    <span class="text-muted small">@user.CreatedAt.ToString("yyyy-MM-dd HH:mm")</span>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Title="Akcje" Sortable="false" Filterable="false" TextAlign="TextAlign.Right" Width="130px">
                <Template Context="user">
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.25rem">
                        <RadzenButton Icon="edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@(() => NavigationManager.NavigateTo($"Admin/Users/Edit/{user.Id}"))" />
                        @if (user.UserName != "admin")
                        {
                            <RadzenButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Click="@(() => OnDeleteUser.InvokeAsync(user))" />
                        }
                    </RadzenStack>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
        <EmptyTemplate>
            <div class="text-center py-5 text-muted">
                <RadzenIcon Icon="group" Style="font-size: 2rem; display: block; margin-bottom: 0.5rem;" />
                Nie znaleziono żadnych użytkowników spełniających kryteria.
            </div>
        </EmptyTemplate>
    </RadzenDataGrid>
</RadzenCard>

@code {
    [Parameter]
    public IEnumerable<AdminUserDto>? Users { get; set; }

    [Parameter]
    public EventCallback<AdminUserDto> OnDeleteUser { get; set; }
}
