<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Quorum.Backend.AdminUI2</RootNamespace>
    
    <!-- Konfiguracja Paczki NuGet Razor Class Library dla Blazor .NET 10 -->
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>Quorum.Backend.AdminUI2</PackageId>
    <Version>2.0.0</Version>
    <Authors>Quorum</Authors>
    <Company>Quorum</Company>
    <Product>Quorum IdentityServer Admin UI 2 (Pure Blazor Radzen)</Product>
    <Title>Quorum Admin UI 2 - Pure Blazor Radzen for Open.IdentityServer</Title>
    <Description>Nowoczesny, w 100% oparty o Blazor i Radzen Blazor pakiet RCL (Razor Class Library) dostarczający kompletny panel administracyjny CRUD dla Open.IdentityServer, ASP.NET Identity, OIDC Federations i API Gateway. Architektura oparta o abstrakcyjne interfejsy modeli dziedzinowych z gotową implementacją Entity Framework Core.</Description>
    <PackageTags>identityserver;openidentityserver;admin;adminui;blazor;radzen;radzen-blazor;oidc;oauth2;dotnet10;rcl</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Quorum/Quorum.Backend</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Quorum/Quorum.Backend</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Radzen.Blazor" Version="11.2.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Quorum.Backend.EntityFramework\Quorum.Backend.EntityFramework.csproj" />
  </ItemGroup>

</Project>
