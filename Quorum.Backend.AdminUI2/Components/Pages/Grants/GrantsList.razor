@page "/admin/grants"
@layout AdminLayout
@inject IAdminGrantStore GrantStore
@inject DialogService DialogService
@inject NotificationService NotificationService

<PageTitle>Aktywne Granty i Tokeny | Quorum Admin UI 2</PageTitle>

<RadzenStack Gap="1.5rem">
    <RadzenRow JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
        <RadzenColumn Size="12" SizeMD="8">
            <RadzenText TextStyle="TextStyle.H4" Class="fw-bold mb-1">Aktywne Granty, Zgody i Tokeny OIDC</RadzenText>
            <RadzenText TextStyle="TextStyle.Body2" Class="text-muted">Przeglądanie i unieważnianie aktywnych Refresh Tokenów, zgód użytkowników (User Consent) oraz kodów autoryzacyjnych.</RadzenText>
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="4" Class="d-flex justify-content-md-end gap-2">
            <RadzenButton Icon="refresh" ButtonStyle="ButtonStyle.Light" Click="@LoadDataAsync" />
        </RadzenColumn>
    </RadzenRow>

    <RadzenCard Class="rz-p-3">
        <RadzenRow AlignItems="AlignItems.Center" Gap="1rem" Class="mb-3">
            <RadzenColumn Size="12" SizeMD="5">
                <RadzenTextBox Placeholder="Szukaj po kluczu, SubjectId, ClientId..." @bind-Value="searchTerm" Class="w-100" @oninput="@OnSearchInput" />
            </RadzenColumn>

            <RadzenColumn Size="12" SizeMD="4">
                <RadzenDropDown @bind-Value="selectedType" Data="@grantTypes" AllowClear="true" Placeholder="Filtruj po typie grantu..." Class="w-100" Change="@(() => { currentPage = 1; LoadDataAsync(); })" />
            </RadzenColumn>
        </RadzenRow>

        <RadzenDataGrid Data="@grants" Count="@totalCount" LoadData="@OnLoadData" AllowPaging="true" PageSize="10" PageSizeOptions="@(new int[] { 5, 10, 25, 50 })" IsLoading="@isLoading" TItem="PersistedGrantAdminModel" EmptyText="Brak aktywnych grantów.">
            <Columns>
                <RadzenDataGridColumn TItem="PersistedGrantAdminModel" Property="Type" Title="Typ Grantu" Width="170px">
                    <Template Context="g">
                        <RadzenBadge BadgeStyle="@(g.Type == "refresh_token" ? BadgeStyle.Primary : (g.Type == "user_consent" ? BadgeStyle.Success : BadgeStyle.Info))" Text="@g.Type" IsPill="true" />
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="PersistedGrantAdminModel" Property="ClientId" Title="Klient (Client ID)" Width="180px">
                    <Template Context="g">
                        <div class="fw-bold">@g.ClientId</div>
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="PersistedGrantAdminModel" Property="SubjectId" Title="Użytkownik (Subject ID)" Width="200px">
                    <Template Context="g">
                        <div style="font-family: monospace; font-size: 0.85rem;">@(g.SubjectId ?? "-")</div>
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="PersistedGrantAdminModel" Property="CreationTime" Title="Utworzono & Wygaśnięcie" Width="200px">
                    <Template Context="g">
                        <div>Utworzono: @g.CreationTime.ToString("yyyy-MM-dd HH:mm")</div>
                        <div class="text-muted" style="font-size: 0.78rem;">
                            @(g.Expiration.HasValue ? $"Wygasa: {g.Expiration.Value:yyyy-MM-dd HH:mm}" : "Brak daty wygaśnięcia")
                        </div>
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="PersistedGrantAdminModel" Title="Akcje" Width="130px" Sortable="false" TextAlign="TextAlign.End">
                    <Template Context="g">
                        <RadzenButton Icon="delete_forever" Text="Unieważnij" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Small" Click="@(() => ConfirmRevokeAsync(g))" Tooltip="Unieważnij ten grant" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </RadzenCard>
</RadzenStack>

@code {
    private IEnumerable<PersistedGrantAdminModel> grants = new List<PersistedGrantAdminModel>();
    private int totalCount;
    private bool isLoading = true;
    private string searchTerm = string.Empty;
    private string? selectedType;
    private List<string> grantTypes = new() { "refresh_token", "user_consent", "authorization_code", "reference_token", "device_code" };
    private int currentPage = 1;
    private int currentPageSize = 10;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task OnLoadData(LoadDataArgs args)
    {
        currentPage = (args.Skip ?? 0) / (args.Top ?? 10) + 1;
        currentPageSize = args.Top ?? 10;
        await LoadDataAsync();
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";
        currentPage = 1;
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        try
        {
            var result = await GrantStore.GetGrantsAsync(searchTerm, selectedType, null, currentPage, currentPageSize);
            grants = result.Items;
            totalCount = result.TotalCount;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ConfirmRevokeAsync(PersistedGrantAdminModel grant)
    {
        var confirmed = await DialogService.Confirm($"Czy na pewno chcesz unieważnić ten grant ({grant.Type}) dla klienta '{grant.ClientId}'?", "Unieważnienie grantu", new ConfirmOptions { OkButtonText = "Tak, unieważnij", CancelButtonText = "Anuluj" });
        if (confirmed == true)
        {
            var result = await GrantStore.RevokeGrantAsync(grant.Key);
            if (result.Success)
            {
                NotificationService.Notify(NotificationSeverity.Success, "Sukces", "Grant został unieważniony.");
                await LoadDataAsync();
            }
            else
            {
                NotificationService.Notify(NotificationSeverity.Error, "Błąd", result.Error ?? "Nie udało się unieważnić grantu.");
            }
        }
    }
}
