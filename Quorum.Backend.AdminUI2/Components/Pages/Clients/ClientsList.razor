@page "/admin/clients"
@layout AdminLayout
@inject IAdminClientStore ClientStore
@inject DialogService DialogService
@inject NotificationService NotificationService
@inject NavigationManager NavigationManager

<PageTitle>Klienci OAuth / OIDC | Quorum Admin UI 2</PageTitle>

<RadzenStack Gap="1.5rem">
    <RadzenRow JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
        <RadzenColumn Size="12" SizeMD="8">
            <RadzenText TextStyle="TextStyle.H4" Class="fw-bold mb-1">Klienci OAuth 2.0 / OpenID Connect</RadzenText>
            <RadzenText TextStyle="TextStyle.Body2" Class="text-muted">Aplikacje SPA, Web Apps, mikroserwisy M2M i urządzenia korzystające z autoryzacji serwera tożsamości.</RadzenText>
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="4" Class="d-flex justify-content-md-end gap-2">
            <RadzenButton Icon="add" Text="Dodaj Klienta" ButtonStyle="ButtonStyle.Primary" Click="@(() => NavigationManager.NavigateTo("admin/clients/create"))" />
            <RadzenButton Icon="refresh" ButtonStyle="ButtonStyle.Light" Click="@LoadDataAsync" />
        </RadzenColumn>
    </RadzenRow>

    <RadzenCard Class="rz-p-3">
        <RadzenRow AlignItems="AlignItems.Center" Gap="1rem" Class="mb-3">
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenTextBox Placeholder="Szukaj po ClientId, nazwie..." @bind-Value="searchTerm" Class="w-100" @oninput="@OnSearchInput" />
            </RadzenColumn>
        </RadzenRow>

        <RadzenDataGrid Data="@clients" Count="@totalCount" LoadData="@OnLoadData" AllowPaging="true" PageSize="10" PageSizeOptions="@(new int[] { 5, 10, 25, 50 })" IsLoading="@isLoading" TItem="ClientAdminModel" EmptyText="Brak klientów spełniających kryteria.">
            <Columns>
                <RadzenDataGridColumn TItem="ClientAdminModel" Property="ClientId" Title="Client ID" Width="200px">
                    <Template Context="client">
                        <div class="fw-bold text-primary">@client.ClientId</div>
                        <div class="text-muted" style="font-size: 0.78rem;">@(string.IsNullOrEmpty(client.ClientName) ? "Brak nazwy" : client.ClientName)</div>
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="ClientAdminModel" Title="Typ Przepływu (Grant Types)" Width="230px">
                    <Template Context="client">
                        <div class="d-flex flex-wrap gap-1">
                            @if (client.AllowedGrantTypes != null && client.AllowedGrantTypes.Count > 0)
                            {
                                @foreach (var gt in client.AllowedGrantTypes)
                                {
                                    <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="@gt" IsPill="true" />
                                }
                            }
                            else
                            {
                                <span class="text-muted">Brak</span>
                            }
                        </div>
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="ClientAdminModel" Title="Dozwolone Scopes" Width="240px">
                    <Template Context="client">
                        <div class="d-flex flex-wrap gap-1">
                            @if (client.AllowedScopes != null && client.AllowedScopes.Count > 0)
                            {
                                @foreach (var sc in client.AllowedScopes.Take(4))
                                {
                                    <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@sc" IsPill="true" />
                                }
                                @if (client.AllowedScopes.Count > 4)
                                {
                                    <RadzenBadge BadgeStyle="BadgeStyle.Secondary" Text="@($"+{client.AllowedScopes.Count - 4}")" IsPill="true" />
                                }
                            }
                        </div>
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="ClientAdminModel" Property="Enabled" Title="Status & PKCE" Width="160px">
                    <Template Context="client">
                        <div class="d-flex flex-column gap-1">
                            @if (client.Enabled)
                            {
                                <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="Włączony" IsPill="true" />
                            }
                            else
                            {
                                <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="Wyłączony" IsPill="true" />
                            }

                            @if (client.RequirePkce)
                            {
                                <RadzenBadge BadgeStyle="BadgeStyle.Primary" Text="PKCE Wymagane" IsPill="true" />
                            }
                        </div>
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="ClientAdminModel" Title="Akcje" Width="140px" Sortable="false" TextAlign="TextAlign.End">
                    <Template Context="client">
                        <div class="d-flex justify-content-end gap-1">
                            <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Flat" Size="ButtonSize.Small" Click="@(() => NavigationManager.NavigateTo($"admin/clients/{client.Id}/edit"))" Tooltip="Edytuj klienta" />
                            <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Small" Click="@(() => ConfirmDeleteAsync(client))" Tooltip="Usuń klienta" />
                        </div>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </RadzenCard>
</RadzenStack>

@code {
    private IEnumerable<ClientAdminModel> clients = new List<ClientAdminModel>();
    private int totalCount;
    private bool isLoading = true;
    private string searchTerm = string.Empty;
    private int currentPage = 1;
    private int currentPageSize = 10;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task OnLoadData(LoadDataArgs args)
    {
        currentPage = (args.Skip ?? 0) / (args.Top ?? 10) + 1;
        currentPageSize = args.Top ?? 10;
        await LoadDataAsync();
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";
        currentPage = 1;
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        try
        {
            var result = await ClientStore.GetClientsAsync(searchTerm, currentPage, currentPageSize);
            clients = result.Items;
            totalCount = result.TotalCount;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ConfirmDeleteAsync(ClientAdminModel client)
    {
        var confirmed = await DialogService.Confirm($"Czy na pewno chcesz bezpowrotnie usunąć klienta '{client.ClientId}'?", "Potwierdzenie usunięcia", new ConfirmOptions { OkButtonText = "Tak, usuń", CancelButtonText = "Anuluj" });
        if (confirmed == true)
        {
            var result = await ClientStore.DeleteClientAsync(client.Id);
            if (result.Success)
            {
                NotificationService.Notify(NotificationSeverity.Success, "Sukces", $"Klient '{client.ClientId}' został usunięty.");
                await LoadDataAsync();
            }
            else
            {
                NotificationService.Notify(NotificationSeverity.Error, "Błąd", result.Error ?? "Nie udało się usunąć klienta.");
            }
        }
    }
}
