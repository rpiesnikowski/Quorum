<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Quorum.Backend.AdminAPI</RootNamespace>
    <!-- Pozwala na użycie zarówno jako samodzielny Web API jak i biblioteka / pakiet NuGet -->
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Konfiguracja Paczki NuGet dla .NET 10 Web API / REST Service -->
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>Quorum.Backend.AdminAPI</PackageId>
    <Version>2.0.0</Version>
    <Authors>Robert Pieśnikowski</Authors>
    <Product>Quorum IdentityServer &amp; API Gateway Admin REST API</Product>
    <Title>Quorum Admin REST API for Open.IdentityServer</Title>
    <Description>Kompletny pakiet REST API dla Open.IdentityServer, ASP.NET Identity, OIDC Federations i API Gateway. Oddziela warstwę interfejsu użytkownika (GUI / Radzen / React / Angular / Mobile) od bazy danych, udostępniając spójne endpointy CRUD, walidację, symulator bramki oraz gotowe kontrakty HTTP.</Description>
    <PackageTags>identityserver;openidentityserver;admin;rest;api;webapi;crud;oidc;oauth2;dotnet10;gateway;radzen</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/rpiesnikowski/Quorum</PackageProjectUrl>
    <RepositoryUrl>https://github.com/rpiesnikowski/Quorum</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Quorum.Backend.AdminUI\Quorum.Backend.AdminUI.csproj" />
    <ProjectReference Include="..\Quorum.Backend.EntityFramework\Quorum.Backend.EntityFramework.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
